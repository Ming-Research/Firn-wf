--- a/tests/unit/pubsub.tcl
+++ b/tests/unit/pubsub.tcl
@@ -84,7 +84,8 @@
     test "PUBLISH/SUBSCRIBE after UNSUBSCRIBE without arguments" {
         set rd1 [redis_deferring_client]
         assert_equal {1 2 3} [subscribe $rd1 {chan1 chan2 chan3}]
-        unsubscribe $rd1
+        $rd1 unsubscribe
+        assert_equal {2 1 0} [consume_subscribe_messages $rd1 unsubscribe {chan1 chan2 chan3}]
         assert_equal 0 [r publish chan1 hello]
         assert_equal 0 [r publish chan2 hello]
         assert_equal 0 [r publish chan3 hello]
@@ -157,7 +158,8 @@
     test "PUBLISH/PSUBSCRIBE after PUNSUBSCRIBE without arguments" {
         set rd1 [redis_deferring_client]
         assert_equal {1 2 3} [psubscribe $rd1 {chan1.* chan2.* chan3.*}]
-        punsubscribe $rd1
+        $rd1 punsubscribe
+        assert_equal {2 1 0} [consume_subscribe_messages $rd1 punsubscribe {chan1.* chan2.* chan3.*}]
         assert_equal 0 [r publish chan1.hi hello]
         assert_equal 0 [r publish chan2.hi hello]
         assert_equal 0 [r publish chan3.hi hello]
@@ -215,8 +217,10 @@
         set patterns [r pubsub numpat]
 
         # clean up clients
-        punsubscribe $rd1
-        punsubscribe $rd2
+        $rd1 punsubscribe
+        assert_equal {1 0} [consume_subscribe_messages $rd1 punsubscribe {foo* bar*}]
+        $rd2 punsubscribe
+        assert_equal {1 0} [consume_subscribe_messages $rd2 punsubscribe {foo* baz*}]
         assert_equal 3 $patterns
         $rd1 close
         $rd2 close
--- a/tests/unit/pubsubshard.tcl
+++ b/tests/unit/pubsubshard.tcl
@@ -45,7 +45,8 @@
         assert_equal {1} [ssubscribe $rd1 {chan1}]
         assert_equal {2} [ssubscribe $rd1 {chan2}]
         assert_equal {3} [ssubscribe $rd1 {chan3}]
-        sunsubscribe $rd1
+        $rd1 sunsubscribe
+        assert_equal {2 1 0} [consume_subscribe_messages $rd1 sunsubscribe {chan1 chan2 chan3}]
         assert_equal 0 [r SPUBLISH chan1 hello]
         assert_equal 0 [r SPUBLISH chan2 hello]
         assert_equal 0 [r SPUBLISH chan3 hello]
