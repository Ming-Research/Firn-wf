--- a/tests/support/test.tcl
+++ b/tests/support/test.tcl
@@ -161,6 +161,19 @@
     return 0
 }
 
+# A failed test can leave the shared connection in RESP3, in raw mode or with
+# unread replies, and every later test then reads shifted replies. Give the
+# next test a fresh connection in the mode the failed one started in.
+proc restore_shared_connection {resp3 raw} {
+    catch {
+        reconnect
+        if {$resp3} {
+            r hello 3
+        }
+        r readraw $raw
+    }
+}
+
 proc test {name code {okpattern undefined} {tags {}}} {
     # abort if test name in skiptests
     if {[search_pattern_list $name $::skiptests]} {
@@ -217,6 +230,14 @@
 
     send_data_packet $::test_server_fd testing $name
 
+    set connection_resp3 0
+    set connection_raw 0
+    catch {
+        set connection_id [string range [srv 0 client] [string length ::redis::redisHandle] end]
+        set connection_resp3 $::redis::testing_resp3($connection_id)
+        set connection_raw $::redis::readraw($connection_id)
+    }
+
     set test_start_time [clock milliseconds]
     if {[catch {set retval [uplevel 1 $code]} error]} {
         set assertion [string match "assertion:*" $error]
@@ -232,6 +253,7 @@
 
             incr ::num_failed
             send_data_packet $::test_server_fd err [join $details "\n"]
+            restore_shared_connection $connection_resp3 $connection_raw
 
             if {$::stop_on_failure} {
                 puts "Test error (last server port:[srv port], log:[srv stdout]), press enter to teardown the test."
@@ -254,6 +276,7 @@
 
             incr ::num_failed
             send_data_packet $::test_server_fd err [join $details "\n"]
+            restore_shared_connection $connection_resp3 $connection_raw
         }
     }
 
