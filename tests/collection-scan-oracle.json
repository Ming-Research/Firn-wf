  {
    "name": "script-resp2",
    "resp": 2,
    "commands": [
      [
        "SADD",
        "scan:set",
        "member"
      ],
      [
        "HSET",
        "scan:hash",
        "field",
        "value"
      ],
      [
        "ZADD",
        "scan:zset",
        "3",
        "member"
      ],
      [
        "EVAL",
        "return {redis.call('SSCAN',KEYS[1],0),redis.call('HSCAN',KEYS[2],0),redis.call('ZSCAN',KEYS[3],0)}",
        "3",
        "scan:set",
        "scan:hash",
        "scan:zset"
      ],
      [
        "EVAL",
        "return redis.pcall('SSCAN',KEYS[1],'bad')",
        "1",
        "scan:set"
      ],
      [
        "EVAL",
        "local r=redis.pcall('HSCAN',KEYS[1],0,'COUNT',0); return r.err",
        "1",
        "scan:hash"
      ],
      [
        "EVAL",
        "local ok,r=pcall(function() return redis.call('ZSCAN',KEYS[1],0,'NOVALUES') end); return ok and 'unexpected success' or 'caught'",
        "1",
        "scan:zset"
      ],
      [
        "EVAL",
        "redis.call('INCR',KEYS[1]); return redis.call('SSCAN','scan:set',0)",
        "1",
        "scan:counter"
      ],
      [
        "GET",
        "scan:counter"
      ],
      [
        "PING"
      ]
    ]
  },
