alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias MemoryMeter = std::process::MemoryMeter;
alias exit_status = std::process::exit_status;

struct Cell {
  live: Bool;
  payload: Box<Slots<u8>>;
}

struct Arena {
  cells: Box<Slots<Cell>>;
}

fn replace(arena: &Arena) -> r: unit writes(arena) {
  if arena^.cells.inner.len > 0_u64 {
    let fresh = box_slots_new::<u8>(capacity: 64_u64);
    set arena^.cells.inner[0_u64].payload = move fresh;
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let cells = box_slots_new::<Cell>(capacity: 1_u64);
  let first = box_slots_new::<u8>(capacity: 64_u64);
  let yes = True();
  let cell = Cell(live: yes, payload: move first);
  if cells.inner.len < cells.inner.cap {
    place_back(window: &cells.inner, value: move cell);
  } else {
    let unplaced = move cell;
  }
  let arena = Arena(cells: move cells);
  replace(arena: &arena);
  let before = std::process::heap_in_use(meter: &meter);
  for (i in 0_u64..1000_u64) {
    replace(arena: &arena);
  }
  let after = std::process::heap_in_use(meter: &meter);
  if after > before {
    let growth = after - before;
    if growth >= 8000_u64 {
      return exit_status(code: 12_u8);
    }
  }
  return exit_status(code: 0_u8);
}
