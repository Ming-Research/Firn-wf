struct Registry {
  root: Frozen<u8>;
  position: u64;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let root = frozen_new::<u8>(value: 7_u8);
  let held = frozen_share::<u8>(frozen: &root);
  let state = Registry(root: move held, position: 0_u64);
  let dataset = shared_new::<Registry>(value: move state);
  atomic registry = &dataset {
    if root.inner != 7_u8 {
      return std::process::exit_status(code: 12_u8);
    }
    if registry^.root.inner != 7_u8 {
      return std::process::exit_status(code: 12_u8);
    }
    set registry^.position = 1_u64;
  }
  atomic registry = &dataset {
    if registry^.position != 1_u64 {
      return std::process::exit_status(code: 13_u8);
    }
  }
  let replacement = frozen_new::<u8>(value: 9_u8);
  atomic registry = &dataset {
    set registry^.root = move replacement;
    if registry^.root.inner != 9_u8 {
      return std::process::exit_status(code: 14_u8);
    }
  }
  if root.inner != 7_u8 {
    return std::process::exit_status(code: 15_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
