struct Registry {
  root: SharedRead<u8>;
  position: u64;
}

fn freeze(value: u8) -> result: SharedRead<u8> pure {
  let writer = shared_new::<u8>(value: value);
  return shared_read::<u8>(shared: &writer);
}

fn main() -> status: std::process::ExitStatus pure waits {
  let root = freeze(value: 7_u8);
  let held = shared_read_share::<u8>(shared: &root);
  let state = Registry(root: move held, position: 0_u64);
  let dataset = shared_new::<Registry>(value: move state);
  atomic registry = &dataset, byte = &root {
    if byte^ != 7_u8 {
      return std::process::exit_status(code: 12_u8);
    }
    set registry^.position = 1_u64;
  }
  atomic registry = &dataset {
    if registry^.position != 1_u64 {
      return std::process::exit_status(code: 13_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
