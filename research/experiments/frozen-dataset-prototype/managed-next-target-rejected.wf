struct Registry {
  root: Frozen<u8>;
  live: Frozen<u8>;
  position: u64;
  published: Bool;
}

fn writer(dataset: Shared<Registry>) -> result: unit pure waits {
  let replacement = frozen_new::<u8>(value: 9_u8);
  atomic registry = &dataset {
    set registry^.live = move replacement;
    set registry^.published = True();
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let root = frozen_new::<u8>(value: 7_u8);
  let live = frozen_share::<u8>(frozen: &root);
  let reader = frozen_share::<u8>(frozen: &root);
  let pending = False();
  let state = Registry(root: move root, live: move live, position: 0_u64, published: pending);
  let dataset = shared_new::<Registry>(value: move state);
  if reader.inner != 7_u8 {
    return std::process::exit_status(code: 12_u8);
  }
  let worker_dataset = shared_share::<Registry>(shared: &dataset);
  let captured = 0_u8;
  let published = 0_u8;
  let position = 0_u64;
  let finished = spawn writer(dataset: move worker_dataset);
  let during = reader.inner;
  atomic registry = &dataset when registry^.published {
    let byte = &registry^.root.inner;
    set captured = byte^;
    set published = registry^.live.inner;
    set registry^.position = 1_u64;
  }
  let after = reader.inner;
  atomic registry = &dataset {
    set position = registry^.position;
  }
  let joined = finished;
  if captured != 7_u8 {
    return std::process::exit_status(code: 12_u8);
  }
  if position != 1_u64 {
    return std::process::exit_status(code: 13_u8);
  }
  if published != 9_u8 {
    return std::process::exit_status(code: 14_u8);
  }
  if during != 7_u8 {
    return std::process::exit_status(code: 15_u8);
  }
  if after != 7_u8 {
    return std::process::exit_status(code: 15_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
