alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const heap_name: Array<u8, 4> =[104_u8, 101_u8, 97_u8, 112_u8];

fn heap_context(totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, meter: std::process::MemoryMeter, index: u64) -> result: unit pure waits {
  doc "Until the deadline reads the process's live heap bytes through its own share of the memory meter once per operation, in batches of 1024, with no atomic statement, then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      let used = std::process::heap_in_use(meter: &meter);
      set state = ixor(state, used);
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn heap_start(totals: &Shared<Totals>, clock: &Clock, meter: &std::process::MemoryMeter, millis: u64, contexts: u64) -> started: Instant reads(totals), reads(meter), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    let share = std::process::meter_share(meter: meter);
    spawn heap_context(totals: move tally_handle, gate: move gate_handle, clock: move ticks, meter: move share, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn heap_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W-heap: each of CONTEXTS contexts reads the process's live heap bytes through its own share of the memory meter once per operation, for MILLISECONDS, with no atomic statement; the heap reading firn takes after every command.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let totals = totals_new();
  let started = heap_start(totals: &totals, clock: &bench.clock, meter: &bench.meter, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &heap_name[0_u64..4_u64], totals: &totals, started: started, ended: ended);
}
