# Settings for the temporary runtime-contention workflow, which runs when
# this file changes on its branch (a workflow only on a branch cannot be
# dispatched by hand). runner is 14900k or github.
runner=14900k
contexts=64
millis=5000
passes=3
witnesses=base private shared read read_param write heap
cpu_lists=0,2 0,2,4,6 0,2,4,6,8,10,12,14 0-15
