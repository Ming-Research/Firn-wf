alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const write_name: Array<u8, 5> =[119_u8, 114_u8, 105_u8, 116_u8, 101_u8];

fn write_context(map: Shared<ConcurrentHashMap<u64>>, counter: Shared<u64>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "Until the deadline holds its own entry of the shared map, under a key no other context uses, and then the shared object every context names, in one atomic statement per operation, as SET holds its key and then the keyspace's metadata; it reads and writes the entry as W-read does and adds one to the object as W-shared does, in batches of 1024; then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let key = context_key(index: index);
  let mine = &key[0_u64..8_u64];
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      atomic slot = &map[mine], held = &counter {
        match slot^ {
          Some(value: seen) => {
            set state = ixor(state, seen^);
          }
          None() => {
          }
        }
        set slot^ = Some<u64>(value: state);
        set state = ixor(state, held^);
        set held^ = held^ +wrap 1_u64;
      }
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn write_start(map: &Shared<ConcurrentHashMap<u64>>, counter: &Shared<u64>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(map), reads(counter), reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let map_handle = shared_share::<ConcurrentHashMap<u64>>(shared: map);
    let counter_handle = shared_share::<u64>(shared: counter);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn write_context(map: move map_handle, counter: move counter_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn write_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W-write: each of CONTEXTS contexts holds its own entry of one shared concurrent hash map and then one shared object every context takes, in one atomic statement per operation, for MILLISECONDS.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let map = shared_map_new::<u64>(capacity: bench.contexts);
  let counter = shared_new::<u64>(value: 0_u64);
  let totals = totals_new();
  let started = write_start(map: &map, counter: &counter, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &write_name[0_u64..5_u64], totals: &totals, started: started, ended: ended);
}
