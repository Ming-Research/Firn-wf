alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;

public fn base_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-base: each of CONTEXTS contexts advances its own local number for MILLISECONDS, with no atomic statement; the runtime's no-sharing baseline.";

public fn private_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-private: each of CONTEXTS contexts adds one to a shared object it made and alone holds, in one atomic statement per operation, for MILLISECONDS; an atomic statement that never meets another context.";

public fn shared_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-shared: each of CONTEXTS contexts adds one to the same shared object, in one atomic statement per operation, for MILLISECONDS; no map.";

public fn read_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-read: each of CONTEXTS contexts holds its own entry of one shared concurrent hash map, in one atomic statement per operation, for MILLISECONDS; no other shared object.";

public fn write_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-write: each of CONTEXTS contexts holds its own entry of one shared concurrent hash map and then one shared object every context takes, in one atomic statement per operation, for MILLISECONDS.";

public fn read_param_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-read-param: W-read with each atomic statement reaching the map through a read-only reference parameter, as firn's GET does.";

public fn heap_main(inputs: Inputs) -> status: ExitStatus pure waits doc "W-heap: each of CONTEXTS contexts reads the process's live heap bytes through its own share of the memory meter once per operation, for MILLISECONDS, with no atomic statement; the heap reading firn takes after every command.";
