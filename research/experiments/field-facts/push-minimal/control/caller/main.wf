alias ExitStatus = std::process::ExitStatus;

struct Reader {
  a: u64;
  b: u64;
}

fn f(bound: u64) -> next: u64 pure contract {
  ensures next <= bound;
} {
  return bound;
}

fn touch(value: &u64) -> result: unit writes(value) {
  set value^ = 1_u64;
  return unit;
}

fn probe(reader: &Reader) -> result: unit writes(reader) contract {
  requires reader^.a <= reader^.b;
} {
  let unrelated = 0_u64;
  for (
    iteration in 0_u64..2_u64,
    invariant window: reader^.a <= reader^.b
  ) {
    let b = reader^.b;
    let n = f(bound: b);
    set reader^.a = n;
    set reader^.b = b;
    touch(value: &unrelated);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  let state = Reader(a: 0_u64, b: 1_u64);
  probe(reader: &state);
  return std::process::exit_status(code: 0_u8);
}
