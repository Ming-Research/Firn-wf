alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Clock = std::time::Clock;

const key_bytes: Array<u8, 1> = "x";

fn held_key(data: Shared<ConcurrentHashMap<u64>>, written: DecisionCell, stop: DecisionCell) -> result: unit pure waits {
  let key = &key_bytes[0_u64..1_u64];
  atomic slot = &data[key] {
    set slot^ = Some<u64>(value: 1_u64);
    let verdict = claim_written(cell: &written);
    loop {
      match decision_cell_read(cell: &stop) {
        Open() => {
        }
        Written() => {
        }
        Killed() => {
          break;
        }
      }
    }
  }
  return unit;
}

fn read_busy(data: &Shared<ConcurrentHashMap<u64>>, busy: &Shared<Bool>) -> result: u64 reads(data), reads(busy) waits {
  let key = &key_bytes[0_u64..1_u64];
  let answer = 0_u64;
  atomic slot = &data^[key], timedout = &busy^ when timedout^ {
    if timedout^ {
      set answer = 1_u64;
    } else {
      match slot^ {
        Some(value: stored) => {
          set answer = 2_u64;
        }
        None() => {
          set answer = 2_u64;
        }
      }
    }
  }
  return answer;
}

fn trial(clock: &Clock, count: u64) -> code: u8 writes(clock) waits {
  let data = shared_map_new::<u64>(capacity: 8_u64);
  let quiet = False();
  let busy = shared_new::<Bool>(value: quiet);
  let written = decision_cell_new();
  let stop = decision_cell_new();
  let start = std::time::now(clock: clock);
  let deadline = std::time::instant_after(instant: start, nanoseconds: 1000000000_u64);
  let child_data = shared_share::<ConcurrentHashMap<u64>>(shared: &data);
  let child_written = decision_cell_share(cell: &written);
  let child_stop = decision_cell_share(cell: &stop);
  let never = std::time::cancel_never();
  let job = spawn held_key(data: move child_data, written: move child_written, stop: move child_stop);
  let elapsed = std::time::sleep_until(deadline: deadline, cancel: &never);
  let began = False();
  match decision_cell_read(cell: &written) {
    Open() => {
    }
    Written() => {
      set began = True();
    }
    Killed() => {
    }
  }
  atomic timedout = &busy {
    set timedout^ = True();
  }
  let answer = 0_u64;
  if began {
    if count == 1_u64 {
      set answer = read_busy(data: &data, busy: &busy);
    }
  }
  let stopped = claim_killed(cell: &stop);
  let joined = job;
  std::time::close_cancel_watch(watch: move never);
  if bnot(began) {
    return 5_u8;
  }
  match elapsed {
    Ok(value: slept) => {
    }
    Err(error: cancelled) => {
      return 9_u8;
    }
  }
  let observed = 0_u64;
  let key = &key_bytes[0_u64..1_u64];
  atomic slot = &data[key] {
    match slot^ {
      Some(value: stored) => {
        set observed = stored^;
      }
      None() => {
      }
    }
  }
  if observed != 1_u64 {
    return 1_u8;
  }
  match decision_cell_read(cell: &written) {
    Open() => {
      return 2_u8;
    }
    Written() => {
    }
    Killed() => {
      return 3_u8;
    }
  }
  match stopped {
    Open() => {
      return 7_u8;
    }
    Written() => {
      return 7_u8;
    }
    Killed() => {
    }
  }
  if count == 1_u64 {
    if answer != 1_u64 {
      return 8_u8;
    }
  }
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: arguments, drivers: drivers, cwd: directory, handles: factory, clock: clock, ..) = move inputs;
  let std::fs::Directory(read: readable, write: writable) = move directory;
  let total = std::text::args_count(args: &arguments);
  let code = if drivers < 2_u64 {
    give 4_u8;
  } else if total == 0_u64 {
    give 6_u8;
  } else if total > 2_u64 {
    give 6_u8;
  } else {
    let count = total - 1_u64;
    give trial(clock: &clock, count: count);
  }
  let closed_write = std::fs::close_directory_write(factory: &factory, directory: move writable);
  let closed_read = std::fs::close_directory(factory: &factory, directory: move readable);
  return std::process::exit_status(code: code);
}
