struct User {
  doc "Valkey ACL LOAD use-after-free with a deferred-free client: https://github.com/valkey-io/valkey/pull/3800 . The local client_user alias models the client's retained pointer while the registry frees its user.";
  name: Array<u8, 4>;
}

fn acl_load(old_user: Box<User>) -> result: unit pure {
  release::<Box<User>>(value: move old_user);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let name = array_filled::<u8, 4>(value: 97_u8);
  let record = User(name: name);
  let registry_user = box_new::<User>(value: record);
  let client_user = &registry_user.inner;
  let close_deferred = True();
  acl_load(old_user: move registry_user);
  if close_deferred {
    let first_name_byte = client_user^.name[0_u64];
    return std::process::exit_status(code: first_name_byte);
  }
  return std::process::exit_status(code: 0_u8);
}
