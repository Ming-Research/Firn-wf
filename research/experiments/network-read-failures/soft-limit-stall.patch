+/// Experiment only (research/experiments/network-read-failures): reads a
+/// large bulk body with one-second receive bounds, prints how long the read
+/// took and its longest wait for a byte, and for every second without a byte
+/// prints the state of the server's sockets, rings and threads.
+pub(super) mod stall {
+    use std::io::Read;
+    use std::net::TcpStream;
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+
+    /// The server's process id and port, set by the case that is watched.
+    pub static SERVER: Mutex<Option<(u32, u16)>> = Mutex::new(None);
+
+    pub fn read_watched(stream: &mut TcpStream, body: &mut [u8]) {
+        let start = Instant::now();
+        stream.set_read_timeout(Some(Duration::from_secs(1))).expect("bound the watched read");
+        let mut read = 0;
+        let mut longest = Duration::ZERO;
+        let mut waited = 0_u32;
+        let mut last = Instant::now();
+        while read < body.len() {
+            match stream.read(&mut body[read..]) {
+                Ok(0) => panic!("pub/sub bulk body: closed after {read} bytes"),
+                Ok(count) => {
+                    let now = Instant::now();
+                    longest = longest.max(now - last);
+                    last = now;
+                    read += count;
+                    waited = 0;
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(error) if matches!(error.kind(), std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut) => {
+                    waited += 1;
+                    eprintln!(
+                        "STALL second={waited} read={read} of={} since_read_start_ms={}",
+                        body.len(),
+                        start.elapsed().as_millis()
+                    );
+                    dump(waited == 1 || waited == 10);
+                    assert!(waited < 25, "pub/sub bulk body: no byte for 25 s after {read} bytes");
+                }
+                Err(error) => panic!("pub/sub bulk body: {error}"),
+            }
+        }
+        stream.set_read_timeout(Some(Duration::from_secs(10))).expect("restore the read bound");
+        eprintln!(
+            "BODY bytes={} ms={} longest_wait_ms={}",
+            body.len(),
+            start.elapsed().as_millis(),
+            longest.as_millis()
+        );
+    }
+
+    fn show(title: &str, text: &str, lines: usize) {
+        eprintln!("DUMP {title}");
+        for line in text.lines().take(lines) {
+            eprintln!("DUMP   {line}");
+        }
+    }
+
+    /// The server's TCP sockets as the kernel reports them, each thread's
+    /// state and system call, and each io_uring's queues.
+    pub fn dump(counters: bool) {
+        let Some((pid, port)) = *SERVER.lock().expect("server") else {
+            eprintln!("DUMP no server named");
+            return;
+        };
+        let port_text = format!(":{port}");
+        match std::process::Command::new("ss")
+            .args(["-tinm", "sport", "=", &port_text, "or", "dport", "=", &port_text])
+            .output()
+        {
+            Ok(output) => show("ss", &String::from_utf8_lossy(&output.stdout), 40),
+            Err(error) => eprintln!("DUMP ss failed: {error}"),
+        }
+        if let Ok(tasks) = std::fs::read_dir(format!("/proc/{pid}/task")) {
+            for task in tasks.flatten() {
+                let path = task.path();
+                let read = |name: &str| std::fs::read_to_string(path.join(name)).unwrap_or_else(|error| format!("unreadable: {error}"));
+                let stat = read("stat");
+                let state = stat.rsplit(") ").next().and_then(|rest| rest.split(' ').next()).unwrap_or("?").to_owned();
+                eprintln!(
+                    "DUMP thread {} comm={} state={state} syscall={} wchan={}",
+                    task.file_name().to_string_lossy(),
+                    read("comm").trim(),
+                    read("syscall").trim(),
+                    read("wchan").trim()
+                );
+            }
+        }
+        if let Ok(descriptors) = std::fs::read_dir(format!("/proc/{pid}/fdinfo")) {
+            for descriptor in descriptors.flatten() {
+                let text = std::fs::read_to_string(descriptor.path()).unwrap_or_default();
+                if text.contains("SqHead") || text.contains("SqMask") {
+                    show(&format!("io_uring fd {}", descriptor.file_name().to_string_lossy()), &text, 80);
+                }
+            }
+        }
+        if counters {
+            for file in ["/proc/net/sockstat", "/proc/net/netstat"] {
+                show(file, &std::fs::read_to_string(file).unwrap_or_default(), 6);
+            }
+        }
+    }
+}
