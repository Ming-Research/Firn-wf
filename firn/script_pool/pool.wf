fn new_pool() -> pool: EnginePool pure {
  let idle = box_slots_new::<PooledEngine>(capacity: 0_u64);
  let registry = box_slots_new::<Registered>(capacity: 0_u64);
  let active = box_slots_new::<Active>(capacity: 0_u64);
  let current = None<u64>();
  let stopping = False();
  return EnginePool(idle: move idle, out: 0_u64, registry: move registry, source_bytes: 0_u64, generation: 0_u64, running: 0_u64, active: move active, current: current, next_id: 0_u64, busy: 0_u64, stopping: stopping);
}
