fn new_pool() -> pool: EnginePool pure {
  let idle = box_slots_new::<PooledEngine>(capacity: 0_u64);
  let registry = box_slots_new::<Registered>(capacity: 0_u64);
  return EnginePool(idle: move idle, out: 0_u64, registry: move registry, source_bytes: 0_u64, generation: 0_u64, running: 0_u64, kills: 0_u64, script_runs: 0_u64, script_held_ns: 0_u64, script_halo_ns: 0_u64, script_command_ns: 0_u64, script_collections: 0_u64);
}
