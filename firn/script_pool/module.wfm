public struct Cached {
  public sha: Array<u8, 40>;
  public id: halo::embed::ScriptId;
}

public struct PooledEngine {
  public engine: halo::embed::Engine;
  public generation: u64;
  public cache: Box<Slots<Cached>>;
}

public struct Registered {
  public sha: Array<u8, 40>;
  public source: Box<Slots<u8>>;
}

public struct EnginePool {
  doc "The one engine scripts run on and the SHA1-to-source registry. A script takes the engine in a short statement that waits while out is 1, keeps it outside the pool's statements while one of its attempts runs, and puts it back after the attempt, so that scripts use the engine in turn and see the state earlier ones left in it, as Redis's scripts share one Lua state; idle holds it while no script has it. running counts the scripts in progress, which SCRIPT KILL answers by, and kills the kills requested, which a script compares, between its attempts, with the count it saw when it first took the engine.";
  public idle: Box<Slots<PooledEngine>>;
  public out: u64;
  public registry: Box<Slots<Registered>>;
  public source_bytes: u64;
  public generation: u64;
  public running: u64;
  public kills: u64;
  public probe_calls_gc: u64;
  public probe_calls_nogc: u64;
  public probe_sum_gc: u64;
  public probe_sum_nogc: u64;
  public probe_max_gc: u64;
  public probe_max_nogc: u64;
  public probe_collections: u64;
  public probe_hist_gc: Array<u64, 40>;
  public probe_hist_nogc: Array<u64, 40>;
  public gc_pause: u64;
  public gc_floor: u64;
  public probe_gc: ProbeGc;
}

public fn new_pool() -> pool: EnginePool pure doc "A pool with no engine yet, the engine made when first taken.";

public struct ProbeKind {
  public live_objects_sum: u64;
  public live_objects_min: u64;
  public live_objects_max: u64;
  public live_bytes_sum: u64;
  public live_bytes_min: u64;
  public live_bytes_max: u64;
  public freed_objects_sum: u64;
  public freed_bytes_sum: u64;
  public slots_visited_sum: u64;
  public first_live_objects: u64;
  public first_live_bytes: u64;
}

public struct ProbeGc {
  public samples: u64;
  public unobserved_collections: u64;
  public first_available: u64;
  public gray_pops_sum: u64;
  public gray_pops_min: u64;
  public gray_pops_max: u64;
  public next_threshold: u64;
  public strings: ProbeKind;
  public tables: ProbeKind;
  public closures: ProbeKind;
  public upvalues: ProbeKind;
  public pause_hist: Array<u64, 5>;
}

public fn new_probe_gc() -> probe: ProbeGc pure doc "Empty experiment counters; minima become meaningful with the first snapshot.";
