public struct Cached {
  public sha: Array<u8, 40>;
  public id: halo::embed::ScriptId;
}

public struct PooledEngine {
  public engine: halo::embed::Engine;
  public generation: u64;
  public cache: Box<Slots<Cached>>;
}

public struct Registered {
  public sha: Array<u8, 40>;
  public source: Box<Slots<u8>>;
}

public struct EnginePool {
  doc "The one engine scripts run on and the SHA1-to-source registry. A script takes the engine in a short statement that waits while out is 1, keeps it outside the pool's statements while one of its attempts runs, and puts it back after the attempt, so that scripts use the engine in turn and see the state earlier ones left in it, as Redis's scripts share one Lua state; idle holds it while no script has it. running counts the scripts in progress, which SCRIPT KILL answers by, and kills the kills requested, which a script compares, between its attempts, with the count it saw when it first took the engine. The script_* fields are diagnostics INFO reports, each updated in a statement a script already holds the pool for: script_runs counts the scripts that took the engine, in the statement that takes it; the others are updated in the statement that gives the engine back, per take: script_held_ns the nanoseconds on the monotonic clock from a successful take to the give-back, script_halo_ns those spent inside Halo's start, resume and call-continuation entry points, script_command_ns those spent running redis.call and redis.pcall commands, and script_collections the garbage collections the engine completed meanwhile. script_collect_runs counts takes during which a collection completed, script_collect_held_ns sums their held nanoseconds, script_collect_held_max_ns and script_collect_halo_max_ns keep their held and Halo maxima, and script_collect_over_100us counts those whose held nanoseconds exceed 100000. script_plain_held_max_ns and script_plain_halo_max_ns keep the held and Halo maxima of takes during which no collection completed. SCRIPT LOAD passes zeros and changes none of these diagnostics. Sums saturate.";
  public idle: Box<Slots<PooledEngine>>;
  public out: u64;
  public registry: Box<Slots<Registered>>;
  public source_bytes: u64;
  public generation: u64;
  public running: u64;
  public kills: u64;
  public script_runs: u64;
  public script_held_ns: u64;
  public script_halo_ns: u64;
  public script_command_ns: u64;
  public script_collections: u64;
  public script_collect_runs: u64;
  public script_collect_held_ns: u64;
  public script_collect_held_max_ns: u64;
  public script_collect_halo_max_ns: u64;
  public script_collect_over_100us: u64;
  public script_plain_held_max_ns: u64;
  public script_plain_halo_max_ns: u64;
}

public fn new_pool() -> pool: EnginePool pure doc "A pool with no engine yet, the engine made when first taken.";
