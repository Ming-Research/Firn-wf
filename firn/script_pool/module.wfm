public struct Cached {
  public sha: Array<u8, 40>;
  public id: halo::embed::ScriptId;
}

public struct PooledEngine {
  public engine: halo::embed::Engine;
  public generation: u64;
  public cache: Box<Slots<Cached>>;
}

public struct Registered {
  public sha: Array<u8, 40>;
  public source: Box<Slots<u8>>;
}

public struct Active {
  public id: u64;
  public decision: DecisionCell;
  public force_stop: DecisionCell;
  public busy: Bool;
}

public struct EnginePool {
  doc "The single shared engine and source registry, with one active record per invocation from first checkout through its last retry. An invocation retains its write-or-kill decision across attempts. current identifies the sole invocation allowed to claim Written; registration, current changes and all-or-nothing KILL share this pool's short atomic statement. busy counts active invocations whose real deadline expired; their cancellable timers publish here without taking dataset metadata. stopping keeps admission closed after forced shutdown even when the final active record is removed.";
  public idle: Box<Slots<PooledEngine>>;
  public out: u64;
  public registry: Box<Slots<Registered>>;
  public source_bytes: u64;
  public generation: u64;
  public running: u64;
  public active: Box<Slots<Active>>;
  public current: Option<u64>;
  public next_id: u64;
  public busy: u64;
  public stopping: Bool;
}

public fn new_pool() -> pool: EnginePool pure doc "A pool with no engine yet, the engine made when first taken.";
