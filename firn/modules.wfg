package halo = "../deps/halo-wf/lib/halo";

pkg::script_pool: [halo::embed];
pkg::bytes: [std::collections::hash_map];
pkg::protocol: [pkg::bytes];
pkg::scores: [pkg::bytes, pkg::protocol];
pkg::extended: [pkg::bytes];
pkg::store: [pkg::script_pool, pkg::bytes, pkg::protocol, std::collections::hash_map, std::collections::priority_queue, std::collections::ordered_map, std::collections::deque];
pkg::scripting: [pkg::scores, pkg::script_pool, pkg::store, pkg::bytes, pkg::protocol, halo::compile, halo::embed, halo::value, halo::heap, halo::vm, halo::number, std::time];
pkg::commands: [pkg::scripting, pkg::bytes, pkg::protocol, pkg::scores, pkg::extended, pkg::store, std::collections::hash_map, std::collections::priority_queue, std::collections::ordered_map, std::collections::deque, std::time];
pkg::persistence: [pkg::scores, std::collections::hash_map, pkg::bytes, pkg::protocol, pkg::store, pkg::commands, std::io, std::fs, std::time];
pkg::server: [pkg::bytes, pkg::protocol, pkg::script_pool, pkg::store, pkg::commands, pkg::persistence, std::time, std::io, std::fs, std::net, std::text, std::process, std::collections::hash_map, std::collections::priority_queue];

entry firn = pkg::server::main;
