alias Client = pkg::protocol::Client;

public struct Score {
  doc "A score read from a request: valid is False for text Redis 7.2.16 refuses as a score, whose value is then zero.";
  public value: f64;
  public valid: Bool;
}

public fn read_score(input: &[u8], start: u64, length: u64) -> score: Score reads(input) doc "Reads bytes of the input as a sorted-set score as Redis 7.2.16 reads one, with C's strtod and nothing after it: an optional sign, then a decimal number with an optional exponent, a C99 hexadecimal one with an optional binary exponent, or inf or infinity in either case, rounded to the nearest double with ties to even. Leading spaces, trailing bytes, NaN, a number that overflows to infinity and a nonzero number that rounds to zero are refused.";

public fn read_bound(input: &[u8], start: u64, length: u64) -> score: Score reads(input) doc "Reads bytes of the input as Redis 7.2.16 reads one end of a score range, with C's strtod over the argument as a C string, up to its first zero byte, accepting only a read that reaches that end: white space before the number, a number past the range of a double, read as infinity, and one that rounds to zero are accepted, and so is an empty string, read as 0; NaN and text of white space alone are refused.";

public fn kept_score(score: f64) -> kept: f64 pure doc "The score a sorted set keeps for one read: negative zero becomes zero, as Redis keeps it in a sorted set it encodes as a listpack, one of at most 128 members of at most 64 bytes, which stores a score equal to an integer as that integer.";

public fn append_argument_text(out: &Box<Slots<u8>>, x: f64) -> r: unit writes(out) doc "Appends Redis 7.2.16 luaArgsToRedisArgv text: ll2string when double2ll accepts an integral value of magnitude at most 2^62, otherwise plain fpconv_dtoa. Negative zero becomes 0; other values follow fpconv, including a NaN's sign.";

public fn append_double_text(out: &Box<Slots<u8>>, x: f64) -> r: unit writes(out) doc "Appends Redis 7.2.16 d2string text: nan for every NaN, inf or -inf for an infinity, 0 or -0 for a zero by its sign, ll2string when double2ll accepts an integral value of magnitude at most 2^62, otherwise fpconv_dtoa.";

public fn fpconv_text(out: &Box<Slots<u8>>, x: f64) -> r: unit writes(out) doc "Appends Redis 7.2.16 fpconv_dtoa text through Halo-wf's port: a set sign bit first, a NaN's included, then 0, inf, nan or Grisu2's digits, with no integer shortcut or d2string special cases.";

public fn reply_score(client: &Client, score: f64) -> result: unit writes(client) doc "Writes a score as Redis 7.2.16's addReplyDouble writes one, using d2string: nan for every NaN, inf or -inf for an infinity, 0 or -0 for a zero by its sign, an integer when double2ll accepts it (integral with magnitude at most 2^62), and otherwise fpconv_dtoa's Grisu2 text. The text is a bulk string under RESP2 and a double, comma then text and CR LF, under RESP3.";

public fn score_bytes(score: f64) -> text: pkg::bytes::Bytes pure doc "Writes Redis 7.2.16's rioWriteBulkDouble text without RESP framing for a stored score in a rewritten append-only file: plain fpconv_dtoa, with no integer shortcut or d2string special cases, so fpconv writes a set sign bit first, then 0, inf, nan or Grisu2's digits.";

public fn score_bytes_17g(score: f64) -> text: pkg::bytes::Bytes pure doc "Redis 7.2.16's ld2string(LD_STR_AUTO) text of a score widened to long double, which ZSCAN writes for a sorted set Redis keeps as a skiplist.";
