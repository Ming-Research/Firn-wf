alias HostOutcome = halo::vm::HostOutcome;
alias num_of = halo::value::num_of;
alias Value = halo::value::Value;
alias Vm = halo::vm::Vm;
alias Engine = halo::embed::Engine;
alias Span = pkg::protocol::Span;

fn install_host(engine: &Engine) -> r: unit writes(engine) {
  doc "Installs the redis table Redis 7.2.16's scriptingInit and luaRegisterRedisAPI (script_lua.c) give scripts, the functions firn implements, the log levels, the replication flags and the version Redis reports, then protects the environment (see protect).";
  let vm = &engine^.vm;
  let redis = halo::heap::new_table(heap: &vm^.heap, asize: 0_u32, hsize: 32_u32);
  let k_4096 = literal(vm: vm, text: &env_text_0[0_u64..4_u64]);
  let v_4096 = Value::Builtin(id: 4096_u32);
  raw(vm: vm, table: redis, key: k_4096, value: v_4096);
  let k_4097 = literal(vm: vm, text: &env_text_1[0_u64..5_u64]);
  let v_4097 = Value::Builtin(id: 4097_u32);
  raw(vm: vm, table: redis, key: k_4097, value: v_4097);
  let k_4098 = literal(vm: vm, text: &env_text_2[0_u64..12_u64]);
  let v_4098 = Value::Builtin(id: 4098_u32);
  raw(vm: vm, table: redis, key: k_4098, value: v_4098);
  let k_4099 = literal(vm: vm, text: &env_text_3[0_u64..11_u64]);
  let v_4099 = Value::Builtin(id: 4099_u32);
  raw(vm: vm, table: redis, key: k_4099, value: v_4099);
  let k_4100 = literal(vm: vm, text: &env_text_4[0_u64..3_u64]);
  let v_4100 = Value::Builtin(id: 4100_u32);
  raw(vm: vm, table: redis, key: k_4100, value: v_4100);
  let k_4102 = literal(vm: vm, text: &env_text_5[0_u64..7_u64]);
  let v_4102 = Value::Builtin(id: 4102_u32);
  raw(vm: vm, table: redis, key: k_4102, value: v_4102);
  let k_4103 = literal(vm: vm, text: &env_text_6[0_u64..7_u64]);
  let v_4103 = Value::Builtin(id: 4103_u32);
  raw(vm: vm, table: redis, key: k_4103, value: v_4103);
  let k_4104 = literal(vm: vm, text: &env_set_repl[0_u64..8_u64]);
  let v_4104 = Value::Builtin(id: 4104_u32);
  raw(vm: vm, table: redis, key: k_4104, value: v_4104);
  let level_0 = literal(vm: vm, text: &env_text_7[0_u64..9_u64]);
  let number_0 = num(x: 0.0_f64);
  raw(vm: vm, table: redis, key: level_0, value: number_0);
  let level_1 = literal(vm: vm, text: &env_text_8[0_u64..11_u64]);
  let number_1 = num(x: 1.0_f64);
  raw(vm: vm, table: redis, key: level_1, value: number_1);
  let level_2 = literal(vm: vm, text: &env_text_9[0_u64..10_u64]);
  let number_2 = num(x: 2.0_f64);
  raw(vm: vm, table: redis, key: level_2, value: number_2);
  let level_3 = literal(vm: vm, text: &env_text_10[0_u64..11_u64]);
  let number_3 = num(x: 3.0_f64);
  raw(vm: vm, table: redis, key: level_3, value: number_3);
  let repl_none = literal(vm: vm, text: &env_repl_none[0_u64..9_u64]);
  raw(vm: vm, table: redis, key: repl_none, value: number_0);
  let repl_aof = literal(vm: vm, text: &env_repl_aof[0_u64..8_u64]);
  raw(vm: vm, table: redis, key: repl_aof, value: number_1);
  let repl_slave = literal(vm: vm, text: &env_repl_slave[0_u64..10_u64]);
  raw(vm: vm, table: redis, key: repl_slave, value: number_2);
  let repl_replica = literal(vm: vm, text: &env_repl_replica[0_u64..12_u64]);
  raw(vm: vm, table: redis, key: repl_replica, value: number_2);
  let repl_all = literal(vm: vm, text: &env_repl_all[0_u64..8_u64]);
  raw(vm: vm, table: redis, key: repl_all, value: number_3);
  let version_key = literal(vm: vm, text: &env_version_name[0_u64..13_u64]);
  let version = literal(vm: vm, text: &env_version_text[0_u64..6_u64]);
  raw(vm: vm, table: redis, key: version_key, value: version);
  let version_num_key = literal(vm: vm, text: &env_version_num_name[0_u64..17_u64]);
  let version_num = num(x: 459280.0_f64);
  raw(vm: vm, table: redis, key: version_num_key, value: version_num);
  let result = halo::embed::set_global(engine: engine, name: &env_text_11[0_u64..5_u64], value: redis);
  protect(engine: engine);
  return unit;
}

fn push_value(out: &Box<Slots<Value>>, value: Value) -> r: unit writes(out) {
  let cap = out^.inner.cap;
  if out^.inner.len == cap {
    let twice = cap +sat cap;
    let target = imax(twice, 16_u64);
    if target > cap {
      grow(cell: out, capacity: target);
    }
  }
  if out^.inner.len < out^.inner.cap {
    place_back(window: &out^.inner, value: value);
  }
  return unit;
}

fn protect_reachable(engine: &Engine, root: Value, seen: Value) -> r: unit writes(engine) {
  doc "Follows Halo-wf's halo-e2e test host (MIT, Bai Ming; Copyright (c) 2026 Bai Ming, see ../../LICENSE). Marks root and every table reachable from it through table values and metatables read-only, through Halo's embedding interface, as Redis 7.2.16's luaSetTableProtectionRecursively (script_lua.c) does. Each table is expanded once, after it is recorded in seen, a host table whose keys are the tables already marked, which ends cycles such as _G._G and is shared between walks. Keys are not followed, as Redis follows only values. set_read_only and table_set refuse only a table that is not live, which a table just reached through table_next is, so their results are not inspected.";
  let pending = box_slots_new::<Value>(capacity: 16_u64);
  push_value(out: &pending, value: root);
  let yes = Value::True();
  loop {
    if pending.inner.len == 0_u64 {
      break;
    }
    let t = take_back(window: &pending.inner);
    let marked = halo::embed::table_get(engine: engine, table: seen, key: t);
    if halo::embed::truthy(value: marked) {
      continue;
    }
    let recorded = halo::embed::table_set(engine: engine, table: seen, key: t, value: yes);
    let marked_read_only = halo::embed::set_read_only(engine: engine, table: t);
    let key = Value::Nil();
    loop {
      match halo::embed::table_next(engine: engine, table: t, key: key) {
        Err(..) => {
          break;
        }
        Ok(value: next) => {
          match next {
            None() => {
              break;
            }
            Some(value: pair) => {
              set key = pair.key;
              let tag = halo::embed::kind(value: pair.val);
              if tag == 4_u8 {
                push_value(out: &pending, value: pair.val);
              }
            }
          }
        }
      }
    }
    let meta = halo::embed::metatable_of(engine: engine, value: t);
    let meta_tag = halo::embed::kind(value: meta);
    if meta_tag == 4_u8 {
      push_value(out: &pending, value: meta);
    }
  }
  return unit;
}

fn protect(engine: &Engine) -> r: unit writes(engine) {
  doc "Protects the script environment as Redis 7.2.16's scriptingInit does (CVE-2025-46818 included), through Halo's embedding interface: the globals get a metatable whose __index raises Redis's error for an undeclared name, then the globals and every table reachable from them, metatables included, become read-only, then so do the metatables of the basic types, of which only strings have one, and the tables reachable from them. Runs once, when the engine is made and before any script has set KEYS or ARGV, which prepare installs afresh for each call through set_global, so they stay writable as in Redis.";
  let rejecting = halo::embed::new_table(engine: engine, asize: 0_u32, hsize: 1_u32);
  let index = halo::embed::intern(engine: engine, bytes: &env_text_12[0_u64..7_u64]);
  let callback = Value::Builtin(id: 4101_u32);
  let indexed = halo::embed::table_set(engine: engine, table: rejecting, key: index, value: callback);
  let globals = Value::Tab(h: engine^.vm.globals);
  let installed = halo::embed::set_metatable(engine: engine, table: globals, meta: rejecting);
  let seen = halo::embed::new_table(engine: engine, asize: 0_u32, hsize: 0_u32);
  protect_reachable(engine: engine, root: globals, seen: seen);
  let nil = Value::Nil();
  let samples = array_filled::<Value, 5>(value: nil);
  set samples[1_u64] = Value::False();
  set samples[2_u64] = num(x: 0.0_f64);
  set samples[3_u64] = index;
  set samples[4_u64] = callback;
  for (i in 0_u64..5_u64) {
    let sample = samples[i];
    let meta = halo::embed::metatable_of(engine: engine, value: sample);
    let tag = halo::embed::kind(value: meta);
    if tag == 4_u8 {
      protect_reachable(engine: engine, root: meta, seen: seen);
    }
  }
  return unit;
}

fn prepare(engine: &Engine, input: &[u8], args: &Box<Slots<Span>>, keys: u64) -> r: unit reads(input), reads(args), writes(engine) {
  let kt = halo::embed::new_table(engine: engine, asize: 0_u32, hsize: 0_u32);
  let at = halo::embed::new_table(engine: engine, asize: 0_u32, hsize: 0_u32);
  let keys_global = halo::embed::set_global(engine: engine, name: &env_text_13[0_u64..4_u64], value: kt);
  let argv_global = halo::embed::set_global(engine: engine, name: &env_text_14[0_u64..4_u64], value: at);
  let count = args^.inner.len;
  let first_arg = keys +sat 3_u64;
  for (i in 3_u64..count) {
    let span = pkg::protocol::arg(args: args, index: i);
    let bytes = copy_source(input: input, span: span);
    let n = bytes.inner.len;
    let v = halo::embed::intern(engine: engine, bytes: &bytes.inner[0_u64..n]);
    let table = at;
    let offset = i -sat first_arg;
    let index = offset +sat 1_u64;
    if i < first_arg {
      set table = kt;
      set index = i - 2_u64;
    }
    let x = cvt.nearest::<u64, f64>(index);
    let key = num(x: x);
    let result = halo::embed::table_set(engine: engine, table: table, key: key, value: v);
  }
  return unit;
}

fn raise(vm: &Vm, text: &[u8]) -> r: HostOutcome reads(text), writes(vm) {
  let message = literal(vm: vm, text: text);
  let error = reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: message);
  set vm^.error = error;
  return HostOutcome::Raised();
}

fn numeric(vm: &Vm, v: Value) -> r: Bool reads(vm) {
  match num_of(v: v) {
    Is(..) => {
      return True();
    }
    Not() => {
    }
  }
  match halo::heap::string_of(heap: &vm^.heap, value: v) {
    Some(value: view) => {
      let h = cvt::<u32, u64>(view.handle);
      if h < vm^.heap.strings.inner.len {
        let n = vm^.heap.strings.inner[h].payload.bytes.inner.len;
        match halo::number::str2number(bytes: &vm^.heap.strings.inner[h].payload.bytes.inner[0_u64..n]) {
          Some(..) => {
            return True();
          }
          None() => {
          }
        }
      }
    }
    None() => {
    }
  }
  return False();
}

fn error_reply_value(vm: &Vm, v: Value) -> r: Value writes(vm) {
  doc "Redis's error_reply first supplies a leading minus to luaPushErrorBuff. Split the explicit code at the first space, default to ERR when there is none, and trim both ends of the message's CR/LF range.";
  let bytes = box_slots_new::<u8>(capacity: 0_u64);
  value_bytes(vm: vm, v: v, out: &bytes);
  let start = 0_u64;
  if bytes.inner.len > 0_u64 {
    if bytes.inner[0_u64] == 45_u8 {
      set start = 1_u64;
    }
  }
  let end = bytes.inner.len;
  for (i in start..bytes.inner.len) {
    if bytes.inner[i] == 0_u8 {
      set end = i;
      break;
    }
  }
  let code_end = end;
  for (i in start..end) {
    if i < bytes.inner.len {
      if bytes.inner[i] == 32_u8 {
        set code_end = i;
        break;
      }
    }
  }
  let has_code = code_end < end;
  let first = start;
  if has_code {
    set first = code_end + 1_u64;
  }
  loop {
    if first >= end {
      break;
    }
    if first < bytes.inner.len {
      let b = bytes.inner[first];
      let cr = b == 13_u8;
      let lf = b == 10_u8;
      let newline = bor(cr, lf);
      if newline {
        set first = first + 1_u64;
      } else {
        break;
      }
    } else {
      break;
    }
  }
  loop {
    if end <= first {
      break;
    }
    let last = end - 1_u64;
    if last < bytes.inner.len {
      let b = bytes.inner[last];
      let cr = b == 13_u8;
      let lf = b == 10_u8;
      let newline = bor(cr, lf);
      if newline {
        set end = last;
      } else {
        break;
      }
    } else {
      break;
    }
  }
  let out = box_slots_new::<u8>(capacity: 0_u64);
  if has_code {
    if start <= code_end {
      if code_end <= bytes.inner.len {
        text_bytes(out: &out, bytes: &bytes.inner[start..code_end]);
      }
    }
    push(out: &out, byte: 32_u8);
  } else {
    text_bytes(out: &out, bytes: &env_text_15[0_u64..4_u64]);
  }
  if first <= end {
    if end <= bytes.inner.len {
      text_bytes(out: &out, bytes: &bytes.inner[first..end]);
    }
  }
  let n = out.inner.len;
  let message = literal(vm: vm, text: &out.inner[0_u64..n]);
  return reply_table(vm: vm, field: &env_text_16[0_u64..3_u64], v: message);
}

const env_text_0: Array<u8, 4> = "call";

const env_text_1: Array<u8, 5> = "pcall";

const env_text_2: Array<u8, 12> = "status_reply";

const env_text_3: Array<u8, 11> = "error_reply";

const env_text_4: Array<u8, 3> = "log";

const env_text_5: Array<u8, 7> = "sha1hex";

const env_text_6: Array<u8, 7> = "setresp";

const env_text_7: Array<u8, 9> = "LOG_DEBUG";

const env_text_8: Array<u8, 11> = "LOG_VERBOSE";

const env_text_9: Array<u8, 10> = "LOG_NOTICE";

const env_text_10: Array<u8, 11> = "LOG_WARNING";

const env_text_11: Array<u8, 5> = "redis";

const env_text_12: Array<u8, 7> = "__index";

const env_text_13: Array<u8, 4> = "KEYS";

const env_text_14: Array<u8, 4> = "ARGV";

const env_text_15: Array<u8, 4> = "ERR ";

const env_text_16: Array<u8, 3> = "err";

const env_set_repl: Array<u8, 8> = "set_repl";

const env_repl_none: Array<u8, 9> = "REPL_NONE";

const env_repl_aof: Array<u8, 8> = "REPL_AOF";

const env_repl_slave: Array<u8, 10> = "REPL_SLAVE";

const env_repl_replica: Array<u8, 12> = "REPL_REPLICA";

const env_repl_all: Array<u8, 8> = "REPL_ALL";

const env_version_name: Array<u8, 13> = "REDIS_VERSION";

const env_version_text: Array<u8, 6> = "7.2.16";

const env_version_num_name: Array<u8, 17> = "REDIS_VERSION_NUM";

fn config_snapshot(vm: &Vm) -> saved: Box<Slots<Array<u64, 9>>> reads(vm) {
  doc "Cjson setters are engine-visible effects even before a keyspace write. Snapshot settings so an abandoned attempt leaves the engine's Lua environment as it found it.";
  let n = vm^.cjson_configs.inner.len;
  let saved = box_slots_new::<Array<u64, 9>>(capacity: n);
  for (i in 0_u64..n) {
    let settings = vm^.cjson_configs.inner[i].settings;
    if saved.inner.len < saved.inner.cap {
      place_back(window: &saved.inner, value: settings);
    }
  }
  return move saved;
}

fn config_restore(vm: &Vm, saved: &Box<Slots<Array<u64, 9>>>, active: u64) -> r: unit reads(saved), writes(vm) {
  loop {
    if vm^.cjson_configs.inner.len <= saved^.inner.len {
      break;
    }
    let dropped = take_back(window: &vm^.cjson_configs.inner);
  }
  for (i in 0_u64..saved^.inner.len) {
    if i < vm^.cjson_configs.inner.len {
      set vm^.cjson_configs.inner[i].settings = saved^.inner[i];
    }
  }
  set vm^.cjson_active_config = active;
  return unit;
}
