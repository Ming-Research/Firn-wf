public struct ScriptMemory {
  doc "Redis 7.0.15 scriptVerifyWriteCommandAllow/scriptVerifyOOM/scriptCall state: OOM captured before EVAL, and whether an accepted WRITE-flagged command ran in this attempt, even when it changed no value. write_dirty also suppresses later active-AOF health checks after the first accepted write (script.c:349-386,547-557); separate from the effects flag used for retry safety.";
  public pre_command_oom: Bool;
  public write_dirty: Bool;
}

public enum ScriptCommandResult {
  doc "A completed Redis command or an uncatchable request to abandon the declared-entry attempt and retry the entire invocation with all sixteen database maps held.";
  Completed(public appended: u64);
  NeedWholeMap();
}

public interface ScriptCommands {
  doc "The commands a script's redis.call and redis.pcall run, inside the script's statement over declared entries or all sixteen database maps, together with metadata: the commands module binds script_command, which runs a command by its parts, writing its reply into the client's and returning how many records it appended to effects. call_entries reads the held Meta only for the active AOF status a script's first WRITE command checks. journal belongs to the current attempt environment and records each key's first live refresh for rollback; client carries the connection's per-read settings, refreshed after its own CONFIG SET before entering a script.";
  fn call(sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, database: &u64, db0: &ConcurrentHashMap<pkg::store::Entry>, db1: &ConcurrentHashMap<pkg::store::Entry>, db2: &ConcurrentHashMap<pkg::store::Entry>, db3: &ConcurrentHashMap<pkg::store::Entry>, db4: &ConcurrentHashMap<pkg::store::Entry>, db5: &ConcurrentHashMap<pkg::store::Entry>, db6: &ConcurrentHashMap<pkg::store::Entry>, db7: &ConcurrentHashMap<pkg::store::Entry>, db8: &ConcurrentHashMap<pkg::store::Entry>, db9: &ConcurrentHashMap<pkg::store::Entry>, db10: &ConcurrentHashMap<pkg::store::Entry>, db11: &ConcurrentHashMap<pkg::store::Entry>, db12: &ConcurrentHashMap<pkg::store::Entry>, db13: &ConcurrentHashMap<pkg::store::Entry>, db14: &ConcurrentHashMap<pkg::store::Entry>, db15: &ConcurrentHashMap<pkg::store::Entry>, meta: &pkg::store::Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(database), writes(db0), writes(db1), writes(db2), writes(db3), writes(db4), writes(db5), writes(db6), writes(db7), writes(db8), writes(db9), writes(db10), writes(db11), writes(db12), writes(db13), writes(db14), writes(db15), writes(meta), writes(effects), writes(client);
  fn call_entries(sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, slots: &Entries<pkg::store::Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, due: &pkg::store::ExpiryQueue, meta: &pkg::store::Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> result: ScriptCommandResult reads(declared), reads(meta.aof_append_error), reads(meta.aof_append_partial), reads(meta.aof_sync_error), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(slots), writes(undo), writes(due), writes(effects), writes(client) contract {
    requires slots^.len == declared^.len;
    ensures slots^.len == entry(slots)^.len;
  };
}

public fn eval<interface ScriptCommands>(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, keys_env: &pkg::bytes::KeyEnv, time: &pkg::store::Time, clock: &std::time::Clock, by_sha: Bool) -> r: unit reads(store), reads(input), reads(args), reads(keys_env), reads(time), writes(client), writes(clock) waits doc "EVAL script numkeys [key ...] [arg ...] or EVALSHA sha1 numkeys [key ...] [arg ...]: compiles or finds the script, takes the pool's one engine, waiting while another script has it, runs the script in attempts, initially holding the immutable declared entry set and metadata, abandoning an out-of-declaration attempt and retrying under all sixteen permanent database maps and metadata, writes its result to the client in the client's protocol, and returns the engine after each attempt, the pool's short statements outside the script's.";

public fn script(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client) -> r: unit reads(store), reads(input), reads(args), writes(client) waits doc "SCRIPT LOAD, EXISTS and FLUSH, checked and answered as Redis 7.0.15 does.";
