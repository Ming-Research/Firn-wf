public struct ScriptMemory {
  doc "Redis 7.0.15 scriptVerifyWriteCommandAllow/scriptVerifyOOM/scriptCall state: OOM captured before EVAL, and whether an accepted WRITE-flagged command ran in this attempt, even when it changed no value. write_dirty also suppresses later active-AOF health checks after the first accepted write (script.c:349-386,547-557); separate from the effects flag used for retry safety.";
  public pre_command_oom: Bool;
  public write_dirty: Bool;
}

public enum ScriptCommandResult {
  doc "A completed Redis command or an uncatchable request to abandon the declared-entry attempt and retry the entire invocation with the whole keyspace and event hub.";
  Completed(public appended: u64);
  NeedWholeMap();
}

public interface ScriptCommands {
  doc "The commands a script's redis.call and redis.pcall run, inside the script's statement over declared entries or the whole keyspace, together with metadata; whole-keyspace attempts also hold the event hub and keep publications in a private stage until acceptance: the commands module binds script_command, which runs a command by its parts, writing its reply into the client's and returning how many records it appended to effects. ready guards whole-map attempts that may service blocked lists; serve drains list readiness only after an accepted attempt commits its effects and Lua reply. call_entries reads the held Meta only for the active AOF status a script's first WRITE command checks. journal belongs to the current attempt environment and records each key's first live refresh for rollback; client carries the connection's per-read settings, refreshed after its own CONFIG SET before entering a script.";
  fn call(hub: &pkg::connection_events::Hub, stage: &pkg::connection_events::Stage, sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<pkg::store::Entry>, meta: &pkg::store::Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(hub), writes(stage), writes(sequence), writes(memory), writes(journal), writes(keys), writes(meta), writes(effects), writes(client);
  fn call_entries(sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, slots: &Entries<pkg::store::Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, due: &pkg::store::ExpiryQueue, meta: &pkg::store::Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> result: ScriptCommandResult reads(declared), reads(meta.aof_append_error), reads(meta.aof_append_partial), reads(meta.aof_sync_error), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(slots), writes(undo), writes(due), writes(effects), writes(client) contract {
    requires slots^.len == declared^.len;
    ensures slots^.len == entry(slots)^.len;
  };
  fn ready(meta: &pkg::store::Meta, hub: &pkg::connection_events::Hub, server: &pkg::store::ServerState) -> ready: Bool reads(meta.aof_rewrite_in_progress), reads(hub.blocking_state), reads(server.memory.maxmemory);
  fn serve(map_shared: &Shared<ConcurrentHashMap<pkg::store::Entry>>, keys: &ConcurrentHashMap<pkg::store::Entry>, meta: &pkg::store::Meta, hub: &pkg::connection_events::Hub, server: &pkg::store::ServerState, client: &pkg::protocol::Client, clock: &std::time::Clock, wall: &std::time::WallClock, logged: Bool) -> result: unit reads(map_shared), reads(server), reads(wall), writes(keys), writes(meta), writes(hub), writes(client), writes(clock);
}

public fn eval<interface ScriptCommands, const start_whole: u64>(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, keys_env: &pkg::bytes::KeyEnv, time: &pkg::store::Time, clock: &std::time::Clock, by_sha: Bool) -> r: unit reads(store), reads(input), reads(args), reads(keys_env), reads(time), writes(client), writes(clock) waits doc "EVAL script numkeys [key ...] [arg ...] or EVALSHA sha1 numkeys [key ...] [arg ...]: compiles or finds the script, takes the pool's one engine, waiting while another script has it, and runs the script in attempts. Compile-time start_whole 0 preserves the unpromoted declared-entry path: initially hold the immutable declared entry set and metadata, then abandon an out-of-declaration or event-hub command before its effects and retry under the whole keyspace, metadata and event hub. Compile-time start_whole 1 starts promoted connections with that whole hold on every attempt, committing the accepted Lua result or error and staged publications before releasing the keyspace. Lua KEYS is unchanged; abandoned budget attempts commit nothing. Pre-attempt validation and compilation errors remain buffered for the caller to commit. The result uses the client's protocol, and the engine returns after each attempt, with the pool's short statements outside the script's.";

public fn script(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client) -> r: unit reads(store), reads(input), reads(args), writes(client) waits doc "SCRIPT LOAD, EXISTS and FLUSH, checked and answered as Redis 7.0.15 does.";
