public struct ScriptMemory {
  doc "Redis 7.0.15 scriptVerifyOOM/scriptCall state: OOM captured before EVAL, and whether an accepted WRITE-flagged command ran in this attempt, even when it changed no value. Separate from the effects flag used for retry safety.";
  public pre_command_oom: Bool;
  public write_dirty: Bool;
}

public enum ScriptCommandResult {
  doc "A completed Redis command or an uncatchable request to abandon the declared-entry attempt and retry the entire invocation with the whole keyspace.";
  Completed(public appended: u64);
  NeedWholeMap();
}

public interface ScriptCommands {
  doc "The commands a script's redis.call and redis.pcall run, inside the script's statement over declared entries or the whole keyspace, together with metadata: the commands module binds script_command, which runs a command by its parts, writing its reply into the client's and returning how many records it appended to effects. journal belongs to the current attempt environment and records each key's first live refresh for rollback; client carries the connection's per-read settings, refreshed after its own CONFIG SET before entering a script.";
  fn call(sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<pkg::store::Entry>, meta: &pkg::store::Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(keys), writes(meta), writes(effects), writes(client);
  fn call_entries(sequence: &pkg::store::WriteSequence, memory: &ScriptMemory, journal: &Option<pkg::store::AccessJournal>, slots: &Entries<pkg::store::Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, env: &pkg::bytes::KeyEnv, time: &pkg::store::Time) -> result: ScriptCommandResult reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(slots), writes(undo), writes(due), writes(effects), writes(client) contract {
    requires slots^.len == declared^.len;
    ensures slots^.len == entry(slots)^.len;
  };
}

public fn eval<interface ScriptCommands>(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client, keys_env: &pkg::bytes::KeyEnv, time: &pkg::store::Time, clock: &std::time::Clock, by_sha: Bool) -> r: unit reads(store), reads(input), reads(args), reads(keys_env), reads(time), writes(client), writes(clock) waits doc "EVAL script numkeys [key ...] [arg ...] or EVALSHA sha1 numkeys [key ...] [arg ...]: compiles or finds the script, takes any idle engine of the pool, waiting while every engine is taken, runs the script in attempts, initially holding the immutable declared entry set, metadata and the Lua state the engines share, abandoning an out-of-declaration attempt and retrying under a whole-keyspace and metadata hold, writes its result to the client in the client's protocol, and returns the engine after each attempt, the pool's short statements outside the script's.";

public fn script(store: &pkg::store::Keyspace, input: &[u8], args: &Box<Slots<pkg::protocol::Span>>, client: &pkg::protocol::Client) -> r: unit reads(store), reads(input), reads(args), writes(client) waits doc "SCRIPT LOAD, EXISTS and FLUSH, checked and answered as Redis 7.0.15 does.";
