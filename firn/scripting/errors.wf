alias Engine = halo::embed::Engine;
alias Value = halo::value::Value;

const redis_err: Array<u8, 4> = "ERR ";

const redis_field: Array<u8, 3> = "err";

const redis_script: Array<u8, 9> = " script: ";

const redis_on: Array<u8, 5> = ", on ";

const redis_location: Array<u8, 13> = "@user_script:";

const redis_nil: Array<u8, 3> = "nil";

const redis_true: Array<u8, 4> = "true";

const redis_false: Array<u8, 5> = "false";

const redis_nonstring: Array<u8, 30> = "(error object is not a string)";

fn redis_value_text(engine: &Engine, value: Value, out: &Box<Slots<u8>>) -> r: unit reads(engine), writes(out) {
  doc "Follows Halo-wf's halo-e2e test host (MIT, Bai Ming; Copyright (c) 2026 Bai Ming, see ../../LICENSE), which follows Redis 7.0.15's eval.c and script_lua.c. The text Redis's reply takes from an error value: a string up to its first NUL, a number in Lua's format, or the name of another kind.";
  match halo::embed::string_of(engine: engine, value: value) {
    Some(value: view) => {
      let h = cvt::<u32, u64>(view.handle);
      if h < engine^.vm.heap.strings.inner.len {
        let n = engine^.vm.heap.strings.inner[h].payload.bytes.inner.len;
        for (i in 0_u64..n) {
          let b = engine^.vm.heap.strings.inner[h].payload.bytes.inner[i];
          if b == 0_u8 {
            break;
          }
          push(out: out, byte: b);
        }
      }
      return unit;
    }
    None() => {
    }
  }
  match halo::embed::number_of(value: value) {
    Is(x: n) => {
      let buffer = array_filled::<u8, 32>(value: 0_u8);
      let count = halo::number::format_number(value: n, out: &buffer[0_u64..32_u64]);
      text_bytes(out: out, bytes: &buffer[0_u64..count]);
    }
    Not() => {
      let tag = halo::embed::kind(value: value);
      if tag == 0_u8 {
        text_bytes(out: out, bytes: &redis_nil[0_u64..3_u64]);
      } else if tag == 1_u8 {
        if halo::embed::truthy(value: value) {
          text_bytes(out: out, bytes: &redis_true[0_u64..4_u64]);
        } else {
          text_bytes(out: out, bytes: &redis_false[0_u64..5_u64]);
        }
      } else {
        text_bytes(out: out, bytes: &redis_nonstring[0_u64..30_u64]);
      }
    }
  }
  return unit;
}

fn redis_error_field(engine: &Engine, table: Value) -> r: Value reads(engine) {
  doc "Follows Halo-wf's halo-e2e test host (MIT, Bai Ming; Copyright (c) 2026 Bai Ming, see ../../LICENSE), which follows Redis 7.0.15's eval.c and script_lua.c. The err field of a Redis error table, or nil.";
  let key = Value::Nil();
  loop {
    match halo::embed::table_next(engine: engine, table: table, key: key) {
      Err(..) => {
        return Value::Nil();
      }
      Ok(value: next) => {
        match next {
          None() => {
            return Value::Nil();
          }
          Some(value: pair) => {
            set key = pair.key;
            let same = False();
            match halo::embed::string_of(engine: engine, value: key) {
              None() => {
              }
              Some(value: view) => {
                let h = cvt::<u32, u64>(view.handle);
                if h < engine^.vm.heap.strings.inner.len {
                  if engine^.vm.heap.strings.inner[h].payload.bytes.inner.len == 3_u64 {
                    set same = True();
                    for (i in 0_u64..3_u64) {
                      let b = engine^.vm.heap.strings.inner[h].payload.bytes.inner[i];
                      if b != redis_field[i] {
                        set same = False();
                      }
                    }
                  }
                }
              }
            }
            if same {
              return pair.val;
            }
          }
        }
      }
    }
  }
  return Value::Nil();
}

fn format_redis_error(engine: &Engine, source: &[u8], line: u64, locate: Bool) -> r: Box<Slots<u8>> reads(engine), reads(source) {
  doc "Follows Halo-wf's halo-e2e test host (MIT, Bai Ming; Copyright (c) 2026 Bai Ming, see ../../LICENSE), which follows Redis 7.0.15's eval.c and script_lua.c. Redis 7's EVAL error reply, after eval.c's string-to-error-table handler and script_lua.c's final reply: an error table's err field, or ERR and the message; then the script body's SHA-1 and the line. The caller supplies the failing line, or zero if unknown; locate adds Lua's user_script prefix to a VM message not yet located.";
  let out = box_slots_new::<u8>(capacity: 0_u64);
  let error = halo::embed::error_value(engine: engine);
  let tag = halo::embed::kind(value: error);
  if tag == 4_u8 {
    let message = redis_error_field(engine: engine, table: error);
    redis_value_text(engine: engine, value: message, out: &out);
  } else {
    text_bytes(out: &out, bytes: &redis_err[0_u64..4_u64]);
    if locate {
      if line > 0_u64 {
        text_bytes(out: &out, bytes: &redis_location[1_u64..13_u64]);
        decimal(out: &out, n: line);
        push(out: &out, byte: 58_u8);
        push(out: &out, byte: 32_u8);
      }
    }
    redis_value_text(engine: engine, value: error, out: &out);
  }
  if line > 0_u64 {
    let digest = halo::embed::sha1hex(bytes: source);
    text_bytes(out: &out, bytes: &redis_script[0_u64..9_u64]);
    text_bytes(out: &out, bytes: &digest[0_u64..40_u64]);
    text_bytes(out: &out, bytes: &redis_on[0_u64..5_u64]);
    text_bytes(out: &out, bytes: &redis_location[0_u64..13_u64]);
    decimal(out: &out, n: line);
    push(out: &out, byte: 46_u8);
  }
  return move out;
}
