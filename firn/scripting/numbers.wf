alias Value = halo::value::Value;
alias Vm = halo::vm::Vm;
alias Client = pkg::protocol::Client;

fn argument_text(vm: &Vm, x: f64) -> r: Value writes(vm) {
  doc "Follows Halo-wf's halo-e2e test host (MIT, Bai Ming; Copyright (c) 2026 Bai Ming, see ../../LICENSE). A Lua number's text as a command argument (see pkg::scores::append_argument_text), as a string of the engine.";
  let bytes = box_slots_new::<u8>(capacity: 32_u64);
  pkg::scores::append_argument_text(out: &bytes, x: x);
  let length = bytes.inner.len;
  return literal(vm: vm, text: &bytes.inner[0_u64..length]);
}

fn reply_double(client: &Client, x: f64) -> r: unit writes(client) {
  doc "Writes a script's double reply through pkg::scores::reply_score, the shared Redis 7.2.16 addReplyDouble writer: d2string text in a bulk string under RESP2 or a double under RESP3.";
  return pkg::scores::reply_score(client: client, score: x);
}
