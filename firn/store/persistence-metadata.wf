fn aof_rewrite_cut(meta: &Meta, pending: &Box<Slots<u8>>) -> cut: Bool reads(meta.rewrite.scan_done), reads(meta.commit_seq), writes(meta.rewrite.end), writes(meta.rewrite.cut), writes(meta.rewrite.active), writes(meta.rewrite.rotating), writes(meta.log), writes(meta.aof_database), writes(meta.aof_pending_capacity), writes(meta.aof_pending_length), writes(pending) {
  let cut = False();
  let ready = band(meta^.rewrite.active, meta^.rewrite.scan_done);
  let empty = pending^.inner.len == 0_u64;
  let allowed = band(ready, empty);
  if allowed {
    set meta^.rewrite.end = meta^.commit_seq;
    set meta^.rewrite.cut = True();
    set meta^.rewrite.active = False();
    set meta^.rewrite.rotating = True();
    swap(first: pending, second: &meta^.log);
    set meta^.aof_database = 16_u64;
    set meta^.aof_pending_capacity = pending^.inner.cap;
    set meta^.aof_pending_length = pending^.inner.len;
    set cut = True();
  }
  return cut;
}

