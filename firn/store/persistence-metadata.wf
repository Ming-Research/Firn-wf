  set meta^.aof_rewrite_retry_blocked = bnot(accepted);
  set meta^.aof_rewrite_scan_peak = meta^.rewrite.scan_peak;
  set meta^.aof_rewrite_cut = meta^.rewrite.cut;
  set meta^.rewrite.used = 0_u64;
  set meta^.rewrite.running = False();
  set meta^.rewrite.active = False();
  set meta^.rewrite.aborted = False();
  set meta^.rewrite.rotating = False();
