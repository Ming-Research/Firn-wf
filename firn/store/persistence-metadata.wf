fn aof_take_collecting(meta: &Meta, pending: &Box<Slots<u8>>, force: Bool) -> result: unit writes(meta.log), writes(meta.aof_pending_capacity), writes(meta.aof_pending_length), writes(pending) {
  if force {
    if pending^.inner.len == 0_u64 {
      swap(first: &meta^.log, second: pending);
    } else {
      let length = meta^.log.inner.len;
      log_append_plain(log: pending, bytes: &meta^.log.inner[0_u64..length]);
      set meta^.log = box_slots_new::<u8>(capacity: 65536_u64);
    }
  } else if pending^.inner.len == 0_u64 {
    swap(first: &meta^.log, second: pending);
  }
  set meta^.aof_pending_capacity = pending^.inner.cap;
  set meta^.aof_pending_length = pending^.inner.len;
  return unit;
}

