fn aof_rewrite_journal_take(meta: &Meta) -> block: Option<Box<Slots<u8>>> writes(meta.rewrite.journal) {
  match meta^.rewrite.journal {
    Some(value: chunks) => {
      if chunks^.inner.len > 0_u64 {
        let taken = take_front(window: &chunks^.inner);
        return Some<Box<Slots<u8>>>(value: move taken);
      }
    }
    None() => {
    }
  }
  return None<Box<Slots<u8>>>();
}

