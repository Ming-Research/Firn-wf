alias KeyEnv = pkg::bytes::KeyEnv;

fn memory_peak_record(meta: &Meta, used: u64) -> peak: u64 writes(meta.memory_peak) {
  set meta^.memory_peak = imax(meta^.memory_peak, used);
  return meta^.memory_peak;
}

fn eviction_candidate_new(key: Box<Array<u8>>, score: u64, database: u64) -> candidate: EvictionCandidate pure contract {
  requires database < 16_u64;
} {
  return EvictionCandidate(key: move key, score: score, database: database);
}

fn eviction_search_stop(meta: &Meta) -> result: unit writes(meta.eviction_searching) {
  set meta^.eviction_searching = False();
  return unit;
}

fn eviction_search_begin(meta: &Meta, start: u64) -> result: unit writes(meta.eviction_cursor), writes(meta.eviction_start), writes(meta.eviction_searching), writes(meta.eviction_wrapped) {
  set meta^.eviction_start = start;
  set meta^.eviction_cursor = start;
  set meta^.eviction_wrapped = False();
  set meta^.eviction_searching = True();
  return unit;
}

fn eviction_search_advance(meta: &Meta, next: u64) -> exhausted: Bool reads(meta.eviction_start), writes(meta.eviction_cursor), writes(meta.eviction_wrapped) {
  let exhausted = False();
  if meta^.eviction_wrapped {
    let ended = next == 0_u64;
    let reached = next >= meta^.eviction_start;
    set exhausted = bor(ended, reached);
  } else if next == 0_u64 {
    set meta^.eviction_wrapped = True();
    set exhausted = meta^.eviction_start == 0_u64;
  }
  set meta^.eviction_cursor = next;
  return exhausted;
}

fn eviction_policy_prepare(meta: &Meta, policy: u64) -> result: unit writes(meta.due.eligibility_changed), writes(meta.eviction_pool), writes(meta.eviction_policy), writes(meta.eviction_searches), writes(meta.eviction_exhausted) {
  let reset = meta^.eviction_policy != policy;
  if bor(reset, meta^.due.eligibility_changed) {
    let inactive = False();
    set meta^.eviction_searches = array_filled::<Bool, 16>(value: inactive);
    set meta^.eviction_exhausted = array_filled::<Bool, 16>(value: inactive);
    set meta^.due.eligibility_changed = False();
  }
  if reset {
    set meta^.eviction_pool = box_slots_new::<EvictionCandidate>(capacity: 16_u64);
    set meta^.eviction_policy = policy;
  }
  return unit;
}

fn eviction_search_load(meta: &Meta, database: u64) -> result: unit reads(meta.eviction_cursors), reads(meta.eviction_starts), reads(meta.eviction_searches), reads(meta.eviction_wraps), writes(meta.eviction_cursor), writes(meta.eviction_start), writes(meta.eviction_searching), writes(meta.eviction_wrapped) contract {
  requires database < 16_u64;
} {
  set meta^.eviction_cursor = meta^.eviction_cursors[database];
  set meta^.eviction_start = meta^.eviction_starts[database];
  set meta^.eviction_searching = meta^.eviction_searches[database];
  set meta^.eviction_wrapped = meta^.eviction_wraps[database];
  return unit;
}

fn eviction_search_save(meta: &Meta, database: u64, exhausted: Bool) -> result: unit reads(meta.eviction_cursor), reads(meta.eviction_start), reads(meta.eviction_searching), reads(meta.eviction_wrapped), writes(meta.eviction_cursors), writes(meta.eviction_starts), writes(meta.eviction_searches), writes(meta.eviction_wraps), writes(meta.eviction_exhausted) contract {
  requires database < 16_u64;
} {
  set meta^.eviction_cursors[database] = meta^.eviction_cursor;
  set meta^.eviction_starts[database] = meta^.eviction_start;
  set meta^.eviction_searches[database] = meta^.eviction_searching;
  set meta^.eviction_wraps[database] = meta^.eviction_wrapped;
  set meta^.eviction_exhausted[database] = exhausted;
  return unit;
}

fn eviction_rotate(meta: &Meta, database: u64) -> result: unit writes(meta.eviction_database) contract {
  requires database < 16_u64;
} {
  let next = database + 1_u64;
  set meta^.eviction_database = next % 16_u64;
  return unit;
}

fn eviction_record_removal(meta: &Meta, lapsed: Bool) -> result: unit writes(meta.evicted_keys), writes(meta.expired_keys) {
  if lapsed {
    set meta^.expired_keys = meta^.expired_keys +wrap 1_u64;
  } else {
    set meta^.evicted_keys = meta^.evicted_keys +wrap 1_u64;
  }
  return unit;
}

fn eviction_pool_add_meta(meta: &Meta, candidate: EvictionCandidate) -> result: unit writes(meta.eviction_pool) {
  doc "Redis 7.0.15 evictionPoolPopulate's 16 best scores, represented without ordering: a full pool replaces only its least score with a better candidate. Names are owned; ghost names are removed when selected. No reference into the map escapes sampling.";
  if meta^.eviction_pool.inner.len < 16_u64 {
    if meta^.eviction_pool.inner.len < meta^.eviction_pool.inner.cap {
      place_back(window: &meta^.eviction_pool.inner, value: move candidate);
      return unit;
    }
  }
  let worst = 0_u64;
  let least = 18446744073709551615_u64;
  let length = meta^.eviction_pool.inner.len;
  for (index in 0_u64..length) {
    let score = meta^.eviction_pool.inner[index].score;
    if score < least {
      set least = score;
      set worst = index;
    }
  }
  let better = candidate.score > least;
  let placed = worst < meta^.eviction_pool.inner.len;
  if band(better, placed) {
    set meta^.eviction_pool.inner[worst] = move candidate;
  } else {
    let unused = move candidate;
  }
  return unit;
}

fn eviction_pool_take_meta(meta: &Meta) -> key: Option<EvictionCandidate> writes(meta.eviction_pool) {
  let length = meta^.eviction_pool.inner.len;
  if length == 0_u64 {
    return None<EvictionCandidate>();
  }
  let best = 0_u64;
  let highest = 0_u64;
  for (index in 0_u64..length) {
    let score = meta^.eviction_pool.inner[index].score;
    if score >= highest {
      set highest = score;
      set best = index;
    }
  }
  if meta^.eviction_pool.inner.len > 0_u64 {
    let candidate = take_back(window: &meta^.eviction_pool.inner);
    if best < meta^.eviction_pool.inner.len {
      swap(first: &candidate, second: &meta^.eviction_pool.inner[best]);
    }
    return Some<EvictionCandidate>(value: move candidate);
  }
  return None<EvictionCandidate>();
}

fn command_set_meta_due_log<T0, T1, A, fn apply(due: &ExpiryQueue, log: &Box<Slots<u8>>, logged: Bool, plan: &T0, work: &T1, input: &[u8], args: &A, key: &[u8], env: &KeyEnv, budget: &LogBudget) -> appended: u64 reads(plan), reads(work), reads(input), reads(args), reads(key), reads(env), writes(due), writes(log), writes(budget)>(meta: &Meta, logged: Bool, plan: &T0, work: &T1, input: &[u8], args: &A, key: &[u8], env: &KeyEnv, budget: &LogBudget) -> appended: u64 reads(plan), reads(work), reads(input), reads(args), reads(key), reads(env), writes(meta.due), writes(meta.log), writes(budget) {
  return apply(due: &meta^.due, log: &meta^.log, logged: logged, plan: plan, work: work, input: input, args: args, key: key, env: env, budget: budget);
}

