fn aof_rewrite_request(meta: &Meta) -> result: unit writes(meta.aof_rewrite_in_progress), writes(meta.aof_rewrite_requested) {
  set meta^.aof_rewrite_in_progress = True();
  set meta^.aof_rewrite_requested = True();
  return unit;
}

fn aof_rewrite_reply_consumed(meta: &Meta) -> result: unit writes(meta.aof_rewrite_reply) {
  set meta^.aof_rewrite_reply = 0_u64;
  return unit;
}

fn aof_rewrite_percentage_set(meta: &Meta, value: u64) -> result: unit writes(meta.aof_rewrite_percentage) {
  set meta^.aof_rewrite_percentage = value;
  return unit;
}

fn aof_rewrite_minimum_set(meta: &Meta, value: u64) -> result: unit writes(meta.aof_rewrite_min_size) {
  set meta^.aof_rewrite_min_size = value;
  return unit;
}

fn aof_rewrite_delay_set(meta: &Meta, value: i64) -> result: unit writes(meta.aof_rewrite_key_delay) {
  set meta^.aof_rewrite_key_delay = value;
  return unit;
}
