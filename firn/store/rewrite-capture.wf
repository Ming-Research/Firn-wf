alias Bytes = pkg::bytes::Bytes;

fn rewrite_capture_new() -> capture: RewriteCapture pure {
  let no = False();
  let journal = None<Box<Ring<Box<Slots<u8>>>>>();
  let no_reason = RewriteAbortReason::None();
  return RewriteCapture(running: no, active: no, aborted: no, scan_done: no, cut: no, cut_done: no, rotated: no, rotating: no, start: 0_u64, end: 0_u64, limit: 0_u64, fixed: 0_u64, used: 0_u64, aof_charged: 0_u64, peak: 0_u64, scan_peak: 0_u64, abort_reason: no_reason, abort_used: 0_u64, abort_peak: 0_u64, journal_images: 0_u64, journal_effects: 0_u64, journal_bytes: 0_u64, cleanup_failed: 0_u64, scan_steps: 0_u64, journal: move journal);
}

fn rewrite_abort(capture: &RewriteCapture, reason: RewriteAbortReason) -> result: unit writes(capture) {
  doc "Logical abort only: retained chunks stay charged until the sole writer detaches and releases them outside holds, one chunk per waiting turn.";
  if capture^.running {
  } else {
    return unit;
  }
  let no_reason = RewriteAbortReason::None();
  if capture^.abort_reason != no_reason {
    return unit;
  }
  set capture^.abort_reason = reason;
  set capture^.abort_used = capture^.used;
  set capture^.abort_peak = capture^.peak;
  set capture^.active = False();
  set capture^.aborted = True();
  set capture^.rotating = False();
  return unit;
}

fn rewrite_charge(capture: &RewriteCapture, bytes: u64) -> accepted: Bool writes(capture) {
  if capture^.aborted {
    return False();
  }
  let charged = rewrite_try_charge(capture: capture, bytes: bytes);
  if charged {
    return True();
  }
  let reserve_reason = RewriteAbortReason::Reserve();
  rewrite_abort(capture: capture, reason: reserve_reason);
  return False();
}

fn rewrite_try_charge(capture: &RewriteCapture, bytes: u64) -> accepted: Bool writes(capture) {
  if capture^.aborted {
    return False();
  }
  let available = capture^.limit -sat capture^.used;
  if bytes > available {
    return False();
  }
  set capture^.used = capture^.used +sat bytes;
  set capture^.peak = imax(capture^.peak, capture^.used);
  return True();
}

fn sequence_room(sequence: &WriteSequence, bytes: u64) -> accepted: Bool writes(sequence) {
  let available = sequence^.allowance -sat sequence^.retained;
  if bytes > available {
    let capture_reason = RewriteAbortReason::Capture();
    sequence_fail(sequence: sequence, reason: capture_reason);
    return False();
  }
  set sequence^.retained = sequence^.retained +sat bytes;
  return True();
}

fn sequence_fail(sequence: &WriteSequence, reason: RewriteAbortReason) -> result: unit writes(sequence.failed), writes(sequence.failure) {
  if sequence^.failed {
    return unit;
  }
  set sequence^.failure = reason;
  set sequence^.failed = True();
  return unit;
}

fn sequence_capture(sequence: &WriteSequence, key: &[u8], slot: &Option<Entry>) -> result: unit reads(key), reads(slot), writes(sequence) {
  doc "Coalesces a changed key's complete final image in bounded execution-unit scratch, unless the statement is opened for one key, has changed only this key and the key's previous write is journaled in the window, when it selects journaling the statement's own bytes. Effect mode is chosen at the first capture and every later capture checks the one-key claim before relying on it, so a second key revokes it before anything is published. Failure affects capture alone; normal mutation and AOF publication still complete.";
  let recording = band(sequence^.capturing, sequence^.taken);
  let viable = bnot(sequence^.failed);
  let enabled = band(recording, viable);
  if enabled {
  } else {
    return unit;
  }
  if sequence^.single {
    let second = sequence_subject(sequence: sequence, key: key, slot: slot);
    if second {
      sequence_revoke(sequence: sequence);
    }
    if sequence^.failed {
      return unit;
    }
  }
  if sequence^.effect {
    return unit;
  }
  let anchored = band(sequence^.anchor_seen, sequence^.anchored);
  let replayable = band(sequence^.single, anchored);
  if replayable {
    match sequence^.images {
      None() => {
        set sequence^.effect = True();
        return unit;
      }
      Some(value: earlier) => {
      }
    }
  }
  sequence_capture_image(sequence: sequence, key: key, slot: slot);
  return unit;
}

fn sequence_subject(sequence: &WriteSequence, key: &[u8], slot: &Option<Entry>) -> second: Bool reads(key), reads(slot), writes(sequence) {
  doc "For a statement opened for one key, retains the name of the first key it captures, charged before allocation, and whether that key is present after its latest change, and answers true when the captured key differs from it. Names are compared byte for byte, so a key removed and written again in the same statement stays the one key.";
  let present = False();
  match slot^ {
    Some(value: held) => {
      set present = True();
    }
    None() => {
    }
  }
  let known = False();
  let differs = False();
  match sequence^.subject {
    Some(value: named) => {
      set known = True();
      let recorded_length = named^.inner.len;
      let recorded = &named^.inner[0_u64..recorded_length];
      let order = pkg::bytes::windows_order(left: key, right: recorded);
      set differs = order != 0_i32;
    }
    None() => {
    }
  }
  if differs {
    return True();
  }
  if known {
    set sequence^.subject_live = present;
    return False();
  }
  let length = key^.len;
  let allocation = length +sat 32_u64;
  let charged = sequence_room(sequence: sequence, bytes: allocation);
  if charged {
    let retained_key = pkg::bytes::copy_bytes(input: key, start: 0_u64, length: length);
    set sequence^.subject = Some<Box<Slots<u8>>>(value: move retained_key);
    set sequence^.subject_live = present;
  }
  return False();
}

fn sequence_revoke(sequence: &WriteSequence) -> result: unit writes(sequence) {
  doc "A statement opened for one key has changed a second. Its own bytes would reach the second key without that key's previous write being journaled, and the scanned image of that key may already hold the change, so the statement journals complete images of every key it changed instead. Keys captured so far hold images unless the first key took the byte path: a first key the statement removed has the image its name alone determines, rebuilt here; a first key still present has no image at hand, so capture fails and the rewrite aborts rather than journal a unit that does not reproduce it.";
  set sequence^.single = False();
  if sequence^.effect {
  } else {
    return unit;
  }
  set sequence^.effect = False();
  if sequence^.subject_live {
    let present_reason = RewriteAbortReason::Capture();
    sequence_fail(sequence: sequence, reason: present_reason);
    return unit;
  }
  let held = None<Box<Slots<u8>>>();
  swap(first: &sequence^.subject, second: &held);
  match move held {
    Some(value: named) => {
      let length = named.inner.len;
      let absent = None<Entry>();
      sequence_capture_image(sequence: sequence, key: &named.inner[0_u64..length], slot: &absent);
    }
    None() => {
      let unnamed_reason = RewriteAbortReason::Capture();
      sequence_fail(sequence: sequence, reason: unnamed_reason);
    }
  }
  return unit;
}

fn sequence_capture_image(sequence: &WriteSequence, key: &[u8], slot: &Option<Entry>) -> result: unit reads(key), reads(slot), writes(sequence) {
  doc "Copies the key's complete final image into the statement's scratch, replacing an earlier image of the same key. Every reservation precedes allocation, including capacity growth overlap and replacement of an earlier image.";
  let length = key^.len;
  let measure = rewrite_measure(slot: slot, key_length: length);
  match sequence^.images {
    None() => {
      let charged = sequence_room(sequence: sequence, bytes: 280_u64);
      if charged {
        let records = box_slots_new::<RewriteImage>(capacity: 16_u64);
        set sequence^.images = Some<Box<Slots<RewriteImage>>>(value: move records);
      } else {
        return unit;
      }
    }
    Some(value: existing) => {
    }
  }
  let copied_keys = length *sat 2_u64;
  let payload = measure.bytes +sat copied_keys;
  let allocation = payload +sat 256_u64;
  let charged = sequence_room(sequence: sequence, bytes: allocation);
  if charged {
  } else {
    return unit;
  }
  let key_copy = pkg::bytes::copy_bytes(input: key, start: 0_u64, length: length);
  let yes = True();
  let output = rewrite_image(slot: slot, key: key, capacity: measure.bytes, replacement: yes);
  let image = RewriteImage(key: move key_copy, output: move output);
  match sequence^.images {
    Some(value: records) => {
      for (index in 0_u64..records^.inner.len) {
        let previous = &records^.inner[index];
        let old_length = previous^.key.inner.len;
        let old_key = &previous^.key.inner[0_u64..old_length];
        let order = pkg::bytes::windows_order(left: key, right: old_key);
        if order == 0_i32 {
          set previous^ = move image;
          return unit;
        }
      }
      let capacity = records^.inner.cap;
      if records^.inner.len == capacity {
        let target = capacity *sat 2_u64;
        let backing = target *sat 16_u64;
        let growth = backing +sat 24_u64;
        let available = sequence^.allowance -sat sequence^.retained;
        if growth > available {
          let capture_reason = RewriteAbortReason::Capture();
          sequence_fail(sequence: sequence, reason: capture_reason);
          return unit;
        }
        set sequence^.retained = sequence^.retained +sat growth;
        if target >= records^.inner.cap {
          grow(cell: records, capacity: target);
        }
      }
      if records^.inner.len < records^.inner.cap {
        place_back(window: &records^.inner, value: move image);
      } else {
        let discarded = move image;
        let capture_reason = RewriteAbortReason::Capture();
        sequence_fail(sequence: sequence, reason: capture_reason);
      }
    }
    None() => {
      let discarded = move image;
      let capture_reason = RewriteAbortReason::Capture();
      sequence_fail(sequence: sequence, reason: capture_reason);
    }
  }
  return unit;
}

fn sequence_capture_at(sequence: &WriteSequence, keys: &KeySet, index: u64, slot: &Option<Entry>) -> result: unit reads(keys), reads(slot), writes(sequence) {
  if sequence^.capturing {
    if sequence^.failed {
      return unit;
    }
    if index < keys^.len {
      let probe = array_filled::<u8, 0>(value: 0_u8);
      let length = key_set_read_key(keys: keys, index: index, out: &probe[0_u64..0_u64]);
      let allocation = length +sat 16_u64;
      let charged = sequence_room(sequence: sequence, bytes: allocation);
      if charged {
        let key_buffer = box_array_filled::<u8>(count: length, value: 0_u8);
        let count = key_buffer.inner.len;
        let bytes = &key_buffer.inner[0_u64..count];
        key_set_read_key(keys: keys, index: index, out: bytes);
        sequence_capture(sequence: sequence, key: bytes, slot: slot);
      }
    }
  }
  return unit;
}

fn rewrite_journal_byte(chunks: &Box<Ring<Box<Slots<u8>>>>, value: u8) -> result: unit writes(chunks) {
  let count = chunks^.inner.len;
  if count > 0_u64 {
    let last = count - 1_u64;
    if last < chunks^.inner.len {
      let output = &chunks^.inner[last];
      if output^.inner.len < output^.inner.cap {
        place_back(window: &output^.inner, value: value);
      }
    }
  }
  return unit;
}

fn rewrite_journal_room(capture: &RewriteCapture, length: u64) -> accepted: Bool writes(capture) {
  doc "Reserve all new 64 KiB staging chunks for an entire unit before appending its first byte. A full staging queue aborts capture rather than waiting for its disk drainer. The fixed pointer directory never grows and is at most one cleanup chunk itself.";
  if capture^.aborted {
    return False();
  }
  let free = 0_u64;
  let count = 0_u64;
  let capacity = 0_u64;
  match capture^.journal {
    Some(value: chunks) => {
      set count = chunks^.inner.len;
      set capacity = chunks^.inner.cap;
      if count > 0_u64 {
        let last = count - 1_u64;
        if last < chunks^.inner.len {
          let output = &chunks^.inner[last];
          set free = output^.inner.cap -sat output^.inner.len;
        }
      }
    }
    None() => {
      let journal_slots_reason = RewriteAbortReason::JournalSlots();
      rewrite_abort(capture: capture, reason: journal_slots_reason);
      return False();
    }
  }
  let excess = length -sat free;
  let rounded = excess +sat 65535_u64;
  let needed = rounded / 65536_u64;
  let slots = capacity -sat count;
  if needed > slots {
    let journal_backlog_reason = RewriteAbortReason::JournalBacklog();
    rewrite_abort(capture: capture, reason: journal_backlog_reason);
    return False();
  }
  let bytes = needed *sat 65560_u64;
  let available = capture^.limit -sat capture^.used;
  if bytes > available {
    let journal_backlog_reason = RewriteAbortReason::JournalBacklog();
    rewrite_abort(capture: capture, reason: journal_backlog_reason);
    return False();
  }
  return rewrite_charge(capture: capture, bytes: bytes);
}

fn rewrite_journal_put(chunks: &Box<Ring<Box<Slots<u8>>>>, value: u8) -> result: unit writes(chunks) {
  let fresh = chunks^.inner.len == 0_u64;
  let count = chunks^.inner.len;
  if count > 0_u64 {
    let last = count - 1_u64;
    if last < chunks^.inner.len {
      set fresh = chunks^.inner[last].inner.len == chunks^.inner[last].inner.cap;
    }
  }
  if fresh {
    if chunks^.inner.len < chunks^.inner.cap {
      let block = box_slots_new::<u8>(capacity: 65536_u64);
      place_back(window: &chunks^.inner, value: move block);
    }
  }
  rewrite_journal_byte(chunks: chunks, value: value);
  return unit;
}

fn rewrite_journal_number(chunks: &Box<Ring<Box<Slots<u8>>>>, value: u64) -> result: unit writes(chunks) {
  let rest = value;
  for (index in 0_u64..8_u64) {
    let low = iand(rest, 255_u64);
    let byte = cvt.wrap::<u64, u8>(low);
    rewrite_journal_put(chunks: chunks, value: byte);
    set rest = rest / 256_u64;
  }
  return unit;
}

fn sequence_publish(meta: &Meta, sequence: &WriteSequence) -> result: unit reads(sequence), reads(meta.log), writes(meta.rewrite) {
  if meta^.rewrite.active {
    if sequence^.failed {
      rewrite_abort(capture: &meta^.rewrite, reason: sequence^.failure);
      return unit;
    }
    if sequence^.exhausted {
      let sequence_exhausted_reason = RewriteAbortReason::SequenceExhausted();
      rewrite_abort(capture: &meta^.rewrite, reason: sequence_exhausted_reason);
      return unit;
    }
    if sequence^.effect {
      sequence_publish_effect(meta: meta, sequence: sequence);
      return unit;
    }
    match sequence^.images {
      Some(value: records) => {
        let length = 0_u64;
        for (index in 0_u64..records^.inner.len) {
          let bytes = records^.inner[index].output.inner.len;
          set length = length +sat bytes;
        }
        let framed = length +sat 24_u64;
        let overlap = sequence^.retained;
        let charged = rewrite_charge(capture: &meta^.rewrite, bytes: overlap);
        if charged {
          let room = rewrite_journal_room(capture: &meta^.rewrite, length: framed);
          if room {
            match meta^.rewrite.journal {
              Some(value: chunks) => {
                rewrite_journal_number(chunks: chunks, value: sequence^.value);
                rewrite_journal_number(chunks: chunks, value: length);
                rewrite_journal_number(chunks: chunks, value: 0_u64);
                for (index in 0_u64..records^.inner.len) {
                  let output = &records^.inner[index].output;
                  for (offset in 0_u64..output^.inner.len) {
                    let byte = output^.inner[offset];
                    rewrite_journal_put(chunks: chunks, value: byte);
                  }
                }
              }
              None() => {
              }
            }
          }
          set meta^.rewrite.used = meta^.rewrite.used -sat overlap;
        }
      }
      None() => {
      }
    }
  }
  return unit;
}

fn sequence_publish_effect(meta: &Meta, sequence: &WriteSequence) -> result: unit reads(sequence), reads(meta.log), writes(meta.rewrite) {
  doc "Journals the statement's own append-only bytes as one framed unit. The statement changed one key, whose previous write is already in the journal, so replaying these bytes in sequence order reproduces the key exactly, at the cost of the bytes rather than the key's size. The retained name of that key overlaps the staging copy, so it is charged across it as an image statement's scratch is.";
  let end = meta^.log.inner.len;
  let start = sequence^.log_start;
  if start > end {
    let journal_invalid_reason = RewriteAbortReason::JournalInvalid();
    rewrite_abort(capture: &meta^.rewrite, reason: journal_invalid_reason);
    return unit;
  }
  let length = end - start;
  let framed = length +sat 24_u64;
  let overlap = sequence^.retained;
  let charged = rewrite_charge(capture: &meta^.rewrite, bytes: overlap);
  if charged {
    let room = rewrite_journal_room(capture: &meta^.rewrite, length: framed);
    if room {
      match meta^.rewrite.journal {
        Some(value: chunks) => {
          rewrite_journal_number(chunks: chunks, value: sequence^.value);
          rewrite_journal_number(chunks: chunks, value: length);
          rewrite_journal_number(chunks: chunks, value: 1_u64);
          for (offset in start..end) {
            let byte = meta^.log.inner[offset];
            rewrite_journal_put(chunks: chunks, value: byte);
          }
        }
        None() => {
        }
      }
    }
    set meta^.rewrite.used = meta^.rewrite.used -sat overlap;
  }
  return unit;
}
