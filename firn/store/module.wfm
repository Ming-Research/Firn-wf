alias HashMap = std::collections::hash_map::HashMap;
alias Bytes = pkg::bytes::Bytes;
alias CancelSource = std::time::CancelSource;
alias Key = pkg::bytes::Key;
alias KeyEnv = pkg::bytes::KeyEnv;
alias OrderedKey = std::collections::ordered_map::OrderedKey;
alias OrderedMap = std::collections::ordered_map::OrderedMap;
alias PriorityOrder = std::collections::priority_queue::PriorityOrder;
alias PriorityQueue = std::collections::priority_queue::PriorityQueue;
alias Span = pkg::protocol::Span;

public const ceiling: u64 = 4294967296_u64;

public enum RewriteAbortReason {
  None();
  Reserve();
  Capture();
  JournalSlots();
  Flush();
  SequenceExhausted();
  MemoryPressure();
  Cancelled();
  BaseIo();
  WriterIo();
  Drain();
  Boundary();
  InstallIo();
  RotationReserve();
  SequenceInvalid();
  JournalInvalid();
  Admission();
}

public struct Rank {
  doc "A sorted set's member at its score, the key the set's order keeps.";
  public score: f64;
  public member: Key;
}

public struct Sorted {
  doc "A sorted set: its members in score order, ties by member bytes, and each member's score.";
  public order: OrderedMap<Rank, unit, ceiling>;
  public scores: HashMap<Key, f64, ceiling>;
}

public enum Value {
  Text(public bytes: Bytes);
  Items(public items: Box<Ring<Box<Slots<u8>>>>);
  Members(public members: HashMap<Key, unit, ceiling>);
  Fields(public fields: HashMap<Key, Bytes, ceiling>);
  Ranked(public ranked: Sorted);
}

public struct Entry {
  doc "A key's value, Redis 7.0.15 robj.lru access bits (object.c createObject and db.c lookupKey), its dataset last-write sequence (zero after loading), and its expiry: the calendar time in milliseconds at which it expires, as Redis keeps it, or zero for none.";
  public value: Value;
  public expires: u64;
  public access: u32;
  public last_write: u64;
}

public struct WriteSequence {
  doc "One outer atomic statement's lazy sequence, initialized from held Meta and committed back before releasing that same hold. All command parts share it; loading leaves the sequence and entry stamps zero. While capture is active, bounded owned images coalesce each changed key before the outer statement commits; the inactive path allocates nothing.";
  public value: u64;
  public taken: Bool;
  public loading: Bool;
  public exhausted: Bool;
  public capturing: Bool;
  public failed: Bool;
  public failure: RewriteAbortReason;
  public allowance: u64;
  public retained: u64;
  public single: Bool;
  public start: u64;
  public log_start: u64;
  public anchor_seen: Bool;
  public anchored: Bool;
  public effect: Bool;
  public images: Option<Box<Slots<RewriteImage>>>;
}

public struct RewriteImage {
  doc "One execution unit's final replacement for a binary key, including DEL, reconstruction and its absolute expiry. Replacing this record coalesces repeated writes under the same hold.";
  public key: Box<Slots<u8>>;
  public output: Box<Slots<u8>>;
}

public struct RewriteCapture {
  doc "running covers admission through worker and chunk cleanup; diagnostics survive it. active covers (start,end]; aborted prevents this attempt's installation. scan_done hands the end cut to the sole writer; cut_done publishes its rotation result. Journal chunks contain little-endian sequence and byte-count frames followed by owned RESP replacements, in Meta commit order.";
  public running: Bool;
  public active: Bool;
  public aborted: Bool;
  public scan_done: Bool;
  public cut: Bool;
  public cut_done: Bool;
  public rotated: Bool;
  public rotating: Bool;
  public start: u64;
  public end: u64;
  public limit: u64;
  public used: u64;
  public peak: u64;
  public scan_peak: u64;
  public abort_reason: RewriteAbortReason;
  public abort_used: u64;
  public abort_peak: u64;
  public journal_images: u64;
  public journal_effects: u64;
  public scan_steps: u64;
  public journal: Option<Box<Ring<Box<Slots<u8>>>>>;
}

public struct RewriteMeasure {
  public bytes: u64;
  public elements: u64;
}

public struct AccessUndo {
  doc "One key's access stamp before its first live refresh in a script attempt.";
  public key: Box<Array<u8>>;
  public stamp: u32;
}

public struct AccessJournal {
  doc "Owned by one script attempt's environment and dropped with it. keys deduplicates binary key names; entries keeps each key and its original stamp in first-refresh order. Ordinary commands and EXEC pass None instead of allocating a journal.";
  public keys: KeySet;
  public entries: Box<Slots<AccessUndo>>;
}

public struct Due {
  doc "An expiry queued for active removal: the key's bytes and the calendar milliseconds it was set to expire at.";
  public key: Bytes;
  public at: u64;
}

public struct ExpiryQueue {
  doc "Active-expiry queue plus invalidation of a resumable volatile-policy absence scan. Every successful creation or transfer of a nonzero expiry calls queue_due in the same entry-and-Meta statement, which sets eligibility_changed even if the queue is full. Removing expiry records or clearing the queue cannot add eligibility and preserves this flag.";
  public queue: PriorityQueue<Due, ceiling>;
  public eligibility_changed: Bool;
}

public struct EvictionCandidate {
  doc "Redis 7.0.15 evictionPoolPopulate's owned key and score; larger scores are better victims. The shared pool keeps at most EVPOOL_SIZE (16) candidates without borrowing the map.";
  public key: Box<Array<u8>>;
  public score: u64;
}

public struct Meta {
  doc "What the keyspace keeps beside its keys: the queued expiries, the dataset statement sequence and capture-exhaustion state, the append-only file's collecting buffer and published writer capacity, the observed heap peak, eviction and active/lazy-helper expiry counts, the shared 16-candidate eviction pool and resumable empty-search cursor, the active-file byte count and rewrite baseline, rewrite request and reply handoff, progress, attempts, last status, worker completion and automatic thresholds, the clients connected, whether the server is stopping, and the state SPOP draws from.";
  public due: ExpiryQueue;
  public commit_seq: u64;
  public aof_rewrite_seq_exhausted: Bool;
  public rewrite: RewriteCapture;
  public aof_rewrite_retry_blocked: Bool;
  public aof_rewrite_reserve: u64;
  public aof_rewrite_scan_peak: u64;
  public aof_rewrite_cut: Bool;
  public log: Box<Slots<u8>>;
  public aof_pending_capacity: u64;
  public memory_peak: u64;
  public evicted_keys: u64;
  public expired_keys: u64;
  public eviction_pool: Box<Slots<EvictionCandidate>>;
  public eviction_policy: u64;
  public eviction_cursor: u64;
  public eviction_start: u64;
  public eviction_searching: Bool;
  public eviction_wrapped: Bool;
  public aof_current_size: u64;
  public aof_base_size: u64;
  public aof_rewrite_in_progress: Bool;
  public aof_rewrite_requested: Bool;
  public aof_rewrite_reply: u64;
  public aof_rewrites: u64;
  public aof_rewrite_ok: Bool;
  public aof_worker_done: Bool;
  public aof_installing: u64;
  public aof_rewrite_percentage: u64;
  public aof_rewrite_min_size: u64;
  public clients: u64;
  public stopping: Bool;
  public random: u64;
}

public struct MemoryConfig {
  doc "Redis 7.0.15 config.c memory settings; policies use maxmemory_policy_enum order, with noeviction at 7. Access tracking and command admission share each connection read's snapshot, refreshed after its own CONFIG SET.";
  public maxmemory: u64;
  public maxmemory_policy: u64;
  public maxmemory_samples: u64;
  public lfu_log_factor: u64;
  public lfu_decay_time: u64;
  public maxmemory_eviction_tenacity: u64;
}

public struct ServerState {
  doc "What the server keeps beside the keyspace that every connection reaches: the password clients must give, empty for none, and how many seconds a silent client is kept, zero for no limit, which CONFIG SET changes; the current receive wake source, replaced with each idle-limit change and fired after replacement or a shutdown request, outside the atomic statement; the values of the parameters whose only effect in Redis is on its internal encodings, which CONFIG SET sets and CONFIG GET reports and firn does not use, in the order of their names: hash-max-listpack-entries, hash-max-listpack-value, list-compress-depth, list-max-listpack-size, set-max-intset-entries, stream-node-max-bytes, stream-node-max-entries, zset-max-listpack-entries and zset-max-listpack-value; how many connections the server has accepted since it started or CONFIG RESETSTAT last ran; the shutdown request, which SHUTDOWN and a stop signal set and main sets again with Meta.stopping, separate from it until every client has left; the calendar time in milliseconds at which it started, which INFO's uptime counts from; and the six maxmemory and LFU settings CONFIG exposes.";
  public password: Bytes;
  public timeout: u64;
  public wake: CancelSource;
  public shutdown: Bool;
  public encodings: Array<i64, 9>;
  public connections: u64;
  public started: u64;
  public memory: MemoryConfig;
}

public struct Keyspace {
  doc "One context's handles to the keyspace's keys, to its metadata, to the server's state and to the script engine's pool, and whether changes are appended to the append-only file's pending bytes, fixed before any client is served.";
  public keys: Shared<ConcurrentHashMap<Entry>>;
  public meta: Shared<Meta>;
  public server: Shared<ServerState>;
  public scripts: Shared<pkg::script_pool::EnginePool>;
  public logging: Bool;
}

public struct Time {
  doc "The clock as one command sees it: unix_ms, calendar milliseconds, which a relative expiry counts from; check, the instant an expiry is compared against, unix_ms while clients are served and zero while a file is replayed; and whether a file is being replayed.";
  public unix_ms: u64;
  public check: u64;
  public loading: Bool;
}

public fn rank_compare(env: &KeyEnv, left: &Rank, right: &Rank) -> order: i32 reads(left), reads(right) doc "Orders ranks by score, then by member bytes, as Redis orders a sorted set.";

public binding RankOrder : OrderedKey<Rank, KeyEnv> {
  compare = rank_compare;
}

public fn due_order(env: &KeyEnv, left: &Due, right: &Due) -> order: i32 reads(left), reads(right) doc "Orders queued expiries by their instant, the earliest first.";

public binding DueOrder : PriorityOrder<Due, KeyEnv> {
  compare = due_order;
}

public const keyspace_capacity: u64 = 262144_u64;

public fn sequence_new(meta: &Meta, loading: Bool) -> sequence: WriteSequence reads(meta.commit_seq), reads(meta.aof_rewrite_seq_exhausted), reads(meta.rewrite), reads(meta.log) doc "Starts one outer atomic statement's sequence token from its held metadata; nested command parts reuse this token. Its captures are complete images.";

public fn sequence_new_key(meta: &Meta, loading: Bool) -> sequence: WriteSequence reads(meta.commit_seq), reads(meta.aof_rewrite_seq_exhausted), reads(meta.rewrite), reads(meta.log) doc "sequence_new for a statement holding exactly one key. When that key's previous write lies inside the current rewrite window, the journal already reproduces its state, so the statement journals its own append-only bytes instead of the key's image.";

public fn sequence_change(sequence: &WriteSequence) -> result: unit writes(sequence) doc "Takes one sequence lazily for an actual dataset mutation, reusing it for the rest of the statement. Reaching u64's maximum saturates the counter and permanently refuses future captures until a quiescent reset protocol exists; service mutations continue. Loading takes no sequence.";

public fn sequence_stamp(sequence: &WriteSequence, slot: &Option<Entry>) -> result: unit reads(slot), writes(sequence), writes(slot.Some.value.last_write) doc "Publishes an actual entry change through the statement's lazy sequence and stamps a surviving entry. Call only for a change; deletion and FLUSH use the same sequence_change contract. Loading stamps zero.";

public fn sequence_replace(sequence: &WriteSequence, slot: &Option<Entry>, replacement: Option<Entry>) -> result: unit writes(sequence), writes(slot) doc "Records the replaced destination's anchor before installing a fresh or transferred entry. The caller then stamps and captures the final value; no replacement uses the incoming entry's stamp as its anchor.";

public fn sequence_fail(sequence: &WriteSequence, reason: RewriteAbortReason) -> result: unit writes(sequence.failed), writes(sequence.failure) doc "Latches the first statement-local capture failure for publication under the outer Meta hold.";

public fn sequence_entry(sequence: &WriteSequence, value: &Entry) -> result: unit writes(sequence), writes(value.last_write) doc "Stamps a changed entry already held through a match, sharing sequence_stamp's publication contract.";

public fn sequence_delete(sequence: &WriteSequence, slot: &Option<Entry>) -> result: unit writes(sequence), writes(slot) doc "Removes a present entry and takes the statement's sequence; an absent entry changes nothing. Expiry, eviction and command deletion share this contract.";

public fn sequence_commit(meta: &Meta, sequence: &WriteSequence, budget: &LogBudget) -> result: unit reads(sequence), reads(budget), reads(meta.log), writes(meta.commit_seq), writes(meta.aof_rewrite_seq_exhausted), writes(meta.rewrite) doc "Publishes a taken sequence, its journal unit (after-images, or a one-key statement's own append-only bytes) and exhaustion flag, plus collecting-buffer growth or its rewrite-only overflow, before the outer atomic statement releases keys and Meta. Loading takes no sequence and has no active rotation budget.";

public fn keyspace_new(seed: u64, logging: Bool, password: Bytes, timeout: u64, started: u64) -> made: Keyspace pure doc "An empty keyspace, its keys a shared map sized for keyspace_capacity keys, appending changes to the append-only file's pending bytes when logging is true, whose SPOP draws start from the seed, beside a server's state that requires the password, none when it is empty, keeps a silent client timeout seconds, none when it is zero, owns an initially unfired receive wake source, holds Redis 7.0.15's defaults for the encoding parameters, and records started, the calendar time in milliseconds at which the server started.";

public fn shutdown_requested(store: &Keyspace) -> requested: Bool reads(store) waits doc "Whether SHUTDOWN or a stop signal requested that contexts drain and close, before the last client lets main stop the writer, or main has stopped it.";

public fn request_shutdown(store: &Keyspace) -> result: unit reads(store) waits doc "Requests that contexts drain and close, as SHUTDOWN and a stop signal do, recording the request and retaining the current receive wake source in one atomic statement once no rewrite is installing its manifest, then firing that source outside the statement. The caller still fires the separate shutdown source for accept, signal and expiry.";

public fn keyspace_share(store: &Keyspace) -> made: Keyspace reads(store) doc "Another context's handle to the same keyspace.";

public fn keyspace_logging(store: &Keyspace, logging: Bool) -> made: Keyspace reads(store) doc "A handle to the same keyspace and server's state that appends changes to the append-only file's pending bytes when logging is true.";

public fn expired(expires: u64, now: u64) -> reached: Bool pure doc "Whether an expiry, zero for none, has passed at now: a key lives through the millisecond its expiry names, as Redis 7.0.15's keyIsExpired keeps it.";

public fn remove_expired(store: &Keyspace, key: &[u8], now: u64) -> result: unit reads(store), reads(key) waits doc "Removes the key when its expiry has passed at now, for a command that found it expired in a statement that only read it, recording the removal as log_removal does; a key set again since keeps its value.";

public fn expire_batch(store: &Keyspace, now: u64, env: &KeyEnv, batch: &Box<Slots<Due>>) -> more: Bool reads(store), reads(env), writes(batch) waits doc "Takes up to 256 queued expiries that have passed, the earliest first, in one atomic statement, then removes each key whose expiry is still the one queued in a statement on that key, recording the removal as log_removal does, and returns whether more may be due. A queued expiry that no longer matches its key's, because the key was set, given another expiry or removed since, is dropped. The batch is scratch space the caller keeps.";

public fn queue_expiry(meta: &Meta, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(meta) doc "Queues a key's new expiry for active removal; one past the queue's ceiling is left to lazy removal.";

public fn queue_due(due: &ExpiryQueue, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(due) doc "Records new volatile eligibility and queues its expiry, as queue_expiry does, for a caller that holds expiry metadata apart from the rest of Meta. The call shares the atomic statement that creates or transfers the expiry, including when AOF is disabled.";

public fn log_removal(log: &Box<Slots<u8>>, key: &[u8], budget: &LogBudget) -> result: unit reads(key), writes(log), writes(budget) doc "Appends DEL key, as Redis 7.0.15 propagates the removal of a key whose expiry has passed, so that a replay, which counts no key as expired, removes the key where the server did and a later command finds it absent there too.";

public fn log_count(log: &Box<Slots<u8>>, count: u64, room: u64, budget: &LogBudget) -> result: unit writes(log), writes(budget) doc "Makes room for a command of about room bytes and appends the header of a RESP array of count elements.";

public fn log_append(log: &Box<Slots<u8>>, bytes: &[u8], budget: &LogBudget) -> result: unit reads(bytes), writes(log), writes(budget) doc "Appends bytes already in the file's form, such as the commands a transaction recorded, as they are.";

public fn log_word(log: &Box<Slots<u8>>, word: &[u8], budget: &LogBudget) -> result: unit reads(word), writes(log), writes(budget) doc "Appends a constant word as a RESP bulk string.";

public fn log_input(log: &Box<Slots<u8>>, input: &[u8], span: Span, budget: &LogBudget) -> result: unit reads(input), writes(log), writes(budget) doc "Appends an argument of the input as a RESP bulk string.";

public fn log_text(log: &Box<Slots<u8>>, text: &Bytes, budget: &LogBudget) -> result: unit reads(text), writes(log), writes(budget) doc "Appends a stored string as a RESP bulk string.";

public fn log_decimal(log: &Box<Slots<u8>>, value: u64, budget: &LogBudget) -> result: unit writes(log), writes(budget) doc "Appends a number as a RESP bulk string of its decimal digits.";

public fn log_command(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>, budget: &LogBudget) -> result: unit reads(input), reads(args), writes(log), writes(budget) doc "Appends a command as the client sent it, every argument a RESP bulk string.";

public fn access_settings(server: &ServerState, client: &pkg::protocol::Client) -> result: unit reads(server), writes(client) doc "Copies memory settings once per connection read, beside its clock snapshot and before any command holds keys. Every command of that read, including queued commands run by EXEC and script calls across attempts, uses this snapshot; this connection refreshes it after executing CONFIG SET. A racing CONFIG SET may cause an old-policy stamp; this is accepted because Redis itself leaves stale stamps after policy switches. CONFIG and INFO still access ServerState directly.";

public fn access_journal_new() -> journal: AccessJournal pure doc "An empty journal for one script attempt; allocation is total under Whitefoot STOR-8.";

public fn record_access(journal: &Option<AccessJournal>, key: &[u8], stamp: u32) -> result: unit reads(key), writes(journal) doc "Records the original stamp at a key's first live refresh in this attempt; later refreshes preserve that first value. None disables journaling for commands outside a script attempt.";

public fn restore_access(journal: &Option<AccessJournal>, keys: &ConcurrentHashMap<Entry>) -> result: unit reads(journal), writes(keys) doc "Restores every journaled stamp before an abandoned, unwritten script attempt releases its atomic keyspace hold. Completed attempts and attempts that wrote never call this.";

public fn sequence_stamp_key(sequence: &WriteSequence, slot: &Option<Entry>, key: &[u8]) -> result: unit reads(slot), reads(key), writes(sequence), writes(slot.Some.value.last_write) doc "Takes the shared statement sequence, stamps a changed surviving entry and captures it: a complete replacement image, or effect mode for an anchored one-key statement. A missing changed slot records a tombstone.";

public fn sequence_delete_key(sequence: &WriteSequence, slot: &Option<Entry>, key: &[u8]) -> result: unit reads(key), writes(sequence), writes(slot) doc "Removes a present key and records its tombstone through the same sequence token. An absent key changes neither sequence nor capture.";

public fn sequence_stamp_at(sequence: &WriteSequence, slot: &Option<Entry>, keys: &KeySet, index: u64) -> result: unit reads(slot), reads(keys), writes(sequence), writes(slot.Some.value.last_write) doc "The key-set-index form of sequence_stamp_key. Capture charges an owned key copy before reading the complete name; an inactive capture allocates nothing.";

public fn sequence_delete_at(sequence: &WriteSequence, slot: &Option<Entry>, keys: &KeySet, index: u64) -> result: unit reads(keys), writes(sequence), writes(slot) doc "The key-set-index form of sequence_delete_key, sharing the actual-removal test and bounded tombstone capture.";

public fn rewrite_capture_new() -> capture: RewriteCapture pure doc "An inactive empty capture with no journal allocation; construct only after any previous worker and bounded cleanup have completed.";

public fn rewrite_abort(capture: &RewriteCapture, reason: RewriteAbortReason) -> result: unit writes(capture) doc "For a running attempt, disables capture and latches the first failure reason, reserve use and peak under Meta before any cleanup. Later failures and ordinary writer activity outside an attempt preserve that snapshot; journal ownership remains until bounded worker cleanup.";

public fn rewrite_charge(capture: &RewriteCapture, bytes: u64) -> accepted: Bool writes(capture) doc "Reserves bytes before allocation, or logically aborts this attempt without allocating when they exceed the remaining allowance. Includes peak reservation accounting.";

public fn sequence_capture(sequence: &WriteSequence, key: &[u8], slot: &Option<Entry>) -> result: unit reads(key), reads(slot), writes(sequence) doc "Coalesces an actual changed key into the already-taken outer sequence: in an anchored one-key statement it only selects effect mode; otherwise it owns complete replacement bytes, charging scratch and allocation overlap; failure aborts capture at commit, never the client command.";

public fn sequence_capture_at(sequence: &WriteSequence, keys: &KeySet, index: u64, slot: &Option<Entry>) -> result: unit reads(keys), reads(slot), writes(sequence) doc "Captures the changed slot under its key-set index after charging the temporary key copy. Used when mutation helpers already stamped an entry through a matched payload.";

public fn rewrite_measure(slot: &Option<Entry>, key_length: u64) -> measured: RewriteMeasure reads(slot) doc "Allocation-free upper bound for complete replacement bytes including RESP framing and encoder lookahead, visiting every payload element; the caller charges the bound against the rewrite reserve before copying.";

public fn rewrite_image(slot: &Option<Entry>, key: &[u8], capacity: u64, replacement: Bool) -> output: Box<Slots<u8>> reads(slot), reads(key) doc "Serializes the complete held image using Redis command-format reconstruction and absolute expiry. The caller must first charge rewrite_measure bytes plus temporary key and formatting storage; replacement prepends DEL.";

public struct LogBudget {
  doc "A statement-local allowance for collecting-buffer growth while the sole writer rotates. Charge full new backing capacity before grow, preserving overlap; failed disables only rewrite accounting, never the ordinary append. sequence_commit publishes this local failure under the same Meta hold.";
  public enabled: Bool;
  public allowance: u64;
  public charged: u64;
  public failed: Bool;
}

public fn log_budget_new() -> budget: LogBudget pure doc "An unmetered ordinary encoder budget for buffers that are not stalled by rotation.";

public fn log_append_plain(log: &Box<Slots<u8>>, bytes: &[u8]) -> result: unit reads(bytes), writes(log) doc "Appends bytes in a private non-command builder, with no rotation-related collecting-buffer budget.";

public fn log_budget_begin(meta: &Meta, loading: Bool) -> budget: LogBudget reads(meta.rewrite) doc "Snapshots remaining R under the statement's Meta hold only while the writer rotates; service encoders charge collecting-buffer growth before allocation, and sequence_commit publishes overflow without failing the command.";
