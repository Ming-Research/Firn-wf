public fn aof_rewrite_minimum_set(meta: &Meta, value: u64) -> result: unit writes(meta.aof_rewrite_min_size) doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

public fn aof_rewrite_delay_set(meta: &Meta, value: i64) -> result: unit writes(meta.aof_rewrite_key_delay) doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

