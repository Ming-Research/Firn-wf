alias HashMap = std::collections::hash_map::HashMap;
alias Bytes = pkg::bytes::Bytes;
alias CancelSource = std::time::CancelSource;
alias Key = pkg::bytes::Key;
alias KeyEnv = pkg::bytes::KeyEnv;
alias OrderedKey = std::collections::ordered_map::OrderedKey;
alias OrderedMap = std::collections::ordered_map::OrderedMap;
alias PriorityOrder = std::collections::priority_queue::PriorityOrder;
alias PriorityQueue = std::collections::priority_queue::PriorityQueue;
alias Span = pkg::protocol::Span;

public const ceiling: u64 = 4294967296_u64;

public enum RewriteAbortReason {
  None();
  Reserve();
  Capture();
  JournalSlots();
  JournalBacklog();
  JournalIo();
  Flush();
  SequenceExhausted();
  MemoryPressure();
  Cancelled();
  BaseIo();
  WriterIo();
  Drain();
  Boundary();
  InstallIo();
  RotationReserve();
  SequenceInvalid();
  JournalInvalid();
  Admission();
}

public struct Rank {
  doc "A sorted set's member at its score, the key the set's order keeps.";
  public score: f64;
  public member: Key;
}

public struct Sorted {
  doc "A sorted set: its members in score order, ties by member bytes, and each member's score.";
  public order: OrderedMap<Rank, unit, ceiling>;
  public scores: HashMap<Key, f64, ceiling>;
}

public enum Value {
  Text(public bytes: Bytes);
  Items(public items: Box<Ring<Box<Slots<u8>>>>);
  Members(public members: HashMap<Key, unit, ceiling>);
  Fields(public fields: HashMap<Key, Bytes, ceiling>);
  Ranked(public ranked: Sorted);
}

public struct Entry {
  doc "A key's value, Redis 7.0.15 robj.lru access bits (object.c createObject and db.c lookupKey), its dataset last-write sequence (zero after loading and after a statement that holds no Meta), and its expiry: the calendar time in milliseconds at which it expires, as Redis keeps it, or zero for none.";
  public value: Value;
  public expires: u64;
  public access: u32;
  public last_write: u64;
}

public struct WriteSequence {
  doc "One outer atomic statement's lazy sequence, initialized from held Meta and committed back before releasing that same hold. All command parts share it; an inert token, taken while loading or by a statement that holds no Meta, leaves the sequence and entry stamps zero. While capture is active, bounded owned images coalesce each changed (database,key) pair before the outer statement commits; database selects subsequent capture identity, and effects_first_db/effects_selected retain the private effect stream's first and last propagated database, with 16 meaning no effects. The inactive path allocates nothing.";
  public readonly database: u64;
  public readonly effects_first_db: u64;
  public readonly effects_selected: u64;
  public readonly value: u64;
  public readonly taken: Bool;
  public readonly inert: Bool;
  public readonly exhausted: Bool;
  public readonly capturing: Bool;
  public readonly failed: Bool;
  public readonly failure: RewriteAbortReason;
  public readonly allowance: u64;
  public readonly retained: u64;
  public readonly single: Bool;
  public readonly start: u64;
  public readonly log_start: u64;
  public readonly anchor_seen: Bool;
  public readonly anchored: Bool;
  public readonly effect: Bool;
  public readonly images: Option<Box<Slots<RewriteImage>>>;
  invariant selected(sequence): sequence.database < 16_u64;
}

public struct RewriteImage {
  doc "One execution unit's final replacement for a (database,binary key) pair, including SELECT, DEL, reconstruction and its absolute expiry. Replacing this record coalesces repeated writes to the same pair under the same hold.";
  public database: u64;
  public key: Box<Slots<u8>>;
  public output: Box<Slots<u8>>;
}

public struct RewriteCapture {
  doc "running covers admission through worker and chunk cleanup; diagnostics survive it. active covers (start,end]; aborted prevents this attempt's installation. scan_done hands the end cut to the sole writer; cut_done publishes its rotation result after journal draining. Staging chunks contain little-endian u64 sequence, byte count and kind (0 images, 1 effect), then owned RESP bytes in Meta commit order. journal_bytes counts successfully appended file bytes; image/effect counters count complete file records, not staged records. cleanup_failed counts failed journal close/remove operations in this attempt, including failures after the first abort cause. fixed is the part of used that admission charged for the attempt's whole life, so limit minus fixed bounds what any later charge can ever reach.";
  public running: Bool;
  public active: Bool;
  public aborted: Bool;
  public scan_done: Bool;
  public cut: Bool;
  public cut_done: Bool;
  public rotated: Bool;
  public rotating: Bool;
  public start: u64;
  public end: u64;
  public limit: u64;
  public fixed: u64;
  public used: u64;
  public peak: u64;
  public scan_peak: u64;
  public abort_reason: RewriteAbortReason;
  public abort_used: u64;
  public abort_peak: u64;
  public journal_images: u64;
  public journal_effects: u64;
  public journal_bytes: u64;
  public cleanup_failed: u64;
  public scan_steps: u64;
  public journal: Option<Box<Ring<Box<Slots<u8>>>>>;
}

public struct RewriteMeasure {
  public bytes: u64;
  public elements: u64;
}

public struct AccessUndo {
  doc "One key's access stamp before its first live refresh in a script attempt.";
  public key: Box<Array<u8>>;
  public stamp: u32;
  public database: u64;
}

public struct AccessJournal {
  doc "One script attempt's first-refresh stamps, deduplicated by separate database-local key sets. Ordinary commands pass None and allocate no journal. The sixteen key sets start empty.";
  keys: Slots<KeySet, 16>;
  entries: Box<Slots<AccessUndo>>;
  database: u64;
  invariant database_bound(journal): journal.database < 16_u64;
  invariant initialized(journal): journal.keys.len == 16_u64;
}

public struct AttemptEntryUndo {
  doc "One declared insertion index and its original optional entry; None records original absence, not an unsaved index.";
  public index: u64;
  public original: Option<Entry>;
}

public struct AttemptUndo {
  doc "Owned originals saved before each declared entry's first possible dataset mutation. AccessJournal restores earlier refresh stamps after these payloads.";
  public entries: Box<Slots<AttemptEntryUndo>>;
}

public struct Due {
  doc "An expiry queued for active removal: the key's bytes and the calendar milliseconds it was set to expire at.";
  public readonly key: Bytes;
  public readonly at: u64;
  public readonly database: u64;
  invariant selected(due): due.database < 16_u64;
}

public struct ExpiryQueue {
  doc "Active-expiry queue plus invalidation of a resumable volatile-policy absence scan. A script attempt instead sets staged to an ordered private list, published only on acceptance through queue_due. Every successful creation or transfer of a nonzero expiry sets eligibility_changed even if the ordinary queue is full. Removing expiry records or clearing the queue cannot add eligibility and preserves this flag.";
  public readonly queue: PriorityQueue<Due, ceiling>;
  public readonly database: u64;
  public readonly eligibility_changed: Bool;
  public readonly staged: Option<Box<Slots<Due>>>;
  invariant selected(due): due.database < 16_u64;
}

public struct EvictionCandidate {
  doc "Redis 7.0.15 evictionPoolPopulate's owned key and score; larger scores are better victims. The shared pool keeps at most EVPOOL_SIZE (16) candidates without borrowing the map.";
  public readonly key: Box<Array<u8>>;
  public readonly score: u64;
  public readonly database: u64;
  invariant selected(candidate): candidate.database < 16_u64;
}

public struct Meta {
  doc "What the keyspace keeps beside its keys: the queued expiries, the dataset statement sequence and capture-exhaustion state, the append-only file's collecting buffer, published retained length/capacity, saved append/sync IoErrors and partial-append marker, the observed heap peak, eviction and active/lazy-helper expiry counts, the shared 16-candidate eviction pool and resumable empty-search cursor, the total active-file and current incremental byte counts, the incremental byte count at its last successful sync, and rewrite baseline, rewrite request and reply handoff, progress, attempts, last status, worker completion, automatic thresholds and the rdb-key-save-delay testing delay the scan reads at each step, the clients connected, whether the server is stopping, and the state SPOP draws from. aof_rewrite_journal_leftover records the latest failed removal of an unlisted temporary journal until a later removal or absence is observed; admission does not reset it and it is not a filesystem stat.";
  public readonly due: ExpiryQueue;
  public readonly database: u64;
  public readonly aof_database: u64;
  public readonly commit_seq: u64;
  public readonly aof_rewrite_seq_exhausted: Bool;
  public readonly rewrite: RewriteCapture;
  public readonly aof_rewrite_retry_blocked: Bool;
  public readonly aof_rewrite_reserve: u64;
  public readonly aof_rewrite_scan_peak: u64;
  public readonly aof_rewrite_cut: Bool;
  public readonly aof_rewrite_journal_leftover: Bool;
  public readonly log: Box<Slots<u8>>;
  public readonly aof_pending_capacity: u64;
  public readonly aof_pending_length: u64;
  public readonly aof_append_error: Option<std::io::IoError>;
  public readonly aof_sync_error: Option<std::io::IoError>;
  public readonly aof_append_partial: Bool;
  public readonly memory_peak: u64;
  public readonly evicted_keys: u64;
  public readonly expired_keys: u64;
  public readonly eviction_pool: Box<Slots<EvictionCandidate>>;
  public readonly eviction_policy: u64;
  public readonly eviction_database: u64;
  public readonly eviction_cursors: Array<u64, 16>;
  public readonly eviction_starts: Array<u64, 16>;
  public readonly eviction_searches: Array<Bool, 16>;
  public readonly eviction_wraps: Array<Bool, 16>;
  public readonly eviction_exhausted: Array<Bool, 16>;
  public readonly eviction_cursor: u64;
  public readonly eviction_start: u64;
  public readonly eviction_searching: Bool;
  public readonly eviction_wrapped: Bool;
  public readonly aof_current_size: u64;
  public readonly aof_incr_size: u64;
  public readonly aof_synced_size: u64;
  public readonly aof_base_size: u64;
  public readonly aof_rewrite_in_progress: Bool;
  public readonly aof_rewrite_requested: Bool;
  public readonly aof_rewrite_reply: u64;
  public readonly aof_rewrites: u64;
  public readonly aof_rewrite_ok: Bool;
  public readonly aof_worker_done: Bool;
  public readonly aof_installing: u64;
  public readonly aof_rewrite_percentage: u64;
  public readonly aof_rewrite_min_size: u64;
  public readonly aof_rewrite_key_delay: i64;
  public readonly clients: u64;
  public readonly stopping: Bool;
  public readonly random: u64;
  invariant selected(meta): meta.database < 16_u64;
}

public fn aof_failed(meta: &Meta) -> failed: Bool reads(meta.aof_append_error), reads(meta.aof_sync_error) doc "Whether active-file append or sync has failed. Admission reads this with its held mutation metadata; rewrite failure is independent. aof_error_text selects what the refusal describes.";

public fn aof_error_text(meta: &Meta) -> text: pkg::protocol::AofErrorText reads(meta.aof_append_error), reads(meta.aof_append_partial), reads(meta.aof_sync_error) doc "Selects the text for the refusal: Host with a failed append's own error when nothing of it was written (aof.c:1157-1162), else Host with the sync error (aof_bio_fsync_errno), else Absent. A partial append is ShortWrite, which Redis reports as ENOSPC whatever the host returned (aof.c:1163-1184), described by the no-space class rather than a host code.";

public struct MemoryConfig {
  doc "Redis 7.0.15 config.c memory settings; policies use maxmemory_policy_enum order, with noeviction at 7. Access tracking and command admission share each connection read's snapshot, refreshed after its own CONFIG SET.";
  public maxmemory: u64;
  public maxmemory_policy: u64;
  public maxmemory_samples: u64;
  public lfu_log_factor: u64;
  public lfu_decay_time: u64;
  public maxmemory_eviction_tenacity: u64;
}

public struct ServerState {
  doc "What the server keeps beside the keyspace that every connection reaches: the password clients must give, empty for none, and how many seconds a silent client is kept, zero for no limit, which CONFIG SET changes; the current receive wake source, replaced with each idle-limit change and fired after replacement or a shutdown request, outside the atomic statement; the values of the parameters whose only effect in Redis is on its internal encodings, which CONFIG SET sets and CONFIG GET reports and firn does not use, in the order of their names: hash-max-listpack-entries, hash-max-listpack-value, list-compress-depth, list-max-listpack-size, set-max-intset-entries, set-max-listpack-entries, set-max-listpack-value, stream-node-max-bytes, stream-node-max-entries, zset-max-listpack-entries and zset-max-listpack-value; how many connections the server has accepted since it started or CONFIG RESETSTAT last ran; the shutdown request, which SHUTDOWN and a stop signal set and main sets again with Meta.stopping, separate from it until every client has left; the calendar time in milliseconds at which it started, which INFO's uptime counts from; and the six maxmemory and LFU settings CONFIG exposes.";
  public password: Bytes;
  public timeout: u64;
  public wake: CancelSource;
  public shutdown: Bool;
  public encodings: Array<i64, 11>;
  public connections: u64;
  public started: u64;
  public memory: MemoryConfig;
}

public struct Databases {
  doc "Permanent identities for Redis databases zero through fifteen. Connections cache one shared handle; SWAPDB exchanges map contents, never these handles.";
  public readonly db0: Shared<ConcurrentHashMap<Entry>>;
  public readonly db1: Shared<ConcurrentHashMap<Entry>>;
  public readonly db2: Shared<ConcurrentHashMap<Entry>>;
  public readonly db3: Shared<ConcurrentHashMap<Entry>>;
  public readonly db4: Shared<ConcurrentHashMap<Entry>>;
  public readonly db5: Shared<ConcurrentHashMap<Entry>>;
  public readonly db6: Shared<ConcurrentHashMap<Entry>>;
  public readonly db7: Shared<ConcurrentHashMap<Entry>>;
  public readonly db8: Shared<ConcurrentHashMap<Entry>>;
  public readonly db9: Shared<ConcurrentHashMap<Entry>>;
  public readonly db10: Shared<ConcurrentHashMap<Entry>>;
  public readonly db11: Shared<ConcurrentHashMap<Entry>>;
  public readonly db12: Shared<ConcurrentHashMap<Entry>>;
  public readonly db13: Shared<ConcurrentHashMap<Entry>>;
  public readonly db14: Shared<ConcurrentHashMap<Entry>>;
  public readonly db15: Shared<ConcurrentHashMap<Entry>>;
}

public struct Keyspace {
  doc "One context's handles to the keyspace's keys, to its metadata, to the server's state and to the script engine's pool, and whether changes are appended to the append-only file's pending bytes, fixed before any client is served. While changes are not appended, a command's statement that queues no expiry and reads nothing else from Meta holds its keys alone, with sequence_inert's token.";
  public readonly keys: Shared<ConcurrentHashMap<Entry>>;
  public readonly meta: Shared<Meta>;
  public readonly server: Shared<ServerState>;
  public readonly scripts: Shared<pkg::script_pool::EnginePool>;
  public readonly logging: Bool;
  public readonly database: u64;
  public readonly databases: Databases;
  invariant selected(store): store.database < 16_u64;
}

public struct Time {
  doc "The clock as one command sees it: unix_ms, calendar milliseconds, which a relative expiry counts from; check, the instant an expiry is compared against, unix_ms while clients are served and zero while a file is replayed; and whether a file is being replayed.";
  public unix_ms: u64;
  public check: u64;
  public loading: Bool;
}

public fn rank_compare(env: &KeyEnv, left: &Rank, right: &Rank) -> order: i32 reads(left), reads(right) doc "Orders ranks by score, then by member bytes, as Redis orders a sorted set.";

public binding RankOrder : OrderedKey<Rank, KeyEnv> {
  compare = rank_compare;
}

public fn due_order(env: &KeyEnv, left: &Due, right: &Due) -> order: i32 reads(left), reads(right) doc "Orders queued expiries by their instant, the earliest first.";

public binding DueOrder : PriorityOrder<Due, KeyEnv> {
  compare = due_order;
}

public const keyspace_capacity: u64 = 262144_u64;

public fn sequence_new(meta: &Meta, loading: Bool) -> sequence: WriteSequence reads(meta.database), reads(meta.commit_seq), reads(meta.aof_rewrite_seq_exhausted), reads(meta.rewrite), reads(meta.log) doc "Starts one outer atomic statement's sequence token from its held metadata; nested command parts reuse this token. Its captures are complete images.";

public fn sequence_new_key(meta: &Meta, loading: Bool) -> sequence: WriteSequence reads(meta.database), reads(meta.commit_seq), reads(meta.aof_rewrite_seq_exhausted), reads(meta.rewrite), reads(meta.log) doc "sequence_new for a statement holding exactly one key. When that key's previous write lies inside the current rewrite window, the journal already reproduces its state, so the statement journals its own append-only bytes instead of the key's image.";

public fn sequence_inert() -> sequence: WriteSequence pure doc "The token of an outer atomic statement that holds no Meta, as a command's statement does while the keyspace keeps no append-only file and the statement queues no expiry: it takes no sequence, stamps changed entries zero, captures nothing and is never committed, as a loading token behaves.";

public fn sequence_change(sequence: &WriteSequence) -> result: unit writes(sequence) doc "Takes one sequence lazily for an actual dataset mutation, reusing it for the rest of the statement. Reaching u64's maximum saturates the counter and permanently refuses future captures until a quiescent reset protocol exists; service mutations continue. An inert token takes no sequence.";

public fn sequence_stamp(sequence: &WriteSequence, slot: &Option<Entry>) -> result: unit reads(slot), writes(sequence), writes(slot.Some.value.last_write) doc "Publishes an actual entry change through the statement's lazy sequence and stamps a surviving entry. Call only for a change; deletion and FLUSH use the same sequence_change contract. An inert token stamps zero.";

public fn sequence_replace(sequence: &WriteSequence, slot: &Option<Entry>, replacement: Option<Entry>) -> result: unit writes(sequence), writes(slot) doc "Records the replaced destination's anchor before installing a fresh or transferred entry. The caller then stamps and captures the final value; no replacement uses the incoming entry's stamp as its anchor.";

public fn sequence_fail(sequence: &WriteSequence, reason: RewriteAbortReason) -> result: unit writes(sequence.failed), writes(sequence.failure) doc "Latches the first statement-local capture failure for publication under the outer Meta hold.";

public fn sequence_entry(sequence: &WriteSequence, value: &Entry) -> result: unit writes(sequence), writes(value.last_write) doc "Stamps a changed entry already held through a match, sharing sequence_stamp's publication contract.";

public fn sequence_delete(sequence: &WriteSequence, slot: &Option<Entry>) -> result: unit writes(sequence), writes(slot) doc "Removes a present entry and takes the statement's sequence; an absent entry changes nothing. Expiry, eviction and command deletion share this contract.";

public fn sequence_commit(meta: &Meta, sequence: &WriteSequence, budget: &LogBudget) -> result: unit reads(sequence), reads(budget), reads(meta.log), writes(meta.aof_database), writes(meta.commit_seq), writes(meta.aof_rewrite_seq_exhausted), writes(meta.rewrite) doc "Publishes a taken sequence, its journal unit (after-images, or a one-key statement's own append-only bytes) and exhaustion flag, plus collecting-buffer growth or its rewrite-only overflow, before the outer atomic statement releases keys and Meta. Loading takes no sequence and has no active rotation budget.";

public fn keyspace_new(seed: u64, logging: Bool, password: Bytes, timeout: u64, started: u64) -> made: Keyspace pure doc "An empty keyspace, its keys a shared map sized for keyspace_capacity keys, appending changes to the append-only file's pending bytes when logging is true, whose SPOP draws start from the seed, beside a server's state that requires the password, none when it is empty, keeps a silent client timeout seconds, none when it is zero, owns an initially unfired receive wake source, holds Redis 7.0.15's defaults for the encoding parameters, and records started, the calendar time in milliseconds at which the server started.";

public fn shutdown_requested(store: &Keyspace) -> requested: Bool reads(store) waits doc "Whether SHUTDOWN or a stop signal requested that contexts drain and close, before the last client lets main stop the writer, or main has stopped it.";

public fn request_shutdown(store: &Keyspace) -> result: unit reads(store) waits doc "Requests that contexts drain and close, as SHUTDOWN and a stop signal do, recording the request and retaining the current receive wake source in one atomic statement once no rewrite is installing its manifest, then firing that source outside the statement. The caller still fires the separate shutdown source for accept, signal and expiry.";

public fn keyspace_share(store: &Keyspace) -> made: Keyspace reads(store) doc "Another context's handle to the same keyspace.";

public fn keyspace_logging(store: &Keyspace, logging: Bool) -> made: Keyspace reads(store) doc "A handle to the same keyspace and server's state that appends changes to the append-only file's pending bytes when logging is true.";

public fn expired(expires: u64, now: u64) -> reached: Bool pure doc "Whether an expiry, zero for none, has passed at now: a key lives through the millisecond its expiry names, as Redis 7.0.15's keyIsExpired keeps it.";

public fn remove_expired(store: &Keyspace, key: &[u8], now: u64) -> result: unit reads(store), reads(key) waits doc "Removes the key when its expiry has passed at now, for a command that found it expired in a statement that only read it, recording the removal as log_removal does; a key set again since keeps its value.";

public fn expire_batch(store: &Keyspace, now: u64, env: &KeyEnv, batch: &Box<Slots<Due>>) -> more: Bool reads(store), reads(env), writes(batch) waits doc "Takes up to 256 queued expiries that have passed, the earliest first, in one atomic statement, then removes each key whose expiry is still the one queued in a statement on that key, recording the removal as log_removal does, and returns whether more may be due. A queued expiry that no longer matches its key's, because the key was set, given another expiry or removed since, is dropped. The batch is scratch space the caller keeps.";

public fn queue_expiry(meta: &Meta, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(meta) doc "Queues a key's new expiry for active removal; one past the queue's ceiling is left to lazy removal.";

public fn queue_due(due: &ExpiryQueue, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(due) doc "Records new volatile eligibility and queues its expiry, as queue_expiry does, for a caller that holds expiry metadata apart from the rest of Meta. The call shares the atomic statement that creates or transfers the expiry, including when AOF is disabled.";

public fn log_removal(log: &Box<Slots<u8>>, key: &[u8], budget: &LogBudget) -> result: unit reads(key), writes(log), writes(budget) doc "Appends DEL key, as Redis 7.0.15 propagates the removal of a key whose expiry has passed, so that a replay, which counts no key as expired, removes the key where the server did and a later command finds it absent there too.";

public fn log_count(log: &Box<Slots<u8>>, count: u64, room: u64, budget: &LogBudget) -> result: unit writes(log), writes(budget) doc "Makes room for a command of about room bytes and appends the header of a RESP array of count elements.";

public fn log_append(log: &Box<Slots<u8>>, bytes: &[u8], budget: &LogBudget) -> result: unit reads(bytes), writes(log), writes(budget) doc "Appends bytes already in the file's form, such as the commands a transaction recorded, as they are.";

public fn log_word(log: &Box<Slots<u8>>, word: &[u8], budget: &LogBudget) -> result: unit reads(word), writes(log), writes(budget) doc "Appends a constant word as a RESP bulk string.";

public fn log_input(log: &Box<Slots<u8>>, input: &[u8], span: Span, budget: &LogBudget) -> result: unit reads(input), writes(log), writes(budget) doc "Appends an argument of the input as a RESP bulk string.";

public fn log_text(log: &Box<Slots<u8>>, text: &Bytes, budget: &LogBudget) -> result: unit reads(text), writes(log), writes(budget) doc "Appends a stored string as a RESP bulk string.";

public fn log_decimal(log: &Box<Slots<u8>>, value: u64, budget: &LogBudget) -> result: unit writes(log), writes(budget) doc "Appends a number as a RESP bulk string of its decimal digits.";

public fn log_command(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>, budget: &LogBudget) -> result: unit reads(input), reads(args), writes(log), writes(budget) doc "Appends a command as the client sent it, every argument a RESP bulk string.";

public fn access_settings(server: &ServerState, client: &pkg::protocol::Client) -> result: unit reads(server), writes(client) doc "Copies memory settings once per connection read, beside its clock snapshot and before any command holds keys. Every command of that read, including queued commands run by EXEC and script calls across attempts, uses this snapshot; this connection refreshes it after executing CONFIG SET. A racing CONFIG SET may cause an old-policy stamp; this is accepted because Redis itself leaves stale stamps after policy switches. CONFIG and INFO still access ServerState directly.";

public fn access_journal_new() -> journal: AccessJournal pure doc "An empty journal for one script attempt; allocation is total under Whitefoot STOR-8.";

public fn record_access(journal: &Option<AccessJournal>, key: &[u8], stamp: u32) -> result: unit reads(key), writes(journal) doc "Records the original stamp at a key's first live refresh in this attempt; later refreshes preserve that first value. None disables journaling for commands outside a script attempt.";

public fn restore_access(journal: &Option<AccessJournal>, keys: &ConcurrentHashMap<Entry>) -> result: unit reads(journal), writes(keys) doc "Restores every journaled stamp before an abandoned, unwritten script attempt releases its atomic keyspace hold. Completed attempts and attempts that wrote never call this.";

public fn copy_value(value: &Value) -> made: Value reads(value) doc "An owned logical deep copy of all five dataset value variants, shared by COPY and script undo: members, values, scores and list order are exact; collection backing is rebuilt.";

public fn attempt_undo_new() -> undo: AttemptUndo pure doc "An empty first-mutation journal for a declared-key script attempt.";

public fn attempt_save(undo: &AttemptUndo, index: u64, slot: &Option<Entry>) -> result: unit reads(slot), writes(undo) doc "Saves an optional logical entry copy once at this declared insertion index before any possible mutation: members, values, scores, list order, expiry, access and last-write stamps are exact; collection backing is rebuilt. No collection cursor or layout-dependent result is promised; revisit if such a command or guarantee is added (research/investigations/script-engines/README.md, Logical collection restore).";

public fn attempt_restore(undo: &AttemptUndo, slots: &Entries<Entry>) -> result: unit writes(undo), writes(slots) contract {
  ensures slots^.len == entry(slots)^.len;
} doc "Moves saved optional entries back into their held declared slots before access stamps are restored; consumes the journal's saved copies.";

public fn key_rank(keys: &KeySet, key: &[u8]) -> index: u64 reads(keys), reads(key) doc "Immutable binary-name lookup in insertion order; returns keys.len when absent without widening the declaration.";

public fn restore_access_entries(journal: &Option<AccessJournal>, declared: &KeySet, slots: &Entries<Entry>) -> result: unit reads(journal), reads(declared), writes(slots) contract {
  requires slots^.len == declared^.len;
  ensures slots^.len == entry(slots)^.len;
} doc "Restores original first-refresh stamps in held declared entries after payload undo, preserving original absence.";

public fn attempt_due_new() -> due: ExpiryQueue pure doc "An empty private expiry queue; its invalidation flag is unpublished until attempt acceptance.";

public fn attempt_due_commit(staged: &ExpiryQueue, target: &ExpiryQueue, env: &KeyEnv) -> result: unit reads(env), writes(staged), writes(target) doc "Publishes accepted expiry insertions and volatile eligibility into held metadata; abandonment drops the private queue instead.";

public fn sequence_stamp_key(sequence: &WriteSequence, slot: &Option<Entry>, key: &[u8]) -> result: unit reads(slot), reads(key), writes(sequence), writes(slot.Some.value.last_write) doc "Takes the shared statement sequence, stamps a changed surviving entry and captures it: a complete replacement image, or effect mode for an anchored one-key statement. A missing changed slot records a tombstone.";

public fn sequence_delete_key(sequence: &WriteSequence, slot: &Option<Entry>, key: &[u8]) -> result: unit reads(key), writes(sequence), writes(slot) doc "Removes a present key and records its tombstone through the same sequence token. An absent key changes neither sequence nor capture.";

public fn sequence_stamp_at(sequence: &WriteSequence, slot: &Option<Entry>, keys: &KeySet, index: u64) -> result: unit reads(slot), reads(keys), writes(sequence), writes(slot.Some.value.last_write) doc "The key-set-index form of sequence_stamp_key. Capture charges an owned key copy before reading the complete name; an inactive capture allocates nothing.";

public fn sequence_delete_at(sequence: &WriteSequence, slot: &Option<Entry>, keys: &KeySet, index: u64) -> result: unit reads(keys), writes(sequence), writes(slot) doc "The key-set-index form of sequence_delete_key, sharing the actual-removal test and bounded tombstone capture.";

public fn rewrite_capture_new() -> capture: RewriteCapture pure doc "An inactive empty capture with no journal allocation; construct only after any previous worker and bounded cleanup have completed.";

public fn rewrite_abort(capture: &RewriteCapture, reason: RewriteAbortReason) -> result: unit writes(capture) doc "For a running attempt, disables capture and latches the first failure reason, reserve use and peak under Meta before any cleanup. Later failures and ordinary writer activity outside an attempt preserve that snapshot; staging ownership remains until bounded sole-writer cleanup.";

public fn rewrite_charge(capture: &RewriteCapture, bytes: u64) -> accepted: Bool writes(capture) doc "Reserves bytes before allocation, or logically aborts this attempt without allocating when they exceed the remaining allowance. Includes peak reservation accounting.";

public fn rewrite_try_charge(capture: &RewriteCapture, bytes: u64) -> accepted: Bool writes(capture) doc "Reserves bytes before allocation when they fit the remaining allowance of a live attempt, with peak reservation accounting, and otherwise changes nothing, leaving the caller to retry smaller work or abort.";

public fn sequence_capture(sequence: &WriteSequence, key: &[u8], slot: &Option<Entry>) -> result: unit reads(key), reads(slot), writes(sequence) doc "Coalesces an actual changed key into the already-taken outer sequence: in an anchored one-key statement it only selects effect mode; otherwise it owns complete replacement bytes, charging scratch and allocation overlap; failure aborts capture at commit, never the client command.";

public fn sequence_capture_at(sequence: &WriteSequence, keys: &KeySet, index: u64, slot: &Option<Entry>) -> result: unit reads(keys), reads(slot), writes(sequence) doc "Captures the changed slot under its key-set index after charging the temporary key copy. Used when mutation helpers already stamped an entry through a matched payload.";

public fn rewrite_measure(slot: &Option<Entry>, key_length: u64) -> measured: RewriteMeasure reads(slot) doc "Allocation-free upper bound for complete replacement bytes including RESP framing and encoder lookahead, visiting every payload element; the caller charges the bound against the rewrite reserve before copying.";

public fn rewrite_image(slot: &Option<Entry>, key: &[u8], capacity: u64, replacement: Bool, database: u64) -> output: Box<Slots<u8>> reads(slot), reads(key) doc "Serializes the complete held image using Redis command-format reconstruction and absolute expiry. The caller must first charge rewrite_measure bytes plus temporary key and formatting storage; replacement prepends SELECT database and DEL.";

public struct LogBudget {
  doc "A statement-local allowance for collecting-buffer growth while the sole writer rotates. Charge full new backing capacity before grow, preserving overlap; failed disables only rewrite accounting, never the ordinary append. sequence_commit publishes this local failure and the last emitted database under the same Meta hold. database is the next effect's context; selected is the last emitted database, with 16 invalid. first records the first private effect database; selecting enables lazy SELECT and defer_first reserves the first private selection for outer MULTI framing.";
  public database: u64;
  public selected: u64;
  public first: u64;
  public selecting: Bool;
  public defer_first: Bool;
  public enabled: Bool;
  public allowance: u64;
  public charged: u64;
  public failed: Bool;
}

public fn log_budget_new() -> budget: LogBudget pure doc "An unmetered ordinary encoder budget for buffers that are not stalled by rotation.";

public fn log_append_plain(log: &Box<Slots<u8>>, bytes: &[u8]) -> result: unit reads(bytes), writes(log) doc "Appends bytes in a private non-command builder, with no rotation-related collecting-buffer budget.";

public fn log_budget_begin(meta: &Meta, loading: Bool) -> budget: LogBudget reads(meta.database), reads(meta.aof_database), reads(meta.rewrite) doc "Snapshots database selection and remaining R under the statement's Meta hold, charging R only while the writer rotates; service encoders charge collecting-buffer growth before allocation, and sequence_commit publishes overflow without failing the command.";

public fn database_context(meta: &Meta, database: u64) -> result: unit writes(meta.database), writes(meta.due.database) contract {
  requires database < 16_u64;
} doc "Sets the database used by sequence, expiry and AOF builders under the existing Meta hold; it never runs on the no-Meta keyed path.";

public fn keyspace_select(store: &Keyspace, database: u64) -> result: unit reads(store.databases), writes(store.keys), writes(store.database) contract {
  requires database < 16_u64;
} doc "Changes this context's cached map and logical database without taking shared state.";

public fn keyspace_database(store: &Keyspace, database: u64) -> made: Keyspace reads(store) contract {
  requires database < 16_u64;
} doc "Shares server handles and selects the requested permanent database for administrative or background work.";

public fn clear_database_expiry(due: &ExpiryQueue, database: u64) -> result: unit writes(due) doc "Drops queued expiry records only for the flushed database, retaining every other database's records.";

public fn swap_database_metadata(meta: &Meta, left_db: u64, right_db: u64) -> result: unit writes(meta) doc "Drops queued records for both swapped databases and invalidates global eviction candidates and absence searches; queue_map_expiry repopulates the two swapped maps before the hold ends.";

public fn effect_budget_begin(sequence: &WriteSequence) -> budget: LogBudget reads(sequence.database), reads(sequence.effects_first_db), reads(sequence.effects_selected) doc "Starts one private effect encoder from its execution unit's database and prior effect selection; the first SELECT is deferred until outer framing.";

public fn effect_budget_commit(sequence: &WriteSequence, budget: &LogBudget) -> result: unit reads(budget.first), reads(budget.selected), writes(sequence.effects_first_db), writes(sequence.effects_selected) doc "Publishes the private effect stream's first and last emitted databases after a held command, including an error after effects.";

public fn record_effects(log: &Box<Slots<u8>>, effects: &Box<Slots<u8>>, appended: u64, sequence: &WriteSequence, budget: &LogBudget) -> result: unit reads(effects), reads(sequence.effects_first_db), reads(sequence.effects_selected), writes(log), writes(budget) doc "Writes optional MULTI without selection, selects the first effect database, appends the private stream and its internal selections, then writes EXEC without changing the last effect database. A selection without effects writes nothing.";

public fn log_append_raw(log: &Box<Slots<u8>>, bytes: &[u8], budget: &LogBudget) -> result: unit reads(bytes), writes(log), writes(budget) doc "Appends already framed bytes while charging growth, without adding database selection; record_effects owns that stream's first and last database context.";

public fn log_select(log: &Box<Slots<u8>>, budget: &LogBudget) -> result: unit writes(log), writes(budget) doc "Emits SELECT lazily for the encoder's database, except a private stream's first selection which outer framing emits; unselected byte builders do nothing.";

public fn expiry_context(due: &ExpiryQueue, database: u64) -> result: unit writes(due.database) contract {
  requires database < 16_u64;
} doc "Selects the database tagged on later expiry insertions under the caller's hold.";

public fn queue_map_expiry(keys: &ConcurrentHashMap<Entry>, due: &ExpiryQueue, database: u64, env: &KeyEnv) -> result: unit reads(keys), reads(env), writes(due) contract {
  requires database < 16_u64;
} doc "Requeues every expiring entry of a swapped map, including records an expiry worker had already removed from the pending queue before the swap.";

public fn access_journal_select(journal: &Option<AccessJournal>, database: u64) -> result: unit writes(journal) contract {
  requires database < 16_u64;
} doc "Selects the database for subsequent first-refresh undo records within a script attempt.";

public fn restore_access_database(journal: &Option<AccessJournal>, keys: &ConcurrentHashMap<Entry>, database: u64) -> result: unit reads(journal), writes(keys) doc "Restores only this database's original access stamps on an abandoned whole-database script attempt.";

public fn sequence_database(sequence: &WriteSequence, database: u64) -> result: unit writes(sequence.database) contract {
  requires database < 16_u64;
} doc "Selects the database identity for subsequent captures within an outer execution unit; it changes neither the global sequence nor the already encoded effect selection.";

public fn meta_client_seed(meta: &Meta) -> seed: u64 writes(meta.random) doc "Takes the client random seed and advances the shared generator under its existing hold.";

public fn meta_client_opened(meta: &Meta) -> result: unit writes(meta.clients) doc "Counts an accepted client.";

public fn meta_client_closed(meta: &Meta) -> result: unit writes(meta.clients) doc "Counts a closed client.";

public fn meta_stop(meta: &Meta) -> result: unit writes(meta.stopping) doc "Stops the writer after clients have drained.";

public fn aof_rewrite_thresholds(meta: &Meta, percentage: u64, minimum: u64) -> result: unit writes(meta.aof_rewrite_percentage), writes(meta.aof_rewrite_min_size) doc "Initializes the automatic rewrite thresholds.";

public fn meta_rewrite_abort(meta: &Meta, reason: RewriteAbortReason) -> result: unit writes(meta.rewrite) doc "The held metadata form of rewrite_abort, preserving its capture accounting.";

public fn meta_rewrite_charge(meta: &Meta, bytes: u64) -> result: Bool writes(meta.rewrite) doc "The held metadata form of rewrite_charge, preserving its capture accounting.";

public fn meta_rewrite_try_charge(meta: &Meta, bytes: u64) -> result: Bool writes(meta.rewrite) doc "The held metadata form of rewrite_try_charge, preserving its capture accounting.";

public fn meta_rewrite_refund(meta: &Meta, bytes: u64) -> result: unit writes(meta.rewrite.used) doc "Releases a completed allocation charge without changing the retained peak.";

public fn aof_pending_capacity(meta: &Meta, capacity: u64) -> result: unit writes(meta.aof_pending_capacity) doc "Publishes the newly allocated writer buffer capacity.";

public fn aof_pending(meta: &Meta, capacity: u64, length: u64) -> result: unit writes(meta.aof_pending_capacity), writes(meta.aof_pending_length) doc "Publishes the retained buffer capacity and length after its update.";

public fn aof_loaded_sizes(meta: &Meta, current: u64, incremental: u64, base: u64) -> result: unit writes(meta.aof_current_size), writes(meta.aof_incr_size), writes(meta.aof_synced_size), writes(meta.aof_base_size) doc "Publishes the authoritative startup sizes after replay.";

public fn aof_rewrite_cancel_request(meta: &Meta) -> result: unit writes(meta.aof_rewrite_requested), writes(meta.aof_rewrite_in_progress), writes(meta.aof_rewrite_reply) doc "Cancels and refuses a pending manual rewrite during shutdown.";

public fn aof_rewrite_take_request(meta: &Meta) -> requested: Bool writes(meta.aof_rewrite_requested) doc "Consumes the manual rewrite request under the writer hold.";

public fn aof_rewrite_started(meta: &Meta) -> result: unit writes(meta.aof_rewrite_in_progress) doc "Publishes the writer decision to start an attempt.";

public fn aof_rewrite_restore_block(meta: &Meta, blocked: Bool) -> result: unit writes(meta.aof_rewrite_retry_blocked) doc "Restores the previous automatic-rewrite block after successful recovery.";

public fn aof_rewrite_cleanup_failed(meta: &Meta) -> result: unit writes(meta.rewrite) doc "Counts and aborts a failed journal cleanup step only during a running attempt.";

public fn aof_rewrite_journal_removed(meta: &Meta, removed: Bool) -> result: unit writes(meta.aof_rewrite_journal_leftover), writes(meta.rewrite) doc "Publishes the cleanup observation and records a failed attempt cleanup.";

public fn aof_rewrite_journal_take(meta: &Meta) -> block: Option<Box<Slots<u8>>> writes(meta.rewrite.journal) doc "Dequeues one staged chunk; its charge stays live until release.";

public fn aof_rewrite_journal_appended(meta: &Meta, appended: u64, images: u64, effects: u64, complete: Bool) -> result: unit writes(meta.rewrite) doc "Counts the successful journal prefix and refuses an incomplete append.";

public fn aof_rewrite_scan_step(meta: &Meta, observed: u64) -> result: unit writes(meta.rewrite.scan_steps), writes(meta.rewrite.scan_peak) doc "Records a completed scan step and its observed heap increase.";

public fn aof_truncated(meta: &Meta, removed: u64, reverted: u64) -> result: unit writes(meta.aof_current_size), writes(meta.aof_incr_size), writes(meta.aof_synced_size) doc "Publishes successful truncation of an unfinished block.";

public fn aof_sync_failed(meta: &Meta, error: std::io::IoError) -> result: unit writes(meta.aof_sync_error) doc "Latches a counted active-file sync failure without clearing prior append state.";

public fn aof_synced(meta: &Meta, written: u64) -> result: unit writes(meta.aof_synced_size) doc "Records the incremental offset covered by this sync, preserving the saved sync error.";

public fn aof_rotated(meta: &Meta) -> result: unit writes(meta.aof_incr_size), writes(meta.aof_synced_size) doc "Resets incremental offsets after published handle rotation.";

public fn aof_rewrite_complete(meta: &Meta, accepted: Bool, manual: Bool, started: Bool) -> result: unit reads(meta.rewrite.scan_peak), reads(meta.rewrite.cut), writes(meta.aof_sync_error), writes(meta.aof_rewrite_in_progress), writes(meta.aof_rewrite_ok), writes(meta.aof_rewrite_retry_blocked), writes(meta.aof_rewrite_scan_peak), writes(meta.aof_rewrite_cut), writes(meta.rewrite.used), writes(meta.rewrite.running), writes(meta.rewrite.active), writes(meta.rewrite.aborted), writes(meta.rewrite.rotating), writes(meta.aof_rewrite_reply) doc "Ends an attempt after worker and journal cleanup; only durable acceptance clears saved sync failure.";

public fn aof_take_collecting(meta: &Meta, pending: &Box<Slots<u8>>, force: Bool) -> result: unit writes(meta.log), writes(meta.aof_pending_capacity), writes(meta.aof_pending_length), writes(pending) doc "Exchanges collecting bytes only once retained bytes drain, or combines both for forced shutdown.";

public fn aof_base_installed(meta: &Meta, size: u64, closed_size: u64) -> result: unit writes(meta.aof_current_size), writes(meta.aof_base_size) doc "Publishes the installed base size while preserving post-cut incremental bytes.";

public fn aof_rewrite_reset(meta: &Meta) -> result: unit writes(meta.rewrite) doc "Starts admission with a fresh inactive capture after prior cleanup.";

public fn aof_rewrite_admitted(meta: &Meta, reserve: u64, fixed: u64, capacity: u64, manual: Bool) -> result: unit reads(meta.commit_seq), writes(meta.rewrite.limit), writes(meta.rewrite.fixed), writes(meta.rewrite.used), writes(meta.rewrite.peak), writes(meta.aof_rewrite_reserve), writes(meta.aof_rewrite_scan_peak), writes(meta.aof_rewrite_cut), writes(meta.rewrite.journal), writes(meta.rewrite.start), writes(meta.rewrite.active), writes(meta.aof_worker_done), writes(meta.aof_rewrites), writes(meta.aof_rewrite_retry_blocked), writes(meta.aof_rewrite_reply) doc "Publishes reserve and allocates the charged journal directory only after admission.";

public fn aof_rewrite_scan_done(meta: &Meta) -> result: unit writes(meta.rewrite.scan_done) doc "Hands completed dataset scanning to the sole writer for the cut.";

public fn aof_rewrite_worker_done(meta: &Meta) -> result: unit writes(meta.aof_worker_done) doc "Publishes worker completion after its file owners close.";

public fn aof_rewrite_cut(meta: &Meta, pending: &Box<Slots<u8>>) -> cut: Bool reads(meta.rewrite.scan_done), reads(meta.commit_seq), writes(meta.rewrite.end), writes(meta.rewrite.cut), writes(meta.rewrite.active), writes(meta.rewrite.rotating), writes(meta.log), writes(meta.aof_database), writes(meta.aof_pending_capacity), writes(meta.aof_pending_length), writes(pending) doc "Freezes capture and seals collecting bytes through S1 in the existing metadata hold.";

public fn aof_rewrite_cut_done(meta: &Meta, switched: Bool) -> result: unit writes(meta.rewrite) doc "Publishes the rotation outcome and aborts a failed switch before worker wakeup.";

public fn aof_installing(meta: &Meta, installing: u64) -> result: unit writes(meta.aof_installing) doc "Publishes installation exclusion under the existing shutdown-and-metadata hold.";

public fn aof_rewrite_journal_detach(meta: &Meta) -> journal: Option<Box<Ring<Box<Slots<u8>>>>> writes(meta.rewrite.journal) doc "Detaches staged owners for bounded release outside metadata holds.";

public fn aof_append_result(meta: &Meta, progress: u64, drained: Bool, error: Option<std::io::IoError>, partial: Bool) -> result: unit writes(meta.rewrite), writes(meta.aof_current_size), writes(meta.aof_incr_size), writes(meta.aof_append_error), writes(meta.aof_append_partial) doc "Records append outcome and the acknowledged file prefix before retained-buffer updates.";

public fn memory_peak_record(meta: &Meta, used: u64) -> peak: u64 writes(meta.memory_peak) doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

public fn eviction_candidate_new(key: Box<Array<u8>>, score: u64, database: u64) -> candidate: EvictionCandidate pure contract {
  requires database < 16_u64;
} doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

public fn eviction_search_stop(meta: &Meta) -> result: unit writes(meta.eviction_searching) doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

public fn eviction_search_begin(meta: &Meta, start: u64) -> result: unit writes(meta.eviction_cursor), writes(meta.eviction_start), writes(meta.eviction_searching), writes(meta.eviction_wrapped) doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

