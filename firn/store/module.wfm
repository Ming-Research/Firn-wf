  requires database < 16_u64;
} doc "Applies this metadata transition inside its declaring module under the caller's existing atomic hold.";

public fn eviction_search_save(meta: &Meta, database: u64, exhausted: Bool) -> result: unit reads(meta.eviction_cursor), reads(meta.eviction_start), reads(meta.eviction_searching), reads(meta.eviction_wrapped), writes(meta.eviction_cursors), writes(meta.eviction_starts), writes(meta.eviction_searches), writes(meta.eviction_wraps), writes(meta.eviction_exhausted) contract {
  requires database < 16_u64;
