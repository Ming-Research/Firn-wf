alias Bytes = pkg::bytes::Bytes;
alias Key = pkg::bytes::Key;
alias aof_map_each = std::collections::hash_map::hash_map_each;
alias aof_map_len = std::collections::hash_map::hash_map_len;
alias ordered_map_each = std::collections::ordered_map::ordered_map_each;

const rewrite_set: Array<u8, 3> = "SET";

const rewrite_rpush: Array<u8, 5> = "RPUSH";

const rewrite_sadd: Array<u8, 4> = "SADD";

const rewrite_zadd: Array<u8, 4> = "ZADD";

const rewrite_hmset: Array<u8, 5> = "HMSET";

const rewrite_expire: Array<u8, 9> = "PEXPIREAT";

const rewrite_select: Array<u8, 6> = "SELECT";

const rewrite_xadd: Array<u8, 4> = "XADD";

const rewrite_xsetid: Array<u8, 6> = "XSETID";

const rewrite_maxlen: Array<u8, 6> = "MAXLEN";

const rewrite_entries_added: Array<u8, 12> = "ENTRIESADDED";

const rewrite_max_deleted: Array<u8, 12> = "MAXDELETEDID";

const rewrite_empty_stream: Array<u8, 6> = "00-1xy";

struct StreamMeasure {
  bytes: u64;
  key_room: u64;
}

struct RewriteEmitter {
  key: Bytes;
  output: Box<Slots<u8>>;
  remaining: u64;
  batch: u64;
  budget: LogBudget;
}

fn rewrite_header(emitter: &RewriteEmitter, word: &[u8], width: u64) -> result: unit reads(word), writes(emitter) {
  if emitter^.batch == 0_u64 {
    let items = imin(emitter^.remaining, 64_u64);
    let arguments = items *wrap width;
    let count = arguments +wrap 2_u64;
    log_count(log: &emitter^.output, count: count, room: 256_u64, budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: word, budget: &emitter^.budget);
    log_text(log: &emitter^.output, text: &emitter^.key, budget: &emitter^.budget);
    set emitter^.batch = items;
  }
  set emitter^.batch = emitter^.batch -wrap 1_u64;
  set emitter^.remaining = emitter^.remaining -wrap 1_u64;
  return unit;
}

fn rewrite_member(env: &RewriteEmitter, key: &Key, value: &unit) -> result: unit reads(key.bytes), writes(env) {
  rewrite_header(emitter: env, word: &rewrite_sadd[0_u64..4_u64], width: 1_u64);
  log_text(log: &env^.output, text: &key^.bytes, budget: &env^.budget);
  return unit;
}

fn rewrite_field(env: &RewriteEmitter, key: &Key, value: &Bytes) -> result: unit reads(key.bytes), reads(value), writes(env) {
  rewrite_header(emitter: env, word: &rewrite_hmset[0_u64..5_u64], width: 2_u64);
  log_text(log: &env^.output, text: &key^.bytes, budget: &env^.budget);
  log_text(log: &env^.output, text: value, budget: &env^.budget);
  return unit;
}

fn rewrite_score(env: &RewriteEmitter, key: &Key, value: &f64) -> result: unit reads(key.bytes), reads(value), writes(env) {
  rewrite_header(emitter: env, word: &rewrite_zadd[0_u64..4_u64], width: 2_u64);
  let digits = pkg::scores::score_bytes(score: value^);
  log_text(log: &env^.output, text: &digits, budget: &env^.budget);
  log_text(log: &env^.output, text: &key^.bytes, budget: &env^.budget);
  return unit;
}

fn rewrite_stream_node(env: &RewriteEmitter, key: &StreamId, value: &StreamNode) -> result: unit reads(value), writes(env) {
  doc "Writes one XADD key id field value ... for each live entry of a stream node, in ID order, as Redis 7.2.16's rewriteStreamObject does.";
  for @items (index in 0_u64..value^.items.inner.len) {
    let item = &value^.items.inner[index];
    if bnot(item^.deleted) {
      let pairs = item^.pairs.inner.len;
      let count = pairs +wrap 3_u64;
      log_count(log: &env^.output, count: count, room: 256_u64, budget: &env^.budget);
      log_word(log: &env^.output, word: &rewrite_xadd[0_u64..4_u64], budget: &env^.budget);
      log_text(log: &env^.output, text: &env^.key, budget: &env^.budget);
      let spelled = stream_id_text(id: item^.id);
      log_text(log: &env^.output, text: &spelled, budget: &env^.budget);
      for @pairs (at in 0_u64..pairs) {
        log_text(log: &env^.output, text: &item^.pairs.inner[at], budget: &env^.budget);
      }
    }
  }
  return unit;
}

fn rewrite_stream(stream: &StreamLog, emitter: &RewriteEmitter) -> result: unit reads(stream), writes(emitter) {
  doc "Writes a stream as Redis 7.2.16's rewriteStreamObject does: one XADD per live entry, or XADD key MAXLEN 0 0-1 x y for a stream with none, then XSETID key last-id ENTRIESADDED n MAXDELETEDID id, which a replay needs to restore what the entries alone do not.";
  if stream^.length == 0_u64 {
    log_count(log: &emitter^.output, count: 7_u64, room: 256_u64, budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_xadd[0_u64..4_u64], budget: &emitter^.budget);
    log_text(log: &emitter^.output, text: &emitter^.key, budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_maxlen[0_u64..6_u64], budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_empty_stream[0_u64..1_u64], budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_empty_stream[1_u64..4_u64], budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_empty_stream[4_u64..5_u64], budget: &emitter^.budget);
    log_word(log: &emitter^.output, word: &rewrite_empty_stream[5_u64..6_u64], budget: &emitter^.budget);
  } else {
    ordered_map_each::<StreamId, StreamNode, RewriteEmitter, fn rewrite_stream_node, ceiling>(map: &stream^.nodes, env: emitter);
  }
  log_count(log: &emitter^.output, count: 7_u64, room: 256_u64, budget: &emitter^.budget);
  log_word(log: &emitter^.output, word: &rewrite_xsetid[0_u64..6_u64], budget: &emitter^.budget);
  log_text(log: &emitter^.output, text: &emitter^.key, budget: &emitter^.budget);
  let last = stream_id_text(id: stream^.last_id);
  log_text(log: &emitter^.output, text: &last, budget: &emitter^.budget);
  log_word(log: &emitter^.output, word: &rewrite_entries_added[0_u64..12_u64], budget: &emitter^.budget);
  log_decimal(log: &emitter^.output, value: stream^.entries_added, budget: &emitter^.budget);
  log_word(log: &emitter^.output, word: &rewrite_max_deleted[0_u64..12_u64], budget: &emitter^.budget);
  let deleted = stream_id_text(id: stream^.max_deleted_id);
  log_text(log: &emitter^.output, text: &deleted, budget: &emitter^.budget);
  return unit;
}

fn rewrite_entry(slot: &Option<Entry>, emitter: &RewriteEmitter) -> result: unit reads(slot), writes(emitter) {
  doc "Redis rewriteAppendOnlyFileRio: retain even elapsed expiries, emit at most 64 collection elements per command, and follow each expiring value with its absolute PEXPIREAT. Script caches have no AOF records and firn implements no persisted functions.";
  match slot^ {
    Some(value: held_value) => {
      match held_value^.value {
        Text(bytes: stored) => {
          log_count(log: &emitter^.output, count: 3_u64, room: 256_u64, budget: &emitter^.budget);
          log_word(log: &emitter^.output, word: &rewrite_set[0_u64..3_u64], budget: &emitter^.budget);
          log_text(log: &emitter^.output, text: &emitter^.key, budget: &emitter^.budget);
          log_text(log: &emitter^.output, text: stored, budget: &emitter^.budget);
        }
        Items(items: listed) => {
          set emitter^.remaining = listed^.inner.len;
          for (index in 0_u64..listed^.inner.len) {
            rewrite_header(emitter: emitter, word: &rewrite_rpush[0_u64..5_u64], width: 1_u64);
            let element = &listed^.inner[index];
            let length = element^.inner.len;
            log_word(log: &emitter^.output, word: &element^.inner[0_u64..length], budget: &emitter^.budget);
          }
        }
        Members(members: stored_members) => {
          set emitter^.remaining = aof_map_len::<Key, unit, ceiling>(map: stored_members);
          aof_map_each::<Key, unit, RewriteEmitter, fn rewrite_member, ceiling>(map: stored_members, env: emitter);
        }
        Fields(fields: stored_fields) => {
          set emitter^.remaining = aof_map_len::<Key, Bytes, ceiling>(map: stored_fields);
          aof_map_each::<Key, Bytes, RewriteEmitter, fn rewrite_field, ceiling>(map: stored_fields, env: emitter);
        }
        Ranked(ranked: stored_ranked) => {
          set emitter^.remaining = aof_map_len::<Key, f64, ceiling>(map: &stored_ranked^.scores);
          aof_map_each::<Key, f64, RewriteEmitter, fn rewrite_score, ceiling>(map: &stored_ranked^.scores, env: emitter);
        }
        Stream(stream: stored_stream) => {
          rewrite_stream(stream: &stored_stream^.inner, emitter: emitter);
        }
      }
      if held_value^.expires != 0_u64 {
        log_count(log: &emitter^.output, count: 3_u64, room: 128_u64, budget: &emitter^.budget);
        log_word(log: &emitter^.output, word: &rewrite_expire[0_u64..9_u64], budget: &emitter^.budget);
        log_text(log: &emitter^.output, text: &emitter^.key, budget: &emitter^.budget);
        log_decimal(log: &emitter^.output, value: held_value^.expires, budget: &emitter^.budget);
      }
    }
    None() => {
    }
  }
  return unit;
}

fn rewrite_measure_member(env: &RewriteMeasure, key: &Key, value: &unit) -> result: unit reads(key.bytes), writes(env) {
  let length = pkg::bytes::bytes_length(bytes: &key^.bytes);
  let room = length +sat 32_u64;
  set env^.bytes = env^.bytes +sat room;
  return unit;
}

fn rewrite_measure_field(env: &RewriteMeasure, key: &Key, value: &Bytes) -> result: unit reads(key.bytes), reads(value), writes(env) {
  let length = pkg::bytes::bytes_length(bytes: &key^.bytes);
  let payload = pkg::bytes::bytes_length(bytes: value);
  let room = length +sat payload;
  let framed = room +sat 64_u64;
  set env^.bytes = env^.bytes +sat framed;
  return unit;
}

fn rewrite_measure_score(env: &RewriteMeasure, key: &Key, value: &f64) -> result: unit reads(key.bytes), writes(env) {
  let length = pkg::bytes::bytes_length(bytes: &key^.bytes);
  let room = length +sat 128_u64;
  set env^.bytes = env^.bytes +sat room;
  return unit;
}

fn rewrite_measure_stream(env: &StreamMeasure, key: &StreamId, value: &StreamNode) -> result: unit reads(value), writes(env) {
  doc "Adds the bytes one stream node's XADD commands can take: per live entry, a header with the key and ID, and each field and value with its framing.";
  for @items (index in 0_u64..value^.items.inner.len) {
    let item = &value^.items.inner[index];
    if bnot(item^.deleted) {
      set env^.bytes = env^.bytes +sat env^.key_room;
      for @pairs (at in 0_u64..item^.pairs.inner.len) {
        let length = pkg::bytes::bytes_length(bytes: &item^.pairs.inner[at]);
        let framed = length +sat 32_u64;
        set env^.bytes = env^.bytes +sat framed;
      }
    }
  }
  return unit;
}

fn rewrite_measure(slot: &Option<Entry>, key_length: u64) -> measured: RewriteMeasure reads(slot) {
  doc "Allocation-free upper bound before copying a complete image, visiting every payload element; the caller charges it against the rewrite reserve. RESP bulk overhead, 64-element command headers, DEL, expiry and the encoder's reserve lookahead are included; saturating arithmetic cannot admit an oversized image.";
  let measured = RewriteMeasure(bytes: 512_u64, elements: 1_u64);
  let commands = 3_u64;
  match slot^ {
    Some(value: held_value) => {
      match held_value^.value {
        Text(bytes: stored) => {
          let length = pkg::bytes::bytes_length(bytes: stored);
          set measured.bytes = measured.bytes +sat length;
        }
        Items(items: listed) => {
          set measured.elements = listed^.inner.len;
          for (index in 0_u64..listed^.inner.len) {
            let length = listed^.inner[index].inner.len;
            let framed = length +sat 32_u64;
            set measured.bytes = measured.bytes +sat framed;
          }
        }
        Members(members: stored_members) => {
          set measured.elements = aof_map_len::<Key, unit, ceiling>(map: stored_members);
          aof_map_each::<Key, unit, RewriteMeasure, fn rewrite_measure_member, ceiling>(map: stored_members, env: &measured);
        }
        Fields(fields: stored_fields) => {
          set measured.elements = aof_map_len::<Key, Bytes, ceiling>(map: stored_fields);
          aof_map_each::<Key, Bytes, RewriteMeasure, fn rewrite_measure_field, ceiling>(map: stored_fields, env: &measured);
        }
        Ranked(ranked: stored_ranked) => {
          set measured.elements = aof_map_len::<Key, f64, ceiling>(map: &stored_ranked^.scores);
          aof_map_each::<Key, f64, RewriteMeasure, fn rewrite_measure_score, ceiling>(map: &stored_ranked^.scores, env: &measured);
        }
        Stream(stream: stored_stream) => {
          let key_room = key_length +sat 128_u64;
          let stream_measure = StreamMeasure(bytes: 0_u64, key_room: key_room);
          ordered_map_each::<StreamId, StreamNode, StreamMeasure, fn rewrite_measure_stream, ceiling>(map: &stored_stream^.inner.nodes, env: &stream_measure);
          let closing = key_room *sat 2_u64;
          set measured.bytes = measured.bytes +sat stream_measure.bytes;
          set measured.bytes = measured.bytes +sat closing;
        }
      }
    }
    None() => {
    }
  }
  let rounded = measured.elements +sat 63_u64;
  let batches = rounded / 64_u64;
  set commands = commands +sat batches;
  let key_room = key_length +sat 128_u64;
  let headers = commands *sat key_room;
  set measured.bytes = measured.bytes +sat headers;
  let payloads = imax(measured.elements, 1_u64);
  set measured.elements = payloads *sat 2_u64;
  return measured;
}

fn rewrite_image(slot: &Option<Entry>, key: &[u8], capacity: u64, replacement: Bool) -> output: Box<Slots<u8>> reads(slot), reads(key) {
  doc "The caller charged the measured capacity, the temporary key copy and score formatting before entry. Scan and journal use the same Redis reconstruction, retaining physical expiry metadata. Replacements clear the previous type, contents and TTL first.";
  let length = key^.len;
  let copied = pkg::bytes::bytes_new(input: key, start: 0_u64, length: length);
  let buffer = box_slots_new::<u8>(capacity: capacity);
  let budget = log_budget_new();
  let emitter = RewriteEmitter(key: move copied, output: move buffer, remaining: 0_u64, batch: 0_u64, budget: budget);
  if replacement {
    log_removal(log: &emitter.output, key: key, budget: &emitter.budget);
  }
  rewrite_entry(slot: slot, emitter: &emitter);
  let RewriteEmitter(key: released_key, output: result_bytes, remaining: unused_remaining, batch: unused_batch, budget: unused_budget) = move emitter;
  return move result_bytes;
}
