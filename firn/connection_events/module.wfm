alias CancelWatch = std::time::CancelWatch;
alias CancelSource = std::time::CancelSource;
alias Instant = std::time::Instant;
alias Clock = std::time::Clock;
alias WallClock = std::time::WallClock;
alias Client = pkg::protocol::Client;
alias Span = pkg::protocol::Span;
alias Key = pkg::bytes::Key;
alias HashMap = std::collections::hash_map::HashMap;
alias PriorityQueue = std::collections::priority_queue::PriorityQueue;

public const extent: u64 = 18446744073709551615_u64;

public struct Frame {
  doc "Two immutable wire segments and the sum of their reserved byte capacities. Each recipient is charged the complete shared body capacity until its frame is released. Allocator block overhead, reference-control storage and queue entries are not included, so this is not Redis allocator accounting.";
  public prefix: Frozen<Box<Slots<u8>>>;
  public body: Frozen<Box<Slots<u8>>>;
  public charge: u64;
}

public struct InputQueue {
  public chunks: Box<Ring<Box<Slots<u8>>>>;
  public bytes: u64;
  public ended: Bool;
}

public struct OutputQueue {
  public frames: Box<Ring<Frame>>;
  public closed: Bool;
}

public struct ReceiveState {
  public subscribed: Bool;
  public activity: Option<Instant>;
  public wake: CancelSource;
}

public struct ReceiveSnapshot {
  public subscribed: Bool;
  public activity: Option<Instant>;
  public cancel: CancelWatch;
}

public struct Connection {
  public id: u64;
  public input: Shared<InputQueue>;
  public output: Shared<OutputQueue>;
  public receive_state: Shared<ReceiveState>;
  public stop: CancelSource;
}

public struct Counts {
  public sub: u64;
  public psub: u64;
  public ssub: u64;
}

public struct RegistryCounts {
  public channels: u64;
  public patterns: u64;
  public shards: u64;
}

public struct BlockedList {
  doc "One suspended original list command. The registration generation is never reused within fewer than 2^64 waits per process. deadline is absolute Unix milliseconds, zero for forever. Names are distinct while args preserve original order and duplicates. The command owner retains its Client; this record owns only request identity, protocol and scalar execution continuation. Database identity is implicitly zero in the single-keyspace server.";
  public generation: u64;
  public deadline: u64;
  public kind: u64;
  public input: Box<Slots<u8>>;
  public args: Box<Slots<Span>>;
  public connection: u64;
  public resp: u64;
  public random: u64;
  public seen_peak: u64;
  public names: Box<Slots<Key>>;
}

public struct BlockingCounts {
  public clients: u64;
  public keys: u64;
  public timed: u64;
}

public struct BlockingState {
  doc "Host-free registration projection, updated in the same hub hold as the owned requests, FIFO memberships and indexed deadline heap. The id map records each live registration generation; the counts describe its distinct source keys and finite deadlines.";
  ids: HashMap<u64, u64, extent>;
  keys: u64;
  timed: u64;
}

public struct BlockResume {
  doc "One completed wait's scalar continuation, committed with its reply and taken exactly once by its suspended command owner before another command. No session object or host handle crosses this completion slot.";
  public generation: u64;
  public random: u64;
  public seen_peak: u64;
}

public struct Record {
  client_id: u64;
  connection: Connection;
  resp: u64;
  channels: Box<Slots<Key>>;
  patterns: Box<Slots<Key>>;
  shards: Box<Slots<Key>>;
  pending: u64;
  soft: Option<u64>;
  resume: Option<BlockResume>;
}

public struct Delivery {
  id: u64;
  frame: Frame;
}

public enum Action {
  Send(connection: Connection, frame: Frame);
  Close(connection: Connection);
  Finish(connection: Connection);
  Membership(connection: Connection, subscribed: Bool);
  Fire(source: CancelSource);
}

public struct Deadline {
  id: u64;
  started: u64;
  due: u64;
}

public struct BlockDeadline {
  id: u64;
  generation: u64;
  due: u64;
}

public struct Stage {
  publications: Box<Ring<Delivery>>;
}

public struct Hub {
  records: HashMap<u64, Record, extent>;
  clients: HashMap<u64, u64, extent>;
  channels: HashMap<Key, Box<Slots<u64>>, extent>;
  patterns: HashMap<Key, Box<Slots<u64>>, extent>;
  shards: HashMap<Key, Box<Slots<u64>>, extent>;
  blocked: HashMap<u64, BlockedList, extent>;
  public readonly blocking_state: BlockingState;
  waiting: HashMap<Key, Box<Slots<u64>>, extent>;
  block_deadlines: PriorityQueue<BlockDeadline, extent>;
  block_positions: HashMap<u64, u64, extent>;
  next_wait: u64;
  committed: Box<Ring<Action>>;
  deadlines: PriorityQueue<Deadline, extent>;
  wake: CancelSource;
  next: u64;
  stopping: Bool;
}

public fn promote(hub: &Hub, client: &Client) -> result: unit writes(hub), writes(client) doc "Allocates the same one-time receiver/command/output registration for the first actual list suspension or subscription; an already promoted client keeps its identity.";

public fn block_install(hub: &Hub, request: BlockedList) -> result: unit writes(hub) doc "Registers distinct source keys in FIFO order under the same hold that observed no available value. A zero generation receives a never-reused identity; reblocking retains its original deadline and generation.";

public fn block_take(hub: &Hub, id: u64) -> request: Option<BlockedList> writes(hub) doc "Removes a wait from every source key before retry, timeout, unblocking or disconnect. The caller commits a completed reply in the same hub hold before allowing the command owner to continue.";

public fn block_front(hub: &Hub, key: &Key) -> id: Option<u64> reads(hub), reads(key) doc "Reads the oldest current waiter on a source key; it grants no wake or mutation authority outside the caller's data/hub hold.";

public fn block_key_count(hub: &Hub, key: &Key) -> count: u64 reads(hub), reads(key) doc "Captures the FIFO retry budget for one ready key; reblocked requests cannot run twice in that pass.";

public fn blocking_counts(hub: &Hub) -> counts: BlockingCounts reads(hub.blocking_state) doc "Counts live suspended clients, distinct registered source keys and finite deadlines. These list waits do not request wake-on-key-deletion, so total_blocking_keys_on_nokey is zero. The narrow observation state changes with registrations and lets guards observe only membership and counts.";

public fn block_complete(hub: &Hub, request: BlockedList, client: &Client, time: u64) -> result: unit writes(hub), writes(client) doc "Commits a served request's temporary reply Client and scalar continuation under the same data/hub hold as its effects. Completion is retained only while its connection record remains live, including after output pressure checks. The request is consumed; a reblocked attempt instead retains its updated scalar state. time is Unix seconds.";

public fn block_wait(hub: &Shared<Hub>, connection: &Connection) -> resumed: Option<BlockResume> reads(hub), reads(connection) waits doc "Suspends the command owner until its committed list reply or cancellation, then consumes the one completion state; None means cancellation or a removed registration. The owner restores random and merges seen_peak before another command. Independent receive and output owners remain active.";

public fn block_unblock(hub: &Hub, client_id: u64, failed: Bool, time: u64) -> changed: Bool writes(hub) doc "CLIENT UNBLOCK under the hub: removes all memberships and commits Redis's timeout null-array or UNBLOCKED error in the same hold before letting the command owner resume. time is Unix seconds for output accounting.";

public fn hub_new() -> made: Shared<Hub> pure doc "Creates the event hub. Connection ids are never reused during this process; the supported execution contains fewer than 2^64 promotions.";

public fn hub_share(hub: &Shared<Hub>) -> made: Shared<Hub> reads(hub) doc "Retains the same event hub.";

public fn hub_stop(hub: &Shared<Hub>) -> result: unit reads(hub) waits doc "Removes every registration and queues cancellation of all promoted connections, then stops delivery after its committed actions drain.";

public fn dispatch(hub: Shared<Hub>) -> result: unit pure waits doc "Delivers committed actions in order without holding the hub during inbox publication or cancellation and without waiting for network progress.";

public fn timer(hub: Shared<Hub>, clock: Clock, wall: WallClock) -> result: unit pure waits doc "Waits on the earliest output soft-limit or blocking-list deadline, or its replacement generation; it never polls an empty queue. Blocking expiry uses strict absolute Unix milliseconds and rechecks the wall clock after each monotonic wake. time arguments for output accounting remain Unix whole seconds.";

public fn connection_get(hub: &Shared<Hub>, id: u64) -> found: Option<Connection> reads(hub) waits doc "Retains a live promoted connection, or returns None after cleanup invalidated its never-reused id.";

public fn connection_live(hub: &Hub, id: u64) -> live: Bool reads(hub) doc "Checks the registration under the caller's hub hold. Promoted command admission uses this boundary before execution, so invalidation prevents later commands even while cancellation delivery is pending.";

public fn connection_share(connection: &Connection) -> made: Connection reads(connection) doc "Retains the connection's independent input, output and cancellation handles.";

public fn forget(hub: &Shared<Hub>, id: u64) -> result: unit reads(hub) waits doc "Idempotently invalidates the registration and removes its subscriptions, then cancels its owners outside the hub hold.";

public fn forget_idle(hub: &Shared<Hub>, connection: &Connection, last: Instant, now: Instant, interval: u64) -> expired: Bool reads(hub), reads(connection) waits doc "Checks authoritative committed membership and latest socket activity together with invalidation. A delayed membership notification cannot expire a subscribed or blocked client. interval is monotonic nanoseconds; cancellation fires outside the holds.";

public fn stage_new() -> made: Stage pure doc "Creates an empty attempt-local publication stage.";

public fn stage_has(stage: &Stage) -> present: Bool reads(stage) doc "Whether the attempt has selected at least one external delivery.";

public fn run(hub: &Hub, kind: u64, input: &[u8], args: &Box<Slots<Span>>, client: &Client, stage: &Stage, in_exec: Bool, time: u64) -> result: unit reads(input), reads(args), writes(hub), writes(client), writes(stage) doc "Runs pub/sub semantics under the caller's hub hold. Acknowledgments accumulate in the caller's reply group; publications retain selected recipients only in the attempt stage until commit.";

public fn commit(hub: &Hub, client: &Client, stage: &Stage, time: u64) -> result: unit writes(hub), writes(client), writes(stage) doc "Commits the promoted client's entire reply prefix first, then accepted staged publications in order; no abandoned attempt calls this function.";

public fn reset(hub: &Hub, client: &Client) -> result: unit writes(hub), writes(client) doc "Quietly removes all three subscription kinds while preserving the promoted connection's identity and owners.";

public fn output_done(hub: &Shared<Hub>, id: u64, bytes: u64, time: u64) -> result: unit reads(hub) waits doc "Releases the retained payload-capacity charge only after the output owner has finished and released an entire frame. The shared body capacity is charged in full per recipient; allocator and queue-control overhead are not represented.";

public fn input_push(connection: &Connection, chunk: Box<Slots<u8>>) -> accepted: Bool reads(connection) waits doc "Enqueues received bytes, refusing a closed input or queued query bytes beyond one GiB. The receiver must close the connection on refusal.";

public fn input_take(connection: &Connection) -> chunk: Option<Box<Slots<u8>>> reads(connection) waits doc "Waits for one received chunk or input termination without polling.";

public fn input_end(connection: &Connection) -> result: unit reads(connection) waits doc "Publishes peer input termination and wakes a waiting command owner.";

public fn output_take(connection: &Connection) -> frame: Option<Frame> reads(connection) waits doc "Waits for the next complete frame or output closure without polling.";

public fn stop(connection: &Connection) -> result: unit reads(connection) waits doc "Closes and empties both inboxes, then fires host cancellation after releasing their holds.";

public fn input_seed(connection: &Connection, bytes: u64) -> accepted: Bool reads(connection) waits doc "Charges the unconsumed input transferred at promotion before the receiver starts.";

public fn input_used(connection: &Connection, bytes: u64) -> result: unit reads(connection) waits doc "Releases query-byte charge after the command owner parses or discards those bytes; taking a chunk does not release it.";

public fn finish(hub: &Shared<Hub>, id: u64) -> result: unit reads(hub) waits doc "Commits output termination after preceding replies; the output owner drains those frames before forgetting the connection.";

public fn receive_snapshot(connection: &Connection) -> snapshot: ReceiveSnapshot reads(connection) waits doc "Reads the receiver idle-exemption class and retains its current membership wake generation together.";

public fn activity(connection: &Connection, instant: Instant) -> result: unit reads(connection) waits doc "Publishes the latest completed receive or frame send; an unsubscribed receiver wakes to recompute its idle deadline.";

public fn client_counts(hub: &Hub, client_id: u64) -> counts: Counts reads(hub) doc "Reads all three membership counts under the caller-held hub using the network client id. Unpromoted and forgotten connections return zero; CLIENT LIST can hold its metadata table and this hub together.";

public fn registry_counts(hub: &Hub) -> counts: RegistryCounts reads(hub) doc "Reads the number of distinct ordinary channels, patterns and shard channels under one hub snapshot for INFO stats.";
