const zkind_none: u64 = 0_u64;

const zkind_lapsed: u64 = 1_u64;

const zkind_zset: u64 = 2_u64;

const zkind_other: u64 = 3_u64;

const zkind_set: u64 = 4_u64;

const zstate_found: u64 = 20_u64;

const zstate_refused: u64 = 21_u64;

const zop_union: u64 = 0_u64;

const zop_inter: u64 = 1_u64;

const zop_diff: u64 = 2_u64;

const zagg_sum: u64 = 0_u64;

const zagg_min: u64 = 1_u64;

const zagg_max: u64 = 2_u64;

const zrefusal_syntax: u64 = 1_u64;

const zrefusal_weight: u64 = 2_u64;

const zrefusal_limit: u64 = 3_u64;

const word_weights: Array<u8, 7> = "WEIGHTS";

const word_aggregate: Array<u8, 9> = "AGGREGATE";

const word_aggregate_sum: Array<u8, 3> = "SUM";

const text_zalg_weight: Array<u8, 31> = "ERR weight value is not a float";

