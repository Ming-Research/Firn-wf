    set selected = db13;
  }
  if database == 14_u64 {
    set selected = db14;
  }
  if database == 15_u64 {
    set selected = db15;
  }
  if kind == 164_u64 {
    if flush_refused(input: input, args: args, client: client) {
      return 0_u64;
    }
    flush_body(sequence: sequence, keys: db0);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 0_u64);
    flush_body(sequence: sequence, keys: db1);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 1_u64);
    flush_body(sequence: sequence, keys: db2);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 2_u64);
    flush_body(sequence: sequence, keys: db3);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 3_u64);
    flush_body(sequence: sequence, keys: db4);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 4_u64);
    flush_body(sequence: sequence, keys: db5);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 5_u64);
    flush_body(sequence: sequence, keys: db6);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 6_u64);
    flush_body(sequence: sequence, keys: db7);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 7_u64);
    flush_body(sequence: sequence, keys: db8);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 8_u64);
    flush_body(sequence: sequence, keys: db9);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 9_u64);
    flush_body(sequence: sequence, keys: db10);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 10_u64);
    flush_body(sequence: sequence, keys: db11);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 11_u64);
    flush_body(sequence: sequence, keys: db12);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 12_u64);
    flush_body(sequence: sequence, keys: db13);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 13_u64);
    flush_body(sequence: sequence, keys: db14);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 14_u64);
    flush_body(sequence: sequence, keys: db15);
    pkg::store::command_clear_database_expiry_due::<fn pkg::store::clear_database_expiry>(meta: meta, database: 15_u64);
    let appended = mset_meta(log: effects, logged: logged, input: input, args: args, budget: effect_budget);
    reply_ok(client: client);
    return appended;
  }
  if kind == 191_u64 {
    let plan = swap_plan(input: input, args: args);
    if swap_refused(client: client, plan: &plan) {
      return 0_u64;
    }
    if plan.left != plan.right {
      let left = db0;
      if plan.left == 1_u64 {
        set left = db1;
      }
      if plan.left == 2_u64 {
        set left = db2;
      }
      if plan.left == 3_u64 {
