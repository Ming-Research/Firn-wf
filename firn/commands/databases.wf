      if destination == 10_u64 {
        set target = db10;
      }
      if destination == 11_u64 {
        set target = db11;
      }
      if destination == 12_u64 {
        set target = db12;
      }
      if destination == 13_u64 {
        set target = db13;
      }
      if destination == 14_u64 {
        set target = db14;
      }
      if destination == 15_u64 {
        set target = db15;
      }
      let source_place = key_bounds(input: input, args: args, index: 1_u64);
      let source_key = &input^[source_place.start..source_place.end];
      let target_place = source_place;
      if copying {
        set target_place = key_bounds(input: input, args: args, index: 2_u64);
      }
      let target_key = &input^[target_place.start..target_place.end];
      let work = database_transfer_body(sequence: sequence, journal: journal, source: &selected^[source_key], target: &target^[target_key], source_key: source_key, target_key: target_key, source_db: database, target_db: destination, client: client, copying: copying, replace: replace);
      let appended = pkg::store::command_database_transfer_meta_due::<TransferWork, fn database_transfer_meta>(meta: meta, log: effects, budget: effect_budget, work: &work, source_key: source_key, target_key: target_key, source_db: database, target_db: destination, logged: logged, input: input, args: args, env: env);
      copy_finish(client: client, error: 0_u64, outcome: work.outcome);
      return appended;
    }
  }
  return held_run(sequence: sequence, effect_budget: effect_budget, journal: journal, kind: kind, keys: selected, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
}

fn run_flushall(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  let database = store^.database;
  let journal = None<pkg::store::AccessJournal>();
  let effects = box_slots_new::<u8>(capacity: 64_u64);
  atomic db0 = &store^.databases.db0, db1 = &store^.databases.db1, db2 = &store^.databases.db2, db3 = &store^.databases.db3, db4 = &store^.databases.db4, db5 = &store^.databases.db5, db6 = &store^.databases.db6, db7 = &store^.databases.db7, db8 = &store^.databases.db8, db9 = &store^.databases.db9, db10 = &store^.databases.db10, db11 = &store^.databases.db11, db12 = &store^.databases.db12, db13 = &store^.databases.db13, db14 = &store^.databases.db14, db15 = &store^.databases.db15, m = &store^.meta {
    if aof_refuse(meta: m, client: client) {
      return unit;
    }
    pkg::store::database_context(meta: m, database: database);
    let sequence = pkg::store::sequence_new(meta: m, loading: time^.loading);
    let budget = pkg::store::log_budget_begin(meta: m, loading: time^.loading);
    let appended = held_databases_run(sequence: &sequence, journal: &journal, database: &database, kind: 164_u64, db0: db0, db1: db1, db2: db2, db3: db3, db4: db4, db5: db5, db6: db6, db7: db7, db8: db8, db9: db9, db10: db10, db11: db11, db12: db12, db13: db13, db14: db14, db15: db15, meta: m, effects: &effects, logged: store^.logging, input: input, args: args, client: client, env: env, time: time);
    pkg::store::command_record_effects_log::<fn pkg::store::record_effects>(meta: m, effects: &effects, appended: appended, sequence: &sequence, budget: &budget);
    pkg::store::sequence_commit(meta: m, sequence: &sequence, budget: &budget);
  }
  return unit;
}
