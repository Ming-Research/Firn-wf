alias Keyspace = pkg::store::Keyspace;
alias Entry = pkg::store::Entry;
alias Meta = pkg::store::Meta;
alias Client = pkg::protocol::Client;
alias Span = pkg::protocol::Span;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Time = pkg::store::Time;

fn move_plan(input: &[u8], args: &Box<Slots<Span>>, database: u64) -> plan: DatabasePlan reads(input), reads(args) {
  let plan = database_plan(input: input, args: args, index: 2_u64);
  if plan.error != 0_u64 {
    return plan;
  }
  if plan.database == database {
    return DatabasePlan(database: plan.database, error: 4_u64);
  }
  return plan;
}

fn move_refused(client: &Client, plan: &DatabasePlan) -> refused: Bool reads(plan), writes(client) {
  if plan^.error == 0_u64 {
    return False();
  }
  if plan^.error == 4_u64 {
    reply_error(client: client, word: &text_same_object[0_u64..47_u64]);
  } else {
    select_finish(client: client, error: plan^.error);
  }
  return True();
}

struct SwapPlan {
  left: u64;
  right: u64;
  error: u64;
  invariant left_valid(plan): plan.left < 16_u64;
  invariant right_valid(plan): plan.right < 16_u64;
}

fn swap_plan(input: &[u8], args: &Box<Slots<Span>>) -> plan: SwapPlan reads(input), reads(args) {
  let left = database_plan(input: input, args: args, index: 1_u64);
  if left.error == 1_u64 {
    return SwapPlan(left: 0_u64, right: 0_u64, error: 1_u64);
  }
  if left.error == 2_u64 {
    return SwapPlan(left: 0_u64, right: 0_u64, error: 1_u64);
  }
  let right = database_plan(input: input, args: args, index: 2_u64);
  if right.error == 1_u64 {
    return SwapPlan(left: 0_u64, right: 0_u64, error: 2_u64);
  }
  if right.error == 2_u64 {
    return SwapPlan(left: 0_u64, right: 0_u64, error: 2_u64);
  }
  let left_out = left.error == 3_u64;
  let right_out = right.error == 3_u64;
  if bor(left_out, right_out) {
    return SwapPlan(left: 0_u64, right: 0_u64, error: 3_u64);
  }
  return SwapPlan(left: left.database, right: right.database, error: 0_u64);
}

const text_first_database: Array<u8, 26> = "ERR invalid first DB index";

const text_second_database: Array<u8, 27> = "ERR invalid second DB index";

fn swap_refused(client: &Client, plan: &SwapPlan) -> refused: Bool reads(plan), writes(client) {
  if plan^.error == 0_u64 {
    return False();
  }
  if plan^.error == 1_u64 {
    reply_error(client: client, word: &text_first_database[0_u64..26_u64]);
  } else if plan^.error == 2_u64 {
    reply_error(client: client, word: &text_second_database[0_u64..27_u64]);
  } else {
    select_finish(client: client, error: 3_u64);
  }
  return True();
}

fn database_transfer_body(sequence: &pkg::store::WriteSequence, journal: &Option<pkg::store::AccessJournal>, source: &Option<Entry>, target: &Option<Entry>, source_key: &[u8], target_key: &[u8], source_db: u64, target_db: u64, client: &Client, copying: Bool, replace: Bool) -> work: TransferWork reads(source_key), reads(target_key), writes(sequence), writes(journal), writes(source), writes(target), writes(client) contract {
  requires source_db < 16_u64;
  requires target_db < 16_u64;
} {
  doc "MOVE and cross-database COPY over naturally separate held entries. Source lookup precedes destination lookup; both lazy expiries survive a zero reply. The payload and absolute expiry transfer together, while COPY retains its source.";
  let no = False();
  let work = TransferWork(outcome: rename_missing, at: 0_u64, source_expired: no, target_expired: no);
  pkg::store::sequence_database(sequence: sequence, database: source_db);
  pkg::store::access_journal_select(journal: journal, database: source_db);
  refresh_access(journal: journal, key: source_key, slot: source, client: client);
  let source_kind = entry_kind(sequence: sequence, capture_key: source_key, slot: source, client: client);
  set work.source_expired = client^.state == state_expired;
  if source_kind == 0_u64 {
    return work;
  }
  pkg::store::sequence_database(sequence: sequence, database: target_db);
  pkg::store::access_journal_select(journal: journal, database: target_db);
  refresh_access(journal: journal, key: target_key, slot: target, client: client);
  let target_kind = entry_kind(sequence: sequence, capture_key: target_key, slot: target, client: client);
  set work.target_expired = client^.state == state_expired;
  let vacant = target_kind == 0_u64;
  if bnot(bor(vacant, replace)) {
    return work;
  }
  set work.at = held_expiry(slot: source);
  if copying {
    let copied = held_copy(client: client, slot: source);
    pkg::store::sequence_replace(sequence: sequence, slot: target, replacement: move copied);
  } else {
    let moved = None<Entry>();
    swap(first: source, second: &moved);
    pkg::store::sequence_replace(sequence: sequence, slot: target, replacement: move moved);
    match target^ {
      Some(value: inserted) => {
        set inserted^.access = new_access(client: client);
      }
      None() => {
      }
    }
    pkg::store::sequence_database(sequence: sequence, database: source_db);
    pkg::store::sequence_stamp_key(sequence: sequence, slot: source, key: source_key);
    pkg::store::sequence_database(sequence: sequence, database: target_db);
  }
  pkg::store::sequence_stamp_key(sequence: sequence, slot: target, key: target_key);
  set work.outcome = rename_done;
  return work;
}

fn database_transfer_meta(due: &pkg::store::ExpiryQueue, log: &Box<Slots<u8>>, budget: &pkg::store::LogBudget, work: &TransferWork, source_key: &[u8], target_key: &[u8], source_db: u64, target_db: u64, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, env: &KeyEnv) -> appended: u64 reads(work), reads(source_key), reads(target_key), reads(input), reads(args), reads(env), writes(due), writes(log), writes(budget) contract {
  requires target_db < 16_u64;
} {
  set budget^.database = source_db;
  let appended = mset_lapse_meta(log: log, logged: logged, lapsed: work^.source_expired, key: source_key, budget: budget);
  set budget^.database = target_db;
  let removed = mset_lapse_meta(log: log, logged: logged, lapsed: work^.target_expired, key: target_key, budget: budget);
  set appended = appended +wrap removed;
  if work^.outcome == rename_done {
    pkg::store::expiry_context(due: due, database: target_db);
    if work^.at != 0_u64 {
      pkg::store::queue_due(due: due, key: target_key, at: work^.at, env: env);
    }
    set budget^.database = source_db;
    let written = mset_meta(log: log, logged: logged, input: input, args: args, budget: budget);
    set appended = appended +wrap written;
  }
  return appended;
}

fn run_database_transfer(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, destination: u64, copying: Bool, replace: Bool) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits contract {
  requires destination < 16_u64;
} {
  let target_store = pkg::store::keyspace_database(store: store, database: destination);
  let source_place = key_bounds(input: input, args: args, index: 1_u64);
  let source_key = &input^[source_place.start..source_place.end];
  let target_place = source_place;
  if copying {
    set target_place = key_bounds(input: input, args: args, index: 2_u64);
  }
  let target_key = &input^[target_place.start..target_place.end];
  let journal = None<pkg::store::AccessJournal>();
  set client^.now = time^.check;
  let outcome = rename_missing;
  atomic source = &store^.keys[source_key], target = &target_store.keys[target_key], m = &store^.meta {
    if aof_refuse(meta: m, client: client) {
      return unit;
    }
    pkg::store::database_context(meta: m, database: store^.database);
    let sequence = pkg::store::sequence_new(meta: m, loading: time^.loading);
    let budget = pkg::store::log_budget_begin(meta: m, loading: time^.loading);
    let work = database_transfer_body(sequence: &sequence, journal: &journal, source: source, target: target, source_key: source_key, target_key: target_key, source_db: store^.database, target_db: destination, client: client, copying: copying, replace: replace);
    let appended = pkg::store::command_database_transfer_meta_due_log::<TransferWork, fn database_transfer_meta>(meta: m, budget: &budget, work: &work, source_key: source_key, target_key: target_key, source_db: store^.database, target_db: destination, logged: store^.logging, input: input, args: args, env: env);
    set outcome = work.outcome;
    pkg::store::sequence_commit(meta: m, sequence: &sequence, budget: &budget);
  }
  copy_finish(client: client, error: 0_u64, outcome: outcome);
  return unit;
}

fn run_move(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  let plan = move_plan(input: input, args: args, database: store^.database);
  if move_refused(client: client, plan: &plan) {
    return unit;
  }
  let copying = False();
  let replace = False();
  run_database_transfer(store: store, input: input, args: args, client: client, env: env, time: time, destination: plan.database, copying: copying, replace: replace);
  return unit;
}

fn database_swap_body(sequence: &pkg::store::WriteSequence, source: &ConcurrentHashMap<Entry>, target: &ConcurrentHashMap<Entry>) -> result: unit writes(sequence), writes(source), writes(target) {
  doc "Swaps map contents under the two permanent map identities. Existing connection handles continue to name their logical databases.";
  pkg::store::sequence_change(sequence: sequence);
  let reason = pkg::store::RewriteAbortReason::Flush();
  pkg::store::sequence_fail(sequence: sequence, reason: reason);
  swap(first: source, second: target);
  return unit;
}

fn held_database_swap(sequence: &pkg::store::WriteSequence, source: &ConcurrentHashMap<Entry>, target: &ConcurrentHashMap<Entry>, meta: &Meta, left_db: u64, right_db: u64, env: &KeyEnv) -> result: unit reads(env), writes(sequence), writes(source), writes(target), writes(meta) contract {
  requires left_db < 16_u64;
  requires right_db < 16_u64;
} {
  database_swap_body(sequence: sequence, source: source, target: target);
  pkg::store::swap_database_metadata(meta: meta, left_db: left_db, right_db: right_db);
  pkg::store::command_queue_map_expiry_due::<fn pkg::store::queue_map_expiry>(meta: meta, keys: source, database: left_db, env: env);
  pkg::store::command_queue_map_expiry_due::<fn pkg::store::queue_map_expiry>(meta: meta, keys: target, database: right_db, env: env);
  return unit;
}

fn run_swapdb(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  let plan = swap_plan(input: input, args: args);
  if swap_refused(client: client, plan: &plan) {
    return unit;
  }
  let source = pkg::store::keyspace_database(store: store, database: plan.left);
  let target = pkg::store::keyspace_database(store: store, database: plan.right);
  atomic left = &source.keys, right = &target.keys, m = &store^.meta {
    if aof_refuse(meta: m, client: client) {
      return unit;
    }
    pkg::store::database_context(meta: m, database: store^.database);
    let sequence = pkg::store::sequence_new(meta: m, loading: time^.loading);
    let budget = pkg::store::log_budget_begin(meta: m, loading: time^.loading);
    if plan.left != plan.right {
      held_database_swap(sequence: &sequence, source: left, target: right, meta: m, left_db: plan.left, right_db: plan.right, env: env);
    }
    let appended = pkg::store::command_mset_meta_log::<fn mset_meta>(meta: m, logged: store^.logging, input: input, args: args, budget: &budget);
    pkg::store::sequence_commit(meta: m, sequence: &sequence, budget: &budget);
  }
  reply_ok(client: client);
  return unit;
}

fn held_databases_run(sequence: &pkg::store::WriteSequence, journal: &Option<pkg::store::AccessJournal>, database: &u64, kind: u64, db0: &ConcurrentHashMap<Entry>, db1: &ConcurrentHashMap<Entry>, db2: &ConcurrentHashMap<Entry>, db3: &ConcurrentHashMap<Entry>, db4: &ConcurrentHashMap<Entry>, db5: &ConcurrentHashMap<Entry>, db6: &ConcurrentHashMap<Entry>, db7: &ConcurrentHashMap<Entry>, db8: &ConcurrentHashMap<Entry>, db9: &ConcurrentHashMap<Entry>, db10: &ConcurrentHashMap<Entry>, db11: &ConcurrentHashMap<Entry>, db12: &ConcurrentHashMap<Entry>, db13: &ConcurrentHashMap<Entry>, db14: &ConcurrentHashMap<Entry>, db15: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(journal), writes(database), writes(db0), writes(db1), writes(db2), writes(db3), writes(db4), writes(db5), writes(db6), writes(db7), writes(db8), writes(db9), writes(db10), writes(db11), writes(db12), writes(db13), writes(db14), writes(db15), writes(meta), writes(effects), writes(client) contract {
  requires database^ < 16_u64;
  ensures database^ < 16_u64;
} {
  if kind == 163_u64 {
    let plan = database_plan(input: input, args: args, index: 1_u64);
    if plan.error == 0_u64 {
      set database^ = plan.database;
    }
    select_finish(client: client, error: plan.error);
    return 0_u64;
  }
  pkg::store::database_context(meta: meta, database: database^);
  pkg::store::sequence_database(sequence: sequence, database: database^);
  pkg::store::access_journal_select(journal: journal, database: database^);
  let effect_budget = pkg::store::effect_budget_begin(sequence: sequence);
  let appended = held_databases_body(sequence: sequence, effect_budget: &effect_budget, journal: journal, database: database^, kind: kind, db0: db0, db1: db1, db2: db2, db3: db3, db4: db4, db5: db5, db6: db6, db7: db7, db8: db8, db9: db9, db10: db10, db11: db11, db12: db12, db13: db13, db14: db14, db15: db15, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
  pkg::store::effect_budget_commit(sequence: sequence, budget: &effect_budget);
  return appended;
}

fn held_databases_body(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, database: u64, kind: u64, db0: &ConcurrentHashMap<Entry>, db1: &ConcurrentHashMap<Entry>, db2: &ConcurrentHashMap<Entry>, db3: &ConcurrentHashMap<Entry>, db4: &ConcurrentHashMap<Entry>, db5: &ConcurrentHashMap<Entry>, db6: &ConcurrentHashMap<Entry>, db7: &ConcurrentHashMap<Entry>, db8: &ConcurrentHashMap<Entry>, db9: &ConcurrentHashMap<Entry>, db10: &ConcurrentHashMap<Entry>, db11: &ConcurrentHashMap<Entry>, db12: &ConcurrentHashMap<Entry>, db13: &ConcurrentHashMap<Entry>, db14: &ConcurrentHashMap<Entry>, db15: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(db0), writes(db1), writes(db2), writes(db3), writes(db4), writes(db5), writes(db6), writes(db7), writes(db8), writes(db9), writes(db10), writes(db11), writes(db12), writes(db13), writes(db14), writes(db15), writes(meta), writes(effects), writes(client) contract {
  requires database < 16_u64;
} {
  let selected = db0;
  if database == 1_u64 {
    set selected = db1;
  }
  if database == 2_u64 {
    set selected = db2;
  }
  if database == 3_u64 {
    set selected = db3;
  }
  if database == 4_u64 {
