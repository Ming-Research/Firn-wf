    }
    let appended = mset_meta(log: effects, logged: logged, input: input, args: args, budget: effect_budget);
    reply_ok(client: client);
    return appended;
  }
  let copying = kind == 39_u64;
  let moving = kind == 190_u64;
  if bor(copying, moving) {
    let destination = database;
    let replace = False();
    if copying {
      let plan = copy_parse(input: input, args: args, database: database);
      if copy_refused(client: client, plan: &plan) {
        return 0_u64;
      }
      set destination = plan.database;
      set replace = plan.replace;
    } else {
      let plan = move_plan(input: input, args: args, database: database);
      if move_refused(client: client, plan: &plan) {
        return 0_u64;
      }
      set destination = plan.database;
    }
    if destination != database {
      let target = db0;
      if destination == 1_u64 {
        set target = db1;
      }
      if destination == 2_u64 {
        set target = db2;
      }
      if destination == 3_u64 {
        set target = db3;
      }
      if destination == 4_u64 {
        set target = db4;
      }
      if destination == 5_u64 {
