alias Client = pkg::protocol::Client;
alias Entry = pkg::store::Entry;
alias Keyspace = pkg::store::Keyspace;
alias Span = pkg::protocol::Span;
alias Time = pkg::store::Time;
alias arg = pkg::protocol::arg;
alias name_is = pkg::bytes::name_is;
alias reply_verbatim = pkg::protocol::reply_verbatim;

const section_default: Array<u8, 7> = "DEFAULT";

const section_all: Array<u8, 3> = "ALL";

const section_everything: Array<u8, 10> = "EVERYTHING";

const section_module_list: Array<u8, 11> = "MODULE_LIST";

const section_names: Array<u8, 105> = "SERVERCLIENTSMEMORYPERSISTENCESTATSREPLICATIONCPUMODULESCOMMANDSTATSERRORSTATSLATENCYSTATSCLUSTERKEYSPACE";

const section_ends: Array<u64, 13> =[6_u64, 13_u64, 19_u64, 30_u64, 35_u64, 46_u64, 49_u64, 56_u64, 68_u64, 78_u64, 90_u64, 97_u64, 105_u64];

const info_server_head: Array<u8, 103> = "# Server\r\nredis_version:7.0.15\r\nredis_git_sha1:00000000\r\nredis_mode:standalone\r\narch_bits:64\r\ntcp_port:";

const info_server_time: Array<u8, 19> = "\r\nserver_time_usec:";

const info_uptime_seconds: Array<u8, 20> = "\r\nuptime_in_seconds:";

const info_uptime_days: Array<u8, 17> = "\r\nuptime_in_days:";

const info_server_tail: Array<u8, 41> = "\r\nhz:10\r\nconfigured_hz:10\r\nconfig_file:\r\n";

const info_clients_head: Array<u8, 29> = "# Clients\r\nconnected_clients:";

const info_clients_tail: Array<u8, 92> = "\r\ncluster_connections:0\r\nblocked_clients:0\r\ntracking_clients:0\r\nclients_in_timeout_table:0\r\n";

const info_memory_head: Array<u8, 35> = "# Memory\r\nnumber_of_cached_scripts:";

const info_memory_limits: Array<u8, 58> = "\r\nnumber_of_functions:0\r\nnumber_of_libraries:0\r\nmaxmemory:";

const info_minus: Array<u8, 1> = "-";

const info_memory_human: Array<u8, 18> = "\r\nmaxmemory_human:";

const info_memory_policy: Array<u8, 19> = "\r\nmaxmemory_policy:";

const info_memory_tail: Array<u8, 51> = "\r\nlazyfree_pending_objects:0\r\nlazyfreed_objects:0\r\n";

const info_persistence_head: Array<u8, 121> = "# Persistence\r\nloading:0\r\nasync_loading:0\r\nrdb_bgsave_in_progress:0\r\nrdb_last_bgsave_status:ok\r\nrdb_saves:0\r\naof_enabled:";

const info_rw_progress: Array<u8, 26> = "\r\naof_rewrite_in_progress:";

const info_rw_status: Array<u8, 53> = "\r\naof_rewrite_scheduled:0\r\naof_last_bgrewrite_status:";

const info_rw_count: Array<u8, 15> = "\r\naof_rewrites:";

const info_rw_current: Array<u8, 19> = "\r\naof_current_size:";

const info_rw_base: Array<u8, 16> = "\r\naof_base_size:";

const info_rw_tail: Array<u8, 29> = "\r\nmodule_fork_in_progress:0\r\n";

const info_rw_ok: Array<u8, 2> = "ok";

const info_rw_error: Array<u8, 3> = "err";

const info_stats_head: Array<u8, 36> = "# Stats\r\ntotal_connections_received:";

const info_stats_tail: Array<u8, 324> = "\r\nrejected_connections:0\r\nsync_full:0\r\nsync_partial_ok:0\r\nsync_partial_err:0\r\nevicted_clients:0\r\npubsub_channels:0\r\npubsub_patterns:0\r\npubsubshard_channels:0\r\nlatest_fork_usec:0\r\ntotal_forks:0\r\nmigrate_cached_sockets:0\r\ntracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\ndump_payload_sanitizations:0\r\n";

const info_replication: Array<u8, 209> = "# Replication\r\nrole:master\r\nconnected_slaves:0\r\nmaster_failover_state:no-failover\r\nmaster_repl_offset:0\r\nsecond_repl_offset:-1\r\nrepl_backlog_active:0\r\nrepl_backlog_first_byte_offset:0\r\nrepl_backlog_histlen:0\r\n";

const info_cpu: Array<u8, 7> = "# CPU\r\n";

const info_modules: Array<u8, 11> = "# Modules\r\n";

const info_commandstats: Array<u8, 16> = "# Commandstats\r\n";

const info_errorstats: Array<u8, 14> = "# Errorstats\r\n";

const info_latencystats: Array<u8, 16> = "# Latencystats\r\n";

const info_cluster: Array<u8, 30> = "# Cluster\r\ncluster_enabled:0\r\n";

const info_keyspace: Array<u8, 12> = "# Keyspace\r\n";

const info_db0: Array<u8, 9> = "db0:keys=";

const info_db0_tail: Array<u8, 2> = "\r\n";

const info_gap: Array<u8, 2> = "\r\n";

fn section_matches(input: &[u8], start: u64, length: u64, which: u64) -> matched: Bool reads(input) {
  doc "Whether length bytes of the input from start name section which of INFO's thirteen, in either case.";
  let first = 0_u64;
  if which > 0_u64 {
    let before = which -wrap 1_u64;
    if before < 13_u64 {
      set first = section_ends[before];
    }
  }
  let last = 105_u64;
  if which < 13_u64 {
    set last = section_ends[which];
  }
  if last <= 105_u64 {
    if first <= last {
      let matched = name_is(input: input, start: start, length: length, word: &section_names[first..last]);
      return matched;
    }
  }
  return False();
}

fn text_reserve(text: &Box<Slots<u8>>, needed: u64) -> result: unit writes(text) {
  doc "Grows the text, at least doubling it, until it has room for needed more bytes; INFO's text stays far below the 2^62 bytes the growth stops at.";
  let length = text^.inner.len;
  let capacity = text^.inner.cap;
  let wanted = length +wrap needed;
  if wanted > capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, wanted);
    let fits = target <= 4611686018427387904_u64;
    if fits {
      if target >= text^.inner.cap {
        grow(cell: text, capacity: target);
      }
    }
  }
  return unit;
}

fn text_word(text: &Box<Slots<u8>>, word: &[u8]) -> result: unit reads(word), writes(text) {
  doc "Appends a constant word to the text.";
  let count = word^.len;
  text_reserve(text: text, needed: count);
  for @bytes (offset in 0_u64..count) {
    let byte = word^[offset];
    if text^.inner.len < text^.inner.cap {
      place_back(window: &text^.inner, value: byte);
    }
  }
  return unit;
}

fn text_signed(text: &Box<Slots<u8>>, value: u64) -> result: unit writes(text) {
  doc "Appends a 64-bit value in decimal as C's %lld reads it: values from 2^63 up are written as the negative two's-complement number, as Redis 7.0.15's INFO writes maxmemory.";
  if value >= 9223372036854775808_u64 {
    let magnitude = 0_u64 -wrap value;
    text_word(text: text, word: &info_minus[0_u64..1_u64]);
    text_number(text: text, value: magnitude);
    return unit;
  }
  text_number(text: text, value: value);
  return unit;
}

fn text_number(text: &Box<Slots<u8>>, value: u64) -> result: unit writes(text) {
  doc "Appends a number in decimal to the text.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @digits {
    let low = rest % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if count < 20_u64 {
      set digits[count] = glyph;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  text_reserve(text: text, needed: count);
  for @emit (index in 0_u64..count) {
    let back = count -wrap index;
    let from = back -wrap 1_u64;
    let glyph = 48_u8;
    if from < 20_u64 {
      set glyph = digits[from];
    }
    if text^.inner.len < text^.inner.cap {
      place_back(window: &text^.inner, value: glyph);
    }
  }
  return unit;
}

fn info_plan(input: &[u8], args: &Box<Slots<Span>>) -> chosen: Array<u64, 13> reads(input), reads(args) {
  doc "INFO's section parsing, shared independently of how the caller obtains the server counters. Unknown sections add no output; there are no option refusals.";
  let count = args^.inner.len;
  let chosen = array_filled::<u64, 13>(value: 0_u64);
  if count == 1_u64 {
    for @defaults (which in 0_u64..13_u64) {
      set chosen[which] = 1_u64;
    }
    set chosen[8_u64] = 0_u64;
    set chosen[10_u64] = 0_u64;
  }
  for @arguments (index in 1_u64..count) {
    let section = arg(args: args, index: index);
    let spelled = before_zero(input: input, span: section);
    let defaults = name_is(input: input, start: section.start, length: spelled, word: &section_default[0_u64..7_u64]);
    let all = name_is(input: input, start: section.start, length: spelled, word: &section_all[0_u64..3_u64]);
    let everything = name_is(input: input, start: section.start, length: spelled, word: &section_everything[0_u64..10_u64]);
    let module_list = name_is(input: input, start: section.start, length: spelled, word: &section_module_list[0_u64..11_u64]);
    let whole = bor(all, everything);
    if whole {
      for @every (which in 0_u64..13_u64) {
        set chosen[which] = 1_u64;
      }
    } else if defaults {
      for @usual (which in 0_u64..13_u64) {
        let extra = which == 8_u64;
        let latency = which == 10_u64;
        let left_out = bor(extra, latency);
        if left_out {
        } else {
          set chosen[which] = 1_u64;
        }
      }
    } else if module_list {
      set chosen[7_u64] = 1_u64;
    } else {
      for @named (which in 0_u64..13_u64) {
        let matched = section_matches(input: input, start: section.start, length: spelled, which: which);
        if matched {
          set chosen[which] = 1_u64;
        }
      }
    }
  }
  return chosen;
}

fn info_body(cached_scripts: u64, used: u64, rss: Option<u64>, maxmemory: u64, memory_policy: u64, chosen: &Array<u64, 13>, clients: u64, started: u64, connections: u64, keys: u64, logged: Bool, persistence: &pkg::store::Meta, client: &Client, time: &Time) -> text: Box<Slots<u8>> reads(chosen), reads(persistence), reads(client), reads(time) {
  doc "Builds INFO's selected sections from the caller's counts and clock, preserving the network field order and text. No key or metadata is changed.";
  let text = box_slots_new::<u8>(capacity: 2048_u64);
  let written = 0_u64;
  for @sections (which in 0_u64..13_u64) {
    if chosen^[which] == 1_u64 {
      if written > 0_u64 {
        text_word(text: &text, word: &info_gap[0_u64..2_u64]);
      }
      set written = written +wrap 1_u64;
      if which == 0_u64 {
        let lived = time^.unix_ms -sat started;
        let seconds = lived / 1000_u64;
        let days = seconds / 86400_u64;
        text_word(text: &text, word: &info_server_head[0_u64..103_u64]);
        text_number(text: &text, value: client^.settings.port);
        text_word(text: &text, word: &info_server_time[0_u64..19_u64]);
        text_number(text: &text, value: client^.unix_us);
        text_word(text: &text, word: &info_uptime_seconds[0_u64..20_u64]);
        text_number(text: &text, value: seconds);
        text_word(text: &text, word: &info_uptime_days[0_u64..17_u64]);
        text_number(text: &text, value: days);
        text_word(text: &text, word: &info_server_tail[0_u64..41_u64]);
      } else if which == 1_u64 {
        text_word(text: &text, word: &info_clients_head[0_u64..29_u64]);
        text_number(text: &text, value: clients);
        text_word(text: &text, word: &info_clients_tail[0_u64..92_u64]);
      } else if which == 2_u64 {
        text_word(text: &text, word: &info_memory_head[0_u64..35_u64]);
        text_number(text: &text, value: cached_scripts);
        text_word(text: &text, word: &info_memory_limits[0_u64..58_u64]);
        text_signed(text: &text, value: maxmemory);
        text_word(text: &text, word: &info_memory_human[0_u64..18_u64]);
        memory_human(text: &text, value: maxmemory);
        text_word(text: &text, word: &info_memory_policy[0_u64..19_u64]);
        memory_policy_text(text: &text, policy: memory_policy);
        text_word(text: &text, word: &info_used_memory[0_u64..14_u64]);
        text_number(text: &text, value: used);
        text_word(text: &text, word: &info_used_memory_human[0_u64..20_u64]);
        memory_human(text: &text, value: used);
        text_word(text: &text, word: &info_used_memory_peak[0_u64..19_u64]);
        text_number(text: &text, value: persistence^.memory_peak);
        text_word(text: &text, word: &info_memory_excluded[0_u64..28_u64]);
        let excluded = memory_excluded(meta: persistence, logged: logged);
        text_number(text: &text, value: excluded);
        match rss {
          Some(value: resident) => {
            text_word(text: &text, word: &info_used_memory_rss[0_u64..18_u64]);
            text_number(text: &text, value: resident);
          }
          None() => {
          }
        }
        text_word(text: &text, word: &info_memory_tail[0_u64..51_u64]);
      } else if which == 3_u64 {
        text_word(text: &text, word: &info_persistence_head[0_u64..121_u64]);
        let kept = 0_u64;
        if logged {
          set kept = 1_u64;
        }
        text_number(text: &text, value: kept);
        text_word(text: &text, word: &info_rw_progress[0_u64..26_u64]);
        let progressing = 0_u64;
        if persistence^.aof_rewrite_in_progress {
          set progressing = 1_u64;
        }
        text_number(text: &text, value: progressing);
        text_word(text: &text, word: &info_rw_status[0_u64..53_u64]);
        if persistence^.aof_rewrite_ok {
          text_word(text: &text, word: &info_rw_ok[0_u64..2_u64]);
        } else {
          text_word(text: &text, word: &info_rw_error[0_u64..3_u64]);
        }
        text_word(text: &text, word: &info_rw_count[0_u64..15_u64]);
        text_number(text: &text, value: persistence^.aof_rewrites);
        text_word(text: &text, word: &info_rw_sequence[0_u64..30_u64]);
        text_number(text: &text, value: persistence^.commit_seq);
        text_word(text: &text, word: &info_rw_cut[0_u64..23_u64]);
        let cut = persistence^.aof_rewrite_cut;
        if persistence^.aof_rewrite_in_progress {
          set cut = persistence^.rewrite.cut;
        }
        let cut_number = 0_u64;
        if cut {
          set cut_number = 1_u64;
        }
        text_number(text: &text, value: cut_number);
        text_word(text: &text, word: &info_rw_reserve[0_u64..27_u64]);
        text_number(text: &text, value: persistence^.aof_rewrite_reserve);
        text_word(text: &text, word: &info_rw_scan_peak[0_u64..29_u64]);
        let scan_peak = persistence^.aof_rewrite_scan_peak;
        if persistence^.aof_rewrite_in_progress {
          set scan_peak = persistence^.rewrite.scan_peak;
        }
        text_number(text: &text, value: scan_peak);
        text_word(text: &text, word: &info_rw_abort_reason[0_u64..32_u64]);
        info_rewrite_reason(text: &text, reason: persistence^.rewrite.abort_reason);
        let rewrite_used = persistence^.rewrite.used;
        let rewrite_peak = persistence^.rewrite.peak;
        let no_reason = pkg::store::RewriteAbortReason::None();
        if persistence^.rewrite.abort_reason != no_reason {
          set rewrite_used = persistence^.rewrite.abort_used;
          set rewrite_peak = persistence^.rewrite.abort_peak;
        }
        text_word(text: &text, word: &info_rw_used[0_u64..24_u64]);
        text_number(text: &text, value: rewrite_used);
        text_word(text: &text, word: &info_rw_peak[0_u64..24_u64]);
        text_number(text: &text, value: rewrite_peak);
        text_word(text: &text, word: &info_rw_journal_images[0_u64..34_u64]);
        text_number(text: &text, value: persistence^.rewrite.journal_images);
        text_word(text: &text, word: &info_rw_journal_effects[0_u64..35_u64]);
        text_number(text: &text, value: persistence^.rewrite.journal_effects);
        text_word(text: &text, word: &info_rw_scan_steps[0_u64..30_u64]);
        text_number(text: &text, value: persistence^.rewrite.scan_steps);
        let scan_done = 0_u64;
        if persistence^.rewrite.scan_done {
          set scan_done = 1_u64;
        }
        text_word(text: &text, word: &info_rw_scan_done[0_u64..29_u64]);
        text_number(text: &text, value: scan_done);
        if logged {
          text_word(text: &text, word: &info_rw_current[0_u64..19_u64]);
          text_number(text: &text, value: persistence^.aof_current_size);
          text_word(text: &text, word: &info_rw_base[0_u64..16_u64]);
          text_number(text: &text, value: persistence^.aof_base_size);
        }
        text_word(text: &text, word: &info_rw_tail[0_u64..29_u64]);
      } else if which == 4_u64 {
        text_word(text: &text, word: &info_stats_head[0_u64..36_u64]);
        text_number(text: &text, value: connections);
        text_word(text: &text, word: &info_evicted_keys[0_u64..15_u64]);
        text_number(text: &text, value: persistence^.evicted_keys);
        text_word(text: &text, word: &info_stats_tail[0_u64..324_u64]);
      } else if which == 5_u64 {
        text_word(text: &text, word: &info_replication[0_u64..209_u64]);
      } else if which == 6_u64 {
        text_word(text: &text, word: &info_cpu[0_u64..7_u64]);
      } else if which == 7_u64 {
        text_word(text: &text, word: &info_modules[0_u64..11_u64]);
      } else if which == 8_u64 {
        text_word(text: &text, word: &info_commandstats[0_u64..16_u64]);
      } else if which == 9_u64 {
        text_word(text: &text, word: &info_errorstats[0_u64..14_u64]);
      } else if which == 10_u64 {
        text_word(text: &text, word: &info_latencystats[0_u64..16_u64]);
      } else if which == 11_u64 {
        text_word(text: &text, word: &info_cluster[0_u64..30_u64]);
      } else {
        text_word(text: &text, word: &info_keyspace[0_u64..12_u64]);
        if keys > 0_u64 {
          text_word(text: &text, word: &info_db0[0_u64..9_u64]);
          text_number(text: &text, value: keys);
          text_word(text: &text, word: &info_db0_tail[0_u64..2_u64]);
        }
      }
    }
  }
  return move text;
}

fn info_finish(client: &Client, text: &Box<Slots<u8>>) -> result: unit reads(text), writes(client) {
  doc "INFO's shared reply: a bulk string under RESP2 or a verbatim string under RESP3.";
  let length = text^.inner.len;
  let window = &text^.inner[0_u64..length];
  reply_verbatim(client: client, input: window, start: 0_u64, length: length);
  return unit;
}

fn run_info(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INFO [section [section ...]]: answers text, a bulk string under RESP2 and a verbatim string under RESP3 as Redis 7.0.15 answers it, of Redis's sections in Redis's order and form, a # header and lines of name:value each, a blank line between sections: with no argument or default, server, clients, memory, persistence, stats, replication, cpu, modules, errorstats, cluster and keyspace; with all or everything, those and commandstats and latencystats; and otherwise the sections the arguments name, modules also as module_list, in either case and up to a zero byte, as Redis compares them, an unknown name adding none. The memory limit and policy read ServerState directly without changing the connection's per-read lookup snapshot; Redis 7.0.15 genRedisInfoString reports raw heap, its observed peak, and AOF exclusion separately. RSS is read on demand through resident_bytes and omitted if the host supplies None. The fields carry real values where firn has them: the port, the calendar time, the seconds and days since the server started, counted on the calendar clock as Redis counts them, the clients connected, whether the append-only file is kept, its rewrite state and byte counts, the connections accepted since the start or CONFIG RESETSTAT, and the keys the keyspace holds, counted in an atomic statement that holds its table whole, as DBSIZE counts them. The cached-script count reads the registry in a separate short statement. Every other field is one whose value is fixed for firn: Redis's version 7.0.15, whose replies firn follows, no git revision, as Redis's builds from a release report, standalone mode, a server of 64 bits, its active expiry's 10 runs a second, no configuration file, no functions, no replica, background save, fork, module, publish and subscribe, tracking or cluster, so that their counts are 0. Fields firn cannot measure, processor time among them, the per-command and per-error counts, and the keyspace line's expires and avg_ttl, are left out, the sections of the counts empty and the keyspace line giving keys alone.";
  let chosen = info_plan(input: input, args: args);
  let cached_scripts = 0_u64;
  let used = 0_u64;
  let rss = None<u64>();
  if chosen[2_u64] == 1_u64 {
    atomic registry = &store^.scripts {
      set cached_scripts = registry^.registry.inner.len;
    }
    set used = heap_read(client: client);
    match client^.meter {
      Some(value: meter) => {
        set rss = std::process::resident_bytes(meter: meter);
      }
      None() => {
      }
    }
  }
  let clients = 0_u64;
  if chosen[1_u64] == 1_u64 {
    atomic m = &store^.meta {
      set clients = m^.clients;
    }
  }
  let started = 0_u64;
  if chosen[0_u64] == 1_u64 {
    atomic v = &store^.server {
      set started = v^.started;
    }
  }
  let connections = 0_u64;
  if chosen[4_u64] == 1_u64 {
    atomic v = &store^.server {
      set connections = v^.connections;
    }
  }
  let maxmemory = 0_u64;
  let memory_policy = 7_u64;
  if chosen[2_u64] == 1_u64 {
    atomic memory_state = &store^.server {
      set maxmemory = memory_state^.memory.maxmemory;
      set memory_policy = memory_state^.memory.maxmemory_policy;
    }
  }
  let keys = 0_u64;
  if chosen[12_u64] == 1_u64 {
    atomic t = &store^.keys {
      set keys = map_count::<Entry>(map: t);
    }
  }
  let text = box_slots_new::<u8>(capacity: 0_u64);
  atomic m = &store^.meta {
    set m^.memory_peak = imax(m^.memory_peak, used);
    set text = info_body(cached_scripts: cached_scripts, used: used, rss: rss, maxmemory: maxmemory, memory_policy: memory_policy, chosen: &chosen, clients: clients, started: started, connections: connections, keys: keys, logged: store^.logging, persistence: m, client: client, time: time);
  }
  info_finish(client: client, text: &text);
  return unit;
}

const human_units: Array<u8, 5> = "KMGTP";

const human_byte: Array<u8, 1> = "B";

const human_dot: Array<u8, 1> = ".";

fn memory_human(text: &Box<Slots<u8>>, value: u64) -> result: unit writes(text) {
  doc "Redis 7.0.15 server.c bytesToHuman: bytes below 1024 or at least 2^60, otherwise binary K/M/G/T/P with two decimals. Integer arithmetic reproduces the uint64-to-double rounding and printf's nearest-even decimal rounding without dropping trailing zeroes.";
  let small = value < 1024_u64;
  let huge = value >= 1152921504606846976_u64;
  if bor(small, huge) {
    text_number(text: text, value: value);
    text_word(text: text, word: &human_byte[0_u64..1_u64]);
    return unit;
  }
  let quantum = 1_u64;
  let magnitude = value;
  loop {
    if magnitude < 9007199254740992_u64 {
      break;
    }
    set magnitude = magnitude / 2_u64;
    set quantum = quantum *wrap 2_u64;
  }
  let rounded = value;
  if quantum > 1_u64 {
    let quotient = value / quantum;
    let residual = value % quantum;
    let half = quantum / 2_u64;
    let odd = quotient % 2_u64;
    let tie = residual == half;
    let odd_quotient = odd == 1_u64;
    let tied_up = band(tie, odd_quotient);
    let above = residual > half;
    let up = bor(above, tied_up);
    if up {
      set quotient = quotient +wrap 1_u64;
    }
    set rounded = quotient *wrap quantum;
  }
  let divisor = 1024_u64;
  let suffix = 0_u64;
  if value < 1048576_u64 {
  } else if value < 1073741824_u64 {
    set divisor = 1048576_u64;
    set suffix = 1_u64;
  } else if value < 1099511627776_u64 {
    set divisor = 1073741824_u64;
    set suffix = 2_u64;
  } else if value < 1125899906842624_u64 {
    set divisor = 1099511627776_u64;
    set suffix = 3_u64;
  } else {
    set divisor = 1125899906842624_u64;
    set suffix = 4_u64;
  }
  let whole = rounded / divisor;
  let residue = rounded % divisor;
  let scaled = residue *wrap 100_u64;
  let base = whole *wrap 100_u64;
  let fraction = scaled / divisor;
  let cents = base +wrap fraction;
  let remainder = scaled % divisor;
  let halfway = divisor / 2_u64;
  let parity = cents % 2_u64;
  let equal = remainder == halfway;
  let odd_cents = parity == 1_u64;
  let tied_round = band(equal, odd_cents);
  let beyond = remainder > halfway;
  if bor(beyond, tied_round) {
    set cents = cents +wrap 1_u64;
  }
  let integral = cents / 100_u64;
  let decimals = cents % 100_u64;
  let tens = decimals / 10_u64;
  let ones = decimals % 10_u64;
  text_number(text: text, value: integral);
  text_word(text: text, word: &human_dot[0_u64..1_u64]);
  text_number(text: text, value: tens);
  text_number(text: text, value: ones);
  if suffix < 5_u64 {
    let end = suffix +wrap 1_u64;
    text_word(text: text, word: &human_units[suffix..end]);
  }
  return unit;
}

const info_used_memory: Array<u8, 14> = "\r\nused_memory:";

const info_used_memory_human: Array<u8, 20> = "\r\nused_memory_human:";

const info_used_memory_rss: Array<u8, 18> = "\r\nused_memory_rss:";

const info_used_memory_peak: Array<u8, 19> = "\r\nused_memory_peak:";

const info_memory_excluded: Array<u8, 28> = "\r\nmem_not_counted_for_evict:";

const info_evicted_keys: Array<u8, 15> = "\r\nevicted_keys:";

const info_rw_sequence: Array<u8, 30> = "\r\nfirn_aof_rewrite_commit_seq:";

const info_rw_reserve: Array<u8, 27> = "\r\nfirn_aof_rewrite_reserve:";

const info_rw_scan_peak: Array<u8, 29> = "\r\nfirn_aof_rewrite_scan_peak:";

const info_rw_cut: Array<u8, 23> = "\r\nfirn_aof_rewrite_cut:";

const info_rw_abort_reason: Array<u8, 32> = "\r\nfirn_aof_rewrite_abort_reason:";

const info_rw_used: Array<u8, 24> = "\r\nfirn_aof_rewrite_used:";

const info_rw_peak: Array<u8, 24> = "\r\nfirn_aof_rewrite_peak:";

const info_rw_journal_images: Array<u8, 34> = "\r\nfirn_aof_rewrite_journal_images:";

const info_rw_journal_effects: Array<u8, 35> = "\r\nfirn_aof_rewrite_journal_effects:";

const info_rw_scan_steps: Array<u8, 30> = "\r\nfirn_aof_rewrite_scan_steps:";

const info_rw_scan_done: Array<u8, 29> = "\r\nfirn_aof_rewrite_scan_done:";

const info_rw_reason_reserve: Array<u8, 7> = "reserve";

const info_rw_reason_capture: Array<u8, 7> = "capture";

const info_rw_reason_journal_slots: Array<u8, 13> = "journal_slots";

const info_rw_reason_flush: Array<u8, 5> = "flush";

const info_rw_reason_sequence_exhausted: Array<u8, 18> = "sequence_exhausted";

const info_rw_reason_memory_pressure: Array<u8, 15> = "memory_pressure";

const info_rw_reason_cancelled: Array<u8, 9> = "cancelled";

const info_rw_reason_base_io: Array<u8, 7> = "base_io";

const info_rw_reason_writer_io: Array<u8, 9> = "writer_io";

const info_rw_reason_drain: Array<u8, 5> = "drain";

const info_rw_reason_boundary: Array<u8, 8> = "boundary";

const info_rw_reason_install_io: Array<u8, 10> = "install_io";

const info_rw_reason_rotation_reserve: Array<u8, 16> = "rotation_reserve";

const info_rw_reason_sequence_invalid: Array<u8, 16> = "sequence_invalid";

const info_rw_reason_journal_invalid: Array<u8, 15> = "journal_invalid";

const info_rw_reason_admission: Array<u8, 9> = "admission";

fn info_rewrite_reason(text: &Box<Slots<u8>>, reason: pkg::store::RewriteAbortReason) -> result: unit writes(text) {
  match reason {
    None() => {
    }
    Reserve() => {
      text_word(text: text, word: &info_rw_reason_reserve[0_u64..7_u64]);
    }
    Capture() => {
      text_word(text: text, word: &info_rw_reason_capture[0_u64..7_u64]);
    }
    JournalSlots() => {
      text_word(text: text, word: &info_rw_reason_journal_slots[0_u64..13_u64]);
    }
    Flush() => {
      text_word(text: text, word: &info_rw_reason_flush[0_u64..5_u64]);
    }
    SequenceExhausted() => {
      text_word(text: text, word: &info_rw_reason_sequence_exhausted[0_u64..18_u64]);
    }
    MemoryPressure() => {
      text_word(text: text, word: &info_rw_reason_memory_pressure[0_u64..15_u64]);
    }
    Cancelled() => {
      text_word(text: text, word: &info_rw_reason_cancelled[0_u64..9_u64]);
    }
    BaseIo() => {
      text_word(text: text, word: &info_rw_reason_base_io[0_u64..7_u64]);
    }
    WriterIo() => {
      text_word(text: text, word: &info_rw_reason_writer_io[0_u64..9_u64]);
    }
    Drain() => {
      text_word(text: text, word: &info_rw_reason_drain[0_u64..5_u64]);
    }
    Boundary() => {
      text_word(text: text, word: &info_rw_reason_boundary[0_u64..8_u64]);
    }
    InstallIo() => {
      text_word(text: text, word: &info_rw_reason_install_io[0_u64..10_u64]);
    }
    RotationReserve() => {
      text_word(text: text, word: &info_rw_reason_rotation_reserve[0_u64..16_u64]);
    }
    SequenceInvalid() => {
      text_word(text: text, word: &info_rw_reason_sequence_invalid[0_u64..16_u64]);
    }
    JournalInvalid() => {
      text_word(text: text, word: &info_rw_reason_journal_invalid[0_u64..15_u64]);
    }
    Admission() => {
      text_word(text: text, word: &info_rw_reason_admission[0_u64..9_u64]);
    }
  }
  return unit;
}
