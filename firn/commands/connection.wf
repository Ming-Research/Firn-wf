fn denied(client: &Client) -> stopped: Bool writes(client) {
  doc "Whether the connection must still authenticate, in which case the command is answered NOAUTH, as Redis answers every command but AUTH, HELLO and QUIT from such a connection once the command is known and its arguments are counted.";
  if client^.locked {
    reply_error(client: client, word: &text_noauth[0_u64..31_u64]);
    return True();
  }
  return False();
}

fn window_matches(input: &[u8], span: Span, window: &[u8]) -> equal: Bool reads(input), reads(window) {
  doc "Whether an argument holds exactly the bytes of a window, reading every byte of the window whatever the argument holds and never stopping at the first difference, so that the time taken depends on the window's length alone.";
  let length = window^.len;
  let difference = 0_u8;
  if span.length != length {
    set difference = 1_u8;
  }
  for @bytes (offset in 0_u64..length) {
    let expected = window^[offset];
    let given = 0_u8;
    if offset < span.length {
      let position = span.start +wrap offset;
      set given = byte_at(input: input, index: position);
    }
    let mixed = ixor(expected, given);
    set difference = ior(difference, mixed);
  }
  let equal = difference == 0_u8;
  return equal;
}

fn secret_matches(input: &[u8], span: Span, secret: &Bytes) -> equal: Bool reads(input), reads(secret) {
  doc "Whether an argument holds exactly the bytes of a secret, compared as window_matches compares them.";
  match secret^ {
    Short(bytes: short) => {
      let length = short^.len;
      let window = &short^[0_u64..length];
      let equal = window_matches(input: input, span: span, window: window);
      return equal;
    }
    Long(bytes: long) => {
      let length = long^.inner.len;
      let window = &long^.inner[0_u64..length];
      let equal = window_matches(input: input, span: span, window: window);
      return equal;
    }
  }
}

fn exact_word(input: &[u8], span: Span, word: &[u8]) -> same: Bool reads(input), reads(word) {
  doc "Whether an argument spells a word exactly, case included.";
  if span.length != word^.len {
    return False();
  }
  for @bytes (offset in 0_u64..span.length) {
    let position = span.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    let expected = byte_at(input: word, index: offset);
    if byte != expected {
      return False();
    }
  }
  return True();
}

fn credentials_accepted(secret: &Bytes, input: &[u8], user: Span, password: Span) -> accepted: Bool reads(secret), reads(input) {
  doc "Whether a user name and a password authenticate as Redis's check of its default user does against the configured password, the secret: default, spelled exactly, is the only user, and it takes any password while none is configured.";
  let named = exact_word(input: input, span: user, word: &word_default[0_u64..7_u64]);
  if named {
  } else {
    return False();
  }
  let length = bytes_length(bytes: secret);
  if length == 0_u64 {
    return True();
  }
  let right = secret_matches(input: input, span: password, secret: secret);
  return right;
}

fn set_name(client: &Client, input: &[u8], name: Span) -> named: Bool reads(input), writes(client) {
  doc "Gives the connection a name as CLIENT SETNAME does and returns true, the empty name removing it; a name holding a byte outside ! to ~, a space or a line break among them, is refused with Redis's error, and the connection keeps its name.";
  for @bytes (offset in 0_u64..name.length) {
    let position = name.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    let below = byte < 33_u8;
    let above = byte > 126_u8;
    let outside = bor(below, above);
    if outside {
      reply_error(client: client, word: &text_client_names[0_u64..71_u64]);
      return False();
    }
  }
  let made = bytes_new(input: input, start: name.start, length: name.length);
  set client^.name = move made;
  set client^.changed = True();
  return True();
}

fn run_auth(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(store), reads(input), reads(args), writes(client) waits {
  doc "AUTH [username] password: authenticates the connection as Redis 7.0 does with its one user, default, against the password the server's state holds now, which CONFIG SET may have changed. With a password configured, the right one, alone or after the user name default, authenticates the connection, which then stays authenticated as Redis's flag does, and a wrong one or another user name is answered WRONGPASS and leaves the connection as it was. With none configured, a password alone is answered with Redis's error for that, and default with any password succeeds and authenticates the connection, as in Redis. More than two arguments are a syntax error.";
  let count = args^.inner.len;
  if count > 3_u64 {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return unit;
  }
  let accepted = False();
  if count == 2_u64 {
    let password = arg(args: args, index: 1_u64);
    let configured = False();
    atomic v = &store^.server {
      let length = bytes_length(bytes: &v^.password);
      set configured = length > 0_u64;
      set accepted = secret_matches(input: input, span: password, secret: &v^.password);
    }
    if configured {
    } else {
      reply_error(client: client, word: &text_auth_unset[0_u64..124_u64]);
      return unit;
    }
  } else {
    let user = arg(args: args, index: 1_u64);
    let password = arg(args: args, index: 2_u64);
    atomic v = &store^.server {
      set accepted = credentials_accepted(secret: &v^.password, input: input, user: user, password: password);
    }
  }
  if accepted {
    set client^.authenticated = True();
    set client^.locked = False();
    reply_ok(client: client);
  } else {
    reply_error(client: client, word: &text_wrongpass[0_u64..61_u64]);
  }
  return unit;
}

fn run_hello(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(store), reads(input), reads(args), writes(client) waits {
  doc "HELLO [protover [AUTH username password] [SETNAME clientname]]: answers in Redis's form. A version that is not a number is refused with Redis's error, and one other than 2 or 3 as unsupported. The options then apply in order, AUTH as AUTH with a user name applies, against the password the server's state holds now, SETNAME as CLIENT SETNAME does, each stopping the command at its error with the options before it applied, and any other option is a syntax error; an option's name is read up to a zero byte, as Redis's strcasecmp reads it. A connection that has not authenticated is then refused, as Redis checks its flag of authentication even once no password is required; any other switches to the version given, keeps its own when none is, and is answered in it with Redis's map of the server's facts, an array under RESP2: server redis and version 7.2.16, the server and version whose replies firn follows, the protocol now in use, the connection's id, standalone mode, the master role and no modules.";
  let count = args^.inner.len;
  let requested = 0_u64;
  if count >= 2_u64 {
    let version = arg(args: args, index: 1_u64);
    let number = read_integer(input: input, start: version.start, length: version.length);
    if number.state != 1_u64 {
      reply_error(client: client, word: &text_proto_number[0_u64..54_u64]);
      return unit;
    }
    let low = number.value < 2_i64;
    let high = number.value > 3_i64;
    let unsupported = bor(low, high);
    if unsupported {
      reply_error(client: client, word: &text_noproto[0_u64..36_u64]);
      return unit;
    }
    set requested = cvt.wrap::<i64, u64>(number.value);
  }
  let index = 2_u64;
  loop @options {
    if index >= count {
      break @options;
    }
    let option = arg(args: args, index: index);
    let last = count -wrap 1_u64;
    let more = last -wrap index;
    let spelled = before_zero(input: input, span: option);
    let authenticating = name_is(input: input, start: option.start, length: spelled, word: &word_auth[0_u64..4_u64]);
    let naming = name_is(input: input, start: option.start, length: spelled, word: &word_setname[0_u64..7_u64]);
    let paired = more >= 2_u64;
    let single = more >= 1_u64;
    let auth_option = band(authenticating, paired);
    let name_option = band(naming, single);
    if auth_option {
      let user_index = index +wrap 1_u64;
      let password_index = index +wrap 2_u64;
      let user = arg(args: args, index: user_index);
      let password = arg(args: args, index: password_index);
      let accepted = False();
      atomic v = &store^.server {
        set accepted = credentials_accepted(secret: &v^.password, input: input, user: user, password: password);
      }
      if accepted {
        set client^.authenticated = True();
        set client^.locked = False();
      } else {
        reply_error(client: client, word: &text_wrongpass[0_u64..61_u64]);
        return unit;
      }
      set index = index +wrap 3_u64;
    } else if name_option {
      let name_index = index +wrap 1_u64;
      let name = arg(args: args, index: name_index);
      let named = set_name(client: client, input: input, name: name);
      if named {
      } else {
        return unit;
      }
      set index = index +wrap 2_u64;
    } else {
      reply_word(client: client, word: &text_hello_option[0_u64..35_u64]);
      let shown = reply_echoed(client: client, input: input, span: option, limit: option.length);
      reply_word(client: client, word: &text_quote_end[0_u64..3_u64]);
      return unit;
    }
  }
  if bnot(client^.authenticated) {
    reply_error(client: client, word: &text_hello_noauth[0_u64..205_u64]);
    return unit;
  }
  if requested != 0_u64 {
    set client^.resp = requested;
    set client^.changed = True();
  }
  reply_map(client: client, pairs: 7_u64);
  reply_word(client: client, word: &reply_hello_server[0_u64..59_u64]);
  let proto = cvt.wrap::<u64, i64>(client^.resp);
  reply_integer(client: client, value: proto);
  reply_word(client: client, word: &reply_hello_id[0_u64..8_u64]);
  let id = cvt.wrap::<u64, i64>(client^.id);
  reply_integer(client: client, value: id);
  reply_word(client: client, word: &reply_hello_tail[0_u64..66_u64]);
  return unit;
}

fn run_quit(client: &Client) -> result: unit writes(client) {
  doc "QUIT: answers OK and marks the connection to close once its replies are sent, the requests after it left unread, as Redis does; it takes any arguments and needs no authentication.";
  reply_ok(client: client);
  set client^.closing = True();
  return unit;
}

fn client_arity(input: &[u8], args: &Box<Slots<Span>>) -> arity: i64 reads(input), reads(args) {
  doc "The command-table arity of the seven supported CLIENT subcommands in Redis 7.2.16's src/commands/client-*.json, zero for an unknown subcommand; option syntax is checked only when the queued or standalone command runs.";
  let sub = arg(args: args, index: 1_u64);
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_id[0_u64..2_u64]) {
    return 2_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_getname[0_u64..7_u64]) {
    return 2_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_setname[0_u64..7_u64]) {
    return 3_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_info[0_u64..4_u64]) {
    return 2_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_setinfo[0_u64..7_u64]) {
    return 4_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_list[0_u64..4_u64]) {
    return -2_i64;
  }
  if name_is(input: input, start: sub.start, length: sub.length, word: &word_no_touch[0_u64..8_u64]) {
    return 3_i64;
  }
  return 0_i64;
}

fn run_client(table: &ClientTable, input: &[u8], args: &Box<Slots<Span>>, client: &Client, multi: i64) -> result: unit reads(table), reads(input), reads(args), writes(client) {
  doc "CLIENT ID, CLIENT GETNAME, CLIENT SETNAME name, CLIENT INFO, CLIENT SETINFO, CLIENT LIST and CLIENT NO-TOUCH answer as Redis 7.2.16 does: the connection's id; its name, or the null bulk string when it has none; OK once SETNAME has given or removed the name; the connection's line of facts, as put_own_line writes it; OK once SETINFO has given or cleared the library name or version; the lines of the live connections, as run_client_list writes them; and OK once NO-TOUCH has turned the mode on or off. Each given the wrong number of arguments is answered as Redis answers it, and then a connection that must authenticate first is answered NOAUTH. Any other subcommand (CACHING, GETREDIR, HELP, KILL, NO-EVICT, PAUSE, REPLY, TRACKING, TRACKINGINFO, UNBLOCK and UNPAUSE) is answered as Redis answers an unknown one, its name echoed to 128 bytes.";
  let count = args^.inner.len;
  let sub = arg(args: args, index: 1_u64);
  let identifying = name_is(input: input, start: sub.start, length: sub.length, word: &word_id[0_u64..2_u64]);
  let getting = name_is(input: input, start: sub.start, length: sub.length, word: &word_getname[0_u64..7_u64]);
  let setting = name_is(input: input, start: sub.start, length: sub.length, word: &word_setname[0_u64..7_u64]);
  let informing = name_is(input: input, start: sub.start, length: sub.length, word: &word_info[0_u64..4_u64]);
  let marking = name_is(input: input, start: sub.start, length: sub.length, word: &word_setinfo[0_u64..7_u64]);
  let listing = name_is(input: input, start: sub.start, length: sub.length, word: &word_list[0_u64..4_u64]);
  let touching = name_is(input: input, start: sub.start, length: sub.length, word: &word_no_touch[0_u64..8_u64]);
  if informing {
    if count != 2_u64 {
      reply_arity_word(client: client, word: &word_client_info[0_u64..11_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    run_client_info(client: client, multi: multi);
    return unit;
  }
  if marking {
    if count != 4_u64 {
      reply_arity_word(client: client, word: &word_client_setinfo[0_u64..14_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    run_client_setinfo(input: input, args: args, client: client);
    return unit;
  }
  if listing {
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    run_client_list(table: table, input: input, args: args, client: client, multi: multi);
    return unit;
  }
  if touching {
    if count != 3_u64 {
      reply_arity_word(client: client, word: &word_client_no_touch[0_u64..15_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    let option = arg(args: args, index: 2_u64);
    let on = name_is(input: input, start: option.start, length: option.length, word: &word_on[0_u64..2_u64]);
    let off = name_is(input: input, start: option.start, length: option.length, word: &word_off[0_u64..3_u64]);
    if on {
      set client^.no_touch = True();
      reply_ok(client: client);
    } else if off {
      set client^.no_touch = False();
      reply_ok(client: client);
    } else {
      reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    }
    return unit;
  }
  if identifying {
    if count != 2_u64 {
      reply_arity_word(client: client, word: &word_client_id[0_u64..9_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    let id = cvt.wrap::<u64, i64>(client^.id);
    reply_integer(client: client, value: id);
    return unit;
  }
  if getting {
    if count != 2_u64 {
      reply_arity_word(client: client, word: &word_client_getname[0_u64..14_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    let length = bytes_length(bytes: &client^.name);
    if length == 0_u64 {
      reply_nil(client: client);
      return unit;
    }
    let name = bytes_copy(bytes: &client^.name);
    reply_text(client: client, text: &name);
    return unit;
  }
  if setting {
    if count != 3_u64 {
      reply_arity_word(client: client, word: &word_client_setname[0_u64..14_u64]);
      return unit;
    }
    let stopped = denied(client: client);
    if stopped {
      return unit;
    }
    let name = arg(args: args, index: 2_u64);
    let named = set_name(client: client, input: input, name: name);
    if named {
      reply_ok(client: client);
    }
    return unit;
  }
  reply_word(client: client, word: &text_unknown_subcommand[0_u64..25_u64]);
  let shown = imin(sub.length, 128_u64);
  let echoed = reply_echoed(client: client, input: input, span: sub, limit: shown);
  reply_word(client: client, word: &text_try_client[0_u64..21_u64]);
  return unit;
}

fn text_bytes(text: &Box<Slots<u8>>, bytes: &Bytes) -> result: unit reads(bytes), writes(text) {
  doc "Appends the bytes of a string to the text.";
  let duplicate = bytes_copy(bytes: bytes);
  let boxed = bytes_boxed(bytes: move duplicate);
  text_boxed(text: text, boxed: &boxed);
  return unit;
}

fn text_boxed(text: &Box<Slots<u8>>, boxed: &Box<Slots<u8>>) -> result: unit reads(boxed), writes(text) {
  doc "Appends the bytes of an allocated string to the text.";
  let length = boxed^.inner.len;
  text_word(text: text, word: &boxed^.inner[0_u64..length]);
  return unit;
}

fn put_age(text: &Box<Slots<u8>>, current: u64, since: u64) -> result: unit writes(text) {
  doc "Appends a connection's age in whole seconds, counted on the calendar clock as Redis counts a client's age, a minus sign and the difference when the clock was set back.";
  if since > current {
    let back = since -wrap current;
    text_word(text: text, word: &client_info_minus[0_u64..1_u64]);
    text_number(text: text, value: back);
  } else {
    let age = current -wrap since;
    text_number(text: text, value: age);
  }
  return unit;
}

fn put_own_line(text: &Box<Slots<u8>>, client: &Client, command: &[u8], multi: i64) -> result: unit reads(client), reads(command), writes(text) {
  doc "The line of facts of the connection running CLIENT INFO or CLIENT LIST, in Redis 7.2.16's catClientInfoString form, name=value pairs in Redis's order separated by spaces and ended by a line feed. The fields carry real values where firn has them: the id, both addresses, the name, the whole seconds since the server began serving the connection, the protocol and the library name and version. The fields that follow the connection's latest interaction are true of the connection while it runs this command and are given for it alone: idle 0, since the interaction is the read that brought this command; the flag x during EXEC followed by T while NO-TOUCH is on, N when neither is set; multi is the whole queue's command count during EXEC and -1 outside it; and cmd is exec during EXEC, which Redis retains in lastcmd, or the command given outside it. No publish and subscribe, blocking or tracking is open. The others are fixed and true of firn: database 0, firn's one; no subscriptions; the user default, firn's one; and no tracking redirection. Fields firn cannot measure, the descriptor, the events and the sizes of Redis's buffers, are left out.";
  text_word(text: text, word: &client_info_id[0_u64..3_u64]);
  text_number(text: text, value: client^.id);
  text_word(text: text, word: &client_info_addr[0_u64..6_u64]);
  text_bytes(text: text, bytes: &client^.addr);
  text_word(text: text, word: &client_info_laddr[0_u64..7_u64]);
  text_bytes(text: text, bytes: &client^.laddr);
  text_word(text: text, word: &client_info_name[0_u64..6_u64]);
  text_bytes(text: text, bytes: &client^.name);
  text_word(text: text, word: &client_info_age[0_u64..5_u64]);
  let current = client^.unix_us / 1000000_u64;
  let since = client^.since_us / 1000000_u64;
  put_age(text: text, current: current, since: since);
  text_word(text: text, word: &client_info_idle[0_u64..14_u64]);
  if multi >= 0_i64 {
    text_word(text: text, word: &client_info_flag_x[0_u64..1_u64]);
  }
  if client^.no_touch {
    text_word(text: text, word: &client_info_flag_t[0_u64..1_u64]);
  } else if multi < 0_i64 {
    text_word(text: text, word: &client_info_flag_n[0_u64..1_u64]);
  }
  text_word(text: text, word: &client_info_shared[0_u64..25_u64]);
  text_word(text: text, word: &client_info_multi[0_u64..7_u64]);
  if multi >= 0_i64 {
    let queued_count = cvt.wrap::<i64, u64>(multi);
    text_number(text: text, value: queued_count);
  } else {
    text_word(text: text, word: &client_info_no_multi[0_u64..2_u64]);
  }
  text_word(text: text, word: &client_info_command[0_u64..5_u64]);
  if multi >= 0_i64 {
    text_word(text: text, word: &client_info_exec[0_u64..4_u64]);
  } else {
    text_word(text: text, word: command);
  }
  text_word(text: text, word: &client_info_tail[0_u64..28_u64]);
  text_number(text: text, value: client^.resp);
  text_word(text: text, word: &client_info_lib_name[0_u64..10_u64]);
  text_bytes(text: text, bytes: &client^.lib_name);
  text_word(text: text, word: &client_info_lib_ver[0_u64..9_u64]);
  text_bytes(text: text, bytes: &client^.lib_ver);
  text_word(text: text, word: &client_info_end[0_u64..1_u64]);
  return unit;
}

fn put_record_line(text: &Box<Slots<u8>>, record: &ClientRecord, current: u64) -> result: unit reads(record), writes(text) {
  doc "The line of another connection, from the record it published, in the form put_own_line writes, but for the fields that follow that connection's latest interaction, idle, flags, multi and cmd, which the record does not hold and which are left out, so that every field given is true. The age counts from the connection's start to the caller's reading of the calendar clock.";
  text_word(text: text, word: &client_info_id[0_u64..3_u64]);
  text_number(text: text, value: record^.id);
  text_word(text: text, word: &client_info_addr[0_u64..6_u64]);
  text_boxed(text: text, boxed: &record^.addr);
  text_word(text: text, word: &client_info_laddr[0_u64..7_u64]);
  text_boxed(text: text, boxed: &record^.laddr);
  text_word(text: text, word: &client_info_name[0_u64..6_u64]);
  text_boxed(text: text, boxed: &record^.name);
  text_word(text: text, word: &client_info_age[0_u64..5_u64]);
  let since = record^.since_us / 1000000_u64;
  put_age(text: text, current: current, since: since);
  text_word(text: text, word: &client_info_shared[0_u64..25_u64]);
  text_word(text: text, word: &client_info_tail[0_u64..28_u64]);
  text_number(text: text, value: record^.resp);
  text_word(text: text, word: &client_info_lib_name[0_u64..10_u64]);
  text_boxed(text: text, boxed: &record^.lib_name);
  text_word(text: text, word: &client_info_lib_ver[0_u64..9_u64]);
  text_boxed(text: text, boxed: &record^.lib_ver);
  text_word(text: text, word: &client_info_end[0_u64..1_u64]);
  return unit;
}

fn put_client_line(text: &Box<Slots<u8>>, record: &ClientRecord, client: &Client, current: u64, multi: i64) -> result: unit reads(record), reads(client), writes(text) {
  doc "Appends one selected client record, taking the calling connection's current facts from its own state and another connection's facts from the record it published.";
  if record^.id == client^.id {
    put_own_line(text: text, client: client, command: &word_client_list[0_u64..11_u64], multi: multi);
  } else {
    put_record_line(text: text, record: record, current: current);
  }
  return unit;
}

fn put_clients(table: &ClientTable, client: &Client, text: &Box<Slots<u8>>, filtered: Bool, wanted: u64, multi: i64) -> result: unit reads(table), reads(client), writes(text) {
  doc "Appends the lines of the live connections from the table already held by the caller: a filtered lookup binary-searches once for wanted and emits its line only when that id is present; an unfiltered call visits every record in client-number order.";
  let current = client^.unix_us / 1000000_u64;
  if filtered {
    let position = pkg::store::client_table_position(table: table, id: wanted);
    if position < table^.records.inner.len {
      let found = &table^.records.inner[position];
      if found^.id == wanted {
        put_client_line(text: text, record: found, client: client, current: current, multi: multi);
      }
    }
    return unit;
  }
  let count = table^.records.inner.len;
  for @records (index in 0_u64..count) {
    if index < table^.records.inner.len {
      let record = &table^.records.inner[index];
      put_client_line(text: text, record: record, client: client, current: current, multi: multi);
    }
  }
  return unit;
}

fn run_client_info(client: &Client, multi: i64) -> result: unit writes(client) {
  doc "CLIENT INFO: the connection's line of facts, as put_own_line writes it, as text, a bulk string under RESP2 and a verbatim string under RESP3.";
  let text = box_slots_new::<u8>(capacity: 512_u64);
  put_own_line(text: &text, client: client, command: &word_client_info[0_u64..11_u64], multi: multi);
  let length = text.inner.len;
  let window = &text.inner[0_u64..length];
  reply_verbatim(client: client, input: window, start: 0_u64, length: length);
  return unit;
}

fn run_client_list(table: &ClientTable, input: &[u8], args: &Box<Slots<Span>>, client: &Client, multi: i64) -> result: unit reads(table), reads(input), reads(args), writes(client) {
  doc "CLIENT LIST, CLIENT LIST TYPE normal|master|replica|slave|pubsub and CLIENT LIST ID id...: the lines of the live connections as Redis 7.2.16's clientCommand answers, as text. A type other than normal lists nothing, firn having no replica, master or publish and subscribe connection; an unknown type, an id that is not an integer and any other arguments are answered with Redis's errors, and an id naming no connection lists nothing for it, one named twice twice.";
  let count = args^.inner.len;
  let text = box_slots_new::<u8>(capacity: 512_u64);
  let option = arg(args: args, index: 2_u64);
  let typed = name_is(input: input, start: option.start, length: option.length, word: &word_type[0_u64..4_u64]);
  let identified = name_is(input: input, start: option.start, length: option.length, word: &word_id[0_u64..2_u64]);
  let four = count == 4_u64;
  let over_three = count > 3_u64;
  let by_type = band(four, typed);
  let by_id = band(over_three, identified);
  if by_type {
    let kind = arg(args: args, index: 3_u64);
    let normal = name_is(input: input, start: kind.start, length: kind.length, word: &word_normal[0_u64..6_u64]);
    let master = name_is(input: input, start: kind.start, length: kind.length, word: &word_master[0_u64..6_u64]);
    let replica = name_is(input: input, start: kind.start, length: kind.length, word: &word_replica[0_u64..7_u64]);
    let slave = name_is(input: input, start: kind.start, length: kind.length, word: &word_slave[0_u64..5_u64]);
    let pubsub = name_is(input: input, start: kind.start, length: kind.length, word: &word_pubsub[0_u64..6_u64]);
    let replicas = bor(replica, slave);
    let fanned = bor(replicas, pubsub);
    let others = bor(master, fanned);
    if normal {
      let unfilteredall = False();
      put_clients(table: table, client: client, text: &text, filtered: unfilteredall, wanted: 0_u64, multi: multi);
    } else if others {
    } else {
      reply_word(client: client, word: &text_unknown_type[0_u64..26_u64]);
      let shown = reply_echoed(client: client, input: input, span: kind, limit: kind.length);
      reply_word(client: client, word: &text_quote_end[0_u64..3_u64]);
      return unit;
    }
  } else if by_id {
    for @identifiers (index in 3_u64..count) {
      let given = arg(args: args, index: index);
      let number = read_integer(input: input, start: given.start, length: given.length);
      if number.state != 1_u64 {
        reply_error(client: client, word: &text_invalid_id[0_u64..21_u64]);
        return unit;
      }
      let wanted = cvt.wrap::<i64, u64>(number.value);
      let byid = True();
      put_clients(table: table, client: client, text: &text, filtered: byid, wanted: wanted, multi: multi);
    }
  } else if count != 2_u64 {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return unit;
  } else {
    let everyone = False();
    put_clients(table: table, client: client, text: &text, filtered: everyone, wanted: 0_u64, multi: multi);
  }
  let length = text.inner.len;
  let window = &text.inner[0_u64..length];
  reply_verbatim(client: client, input: window, start: 0_u64, length: length);
  return unit;
}

fn run_client_setinfo(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "CLIENT SETINFO LIB-NAME|LIB-VER value as Redis 7.2.16's clientSetinfoCommand answers: an attribute other than the two is refused naming it as typed; a value holding a byte outside ! to ~ before its first zero byte, validateClientAttr reading it as a C string, is refused naming the attribute as typed and leaves the stored value; otherwise the value, cut at a zero byte as Redis prints it, replaces the stored one, the empty value removing it, and the answer is OK.";
  let attr = arg(args: args, index: 2_u64);
  let value = arg(args: args, index: 3_u64);
  let naming = name_is(input: input, start: attr.start, length: attr.length, word: &word_lib_name[0_u64..8_u64]);
  let versioning = name_is(input: input, start: attr.start, length: attr.length, word: &word_lib_ver[0_u64..7_u64]);
  let known = bor(naming, versioning);
  if bnot(known) {
    reply_word(client: client, word: &text_unrecognized[0_u64..26_u64]);
    let shown = reply_echoed(client: client, input: input, span: attr, limit: attr.length);
    reply_word(client: client, word: &text_quote_end[0_u64..3_u64]);
    return unit;
  }
  let live = value.length;
  let ended = False();
  for @scan (offset in 0_u64..value.length) {
    if bnot(ended) {
      let position = value.start +wrap offset;
      let byte = byte_at(input: input, index: position);
      if byte == 0_u8 {
        set ended = True();
        set live = offset;
      } else {
        let below = byte < 33_u8;
        let above = byte > 126_u8;
        let outside = bor(below, above);
        if outside {
          reply_word(client: client, word: &text_err_prefix[0_u64..5_u64]);
          let shown = reply_echoed(client: client, input: input, span: attr, limit: attr.length);
          reply_word(client: client, word: &text_cannot_contain[0_u64..57_u64]);
          return unit;
        }
      }
    }
  }
  let made = bytes_new(input: input, start: value.start, length: live);
  if naming {
    set client^.lib_name = move made;
  } else {
    set client^.lib_ver = move made;
  }
  set client^.changed = True();
  reply_ok(client: client);
  return unit;
}

fn select_plan(input: &[u8], args: &Box<Slots<Span>>) -> error: u64 reads(input), reads(args) {
  doc "SELECT's parsing and one-database body: 0 selects database zero, 1 is not an integer, 2 exceeds signed 32 bits, 3 names an unavailable database. No key or metadata changes are needed.";
  let index = arg(args: args, index: 1_u64);
  let number = read_integer(input: input, start: index.start, length: index.length);
  if number.state != 1_u64 {
    return 1_u64;
  }
  let below = number.value < -2147483648_i64;
  let above = number.value > 2147483647_i64;
  let outside = bor(below, above);
  if outside {
    return 2_u64;
  }
  if number.value != 0_i64 {
    return 3_u64;
  }
  return 0_u64;
}

fn select_finish(client: &Client, error: u64) -> result: unit writes(client) {
  doc "SELECT's reply and refusals, shared by the network, EXEC and scripts.";
  if error == 1_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
  } else if error == 2_u64 {
    reply_error(client: client, word: &text_select_range[0_u64..72_u64]);
  } else if error == 3_u64 {
    reply_error(client: client, word: &text_db_range[0_u64..28_u64]);
  } else {
    reply_ok(client: client);
  }
  return unit;
}

fn run_select(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "SELECT index through select_plan and select_finish, with no key or metadata work: firn has one database, so selecting zero leaves the connection as it was.";
  let error = select_plan(input: input, args: args);
  select_finish(client: client, error: error);
  return unit;
}

struct TimeReply {
  seconds: i64;
  microseconds: i64;
}

fn time_body(unix_us: u64) -> made: TimeReply pure {
  doc "TIME's body over the calendar reading, with no arguments to parse or keyspace metadata to change.";
  let seconds = unix_us / 1000000_u64;
  let micro = unix_us % 1000000_u64;
  let whole = cvt.wrap::<u64, i64>(seconds);
  let part = cvt.wrap::<u64, i64>(micro);
  return TimeReply(seconds: whole, microseconds: part);
}

fn time_finish(client: &Client, value: &TimeReply) -> result: unit reads(value), writes(client) {
  doc "TIME's reply: two bulk strings of decimal seconds and microseconds.";
  reply_array(client: client, count: 2_u64);
  reply_bulk_decimal(client: client, value: value^.seconds);
  reply_bulk_decimal(client: client, value: value^.microseconds);
  return unit;
}

fn run_time(client: &Client) -> result: unit writes(client) {
  doc "TIME through time_body and time_finish: the calendar time as the clocks were last read, preserving the network path's clock source.";
  let value = time_body(unix_us: client^.unix_us);
  time_finish(client: client, value: &value);
  return unit;
}
