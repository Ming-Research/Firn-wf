struct Counted {
  value: i64;
  delta: i64;
  now: u64;
  state: u64;
}

struct Delta {
  state: u64;
  value: i64;
}

struct StringOptions {
  flags: u64;
  amount: u64;
  valid: Bool;
}

struct Deadline {
  at: u64;
  state: u64;
}

struct FloatSum {
  increment: Reading;
  text: Bytes;
  now: u64;
  state: u64;
}

fn run_ping(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "PING [message]: answers PONG, or the message as a bulk string.";
  if args^.inner.len > 2_u64 {
    let name = arg(args: args, index: 0_u64);
    reply_arity(client: client, input: input, name: name);
    return unit;
  }
  if args^.inner.len == 2_u64 {
    let message = arg(args: args, index: 1_u64);
    reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
    return unit;
  }
  reply_word(client: client, word: &reply_pong[0_u64..7_u64]);
  return unit;
}

fn run_echo(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "ECHO message: answers the message as a bulk string.";
  let message = arg(args: args, index: 1_u64);
  reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
  return unit;
}

fn text_value(env: &Client, value: &Entry) -> kind: u64 reads(value), writes(env) {
  doc "Writes a live string's bytes as a bulk string reply, recording done; records wrong for another kind and expired for an expired entry, writing nothing.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 0_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      reply_text(client: env, text: stored);
      set env^.state = state_done;
      return 1_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 2_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 4_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 5_u64;
    }
  }
}

fn run_get(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "GET key: answers a live string as a bulk string, written into the reply inside the statement on the key that finds it; a key whose expiry has passed is removed there instead.";
  let journal = None<pkg::store::AccessJournal>();
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  atomic slot = &store^.keys[key] {
    get_body(journal: &journal, access_key: key, slot: slot, client: client);
  }
  if client^.state == state_expired {
    remove_expired(store: store, key: key, now: client^.now);
  }
  get_finish(client: client);
  return unit;
}

fn get_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client) -> result: unit reads(access_key), reads(slot), writes(journal), writes(slot.Some.value.access), writes(client) {
  doc "GET's work on its key's entry, held by the caller, against the client's now: a live string is written as a bulk string reply, recording done; another kind records wrong and an expired entry expired, writing nothing; an absent entry leaves the state as the caller set it.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  match slot^ {
    Some(value: held) => {
      let kind = text_value(env: client, value: held);
    }
    None() => {
    }
  }
  return unit;
}

fn get_finish(client: &Client) -> result: unit writes(client) {
  doc "GET's reply after its work: nothing more once a string was written, WRONGTYPE for another kind, and the null bulk string for an absent or expired key.";
  if client^.state == state_done {
    return unit;
  }
  if client^.state == state_wrong {
    reply_wrong_type(client: client);
    return unit;
  }
  reply_nil(client: client);
  return unit;
}

fn put_text(client: &Client, slot: &Option<Entry>, value: Bytes, expires: u64) -> result: unit reads(client), writes(slot) {
  doc "Stores a string in an entry, replacing any value it held.";
  let text = Value::Text(bytes: move value);
  let stamp = replacement_access(slot: slot, client: client);
  let held_entry = Entry(value: move text, expires: expires, access: stamp);
  set slot^ = Some<Entry>(value: move held_entry);
  return unit;
}

fn string_options(input: &[u8], args: &Box<Slots<Span>>, first: u64, setting: Bool) -> options: StringOptions reads(input), reads(args) {
  doc "Reads SET's options from the argument at first on (setting), or GETEX's (not setting), as Redis 7.0.15's parseExtendedStringArgumentsOrReply reads them, each word compared in either case up to a zero byte: NX or XX, GET and KEEPTTL for SET alone, PERSIST for GETEX alone, and EX, PX, EXAT or PXAT followed by its amount, whose index amount records, a later amount of the same option replacing an earlier one. An option beside one it excludes, an expiry option with no argument after it and any other word make the options invalid, which Redis answers as a syntax error.";
  let count = args^.inner.len;
  let flags = 0_u64;
  let amount = 0_u64;
  let index = first;
  let readable = True();
  loop @options {
    if index >= count {
      break @options;
    }
    let span = arg(args: args, index: index);
    let code = option_code(input: input, span: span);
    let flag = 0_u64;
    let refused = 0_u64;
    let allowed = setting;
    let expiry = False();
    if code == code_nx {
      set flag = option_nx;
      set refused = option_xx;
    } else if code == code_xx {
      set flag = option_xx;
      set refused = option_nx;
    } else if code == code_get {
      set flag = option_get;
    } else if code == code_keepttl {
      set flag = option_keepttl;
      set refused = ior(option_persist, options_expiry);
    } else if code == code_persist {
      set flag = option_persist;
      set refused = ior(option_keepttl, options_expiry);
      set allowed = bnot(setting);
    } else if code == code_ex {
      set flag = option_ex;
      set expiry = True();
    } else if code == code_px {
      set flag = option_px;
      set expiry = True();
    } else if code == code_exat {
      set flag = option_exat;
      set expiry = True();
    } else if code == code_pxat {
      set flag = option_pxat;
      set expiry = True();
    }
    let following = index +wrap 1_u64;
    if expiry {
      set allowed = following < count;
      let others = ixor(options_expiry, flag);
      let persistence = ior(option_keepttl, option_persist);
      set refused = ior(persistence, others);
    }
    let clash = iand(flags, refused);
    let unknown = flag == 0_u64;
    let excluded = clash != 0_u64;
    let barred = bnot(allowed);
    let misplaced = bor(excluded, barred);
    let refusal = bor(unknown, misplaced);
    if refusal {
      set readable = False();
      break @options;
    }
    set flags = ior(flags, flag);
    if expiry {
      set amount = following;
      set index = following;
    }
    set index = index +wrap 1_u64;
  }
  return StringOptions(flags: flags, amount: amount, valid: readable);
}

fn string_deadline(input: &[u8], span: Span, flags: u64, unix_ms: u64) -> deadline: Deadline reads(input) {
  doc "The calendar milliseconds an expiry option's amount names, as Redis 7.0.15's getExpireMillisecondsOrReply reads it: a positive integer, of seconds for EX and EXAT, at most what milliseconds in i64 hold, and of milliseconds for PX and PXAT, EX and PX counting from the command's time. State 1 is an expiry, 0 an amount that is not an integer, and 2 one that is not positive or whose milliseconds, or their sum with the command's time, leave the range of i64, which Redis answers as an invalid expire time.";
  let number = read_integer(input: input, start: span.start, length: span.length);
  if number.state != 1_u64 {
    return Deadline(at: 0_u64, state: 0_u64);
  }
  if number.value <= 0_i64 {
    return Deadline(at: 0_u64, state: 2_u64);
  }
  let value = cvt.wrap::<i64, u64>(number.value);
  let seconds = ior(option_ex, option_exat);
  let in_seconds = iand(flags, seconds);
  if in_seconds != 0_u64 {
    if value > 9223372036854775_u64 {
      return Deadline(at: 0_u64, state: 2_u64);
    }
    set value = value *wrap 1000_u64;
  }
  let relative = ior(option_ex, option_px);
  let counted = iand(flags, relative);
  if counted != 0_u64 {
    set value = value +wrap unix_ms;
    if value > 9223372036854775807_u64 {
      return Deadline(at: 0_u64, state: 2_u64);
    }
  }
  return Deadline(at: value, state: 1_u64);
}

fn held_expiry(slot: &Option<Entry>) -> expires: u64 reads(slot) {
  doc "The expiry an entry's value holds, zero for none and for an absent entry.";
  match slot^ {
    Some(value: held) => {
      return held^.expires;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn hold_expiry(slot: &Option<Entry>, expires: u64) -> result: unit writes(slot) {
  doc "Gives an entry's value the expiry, zero for none; an absent entry stays absent.";
  match slot^ {
    Some(value: held) => {
      set held^.expires = expires;
    }
    None() => {
    }
  }
  return unit;
}

fn reply_held_text(slot: &Option<Entry>, client: &Client) -> result: unit reads(slot), writes(client) {
  doc "Writes the string a live entry holds as a bulk string reply, as text_value writes it; another kind and an absent entry write nothing.";
  match slot^ {
    Some(value: held) => {
      let kind = text_value(env: client, value: held);
    }
    None() => {
    }
  }
  return unit;
}

fn log_set(log: &Box<Slots<u8>>, input: &[u8], key: Span, value: Span) -> result: unit reads(input), writes(log) {
  doc "Appends SET key value.";
  let room = key.length +wrap value.length;
  log_count(log: log, count: 3_u64, room: room);
  log_word(log: log, word: &word_set[0_u64..3_u64]);
  log_input(log: log, input: input, span: key);
  log_input(log: log, input: input, span: value);
  return unit;
}

fn log_set_at(log: &Box<Slots<u8>>, input: &[u8], key: Span, value: Span, at: u64) -> result: unit reads(input), writes(log) {
  doc "Appends SET key value PXAT at, the form Redis 7.0.15 propagates every store with an expiry in, the expiry as calendar milliseconds.";
  let room = key.length +wrap value.length;
  let more = room +wrap 48_u64;
  log_count(log: log, count: 5_u64, room: more);
  log_word(log: log, word: &word_set[0_u64..3_u64]);
  log_input(log: log, input: input, span: key);
  log_input(log: log, input: input, span: value);
  log_word(log: log, word: &word_pxat[0_u64..4_u64]);
  log_decimal(log: log, value: at);
  return unit;
}

fn get_option(input: &[u8], args: &Box<Slots<Span>>, index: u64) -> option: Bool reads(input), reads(args) {
  doc "Whether the argument at index is one of SET's GET options: from the fourth argument on, GET in either case up to a zero byte.";
  if index < 3_u64 {
    return False();
  }
  let span = arg(args: args, index: index);
  let code = option_code(input: input, span: span);
  let option = code == code_get;
  return option;
}

fn log_without_get(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>) -> result: unit reads(input), reads(args), writes(log) {
  doc "Appends a SET as it was sent but for its GET options, which Redis 7.0.15 leaves out of what it propagates.";
  let count = args^.inner.len;
  let kept = 0_u64;
  for @counting (index in 0_u64..count) {
    let dropped = get_option(input: input, args: args, index: index);
    if dropped {
    } else {
      set kept = kept +wrap 1_u64;
    }
  }
  log_count(log: log, count: kept, room: 0_u64);
  for @arguments (index in 0_u64..count) {
    let dropped = get_option(input: input, args: args, index: index);
    if dropped {
    } else {
      let span = args^.inner[index];
      log_input(log: log, input: input, span: span);
    }
  }
  return unit;
}

fn set_key(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, key_index: u64, value_index: u64, flags: u64, at: u64, mode: u64) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "Stores the argument at value_index under the key at key_index as Redis 7.0.15's setGenericCommand does, in one atomic statement on the key's entry that also appends the change to the append-only file's pending bytes, an expired key counting as absent and its removal recorded as log_removal records it. With GET the string the key held is written as the reply first and a key of another kind is refused, nothing stored; with NX nothing is stored over a live key, with XX nothing in place of an absent one. The value keeps the key's expiry with KEEPTTL, takes at with an expiry option, and has none otherwise. The reply is OK, or nil when nothing was stored; 1 or 0 for SETNX (mode_setnx); with GET the old string or nil alone. The file records a store with an expiry as SET key value PXAT at, GETSET (mode_getset) as SET key value, a SET with GET as it was sent without its GET options, and any other as it was sent, as Redis propagates them.";
  let journal = None<pkg::store::AccessJournal>();
  let value_span = arg(args: args, index: value_index);
  let place = key_bounds(input: input, args: args, index: key_index);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  let timed_flag = iand(flags, options_expiry);
  let timed = timed_flag != 0_u64;
  let logged = store^.logging;
  set client^.now = time^.check;
  let plan = SetPlan(flags: flags, at: at, mode: mode, key_index: key_index, value_index: value_index);
  let none = False();
  let work = SetWork(outcome: state_absent, answered: none, removed: none);
  atomic slot = &store^.keys[key], m = &store^.meta {
    set work = set_body(journal: &journal, access_key: key, slot: slot, client: client, value: move value, flags: flags, at: at);
    let stored = work.outcome == state_done;
    let queued = band(stored, timed);
    let changed = bor(stored, work.removed);
    let recorded = band(logged, changed);
    let touches = bor(queued, recorded);
    if touches {
      let appended = set_meta(due: &m^.due, log: &m^.log, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env);
    }
  }
  set_finish(client: client, plan: &plan, work: &work);
  return unit;
}

struct SetPlan {
  doc "What a SET-like command asks of its key: SET's option flags, the expiry at for an expiry option, which command it is, mode_set, mode_setnx or mode_getset, and where its key and value are among its arguments.";
  flags: u64;
  at: u64;
  mode: u64;
  key_index: u64;
  value_index: u64;
}

struct SetWork {
  doc "What a SET-like command did to its key: outcome is done when it stored, wrong when it refused another kind and absent when it stored nothing; answered records that GET's old string was written as the reply; removed that an expired value was removed first.";
  outcome: u64;
  answered: Bool;
  removed: Bool;
}

fn set_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client, value: Bytes, flags: u64, at: u64) -> work: SetWork reads(access_key), writes(journal), writes(slot), writes(client) {
  doc "A SET-like command's work on its key's entry, held by the caller, against the client's now, under SET's option flags, returning what it did, as Redis 7.0.15's setGenericCommand does: an expired value is removed first; with GET the string the key held is written as the reply and a key of another kind is refused, nothing stored; with NX nothing is stored over a live key, with XX nothing in place of an absent one. The value keeps the key's expiry with KEEPTTL, takes at with an expiry option, and has none otherwise.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let getting_flag = iand(flags, option_get);
  let getting = getting_flag != 0_u64;
  let fresh_flag = iand(flags, option_nx);
  let only_fresh = fresh_flag != 0_u64;
  let present_flag = iand(flags, option_xx);
  let only_present = present_flag != 0_u64;
  let keep_flag = iand(flags, option_keepttl);
  let keep = keep_flag != 0_u64;
  let timed_flag = iand(flags, options_expiry);
  let timed = timed_flag != 0_u64;
  let kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  let none = False();
  let found = kind != 0_u64;
  let text = kind == 1_u64;
  let other = kind > 1_u64;
  let refused = band(getting, other);
  if refused {
    let unused = move value;
    return SetWork(outcome: state_wrong, answered: none, removed: removed);
  }
  if getting {
    refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  }
  let answered = band(getting, text);
  if answered {
    reply_held_text(slot: slot, client: client);
  }
  let absent = bnot(found);
  let occupied = band(only_fresh, found);
  let missing = band(only_present, absent);
  let blocked = bor(occupied, missing);
  if blocked {
    let unused = move value;
    return SetWork(outcome: state_absent, answered: answered, removed: removed);
  }
  let expires = 0_u64;
  if keep {
    set expires = held_expiry(slot: slot);
  }
  if timed {
    set expires = at;
  }
  put_text(client: client, slot: slot, value: move value, expires: expires);
  return SetWork(outcome: state_done, answered: answered, removed: removed);
}

fn set_meta(due: &PriorityQueue<Due, ceiling>, log: &Box<Slots<u8>>, logged: Bool, plan: &SetPlan, work: &SetWork, input: &[u8], args: &Box<Slots<Span>>, key: &[u8], env: &KeyEnv) -> appended: u64 reads(plan), reads(work), reads(input), reads(args), reads(key), reads(env), writes(due), writes(log) {
  doc "What a SET-like command's work leaves to the keyspace's metadata, and the number of commands it appended to log: a stored value with an expiry option queues that expiry; when logged, an expired value's removal is recorded as log_removal records it, and a store as Redis propagates it: with an expiry as SET key value PXAT at, GETSET as SET key value, a SET with GET as it was sent without its GET options, and any other as it was sent.";
  let appended = 0_u64;
  let stored = work^.outcome == state_done;
  let timed_flag = iand(plan^.flags, options_expiry);
  let timed = timed_flag != 0_u64;
  let getting_flag = iand(plan^.flags, option_get);
  let getting = getting_flag != 0_u64;
  let key_span = arg(args: args, index: plan^.key_index);
  let value_span = arg(args: args, index: plan^.value_index);
  if logged {
    if work^.removed {
      log_removal(log: log, key: key);
      set appended = appended +wrap 1_u64;
    }
  }
  if stored {
    if timed {
      queue_due(due: due, key: key, at: plan^.at, env: env);
    }
    if logged {
      if timed {
        log_set_at(log: log, input: input, key: key_span, value: value_span, at: plan^.at);
      } else if plan^.mode == mode_getset {
        log_set(log: log, input: input, key: key_span, value: value_span);
      } else if getting {
        log_without_get(log: log, input: input, args: args);
      } else {
        log_command(log: log, input: input, args: args);
      }
      set appended = appended +wrap 1_u64;
    }
  }
  return appended;
}

fn set_finish(client: &Client, plan: &SetPlan, work: &SetWork) -> result: unit reads(plan), reads(work), writes(client) {
  doc "A SET-like command's reply after its work: WRONGTYPE for a refused kind; 1 or 0 for SETNX; with GET the old string, already written, or nil; and otherwise OK, or nil when nothing was stored.";
  if work^.outcome == state_wrong {
    reply_wrong_type(client: client);
    return unit;
  }
  let stored = work^.outcome == state_done;
  if plan^.mode == mode_setnx {
    if stored {
      reply_word(client: client, word: &reply_one[0_u64..4_u64]);
    } else {
      reply_word(client: client, word: &reply_zero[0_u64..4_u64]);
    }
    return unit;
  }
  let getting_flag = iand(plan^.flags, option_get);
  if getting_flag != 0_u64 {
    if work^.answered {
    } else {
      reply_nil(client: client);
    }
    return unit;
  }
  if stored {
    reply_ok(client: client);
    return unit;
  }
  reply_nil(client: client);
  return unit;
}

fn run_set(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "SET key value [NX | XX] [GET] [EX seconds | PX milliseconds | EXAT unix-seconds | PXAT unix-milliseconds | KEEPTTL]: reads the options and their amount as Redis 7.0.15 does, refusing them before the key is read, and stores the value as set_key stores it.";
  let setting = True();
  let options = string_options(input: input, args: args, first: 3_u64, setting: setting);
  if options.valid {
  } else {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return unit;
  }
  let at = 0_u64;
  let timed = iand(options.flags, options_expiry);
  if timed != 0_u64 {
    let amount = arg(args: args, index: options.amount);
    let deadline = string_deadline(input: input, span: amount, flags: options.flags, unix_ms: time^.unix_ms);
    if deadline.state == 0_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return unit;
    }
    if deadline.state == 2_u64 {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return unit;
    }
    set at = deadline.at;
  }
  set_key(store: store, input: input, args: args, client: client, env: env, time: time, key_index: 1_u64, value_index: 2_u64, flags: options.flags, at: at, mode: mode_set);
  return unit;
}

fn run_setnx(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "SETNX key value: stores the value when the key is absent, answering 1, and answers 0 otherwise, as SET with NX stores it.";
  set_key(store: store, input: input, args: args, client: client, env: env, time: time, key_index: 1_u64, value_index: 2_u64, flags: option_nx, at: 0_u64, mode: mode_setnx);
  return unit;
}

fn setex_parse(input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, in_seconds: Bool, invalid: &[u8]) -> parsed: Option<SetPlan> reads(input), reads(args), reads(time), reads(invalid), writes(client) {
  doc "Reads SETEX or PSETEX's expiry before lookup, returning its SET plan or writing the command's refusal and returning None.";
  let flags = option_px;
  if in_seconds {
    set flags = option_ex;
  }
  let amount = arg(args: args, index: 2_u64);
  let deadline = string_deadline(input: input, span: amount, flags: flags, unix_ms: time^.unix_ms);
  if deadline.state == 0_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return None<SetPlan>();
  }
  if deadline.state == 2_u64 {
    reply_error(client: client, word: invalid);
    return None<SetPlan>();
  }
  let plan = SetPlan(flags: flags, at: deadline.at, mode: mode_set, key_index: 1_u64, value_index: 3_u64);
  return Some<SetPlan>(value: plan);
}

fn run_setex(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, in_seconds: Bool, invalid: &[u8]) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(client) waits {
  doc "SETEX key seconds value (in_seconds) and PSETEX key milliseconds value: stores the value with the expiry the amount gives, counted from the command's time, as SET with EX or PX stores it; invalid is the reply to an amount out of range.";
  let parsed = setex_parse(input: input, args: args, client: client, time: time, in_seconds: in_seconds, invalid: invalid);
  let plan = match parsed {
    Some(value: accepted) => {
      give accepted;
    }
    None() => {
      return unit;
    }
  }
  set_key(store: store, input: input, args: args, client: client, env: env, time: time, key_index: plan.key_index, value_index: plan.value_index, flags: plan.flags, at: plan.at, mode: plan.mode);
  return unit;
}

fn run_getset(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "GETSET key value: answers the string the key held, or nil, and stores the value without an expiry, as SET with GET does, refusing a key of another kind; the file records it as SET key value.";
  set_key(store: store, input: input, args: args, client: client, env: env, time: time, key_index: 1_u64, value_index: 2_u64, flags: option_get, at: 0_u64, mode: mode_getset);
  return unit;
}

fn run_getdel(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "GETDEL key: answers a live string as GET does and removes the key in the same atomic statement, which the file records as DEL key, as Redis propagates it, after the removal of a key found expired, as log_removal records it; a key of another kind is refused and kept.";
  let journal = None<pkg::store::AccessJournal>();
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  set client^.now = time^.check;
  let kind = 0_u64;
  atomic slot = &store^.keys[key], m = &store^.meta {
    set kind = getdel_body(journal: &journal, access_key: key, slot: slot, client: client);
    let removed = client^.state == state_expired;
    let appended = getdel_meta(log: &m^.log, logged: logged, removed: removed, kind: kind, input: input, key_span: key_span, key: key);
  }
  getdel_finish(client: client, kind: kind);
  return unit;
}

fn run_getex(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "GETEX key [EX seconds | PX milliseconds | EXAT unix-seconds | PXAT unix-milliseconds | PERSIST]: answers a live string as GET does and gives it the expiry the option names, or removes its expiry with PERSIST, in one atomic statement on the key, as Redis 7.0.15 does; an absolute expiry already past removes the key instead. The options are read before the key and their amount after it, so that an absent key answers nil, and a key of another kind is refused, whatever the amount. The file records the change as Redis propagates it: PEXPIREAT key at, DEL key, or PERSIST key when an expiry was removed, after the removal of a key found expired, as log_removal records it.";
  let journal = None<pkg::store::AccessJournal>();
  let options = getex_options(input: input, args: args, client: client);
  if bnot(options.valid) {
    return unit;
  }
  let plan = getex_plan(input: input, args: args, options: &options, time: time);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  set client^.now = time^.check;
  let none = False();
  let work = GetexWork(kind: 0_u64, removed: none, change: 0_u64);
  atomic slot = &store^.keys[key], m = &store^.meta {
    set work = getex_body(journal: &journal, access_key: key, slot: slot, client: client, plan: &plan);
    let appended = getex_meta(due: &m^.due, log: &m^.log, logged: logged, plan: &plan, work: &work, input: input, key_span: key_span, key: key, env: env);
  }
  getex_finish(client: client, plan: &plan, work: &work);
  return unit;
}

fn held_lapsed(slot: &Option<Entry>, now: u64) -> lapsed: Bool reads(slot) {
  doc "Whether an entry holds a value whose expiry has passed at now.";
  match slot^ {
    Some(value: held) => {
      let reached = expired(expires: held^.expires, now: now);
      return reached;
    }
    None() => {
      return False();
    }
  }
}

fn mset_pairs_refused(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> rejected: Bool reads(input), reads(args), writes(client) {
  doc "Refuses an incomplete key/value pair with MSET or MSETNX's command-local arity reply, after the dispatcher has checked minimum arity.";
  let count = args^.inner.len;
  let parity = count % 2_u64;
  if parity == 0_u64 {
    let name = arg(args: args, index: 0_u64);
    reply_arity(client: client, input: input, name: name);
    return True();
  }
  return False();
}

fn run_mset(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "MSET key value [key value ...]: stores every pair, removing any expiry the keys had, in one statement on the keys' entries; a key named twice keeps its last value. The file records each key found expired as log_removal does, as Redis propagates the removal when it overwrites such a key, then the command as it was sent.";
  let journal = None<pkg::store::AccessJournal>();
  let count = args^.inner.len;
  let pairs = count / 2_u64;
  let keys = key_set_new(capacity: pairs);
  key_positions(positions: &client^.key_metadata, count: pairs);
  key_positions(positions: &client^.key_lookups, count: pairs);
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let next = index +wrap 1_u64;
    let at = key_set_insert(keys: &keys, key: key);
    if pair < client^.key_lookups.inner.len {
      set client^.key_lookups.inner[pair] = at;
    }
    if at < client^.key_metadata.inner.len {
      set client^.key_metadata.inner[at] = next;
    }
  }
  let logged = store^.logging;
  atomic slots = &store^.keys[keys], m = &store^.meta {
    for @stored (pair in 0_u64..pairs) {
      if pair < client^.key_lookups.inner.len {
        let at = client^.key_lookups.inner[pair];
        if at < slots^.len {
          let doubled = pair *wrap 2_u64;
          let position = doubled +wrap 2_u64;
          let lapsed = mset_body(journal: &journal, client: client, slot: &slots^[at], input: input, args: args, value_index: position, now: time^.check);
          if lapsed {
            let index = position -wrap 1_u64;
            let place = key_bounds(input: input, args: args, index: index);
            let key = &input^[place.start..place.end];
            let removal = mset_lapse_meta(log: &m^.log, logged: logged, lapsed: lapsed, key: key);
          }
        }
      }
    }
    let recorded = mset_meta(log: &m^.log, logged: logged, input: input, args: args);
  }
  reply_ok(client: client);
  return unit;
}

fn mset_lapse_meta(log: &Box<Slots<u8>>, logged: Bool, lapsed: Bool, key: &[u8]) -> appended: u64 reads(key), writes(log) {
  doc "MSET's metadata for one key after mset_body: when the entry it replaced had expired and the keyspace keeps a file, appends the removal as log_removal records it, as Redis propagates the removal when it overwrites such a key, and answers 1; otherwise 0.";
  if lapsed {
    if logged {
      log_removal(log: log, key: key);
      return 1_u64;
    }
  }
  return 0_u64;
}

fn mset_meta(log: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>) -> appended: u64 reads(input), reads(args), writes(log) {
  doc "MSET's metadata after its work on every key: when the keyspace keeps a file, appends the command as it was sent and answers 1; otherwise 0.";
  if logged {
    log_command(log: log, input: input, args: args);
    return 1_u64;
  }
  return 0_u64;
}

fn mset_body(journal: &Option<pkg::store::AccessJournal>, client: &Client, slot: &Option<Entry>, input: &[u8], args: &Box<Slots<Span>>, value_index: u64, now: u64) -> lapsed: Bool reads(input), reads(args), writes(journal), writes(client), writes(slot) {
  doc "MSET's work on one key's entry, held by the caller: stores the value the argument at value_index holds, without an expiry, and answers whether the entry it replaced had expired, whose removal the file records first.";
  set client^.now = now;
  let key_index = value_index -sat 1_u64;
  let key_place = key_bounds(input: input, args: args, index: key_index);
  let access_key = &input^[key_place.start..key_place.end];
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let lapsed = held_lapsed(slot: slot, now: now);
  let value_span = arg(args: args, index: value_index);
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  put_text(client: client, slot: slot, value: move value, expires: 0_u64);
  return lapsed;
}

fn bump_value(env: &Counted, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Adds env's delta to a live stored decimal in place, keeping its expiry. State 1 is done, 3 marks another kind, 5 a string that is not a number, 6 a sum past the range of i64, and 2 an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 2_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      let number = bytes_integer(bytes: stored);
      if number.state != 1_u64 {
        set env^.state = 5_u64;
        return 5_u64;
      }
      match number.value +checked env^.delta {
        Ok(value: bumped) => {
          let fresh = decimal_text(value: bumped);
          set stored^ = move fresh;
          set env^.value = bumped;
          set env^.state = state_done;
          return 1_u64;
        }
        Err(error: overflow) => {
          set env^.state = 6_u64;
          return 6_u64;
        }
      }
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
  }
}

fn run_incr(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, delta: i64) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INCR key (delta 1), DECR key (delta -1), and INCRBY and DECRBY once run_incrby has read their amount: adds delta to the stored number, keeping its expiry, or stores delta without one for an absent or expired key, in one atomic statement, as Redis 7.0.15's incrDecrCommand does; another kind, a string that is not an integer and a sum past the range of i64 are refused. The file records an expired key's removal as log_removal does, then the command as it was sent.";
  let journal = None<pkg::store::AccessJournal>();
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, delta: delta, now: time^.check, state: state_absent);
  atomic slot = &store^.keys[key], m = &store^.meta {
    let removed = incr_body(journal: &journal, access_key: key, client: client, slot: slot, counted: &counted);
    if store^.logging {
      let appended = incr_log(log: &m^.log, removed: removed, counted: &counted, input: input, args: args, key: key);
    }
  }
  incr_finish(client: client, counted: &counted);
  return unit;
}

fn incr_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], client: &Client, slot: &Option<Entry>, counted: &Counted) -> removed: Bool reads(access_key), writes(journal), writes(client), writes(slot), writes(counted) {
  doc "INCR's work on its key's entry, held by the caller: adds counted's delta to a live stored decimal in place, keeping its expiry, or stores the delta without one for an absent or expired entry, recording done; another kind and a string that is not an integer or whose sum leaves the range of i64 record their refusal and change nothing. Returns whether an expired entry was replaced, whose removal the file records first.";
  set client^.now = counted^.now;
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let fresh_needed = True();
  match slot^ {
    Some(value: held) => {
      let outcome = bump_value(env: counted, value: held);
      set fresh_needed = False();
    }
    None() => {
    }
  }
  let removed = counted^.state == state_expired;
  if removed {
    set fresh_needed = True();
  }
  if fresh_needed {
    let fresh = decimal_text(value: counted^.delta);
    put_text(client: client, slot: slot, value: move fresh, expires: 0_u64);
    set counted^.value = counted^.delta;
    set counted^.state = state_done;
  }
  return removed;
}

fn incr_log(log: &Box<Slots<u8>>, removed: Bool, counted: &Counted, input: &[u8], args: &Box<Slots<Span>>, key: &[u8]) -> appended: u64 reads(counted), reads(input), reads(args), reads(key), writes(log) {
  doc "Appends what INCR changed to the file's bytes and returns how many commands it appended: an expired key's removal as log_removal records it, then the command as it was sent once it stored a number.";
  let appended = 0_u64;
  if removed {
    log_removal(log: log, key: key);
    set appended = appended +wrap 1_u64;
  }
  if counted^.state == state_done {
    log_command(log: log, input: input, args: args);
    set appended = appended +wrap 1_u64;
  }
  return appended;
}

fn incr_finish(client: &Client, counted: &Counted) -> result: unit reads(counted), writes(client) {
  doc "INCR's reply after its work: the new number, WRONGTYPE for another kind, and Redis's errors for a sum past the range of i64 or a string that is not an integer.";
  if counted^.state == state_done {
    reply_integer(client: client, value: counted^.value);
  } else if counted^.state == state_wrong {
    reply_wrong_type(client: client);
  } else if counted^.state == 6_u64 {
    reply_error(client: client, word: &text_overflow[0_u64..41_u64]);
  } else {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
  }
  return unit;
}

fn incrby_delta(input: &[u8], args: &Box<Slots<Span>>, negate: Bool) -> delta: Delta reads(input), reads(args) {
  doc "INCRBY's and DECRBY's parsing (negate), before the key is read: the amount as Redis reads one, state 0 with the delta to add, its negation for DECRBY, 1 for text that is not an integer, and 2 for DECRBY of the least i64, whose negation would overflow.";
  let amount = arg(args: args, index: 2_u64);
  let number = read_integer(input: input, start: amount.start, length: amount.length);
  if number.state != 1_u64 {
    return Delta(state: 1_u64, value: 0_i64);
  }
  let value = number.value;
  if negate {
    let least = cvt.wrap::<u64, i64>(9223372036854775808_u64);
    if value == least {
      return Delta(state: 2_u64, value: 0_i64);
    }
    set value = 0_i64 -wrap value;
  }
  return Delta(state: 0_u64, value: value);
}

fn delta_refused(client: &Client, delta: &Delta) -> refused: Bool reads(delta), writes(client) {
  doc "Writes the reply to a refused INCRBY or DECRBY amount as Redis writes it and answers whether it was refused.";
  if delta^.state == 1_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return True();
  }
  if delta^.state == 2_u64 {
    reply_error(client: client, word: &text_decrement[0_u64..28_u64]);
    return True();
  }
  return False();
}

fn run_incrby(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, negate: Bool) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INCRBY key increment and DECRBY key decrement (negate): reads the amount as incrby_delta does, refusing it before the key is read, then adds it, or its negation, as run_incr does.";
  let delta = incrby_delta(input: input, args: args, negate: negate);
  let refused = delta_refused(client: client, delta: &delta);
  if refused {
    return unit;
  }
  run_incr(store: store, input: input, args: args, client: client, env: env, time: time, delta: delta.value);
  return unit;
}

fn text_with(input: &[u8], span: Span, offset: u64, prefix: &[u8]) -> made: Bytes reads(input), reads(prefix) {
  doc "A string of the bytes of prefix, then zero bytes up to offset, then the bytes of the input span names starting at offset, overwriting any of prefix there, held inline when it has at most 24 bytes, as bytes_new chooses the form. A string longer than 2^62 bytes, which the callers' limit of 512 MiB rules out, is made empty.";
  let old_length = prefix^.len;
  let end = offset +wrap span.length;
  let total = imax(old_length, end);
  if total <= 24_u64 {
    let short = slots_new::<u8, 24>();
    for @filling (position in 0_u64..total) {
      let byte = 0_u8;
      if position < old_length {
        set byte = prefix^[position];
      }
      let inside = position >= offset;
      if inside {
        if position < end {
          let from = position -wrap offset;
          let source = span.start +wrap from;
          set byte = byte_at(input: input, index: source);
        }
      }
      if short.len < short.cap {
        place_back(window: &short, value: byte);
      }
    }
    return Bytes::Short(bytes: move short);
  }
  if total > 4611686018427387904_u64 {
    let empty = slots_new::<u8, 24>();
    return Bytes::Short(bytes: move empty);
  }
  let long = box_slots_new::<u8>(capacity: total);
  for @copying (position in 0_u64..total) {
    let byte = 0_u8;
    if position < old_length {
      set byte = prefix^[position];
    }
    let inside = position >= offset;
    if inside {
      if position < end {
        let from = position -wrap offset;
        let source = span.start +wrap from;
        set byte = byte_at(input: input, index: source);
      }
    }
    if long.inner.len < long.inner.cap {
      place_back(window: &long.inner, value: byte);
    }
  }
  return Bytes::Long(bytes: move long);
}

fn long_write(long: &Box<Slots<u8>>, input: &[u8], span: Span, offset: u64) -> result: unit reads(input), writes(long) {
  doc "Writes the bytes of the input span names into a string held in an allocation of its own, starting at offset, first filling it with zero bytes up to offset and growing the allocation at least to twice its size when it is full, so that writing at its end in steps costs time in proportion to the bytes written. The allocation stops growing at 2^62 bytes, which the callers' limit of 512 MiB rules out.";
  let end = offset +wrap span.length;
  let capacity = long^.inner.cap;
  if end > capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, end);
    let fits = target <= 4611686018427387904_u64;
    if fits {
      if target >= long^.inner.cap {
        grow(cell: long, capacity: target);
      }
    }
  }
  loop @zeros {
    if long^.inner.len >= offset {
      break @zeros;
    }
    if long^.inner.len < long^.inner.cap {
      place_back(window: &long^.inner, value: 0_u8);
    } else {
      break @zeros;
    }
  }
  for @bytes (step in 0_u64..span.length) {
    let position = offset +wrap step;
    let source = span.start +wrap step;
    let byte = byte_at(input: input, index: source);
    if position < long^.inner.len {
      set long^.inner[position] = byte;
    } else if long^.inner.len < long^.inner.cap {
      place_back(window: &long^.inner, value: byte);
    }
  }
  return unit;
}

fn text_write(text: &Bytes, input: &[u8], span: Span, offset: u64) -> length: u64 reads(input), writes(text) {
  doc "Writes the bytes of the input span names into a string starting at offset, as SETRANGE and, at the string's end, APPEND write them: zero bytes fill any gap before offset, and the string keeps the form bytes_new would choose for its new length, held inline while it has at most 24 bytes. Returns the new length.";
  let moved = False();
  let made = slots_new::<u8, 24>();
  let replacement = Bytes::Short(bytes: move made);
  match text^ {
    Short(bytes: short) => {
      let length = short^.len;
      let window = &short^[0_u64..length];
      set replacement = text_with(input: input, span: span, offset: offset, prefix: window);
      set moved = True();
    }
    Long(bytes: long) => {
      long_write(long: long, input: input, span: span, offset: offset);
    }
  }
  if moved {
    set text^ = move replacement;
  } else {
    let unused = move replacement;
  }
  let length = bytes_length(bytes: text);
  return length;
}

fn held_text_length(slot: &Option<Entry>) -> length: u64 reads(slot) {
  doc "The length of the string a live entry holds, zero for another kind and for an absent entry.";
  match slot^ {
    Some(value: held) => {
      match held^.value {
        Text(bytes: stored) => {
          let length = bytes_length(bytes: stored);
          return length;
        }
        Items(items: list) => {
          return 0_u64;
        }
        Members(members: set_of) => {
          return 0_u64;
        }
        Fields(fields: hash_of) => {
          return 0_u64;
        }
        Ranked(ranked: sorted) => {
          return 0_u64;
        }
      }
    }
    None() => {
      return 0_u64;
    }
  }
}

fn held_text_write(slot: &Option<Entry>, input: &[u8], span: Span, offset: u64) -> length: u64 reads(input), writes(slot) {
  doc "Writes into the string a live entry holds as text_write does, keeping its expiry, and returns the new length; another kind and an absent entry are left as they are, answering zero.";
  match slot^ {
    Some(value: held) => {
      match held^.value {
        Text(bytes: stored) => {
          let length = text_write(text: stored, input: input, span: span, offset: offset);
          return length;
        }
        Items(items: list) => {
          return 0_u64;
        }
        Members(members: set_of) => {
          return 0_u64;
        }
        Fields(fields: hash_of) => {
          return 0_u64;
        }
        Ranked(ranked: sorted) => {
          return 0_u64;
        }
      }
    }
    None() => {
      return 0_u64;
    }
  }
}

fn reply_text_range(client: &Client, text: &Bytes, start: i64, end: i64) -> result: unit reads(text), writes(client) {
  doc "Writes the bytes of a string from start to end, both included, as Redis 7.0.15's getrangeCommand reads them: a negative index counts from the end, both are then clamped to the string, and a range that ends before it starts, or two negative indices in that order, is the empty bulk string.";
  let length = bytes_length(bytes: text);
  let size = cvt.wrap::<u64, i64>(length);
  let backwards = start > end;
  let first_negative = start < 0_i64;
  let last_negative = end < 0_i64;
  let both = band(first_negative, last_negative);
  let reversed = band(both, backwards);
  if reversed {
    reply_word(client: client, word: &reply_empty[0_u64..6_u64]);
    return unit;
  }
  let from = start;
  let to = end;
  if from < 0_i64 {
    set from = size +wrap from;
  }
  if to < 0_i64 {
    set to = size +wrap to;
  }
  if from < 0_i64 {
    set from = 0_i64;
  }
  if to < 0_i64 {
    set to = 0_i64;
  }
  if to >= size {
    set to = size -wrap 1_i64;
  }
  let empty = length == 0_u64;
  let after = from > to;
  let nothing = bor(empty, after);
  if nothing {
    reply_word(client: client, word: &reply_empty[0_u64..6_u64]);
    return unit;
  }
  let first = cvt.wrap::<i64, u64>(from);
  let last = cvt.wrap::<i64, u64>(to);
  let span = last -wrap first;
  let count = span +wrap 1_u64;
  match text^ {
    Short(bytes: short) => {
      let size_held = short^.len;
      let window = &short^[0_u64..size_held];
      reply_bulk_input(client: client, input: window, start: first, length: count);
    }
    Long(bytes: long) => {
      let size_held = long^.inner.len;
      let window = &long^.inner[0_u64..size_held];
      reply_bulk_input(client: client, input: window, start: first, length: count);
    }
  }
  return unit;
}

fn reply_held_range(slot: &Option<Entry>, client: &Client, start: i64, end: i64) -> result: unit reads(slot), writes(client) {
  doc "Writes a range of the string a live entry holds as reply_text_range writes it; another kind and an absent entry write nothing.";
  match slot^ {
    Some(value: held) => {
      match held^.value {
        Text(bytes: stored) => {
          reply_text_range(client: client, text: stored, start: start, end: end);
        }
        Items(items: list) => {
        }
        Members(members: set_of) => {
        }
        Fields(fields: hash_of) => {
        }
        Ranked(ranked: sorted) => {
        }
      }
    }
    None() => {
    }
  }
  return unit;
}

fn run_append(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "APPEND key value: appends the value to a live string, keeping its expiry, or stores it as a string without one for an absent or expired key, an empty value included, and answers the string's length, in one atomic statement, as Redis 7.0.15 does; a key of another kind is refused, and so is a string that would pass proto-max-bulk-len's 512 MiB. The file records the command as it was sent, after a key found expired as log_removal records it.";
  let journal = None<pkg::store::AccessJournal>();
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value_span = arg(args: args, index: 2_u64);
  let logged = store^.logging;
  set client^.now = time^.check;
  let none = False();
  let work = StringWork(outcome: state_absent, length: 0_u64, removed: none);
  atomic slot = &store^.keys[key], m = &store^.meta {
    set work = append_body(journal: &journal, access_key: key, slot: slot, input: input, client: client, value_span: value_span);
    let changed = work.outcome == state_done;
    let appended = changed_meta(log: &m^.log, logged: logged, removed: work.removed, changed: changed, input: input, args: args, key: key);
  }
  string_write_finish(client: client, work: &work);
  return unit;
}

fn run_setrange(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "SETRANGE key offset value: writes the value into a live string from offset on, keeping its expiry, zero bytes filling any gap, or into a new string of zero bytes for an absent or expired key, and answers the string's length, in one atomic statement, as Redis 7.0.15 does. An empty value changes nothing, answering the length or 0 for an absent key; an offset that is not an integer, a negative one, a key of another kind and a string that would pass proto-max-bulk-len's 512 MiB are refused. The file records a change as it was sent, after a key found expired as log_removal records it.";
  let journal = None<pkg::store::AccessJournal>();
  let plan = setrange_plan(input: input, args: args);
  let refused = setrange_refused(client: client, plan: &plan);
  if refused {
    return unit;
  }
  let offset = cvt.wrap::<i64, u64>(plan.value);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value_span = arg(args: args, index: 3_u64);
  let logged = store^.logging;
  set client^.now = time^.check;
  let none = False();
  let work = StringWork(outcome: state_absent, length: 0_u64, removed: none);
  atomic slot = &store^.keys[key], m = &store^.meta {
    set work = setrange_body(journal: &journal, access_key: key, slot: slot, input: input, client: client, value_span: value_span, offset: offset);
    let changed = work.outcome == state_done;
    let appended = changed_meta(log: &m^.log, logged: logged, removed: work.removed, changed: changed, input: input, args: args, key: key);
  }
  string_write_finish(client: client, work: &work);
  return unit;
}

fn run_strlen(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "STRLEN key: answers the length of a live string, 0 for an absent or expired key, which is removed and its removal recorded as log_removal records it, and refuses a key of another kind.";
  let journal = None<pkg::store::AccessJournal>();
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  set client^.now = time^.check;
  let none = False();
  let work = StringWork(outcome: 0_u64, length: 0_u64, removed: none);
  atomic slot = &store^.keys[key], m = &store^.meta {
    set work = strlen_body(journal: &journal, access_key: key, slot: slot, client: client);
    let appended = mset_lapse_meta(log: &m^.log, logged: logged, lapsed: work.removed, key: key);
  }
  strlen_finish(client: client, work: &work);
  return unit;
}

fn run_getrange(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "GETRANGE key start end and SUBSTR key start end: answers the bytes of a live string between the indices, as reply_text_range reads them, written into the reply inside the statement on the key; the empty bulk string for an absent or expired key, which is removed and its removal recorded as log_removal records it. Indices that are not integers are refused before the key is read, as is a key of another kind after.";
  let journal = None<pkg::store::AccessJournal>();
  let plan = getrange_plan(input: input, args: args);
  let rejected = getrange_refused(client: client, plan: &plan);
  if rejected {
    return unit;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  set client^.now = time^.check;
  let kind = 0_u64;
  atomic slot = &store^.keys[key], m = &store^.meta {
    set kind = getrange_body(journal: &journal, access_key: key, slot: slot, client: client, start: plan.start, end: plan.end);
    let removed = client^.state == state_expired;
    let appended = mset_lapse_meta(log: &m^.log, logged: logged, lapsed: removed, key: key);
  }
  getrange_finish(client: client, kind: kind);
  return unit;
}

fn run_mget(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "MGET key [key ...]: answers each key's live string, or nil for an absent or expired key or one of another kind, in the order the keys are named, a key named twice answered twice, written into the reply inside one statement on the keys' entries, as Redis 7.0.15 does. Before the statement each argument is given its key's position in the key set, in first-insertion order; a key found expired is removed, and the file records its removal as log_removal does.";
  let journal = None<pkg::store::AccessJournal>();
  let count = args^.inner.len;
  let keys = key_set_new(capacity: count);
  let named = count -sat 1_u64;
  key_positions(positions: &client^.key_metadata, count: named);
  for @named (index in 1_u64..count) {
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let rank = key_set_insert(keys: &keys, key: key);
    let step = index -wrap 1_u64;
    if step < client^.key_metadata.inner.len {
      set client^.key_metadata.inner[step] = rank;
    }
  }
  reply_array(client: client, count: named);
  set client^.now = time^.check;
  let logged = store^.logging;
  atomic slots = &store^.keys[keys], m = &store^.meta {
    for @answers (step in 0_u64..client^.key_metadata.inner.len) {
      if step < client^.key_metadata.inner.len {
        let rank = client^.key_metadata.inner[step];
        if rank < slots^.len {
          let index = step +wrap 1_u64;
          let place = key_bounds(input: input, args: args, index: index);
          let key = &input^[place.start..place.end];
          let kind = mget_body(journal: &journal, access_key: key, slot: &slots^[rank], client: client);
          if client^.state == state_expired {
            if logged {
              let lapsed = True();
              let appended = mset_lapse_meta(log: &m^.log, logged: logged, lapsed: lapsed, key: key);
            }
          }
          mget_finish(client: client, kind: kind);
        } else {
          reply_nil(client: client);
        }
      }
    }
  }
  return unit;
}

fn run_msetnx(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "MSETNX key value [key value ...]: stores every pair, without expiries, when none of the keys is live, answering 1, and stores nothing otherwise, answering 0, in one statement on the keys' entries, as Redis 7.0.15 does; a key named twice keeps its last value. As Redis's msetGenericCommand does, the statement looks the keys up in the order they are named and stops at the first live one, so a key named after it is not looked up; each key it finds expired is removed, and the file records its removal as log_removal does, then the command as it was sent when it stored. The preliminary existence check visits distinct keys in first-insertion order; stores visit every pair in argument order, including duplicate keys, so each setKey lookup updates LFU.";
  let journal = None<pkg::store::AccessJournal>();
  let count = args^.inner.len;
  let pairs = count / 2_u64;
  let keys = key_set_new(capacity: pairs);
  key_positions(positions: &client^.key_metadata, count: pairs);
  key_positions(positions: &client^.key_lookups, count: pairs);
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let next = index +wrap 1_u64;
    let at = key_set_insert(keys: &keys, key: key);
    if pair < client^.key_lookups.inner.len {
      set client^.key_lookups.inner[pair] = at;
    }
    if at < client^.key_metadata.inner.len {
      set client^.key_metadata.inner[at] = next;
    }
  }
  set client^.now = time^.check;
  let logged = store^.logging;
  let stored = False();
  atomic slots = &store^.keys[keys], m = &store^.meta {
    let blocked = False();
    for @checked (
      rank in 0_u64..keys.len,
      invariant aligned: slots^.len == keys.len
    ) {
      if rank < slots^.len {
        refresh_access_at(journal: &journal, slots: slots, access_keys: &keys, index: rank, client: client);
        let kind = entry_kind(slot: &slots^[rank], client: client);
        if client^.state == state_expired {
          if logged {
            let position = key_position(positions: &client^.key_metadata, index: rank);
            let index = position -wrap 1_u64;
            let place = key_bounds(input: input, args: args, index: index);
            let key = &input^[place.start..place.end];
            let lapsed = True();
            let appended = mset_lapse_meta(log: &m^.log, logged: logged, lapsed: lapsed, key: key);
          }
        }
        if kind != 0_u64 {
          set blocked = True();
          break @checked;
        }
      }
    }
    if blocked {
    } else {
      for @stored (pair in 0_u64..pairs) {
        if pair < client^.key_lookups.inner.len {
          let at = client^.key_lookups.inner[pair];
          if at < slots^.len {
            let doubled = pair *wrap 2_u64;
            let position = doubled +wrap 2_u64;
            let replaced = mset_body(journal: &journal, client: client, slot: &slots^[at], input: input, args: args, value_index: position, now: time^.check);
          }
        }
      }
      if logged {
        let appended = mset_meta(log: &m^.log, logged: logged, input: input, args: args);
      }
      set stored = True();
    }
  }
  msetnx_finish(client: client, stored: stored);
  return unit;
}

fn text_sum(text: &Bytes, increment: &Reading) -> sum: Sum reads(text), reads(increment) {
  doc "The increment added to a stored string read as a long double, as extended_sum adds it.";
  match text^ {
    Short(bytes: short) => {
      let length = short^.len;
      let window = &short^[0_u64..length];
      let sum = extended_sum(value: window, increment: increment);
      return move sum;
    }
    Long(bytes: long) => {
      let length = long^.inner.len;
      let window = &long^.inner[0_u64..length];
      let sum = extended_sum(value: window, increment: increment);
      return move sum;
    }
  }
}

fn float_value(env: &FloatSum, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Adds env's increment to a live string read as a long double, as INCRBYFLOAT does, keeping its expiry: state 1 has stored the sum's text and kept it in env, 3 marks another kind, 5 a string or an increment that is not a number, 6 a sum that is not a number or is infinite, and 2 an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 2_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      let sum = text_sum(text: stored, increment: &env^.increment);
      let Sum(text: made, state: outcome) = move sum;
      if outcome == 1_u64 {
        let kept = bytes_copy(bytes: &made);
        set stored^ = move kept;
        set env^.text = move made;
        set env^.state = state_done;
        return 1_u64;
      }
      let unused = move made;
      if outcome == 2_u64 {
        set env^.state = 6_u64;
        return 6_u64;
      }
      set env^.state = 5_u64;
      return 5_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
  }
}

fn log_float(log: &Box<Slots<u8>>, input: &[u8], key: Span, text: &Bytes) -> result: unit reads(input), reads(text), writes(log) {
  doc "Appends SET key value KEEPTTL, the form Redis 7.0.15 propagates INCRBYFLOAT in, so that a replay stores the very text the sum was written as.";
  let length = bytes_length(bytes: text);
  let sum = key.length +wrap length;
  let room = sum +wrap 32_u64;
  log_count(log: log, count: 4_u64, room: room);
  log_word(log: log, word: &word_set[0_u64..3_u64]);
  log_input(log: log, input: input, span: key);
  log_text(log: log, text: text);
  log_word(log: log, word: &word_keepttl[0_u64..7_u64]);
  return unit;
}

fn incrbyfloat_parse(input: &[u8], args: &Box<Slots<Span>>) -> increment: Reading reads(input), reads(args) {
  doc "Reads INCRBYFLOAT's increment before lookup; its body checks the key's type before refusing an invalid number.";
  let amount = arg(args: args, index: 2_u64);
  let parsed = extended_read(input: input, start: amount.start, length: amount.length);
  return parsed;
}

fn run_incrbyfloat(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INCRBYFLOAT key increment: adds the increment to the stored number in x87 long double arithmetic and stores the sum written as Redis 7.0.15 writes it, keeping the key's expiry, or stores the increment's sum with zero without one for an absent or expired key, in one atomic statement, and answers the sum as a bulk string. The increment is read before the statement and judged after the key, so that a key of another kind is refused first; a value or increment that is not a number and a sum that is not a number or is infinite are refused. The file records the change as SET key value KEEPTTL, as Redis propagates it, after a key found expired as log_removal records it.";
  let journal = None<pkg::store::AccessJournal>();
  let increment = incrbyfloat_parse(input: input, args: args);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  let nothing = slots_new::<u8, 24>();
  let empty = Bytes::Short(bytes: move nothing);
  let summed = FloatSum(increment: increment, text: move empty, now: time^.check, state: state_absent);
  atomic slot = &store^.keys[key], m = &store^.meta {
    let removed = incrbyfloat_body(journal: &journal, access_key: key, client: client, slot: slot, summed: &summed);
    let appended = incrbyfloat_meta(log: &m^.log, logged: logged, removed: removed, summed: &summed, input: input, key_span: key_span, key: key);
  }
  incrbyfloat_finish(client: client, summed: &summed);
  return unit;
}

struct StringWork {
  outcome: u64;
  length: u64;
  removed: Bool;
}

fn append_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, input: &[u8], client: &Client, value_span: Span) -> work: StringWork reads(access_key), reads(input), writes(journal), writes(slot), writes(client) {
  doc "APPEND's work on a held entry, preserving its expiry and returning its outcome, length and expired removal.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let outcome = state_absent;
  let length = 0_u64;
  let kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  if kind == 0_u64 {
    let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
    put_text(client: client, slot: slot, value: move value, expires: 0_u64);
    set length = value_span.length;
    set outcome = state_done;
  } else if kind == 1_u64 {
    let held = held_text_length(slot: slot);
    let total = held +wrap value_span.length;
    if total > string_limit {
      set outcome = state_long;
    } else {
      set length = held_text_write(slot: slot, input: input, span: value_span, offset: held);
      set outcome = state_done;
    }
  } else {
    set outcome = state_wrong;
  }
  return StringWork(outcome: outcome, length: length, removed: removed);
}

fn string_write_finish(client: &Client, work: &StringWork) -> result: unit reads(work), writes(client) {
  doc "APPEND and SETRANGE answer the resulting length or their type or size refusal.";
  if work^.outcome == state_wrong {
    reply_wrong_type(client: client);
    return unit;
  }
  if work^.outcome == state_long {
    reply_error(client: client, word: &text_too_long[0_u64..60_u64]);
    return unit;
  }
  let answer = cvt.wrap::<u64, i64>(work^.length);
  reply_integer(client: client, value: answer);
  return unit;
}

fn setrange_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, input: &[u8], client: &Client, value_span: Span, offset: u64) -> work: StringWork reads(access_key), reads(input), writes(journal), writes(slot), writes(client) {
  doc "SETRANGE's work on a held entry, preserving its expiry and returning its outcome, length and expired removal.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let outcome = state_absent;
  let length = 0_u64;
  let empty = value_span.length == 0_u64;
  let total = offset +wrap value_span.length;
  let beyond = total > string_limit;
  let kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  if kind > 1_u64 {
    set outcome = state_wrong;
  } else if empty {
    set length = held_text_length(slot: slot);
  } else if beyond {
    set outcome = state_long;
  } else if kind == 0_u64 {
    let nothing = slots_new::<u8, 24>();
    let prefix = &nothing[0_u64..0_u64];
    let value = text_with(input: input, span: value_span, offset: offset, prefix: prefix);
    put_text(client: client, slot: slot, value: move value, expires: 0_u64);
    set length = total;
    set outcome = state_done;
  } else {
    set length = held_text_write(slot: slot, input: input, span: value_span, offset: offset);
    set outcome = state_done;
  }
  return StringWork(outcome: outcome, length: length, removed: removed);
}

fn getdel_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client) -> kind: u64 reads(access_key), writes(journal), writes(slot), writes(client) {
  doc "GETDEL reads a live string into the reply and removes it; entry_kind records expired removal.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let kind = entry_kind(slot: slot, client: client);
  if kind == 1_u64 {
    reply_held_text(slot: slot, client: client);
    set slot^ = None<Entry>();
  }
  return kind;
}

fn getdel_meta(log: &Box<Slots<u8>>, logged: Bool, removed: Bool, kind: u64, input: &[u8], key_span: Span, key: &[u8]) -> appended: u64 reads(input), reads(key), writes(log) {
  doc "GETDEL propagates its expired removal, or DEL for a removed live string.";
  let appended = mset_lapse_meta(log: log, logged: logged, lapsed: removed, key: key);
  if kind == 1_u64 {
    if logged {
      log_key_word(log: log, word: &word_del[0_u64..3_u64], input: input, key: key_span);
      set appended = appended +wrap 1_u64;
    }
  }
  return appended;
}

fn getdel_finish(client: &Client, kind: u64) -> result: unit writes(client) {
  doc "Finishes GETDEL after a live string's reply was written by its body.";
  if kind == 0_u64 {
    reply_nil(client: client);
    return unit;
  }
  if kind != 1_u64 {
    reply_wrong_type(client: client);
  }
  return unit;
}

fn strlen_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client) -> work: StringWork reads(access_key), writes(journal), writes(slot), writes(client) {
  doc "STRLEN reads the kind and length, removing expired entries.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  let length = held_text_length(slot: slot);
  return StringWork(outcome: kind, length: length, removed: removed);
}

fn strlen_finish(client: &Client, work: &StringWork) -> result: unit reads(work), writes(client) {
  doc "STRLEN answers zero for absence and refuses another kind.";
  if work^.outcome > 1_u64 {
    reply_wrong_type(client: client);
    return unit;
  }
  let answer = cvt.wrap::<u64, i64>(work^.length);
  reply_integer(client: client, value: answer);
  return unit;
}

fn getrange_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client, start: i64, end: i64) -> kind: u64 reads(access_key), writes(journal), writes(slot), writes(client) {
  doc "GETRANGE reads a live string's requested range into the reply, removing expired entries.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let kind = entry_kind(slot: slot, client: client);
  reply_held_range(slot: slot, client: client, start: start, end: end);
  return kind;
}

fn getrange_finish(client: &Client, kind: u64) -> result: unit writes(client) {
  doc "GETRANGE finishes an absent or wrongly typed key's reply.";
  if kind == 0_u64 {
    reply_word(client: client, word: &reply_empty[0_u64..6_u64]);
    return unit;
  }
  if kind > 1_u64 {
    reply_wrong_type(client: client);
  }
  return unit;
}

fn incrbyfloat_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], client: &Client, slot: &Option<Entry>, summed: &FloatSum) -> removed: Bool reads(access_key), writes(journal), writes(client), writes(slot), writes(summed) {
  doc "INCRBYFLOAT's work on a held entry, returning whether its previous value expired. An expired entry is removed before the increment is judged, as Redis 7.0.15's lookupKeyWrite removes it, so that a refused increment leaves no entry the file's DEL says is gone.";
  set client^.now = summed^.now;
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let fresh_needed = True();
  match slot^ {
    Some(value: held) => {
      let outcome = float_value(env: summed, value: held);
      set fresh_needed = False();
    }
    None() => {
    }
  }
  let removed = summed^.state == state_expired;
  if removed {
    set slot^ = None<Entry>();
    set fresh_needed = True();
  }
  if fresh_needed {
    let zero = &word_zero[0_u64..1_u64];
    let sum = extended_sum(value: zero, increment: &summed^.increment);
    let Sum(text: made, state: outcome) = move sum;
    if outcome == 1_u64 {
      let kept = bytes_copy(bytes: &made);
      put_text(client: client, slot: slot, value: move kept, expires: 0_u64);
      set summed^.text = move made;
      set summed^.state = state_done;
    } else {
      let unused = move made;
      if outcome == 2_u64 {
        set summed^.state = 6_u64;
      } else {
        set summed^.state = 5_u64;
      }
    }
  }
  return removed;
}

fn incrbyfloat_meta(log: &Box<Slots<u8>>, logged: Bool, removed: Bool, summed: &FloatSum, input: &[u8], key_span: Span, key: &[u8]) -> appended: u64 reads(summed), reads(input), reads(key), writes(log) {
  doc "INCRBYFLOAT propagates the expired removal and SET with KEEPTTL for its computed value.";
  let appended = mset_lapse_meta(log: log, logged: logged, lapsed: removed, key: key);
  if summed^.state == state_done {
    if logged {
      log_float(log: log, input: input, key: key_span, text: &summed^.text);
      set appended = appended +wrap 1_u64;
    }
  }
  return appended;
}

fn incrbyfloat_finish(client: &Client, summed: &FloatSum) -> result: unit reads(summed), writes(client) {
  doc "INCRBYFLOAT answers its computed decimal or the existing type or numeric error.";
  if summed^.state == state_done {
    reply_text(client: client, text: &summed^.text);
  } else if summed^.state == state_wrong {
    reply_wrong_type(client: client);
  } else if summed^.state == 6_u64 {
    reply_error(client: client, word: &text_nan[0_u64..43_u64]);
  } else {
    reply_error(client: client, word: &text_not_float[0_u64..30_u64]);
  }
  return unit;
}

struct GetexPlan {
  timed: Bool;
  persisting: Bool;
  lapsed: Bool;
  deadline: Deadline;
}

struct GetexWork {
  kind: u64;
  removed: Bool;
  change: u64;
}

fn getex_options(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> options: StringOptions reads(input), reads(args), writes(client) {
  doc "Reads GETEX's options and writes its syntax refusal before lookup; deadline errors remain subject to the body's key-type and presence checks.";
  let setting = False();
  let parsed = string_options(input: input, args: args, first: 2_u64, setting: setting);
  if bnot(parsed.valid) {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
  }
  return parsed;
}

fn getex_plan(input: &[u8], args: &Box<Slots<Span>>, options: &StringOptions, time: &Time) -> plan: GetexPlan reads(input), reads(args), reads(options), reads(time) {
  doc "Reads GETEX's expiry amount and frozen deadline; the body checks type before reporting an invalid amount.";
  let flags = options^.flags;
  let timed_flag = iand(flags, options_expiry);
  let timed = timed_flag != 0_u64;
  let persist_flag = iand(flags, option_persist);
  let persisting = persist_flag != 0_u64;
  let deadline = Deadline(at: 0_u64, state: 1_u64);
  if timed {
    let amount = arg(args: args, index: options^.amount);
    set deadline = string_deadline(input: input, span: amount, flags: flags, unix_ms: time^.unix_ms);
  }
  let calendar = ior(option_exat, option_pxat);
  let absolute_flag = iand(flags, calendar);
  let absolute = absolute_flag != 0_u64;
  let passed = deadline.at <= time^.unix_ms;
  let lapsed = band(absolute, passed);
  if time^.loading {
    set lapsed = False();
  }
  return GetexPlan(timed: timed, persisting: persisting, lapsed: lapsed, deadline: deadline);
}

fn getex_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client, plan: &GetexPlan) -> work: GetexWork reads(access_key), reads(plan), writes(journal), writes(slot), writes(client) {
  doc "GETEX reads a live string and applies its expiry change; change 1 deletes, 2 sets expiry, and 3 removes expiry.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  let change = 0_u64;
  let text = kind == 1_u64;
  let readable = plan^.deadline.state == 1_u64;
  let go = band(text, readable);
  if go {
    reply_held_text(slot: slot, client: client);
    if plan^.timed {
      if plan^.lapsed {
        set slot^ = None<Entry>();
        set change = 1_u64;
      } else {
        hold_expiry(slot: slot, expires: plan^.deadline.at);
        set change = 2_u64;
      }
    } else if plan^.persisting {
      let had = held_expiry(slot: slot);
      if had != 0_u64 {
        hold_expiry(slot: slot, expires: 0_u64);
        set change = 3_u64;
      }
    }
  }
  return GetexWork(kind: kind, removed: removed, change: change);
}

fn getex_meta(due: &PriorityQueue<Due, ceiling>, log: &Box<Slots<u8>>, logged: Bool, plan: &GetexPlan, work: &GetexWork, input: &[u8], key_span: Span, key: &[u8], env: &KeyEnv) -> appended: u64 reads(plan), reads(work), reads(input), reads(key), reads(env), writes(due), writes(log) {
  doc "Queues GETEX's new expiry and propagates its expired removal and DEL, PEXPIREAT or PERSIST change.";
  let appended = mset_lapse_meta(log: log, logged: logged, lapsed: work^.removed, key: key);
  if work^.change == 2_u64 {
    queue_due(due: due, key: key, at: plan^.deadline.at, env: env);
  }
  if logged {
    if work^.change == 1_u64 {
      log_key_word(log: log, word: &word_del[0_u64..3_u64], input: input, key: key_span);
    } else if work^.change == 2_u64 {
      log_expire_at(log: log, input: input, key: key_span, at_ms: plan^.deadline.at);
    } else if work^.change == 3_u64 {
      log_key_word(log: log, word: &word_persist[0_u64..7_u64], input: input, key: key_span);
    }
    if work^.change != 0_u64 {
      set appended = appended +wrap 1_u64;
    }
  }
  return appended;
}

fn getex_finish(client: &Client, plan: &GetexPlan, work: &GetexWork) -> result: unit reads(plan), reads(work), writes(client) {
  doc "Finishes GETEX with absence or type taking precedence over an invalid expiry amount.";
  if work^.kind == 0_u64 {
    reply_nil(client: client);
    return unit;
  }
  if work^.kind != 1_u64 {
    reply_wrong_type(client: client);
    return unit;
  }
  if plan^.deadline.state == 0_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return unit;
  }
  if plan^.deadline.state == 2_u64 {
    reply_error(client: client, word: &text_expire_getex[0_u64..42_u64]);
  }
  return unit;
}

fn setrange_plan(input: &[u8], args: &Box<Slots<Span>>) -> plan: Delta reads(input), reads(args) {
  doc "Reads SETRANGE's integer offset, distinguishing malformed and negative offsets.";
  let amount = arg(args: args, index: 2_u64);
  let number = read_integer(input: input, start: amount.start, length: amount.length);
  if number.state != 1_u64 {
    return Delta(state: 1_u64, value: 0_i64);
  }
  if number.value < 0_i64 {
    return Delta(state: 2_u64, value: 0_i64);
  }
  return Delta(state: 0_u64, value: number.value);
}

fn setrange_refused(client: &Client, plan: &Delta) -> refused: Bool reads(plan), writes(client) {
  doc "Writes SETRANGE's offset refusal before lookup.";
  if plan^.state == 1_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return True();
  }
  if plan^.state == 2_u64 {
    reply_error(client: client, word: &text_offset_range[0_u64..26_u64]);
    return True();
  }
  return False();
}

struct GetrangePlan {
  start: i64;
  end: i64;
  valid: Bool;
}

fn getrange_plan(input: &[u8], args: &Box<Slots<Span>>) -> plan: GetrangePlan reads(input), reads(args) {
  doc "Reads GETRANGE's two integer bounds before lookup.";
  let first = arg(args: args, index: 2_u64);
  let start = read_integer(input: input, start: first.start, length: first.length);
  let last = arg(args: args, index: 3_u64);
  let end = read_integer(input: input, start: last.start, length: last.length);
  let first_valid = start.state == 1_u64;
  let last_valid = end.state == 1_u64;
  let valid = band(first_valid, last_valid);
  return GetrangePlan(start: start.value, end: end.value, valid: valid);
}

fn getrange_refused(client: &Client, plan: &GetrangePlan) -> rejected: Bool reads(plan), writes(client) {
  doc "Refuses GETRANGE's invalid bounds before lookup with its integer error.";
  if plan^.valid {
    return False();
  }
  reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
  return True();
}

fn mget_body(journal: &Option<pkg::store::AccessJournal>, access_key: &[u8], slot: &Option<Entry>, client: &Client) -> kind: u64 reads(access_key), writes(journal), writes(slot), writes(client) {
  doc "Reads one MGET entry; strings write their bulk reply, other kinds and absence leave the nil reply to mget_finish.";
  refresh_access(journal: journal, key: access_key, slot: slot, client: client);
  let kind = entry_kind(slot: slot, client: client);
  if kind == 1_u64 {
    reply_held_text(slot: slot, client: client);
  }
  return kind;
}

fn mget_finish(client: &Client, kind: u64) -> result: unit writes(client) {
  doc "MGET answers nil for absent entries and values of another kind.";
  if kind != 1_u64 {
    reply_nil(client: client);
  }
  return unit;
}

fn msetnx_finish(client: &Client, stored: Bool) -> result: unit writes(client) {
  doc "MSETNX answers whether every pair was stored.";
  if stored {
    reply_word(client: client, word: &reply_one[0_u64..4_u64]);
    return unit;
  }
  reply_word(client: client, word: &reply_zero[0_u64..4_u64]);
  return unit;
}
