fn script_lpos(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "LPOS by the network parts under EXEC or a script; expired keys are removed and recorded immediately.";
  let no = False();
  let seek = Seek(rank: 1_i64, count: 0_i64, counted: no, maxlen: 0_u64, now: time^.check, state: state_absent);
  let ready = lpos_parse(input: input, args: args, client: client, time: time, seek: &seek);
  if bnot(ready) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let positions = box_slots_new::<u64>(capacity: 0_u64);
  let slot = &keys^[key];
  lpos_body(journal: journal, access_key: key, client: client, slot: slot, input: input, args: args, seek: &seek, positions: &positions);
  let removed = seek.state == state_expired;
  if removed {
    set slot^ = None<Entry>();
  }
  let appended = ttl_meta(log: effects, logged: logged, removed: removed, key: key);
  lpos_finish(client: client, seek: &seek, positions: &positions);
  return appended;
}

fn script_lmove(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, named: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "LMOVE or RPOPLPUSH through the same key-set body and metadata as the network, under the caller's statement.";
  let from_head = False();
  let to_head = True();
  if named {
    let ready = lmove_parse(input: input, args: args, client: client);
    if bnot(ready) {
      return 0_u64;
    }
    set from_head = client^.low == 0_i64;
    set to_head = client^.high == 0_i64;
  }
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let slots = &keys^[ks];
  let work = lmove_body(journal: journal, access_keys: &ks, slots: slots, source: pair.source, destination: pair.target, client: client, from_head: from_head, to_head: to_head);
  let appended = lmove_meta(log: effects, logged: logged, work: &work, input: input, args: args);
  lmove_finish(client: client);
  return appended;
}

