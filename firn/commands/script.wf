fn script_admit(memory: &pkg::scripting::ScriptMemory, meta: &Meta, input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> kind: u64 reads(input), reads(args), reads(meta.aof_append_error), reads(meta.aof_append_partial), reads(meta.aof_sync_error), writes(memory), writes(client) {
  doc "Redis script command admission, shared by declared and whole attempts, in Redis 7.0.15 scriptCall's order (script.c:530-557): subcommand and arity errors, then the active AOF check at the first WRITE command (scriptVerifyWriteCommandAllow, script.c:349-386), then DENYOOM; accepted WRITE flags are recorded before command-specific parsing. Both attempt kinds hold Meta for the entire attempt and the writer needs that hold to publish, so the status read here cannot change during the attempt. WRITE_DIRTY suppresses later disk checks and restarts with each retry, including the whole-keyspace fallback. The shared error reply reaches redis.call as an exception and redis.pcall as an error table.";
  let count = args^.inner.len;
  let name = arg(args: args, index: 0_u64);
  let kind = held_kind(input: input, name: name);
  if kind == 171_u64 {
    let object_count = object_arity(input: input, args: args);
    if object_count == 0_i64 {
      reply_error(client: client, word: &text_script_unknown[0_u64..44_u64]);
      return 0_u64;
    }
    let object_fits = arity_holds(arity: object_count, count: count);
    if bnot(object_fits) {
      reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
      return 0_u64;
    }
  }
  if kind == 166_u64 {
    let command = command_plan(input: input, args: args);
    if command == 3_u64 {
      reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
      return 0_u64;
    }
    if command == 0_u64 {
      reply_error(client: client, word: &text_script_unknown[0_u64..44_u64]);
      return 0_u64;
    }
    if command == 4_u64 {
      reply_error(client: client, word: &text_script_unknown_or_unsplit[0_u64..87_u64]);
      return 0_u64;
    }
  }
  if kind != 0_u64 {
    let arity = held_arity(kind: kind);
    if arity_holds(arity: arity, count: count) {
      let denyoom = command_denyoom(kind: kind);
      let unwritten = bnot(memory^.write_dirty);
      let writing = admission_writes(kind: kind, input: input, args: args);
      if band(unwritten, writing) {
        if aof_refuse(meta: meta, client: client) {
          return 0_u64;
        }
      }
      let before_write = band(memory^.pre_command_oom, unwritten);
      if band(before_write, denyoom) {
        reply_error(client: client, word: &oom_error[0_u64..55_u64]);
        return 0_u64;
      }
      if admission_writes(kind: kind, input: input, args: args) {
        set memory^.write_dirty = True();
      }
      return kind;
    }
    reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
    return 0_u64;
  }
  let code = name_code(input: input, start: name.start, length: name.length);
  let auth = code == code_auth;
  let hello = code == code_hello;
  let quit = code == code_quit;
  let resetting = code == code_reset;
  let debug = code == code_debug;
  let config = code == code_config;
  let client_command = code == code_client;
  let function = code == code_function;
  let greeting = bor(auth, hello);
  let leaving = bor(quit, debug);
  let settings = bor(config, client_command);
  let connection = bor(greeting, leaving);
  let administration = bor(settings, function);
  let normal_refused = bor(connection, administration);
  let shutdown = code == code_shutdown;
  let process_refused = bor(normal_refused, shutdown);
  let refused = bor(process_refused, resetting);
  if refused {
    if resetting {
      if count != 1_u64 {
        reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
        return 0_u64;
      }
    }
    let auth_or_debug = bor(auth, debug);
    let argued = bor(auth_or_debug, administration);
    if argued {
      if arity_holds(arity: arity_noscript_with_argument, count: count) {
      } else {
        reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
        return 0_u64;
      }
    }
    reply_error(client: client, word: &text_script_refused[0_u64..49_u64]);
    return 0_u64;
  }
  reply_error(client: client, word: &text_script_unknown_or_unsplit[0_u64..87_u64]);
  return 0_u64;
}

fn script_command(sequence: &pkg::store::WriteSequence, memory: &pkg::scripting::ScriptMemory, journal: &Option<pkg::store::AccessJournal>, database: &u64, db0: &ConcurrentHashMap<Entry>, db1: &ConcurrentHashMap<Entry>, db2: &ConcurrentHashMap<Entry>, db3: &ConcurrentHashMap<Entry>, db4: &ConcurrentHashMap<Entry>, db5: &ConcurrentHashMap<Entry>, db6: &ConcurrentHashMap<Entry>, db7: &ConcurrentHashMap<Entry>, db8: &ConcurrentHashMap<Entry>, db9: &ConcurrentHashMap<Entry>, db10: &ConcurrentHashMap<Entry>, db11: &ConcurrentHashMap<Entry>, db12: &ConcurrentHashMap<Entry>, db13: &ConcurrentHashMap<Entry>, db14: &ConcurrentHashMap<Entry>, db15: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(database), writes(db0), writes(db1), writes(db2), writes(db3), writes(db4), writes(db5), writes(db6), writes(db7), writes(db8), writes(db9), writes(db10), writes(db11), writes(db12), writes(db13), writes(db14), writes(db15), writes(meta), writes(effects), writes(client) contract {
  requires database^ < 16_u64;
  ensures database^ < 16_u64;
} {
  doc "Runs an admitted script command with all sixteen permanent maps held; its selected database is local to the attempt and EXEC shares held_databases_run.";
  let kind = script_admit(memory: memory, meta: meta, input: input, args: args, client: client);
  if kind == 0_u64 {
    return 0_u64;
  }
  return held_databases_run(sequence: sequence, journal: journal, database: database, kind: kind, db0: db0, db1: db1, db2: db2, db3: db3, db4: db4, db5: db5, db6: db6, db7: db7, db8: db8, db9: db9, db10: db10, db11: db11, db12: db12, db13: db13, db14: db14, db15: db15, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
}

fn script_command_entries(sequence: &pkg::store::WriteSequence, memory: &pkg::scripting::ScriptMemory, journal: &Option<pkg::store::AccessJournal>, slots: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, due: &pkg::store::ExpiryQueue, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: pkg::scripting::ScriptCommandResult reads(declared), reads(meta.aof_append_error), reads(meta.aof_append_partial), reads(meta.aof_sync_error), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(memory), writes(journal), writes(slots), writes(undo), writes(due), writes(effects), writes(client) contract {
  requires slots^.len == declared^.len;
  ensures slots^.len == entry(slots)^.len;
} {
  doc "Run Redis admission and then finite entry adapters; a whole footprint or undeclared operand abandons the attempt without becoming a Lua error.";
  let kind = script_admit(memory: memory, meta: meta, input: input, args: args, client: client);
  if kind == 0_u64 {
    return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
  }
  if kind == 163_u64 {
    let selection = database_plan(input: input, args: args, index: 1_u64);
    if selection.error != 0_u64 {
      select_finish(client: client, error: selection.error);
      return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
    }
    if selection.database != sequence^.database {
      return pkg::scripting::ScriptCommandResult::NeedWholeMap();
    }
    reply_ok(client: client);
    return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
  }
  if kind == 39_u64 {
    let copying = copy_parse(input: input, args: args, database: sequence^.database);
    if copy_refused(client: client, plan: &copying) {
      return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
    }
    if copying.database != sequence^.database {
      return pkg::scripting::ScriptCommandResult::NeedWholeMap();
    }
  }
  if kind == 190_u64 {
    let moving = move_plan(input: input, args: args, database: sequence^.database);
    if move_refused(client: client, plan: &moving) {
      return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
    }
    return pkg::scripting::ScriptCommandResult::NeedWholeMap();
  }
  if kind == 191_u64 {
    let swapping = swap_plan(input: input, args: args);
    if swap_refused(client: client, plan: &swapping) {
      return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
    }
    return pkg::scripting::ScriptCommandResult::NeedWholeMap();
  }
  if script_whole_kind(kind: kind) {
    if kind == 168_u64 {
      let plan = scan_plan(input: input, args: args);
      if scan_refused(client: client, plan: &plan) {
        return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
      }
    }
    let flushall = kind == 164_u64;
    let flushdb = kind == 165_u64;
    if bor(flushall, flushdb) {
      if flush_refused(input: input, args: args, client: client) {
        return pkg::scripting::ScriptCommandResult::Completed(appended: 0_u64);
      }
    }
    return pkg::scripting::ScriptCommandResult::NeedWholeMap();
  }
  let fallback = False();
  let effect_budget = pkg::store::effect_budget_begin(sequence: sequence);
  let appended = held_entries_run(sequence: sequence, effect_budget: &effect_budget, journal: journal, kind: kind, keys: slots, declared: declared, undo: undo, fallback: &fallback, due: due, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
  pkg::store::effect_budget_commit(sequence: sequence, budget: &effect_budget);
  if fallback {
    return pkg::scripting::ScriptCommandResult::NeedWholeMap();
  }
  return pkg::scripting::ScriptCommandResult::Completed(appended: appended);
}

