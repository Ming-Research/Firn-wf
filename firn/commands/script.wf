fn script_lrem(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "The network command parts under EXEC or a script, with expired removals recorded in the caller's effects.";
  let ready = lrem_parse(input: input, args: args, client: client, time: time);
  if bnot(ready) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let work = lrem_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, input: input, args: args);
  let appended = changed_meta(log: effects, logged: logged, removed: work.removed, changed: work.changed, input: input, args: args, key: key, budget: effect_budget);
  lrem_finish(client: client);
  return appended;
}

