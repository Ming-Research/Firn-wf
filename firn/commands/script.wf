fn script_set_combine(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, operation: u64, storing: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "SINTER, SUNION, SDIFF and their STORE forms under a held statement, through the shared ordered operand lookup, removal records and reply, including wrong-type refusals.";
  let ks = set_combine_parse(input: input, args: args, client: client, storing: storing, now: time^.check);
  let members = hash_map_new::<Key, unit, ceiling>(capacity: 0_u64);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let ranks = script_key_ranks(keys: &ks, declared: declared);
  let work = set_combine_body(sequence: sequence, journal: journal, slots: keys, keys: &ks, access_keys: declared, ranks: &ranks, client: client, env: env, operation: operation, storing: storing, members: &members);
  let appended = set_operands_meta(log: effects, logged: logged, removed: &work.removed, changed: work.changed, input: input, args: args, budget: effect_budget);
  set_combine_finish(client: client, storing: storing, members: &members);
  return appended;
}

fn script_sintercard(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "SINTERCARD under a held statement, through the network parts, removing and recording each expired operand once.";
  let plan = sintercard_parse(input: input, args: args, client: client);
  if bnot(plan.valid) {
    return 0_u64;
  }
  let ks = sintercard_keys(input: input, args: args, client: client, end: plan.end, now: time^.check);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let ranks = script_key_ranks(keys: &ks, declared: declared);
  let removed = sintercard_body(sequence: sequence, journal: journal, slots: keys, keys: &ks, access_keys: declared, ranks: &ranks, client: client, env: env, limit: plan.limit);
  let changed = False();
  let appended = set_operands_meta(log: effects, logged: logged, removed: &removed, changed: changed, input: input, args: args, budget: effect_budget);
  sintercard_finish(client: client);
  return appended;
}

fn script_zadd(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, increment: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "Runs the same ZADD parts over the entries held by EXEC or a script.";
  let plan = zadd_plan();
  let valid = zadd_parse(input: input, args: args, client: client, increment: increment, plan: &plan);
  if bnot(valid) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let lapsed = zadd_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, plan: &plan);
  let appended = zadd_meta(log: effects, logged: logged, lapsed: lapsed, plan: &plan, input: input, args: args, key: key, budget: effect_budget);
  zadd_finish(client: client, plan: &plan);
  return appended;
}

