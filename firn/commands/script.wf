fn held_run(journal: &Option<pkg::store::AccessJournal>, kind: u64, keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(journal), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "Runs a command held_kind names, its arity already checked, by its parts inside a statement holding every key and the keyspace's metadata, writing its reply into the client's reply as the network does and returning how many commands it appended to effects, the caller's record of what it changed. journal is the attempt environment's first-refresh undo log, or None for EXEC; the client carries the read's memory settings, refreshed after its own CONFIG SET. time is the statement's: its check is the instant the script or the transaction began, and its calendar time is frozen with it.";
  if kind == 171_u64 {
    return held_object(keys: keys, log: effects, logged: logged, input: input, args: args, client: client, time: time);
  }
  if kind == 164_u64 {
    return held_flush(keys: keys, due: &meta^.due, log: effects, logged: logged, input: input, args: args, client: client);
  }
  if kind == 165_u64 {
    return held_flush(keys: keys, due: &meta^.due, log: effects, logged: logged, input: input, args: args, client: client);
  }
  if kind == 168_u64 {
    return held_scan(keys: keys, log: effects, logged: logged, input: input, args: args, client: client, now: time^.check);
  }
  if kind == 169_u64 {
    held_keys(keys: keys, input: input, args: args, client: client, now: time^.check);
    return 0_u64;
  }
  if kind == 170_u64 {
    return held_randomkey(keys: keys, random: &meta^.random, log: effects, logged: logged, client: client, now: time^.check);
  }
  let relative = False();
  let calendar = True();
  if kind == 1_u64 {
    let got = script_get(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return got;
  }
  if kind == 2_u64 {
    let stored = script_set(journal: journal, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
    return stored;
  }
  if kind == 3_u64 {
    let bumped = script_incr(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: 1_i64);
    return bumped;
  }
  if kind == 4_u64 {
    let lowered = script_incr(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: -1_i64);
    return lowered;
  }
  if kind == 5_u64 {
    let added = script_incrby(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, negate: relative);
    return added;
  }
  if kind == 6_u64 {
    let taken = script_incrby(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, negate: calendar);
    return taken;
  }
  if kind == 7_u64 {
    let expiring = script_expire(journal: journal, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, scale: 1000_u64, absolute: relative, invalid: &text_expire_expire[0_u64..43_u64]);
    return expiring;
  }
  if kind == 8_u64 {
    let expiring = script_expire(journal: journal, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, scale: 1_u64, absolute: relative, invalid: &text_expire_pexpire[0_u64..44_u64]);
    return expiring;
  }
  if kind == 9_u64 {
    let expiring = script_expire(journal: journal, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, scale: 1000_u64, absolute: calendar, invalid: &text_expire_expireat[0_u64..45_u64]);
    return expiring;
  }
  if kind == 10_u64 {
    let expiring = script_expire(journal: journal, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, scale: 1_u64, absolute: calendar, invalid: &text_expire_pexpireat[0_u64..46_u64]);
    return expiring;
  }
  if kind == 11_u64 {
    let whole_seconds = True();
    let read = script_ttl(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, in_seconds: whole_seconds, absolute: relative);
    return read;
  }
  if kind == 12_u64 {
    let milliseconds = False();
    let read = script_ttl(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, in_seconds: milliseconds, absolute: relative);
    return read;
  }
  if kind == 13_u64 {
    let whole_seconds = True();
    let read = script_ttl(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, in_seconds: whole_seconds, absolute: calendar);
    return read;
  }
  if kind == 14_u64 {
    let milliseconds = False();
    let read = script_ttl(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, in_seconds: milliseconds, absolute: calendar);
    return read;
  }
  if kind == 15_u64 {
    let stored = script_mset(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return stored;
  }
  if kind == 16_u64 {
    let appended = script_named(journal: journal, kind: kind, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return appended;
  }
  if kind == 17_u64 {
    let appended = script_named(journal: journal, kind: kind, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return appended;
  }
  if kind == 18_u64 {
    let appended = script_named(journal: journal, kind: kind, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return appended;
  }
  if kind == 19_u64 {
    let appended = script_type(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return appended;
  }
  if kind == 20_u64 {
    let appended = script_persist(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return appended;
  }
  if kind == 21_u64 {
    let size = dbsize_body(keys: keys);
    count_finish(client: client, count: size);
    return 0_u64;
  }
  if kind == 22_u64 {
    run_ping(input: input, args: args, client: client);
    return 0_u64;
  }
  if kind == 23_u64 {
    run_echo(input: input, args: args, client: client);
    return 0_u64;
