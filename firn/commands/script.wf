  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  set client^.number = 0_u64;
  let slot = &keys^[key];
  let removed = hsetnx_body(slot: slot, client: client);
  let stored = client^.state == state_done;
  let added = client^.number > 0_u64;
  let changed = band(stored, added);
  let appended = changed_meta(log: effects, logged: logged, removed: removed, changed: changed, input: input, args: args, key: key);
  hsetnx_finish(client: client);
  return appended;
}

