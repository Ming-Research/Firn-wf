fn script_hincrbyfloat(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "HINCRBYFLOAT through the network command parts while EXEC or a script holds every key.";
  let read = hincrbyfloat_parse(input: input, args: args);
  let refused = hincrbyfloat_refused(client: client, read: &read);
  if refused {
    return 0_u64;
  }
  hash_field_parse(input: input, args: args, client: client);
  let key_span = arg(args: args, index: 1_u64);
  let field_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  let empty = decimal_text(value: 0_i64);
  let floating = Floating(increment: read, text: move empty, state: state_absent);
  let slot = &keys^[key];
  let removed = hincrbyfloat_body(journal: journal, access_key: key, slot: slot, client: client, floating: &floating);
  let appended = hincrbyfloat_meta(log: effects, logged: logged, removed: removed, client: client, floating: &floating, input: input, key_span: key_span, field_span: field_span, key: key);
  hincrbyfloat_finish(client: client, floating: &floating);
  return appended;
}

