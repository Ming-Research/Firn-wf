fn script_incrbyfloat(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "run_incrbyfloat through its shared parts over the entries held by EXEC or a script; returns its propagated record count.";
  let records = 0_u64;
  let increment = incrbyfloat_parse(input: input, args: args);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let nothing = slots_new::<u8, 24>();
  let empty = Bytes::Short(bytes: move nothing);
  let summed = FloatSum(increment: increment, text: move empty, now: time^.check, state: state_absent);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let removed = incrbyfloat_body(sequence: sequence, journal: journal, access_key: key, client: client, slot: slot, summed: &summed);
  let recorded_part = incrbyfloat_meta(log: effects, logged: logged, removed: removed, summed: &summed, input: input, key_span: key_span, key: key, budget: effect_budget);
  set records = records +wrap recorded_part;
  incrbyfloat_finish(client: client, summed: &summed);
  return records;
}

fn script_set_key(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, key_index: u64, value_index: u64, flags: u64, at: u64, mode: u64) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "set_key through its shared parts over the entries held by EXEC or a script; returns its propagated record count.";
  let records = 0_u64;
  let value_span = arg(args: args, index: value_index);
  let place = key_bounds(input: input, args: args, index: key_index);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  let timed_flag = iand(flags, options_expiry);
  let timed = timed_flag != 0_u64;
  set client^.now = time^.check;
  let plan = SetPlan(flags: flags, at: at, mode: mode, key_index: key_index, value_index: value_index);
  let none = False();
  let work = SetWork(outcome: state_absent, answered: none, removed: none);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  set work = set_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, value: move value, flags: flags, at: at);
  let stored = work.outcome == state_done;
  let queued = band(stored, timed);
  let changed = bor(stored, work.removed);
  let recorded = band(logged, changed);
  let touches = bor(queued, recorded);
  if touches {
    let recorded_part = set_meta(due: due, log: effects, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env, budget: effect_budget);
    set records = records +wrap recorded_part;
  }
  set_finish(client: client, plan: &plan, work: &work);
  return records;
}

fn script_setex(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, in_seconds: Bool, invalid: &[u8]) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "SETEX and PSETEX read their expiry before lookup and use SET's shared parts.";
  let parsed = setex_parse(input: input, args: args, client: client, time: time, in_seconds: in_seconds, invalid: invalid);
  let plan = match parsed {
    Some(value: accepted) => {
      give accepted;
    }
    None() => {
      return 0_u64;
    }
  }
  let appended = script_set_key(sequence: sequence, effect_budget: effect_budget, journal: journal, keys: keys, declared: declared, undo: undo, fallback: fallback, operation_kind: operation_kind, due: due, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, key_index: plan.key_index, value_index: plan.value_index, flags: plan.flags, at: plan.at, mode: plan.mode);
  return appended;
}

fn script_named(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, kind: u64, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "DEL and UNLINK remove each named entry, EXISTS and TOUCH count every occurrence, and MGET answers each in order, using the network bodies and metadata.";
  let count = args^.inner.len;
  let many = count -sat 1_u64;
  let removed_count = 0_u64;
  let live = 0_u64;
  let appended = 0_u64;
  set client^.now = time^.check;
  if kind == 34_u64 {
    reply_array(client: client, count: many);
  }
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  for @named (index in 1_u64..count) {
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let rank = script_key_rank(keys: declared, key: key);
    if rank >= keys^.len {
      set fallback^ = True();
      return 0_u64;
    }
    let slot = &keys^[rank];
    let lapsed = False();
    if kind <= 17_u64 {
      let found = remove_live(sequence: sequence, capture_key: key, slot: slot, now: time^.check);
      if found == 1_u64 {
        set removed_count = removed_count +wrap 1_u64;
      }
      set lapsed = found == 2_u64;
    } else if kind == 34_u64 {
      let found = mget_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client);
      set lapsed = client^.state == state_expired;
      mget_finish(client: client, kind: found);
    } else {
      if kind == 160_u64 {
        refresh_access(journal: journal, key: key, slot: slot, client: client);
      }
      let found = entry_kind(sequence: sequence, capture_key: key, slot: slot, client: client);
      set lapsed = client^.state == state_expired;
      if found != 0_u64 {
        set live = live +wrap 1_u64;
      }
    }
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key, budget: effect_budget);
    set appended = appended +wrap removal;
  }
  if kind <= 17_u64 {
    if removed_count > 0_u64 {
      let recorded = mset_meta(log: effects, logged: logged, input: input, args: args, budget: effect_budget);
      set appended = appended +wrap recorded;
    }
    count_finish(client: client, count: removed_count);
  } else if kind != 34_u64 {
    count_finish(client: client, count: live);
  }
  return appended;
}

fn script_msetnx(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "MSETNX probes entries in argument order, stopping at the first live entry, then stores each pair through mset_body only if all were absent.";
  let count = args^.inner.len;
  let rejected = mset_pairs_refused(input: input, args: args, client: client);
  if rejected {
    return 0_u64;
  }
  let pairs = count / 2_u64;
  let appended = 0_u64;
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  for @checked (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let rank = script_key_rank(keys: declared, key: key);
    if rank >= keys^.len {
      set fallback^ = True();
      return 0_u64;
    }
    let slot = &keys^[rank];
    refresh_access(journal: journal, key: key, slot: slot, client: client);
    let kind = entry_kind(sequence: sequence, capture_key: key, slot: slot, client: client);
    let lapsed = client^.state == state_expired;
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key, budget: effect_budget);
    set appended = appended +wrap removal;
    if kind != 0_u64 {
      let stored = False();
      msetnx_finish(client: client, stored: stored);
      return appended;
    }
  }
  for @stored (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let value_index = index +wrap 1_u64;
    let rank = script_key_rank(keys: declared, key: key);
    if rank >= keys^.len {
      set fallback^ = True();
      return 0_u64;
    }
    let slot = &keys^[rank];
    let replaced = mset_body(sequence: sequence, journal: journal, client: client, slot: slot, input: input, args: args, value_index: value_index, now: time^.check);
  }
  let recorded = mset_meta(log: effects, logged: logged, input: input, args: args, budget: effect_budget);
  set appended = appended +wrap recorded;
  let stored = True();
  msetnx_finish(client: client, stored: stored);
  return appended;
}

fn script_rename(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, fresh: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "RENAME and RENAMENX under the caller's held entries: the same parts as the network, with entries selected by the same key set and records appended to the caller's effects.";
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let ranks = script_key_ranks(keys: &ks, declared: declared);
  let source = key_position(positions: &ranks, index: pair.source);
  let target = key_position(positions: &ranks, index: pair.target);
  let work = rename_body(sequence: sequence, journal: journal, access_keys: declared, slots: keys, source: source, target: target, client: client, fresh: fresh);
  let appended = transfer_meta(due: due, log: effects, logged: logged, work: &work, input: input, args: args, env: env, budget: effect_budget);
  rename_finish(client: client, outcome: work.outcome, fresh: fresh);
  return appended;
}

fn script_copy(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "COPY under the caller's held entries: the same parsing, entries body, metadata and reply as the network, with records appended to the caller's effects.";
  let plan = copy_parse(input: input, args: args, database: sequence^.database);
  let rejected = copy_refused(client: client, plan: &plan);
  if rejected {
    return 0_u64;
  }
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let ranks = script_key_ranks(keys: &ks, declared: declared);
  let source = key_position(positions: &ranks, index: pair.source);
  let target = key_position(positions: &ranks, index: pair.target);
  let work = copy_body(sequence: sequence, journal: journal, access_keys: declared, slots: keys, source: source, target: target, client: client, replace: plan.replace);
  let appended = transfer_meta(due: due, log: effects, logged: logged, work: &work, input: input, args: args, env: env, budget: effect_budget);
  copy_finish(client: client, error: 0_u64, outcome: work.outcome);
  return appended;
}

