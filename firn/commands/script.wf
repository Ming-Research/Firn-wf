fn held_run(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, kind: u64, keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "Runs a command held_kind names, its arity already checked, by its parts inside a statement holding every key and the keyspace's metadata, writing its reply into the client's reply as the network does and returning how many commands it appended to effects, the caller's record of what it changed. journal is the attempt environment's first-refresh undo log, or None for EXEC; the client carries the read's memory settings, refreshed after its own CONFIG SET. time is the statement's: its check is the instant the script or the transaction began, and its calendar time is frozen with it.";
  if kind == 164_u64 {
    return pkg::store::command_held_flush_due::<Box<Slots<Span>>, Client, fn held_flush>(meta: meta, sequence: sequence, keys: keys, log: effects, logged: logged, input: input, args: args, client: client, budget: effect_budget);
  }
  if kind == 165_u64 {
    return pkg::store::command_held_flush_due::<Box<Slots<Span>>, Client, fn held_flush>(meta: meta, sequence: sequence, keys: keys, log: effects, logged: logged, input: input, args: args, client: client, budget: effect_budget);
  }
  if kind == 168_u64 {
    return held_scan(sequence: sequence, keys: keys, log: effects, logged: logged, input: input, args: args, client: client, now: time^.check, budget: effect_budget);
  }
  if kind == 169_u64 {
    held_keys(keys: keys, input: input, args: args, client: client, now: time^.check);
    return 0_u64;
  }
  if kind == 170_u64 {
    return pkg::store::command_held_randomkey_random::<Client, fn held_randomkey>(meta: meta, sequence: sequence, keys: keys, log: effects, logged: logged, client: client, now: time^.check, budget: effect_budget);
  }
  if kind == 21_u64 {
    let size = dbsize_body(keys: keys);
