fn script_incrbyfloat(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "run_incrbyfloat through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let amount = arg(args: args, index: 2_u64);
  let increment = extended_read(input: input, start: amount.start, length: amount.length);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let nothing = slots_new::<u8, 24>();
  let empty = Bytes::Short(bytes: move nothing);
  let summed = FloatSum(increment: increment, text: move empty, now: time^.check, state: state_absent);
  let slot = &keys^[key];
  let removed = incrbyfloat_body(slot: slot, summed: &summed);
  let recorded_part = incrbyfloat_meta(log: effects, logged: logged, removed: removed, summed: &summed, input: input, key_span: key_span, key: key);
  set records = records +wrap recorded_part;
  incrbyfloat_finish(client: client, summed: &summed);
  return records;
}

fn script_set_key(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, key_index: u64, value_index: u64, flags: u64, at: u64, mode: u64) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "set_key through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let value_span = arg(args: args, index: value_index);
  let place = key_bounds(input: input, args: args, index: key_index);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  let timed_flag = iand(flags, options_expiry);
  let timed = timed_flag != 0_u64;
  set client^.now = time^.check;
  let plan = SetPlan(flags: flags, at: at, mode: mode, key_index: key_index, value_index: value_index);
  let none = False();
  let work = SetWork(outcome: state_absent, answered: none, removed: none);
  let slot = &keys^[key];
  set work = set_body(slot: slot, client: client, value: move value, flags: flags, at: at);
  let stored = work.outcome == state_done;
  let queued = band(stored, timed);
  let changed = bor(stored, work.removed);
  let recorded = band(logged, changed);
  let touches = bor(queued, recorded);
  if touches {
    let recorded_part = set_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env);
    set records = records +wrap recorded_part;
  }
  set_finish(client: client, plan: &plan, work: &work);
  return records;
}

fn script_setex(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, in_seconds: Bool, invalid: &[u8]) -> appended: u64 reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "SETEX and PSETEX read their expiry before lookup and use SET's shared parts.";
  let flags = option_px;
  if in_seconds {
    set flags = option_ex;
  }
  let amount = arg(args: args, index: 2_u64);
  let deadline = string_deadline(input: input, span: amount, flags: flags, unix_ms: time^.unix_ms);
  if deadline.state == 0_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return 0_u64;
  }
  if deadline.state == 2_u64 {
    reply_error(client: client, word: invalid);
    return 0_u64;
  }
  let appended = script_set_key(keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time, key_index: 1_u64, value_index: 3_u64, flags: flags, at: deadline.at, mode: mode_set);
  return appended;
}

fn script_named(kind: u64, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "DEL and UNLINK remove each named entry, EXISTS counts every occurrence, and MGET answers each in order, using the network bodies and metadata.";
  let count = args^.inner.len;
  let many = count -sat 1_u64;
  let removed_count = 0_u64;
  let live = 0_u64;
  let appended = 0_u64;
  set client^.now = time^.check;
  if kind == 34_u64 {
    reply_array(client: client, count: many);
  }
  for @named (index in 1_u64..count) {
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let slot = &keys^[key];
    let lapsed = False();
    if kind <= 17_u64 {
      let found = remove_live(slot: slot, now: time^.check);
      if found == 1_u64 {
        set removed_count = removed_count +wrap 1_u64;
      }
      set lapsed = found == 2_u64;
    } else if kind == 34_u64 {
      let found = mget_body(slot: slot, client: client);
      set lapsed = client^.state == state_expired;
      mget_finish(client: client, kind: found);
    } else {
      let found = entry_kind(slot: slot, client: client);
      set lapsed = client^.state == state_expired;
      if found != 0_u64 {
        set live = live +wrap 1_u64;
      }
    }
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key);
    set appended = appended +wrap removal;
  }
  if kind <= 17_u64 {
    if removed_count > 0_u64 {
      let recorded = mset_meta(log: effects, logged: logged, input: input, args: args);
      set appended = appended +wrap recorded;
    }
    count_finish(client: client, count: removed_count);
  } else if kind != 34_u64 {
    count_finish(client: client, count: live);
  }
  return appended;
}

fn script_msetnx(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "MSETNX probes entries in argument order, stopping at the first live entry, then stores each pair through mset_body only if all were absent.";
  let count = args^.inner.len;
  let parity = count % 2_u64;
  if parity == 0_u64 {
    let name = arg(args: args, index: 0_u64);
    reply_arity(client: client, input: input, name: name);
    return 0_u64;
  }
  let pairs = count / 2_u64;
  let appended = 0_u64;
  set client^.now = time^.check;
  for @checked (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let slot = &keys^[key];
    let kind = entry_kind(slot: slot, client: client);
    let lapsed = client^.state == state_expired;
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key);
    set appended = appended +wrap removal;
    if kind != 0_u64 {
      let stored = False();
      msetnx_finish(client: client, stored: stored);
      return appended;
    }
  }
  for @stored (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let value_index = index +wrap 1_u64;
    let slot = &keys^[key];
    let replaced = mset_body(slot: slot, input: input, args: args, value_index: value_index, now: time^.check);
  }
  let recorded = mset_meta(log: effects, logged: logged, input: input, args: args);
  set appended = appended +wrap recorded;
  let stored = True();
  msetnx_finish(client: client, stored: stored);
  return appended;
}

fn script_rename(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, fresh: Bool) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "RENAME and RENAMENX under a statement holding every key: the same parts as the network, with entries selected by the same key set and records appended to the caller's effects.";
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let slots = &keys^[ks];
  let work = rename_body(slots: slots, source: pair.source, target: pair.target, client: client, fresh: fresh);
  let appended = transfer_meta(due: &meta^.due, log: effects, logged: logged, work: &work, input: input, args: args, env: env);
  rename_finish(client: client, outcome: work.outcome, fresh: fresh);
  return appended;
}

fn script_copy(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "COPY under a statement holding every key: the same parsing, entries body, metadata and reply as the network, with records appended to the caller's effects.";
  let plan = copy_parse(input: input, args: args);
  if plan.error != 0_u64 {
    copy_finish(client: client, error: plan.error, outcome: rename_missing);
    return 0_u64;
  }
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let slots = &keys^[ks];
  let work = copy_body(slots: slots, source: pair.source, target: pair.target, client: client, replace: plan.replace);
  let appended = transfer_meta(due: &meta^.due, log: effects, logged: logged, work: &work, input: input, args: args, env: env);
  copy_finish(client: client, error: 0_u64, outcome: work.outcome);
  return appended;
}

fn script_hset(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, counted: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "HSET and HMSET through the network command parts while EXEC or a script holds every key.";
