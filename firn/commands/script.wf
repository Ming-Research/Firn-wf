fn script_getex(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "run_getex through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let setting = False();
  let options = string_options(input: input, args: args, first: 2_u64, setting: setting);
  if options.valid {
  } else {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return 0_u64;
  }
  let plan = getex_plan(input: input, args: args, options: &options, time: time);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let none = False();
  let work = GetexWork(kind: 0_u64, removed: none, change: 0_u64);
  let slot = &keys^[key];
  set work = getex_body(slot: slot, client: client, plan: &plan);
  let recorded_part = getex_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, work: &work, input: input, key_span: key_span, key: key, env: env);
  set records = records +wrap recorded_part;
  getex_finish(client: client, plan: &plan, work: &work);
  return records;
}

fn script_append(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "run_append through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value_span = arg(args: args, index: 2_u64);
  set client^.now = time^.check;
  let none = False();
  let work = StringWork(outcome: state_absent, length: 0_u64, removed: none);
  let slot = &keys^[key];
  set work = append_body(slot: slot, input: input, client: client, value_span: value_span);
  let changed = work.outcome == state_done;
  let recorded_part = changed_meta(log: effects, logged: logged, removed: work.removed, changed: changed, input: input, args: args, key: key);
  set records = records +wrap recorded_part;
  string_write_finish(client: client, work: &work);
  return records;
}

fn script_setrange(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "run_setrange through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let plan = setrange_plan(input: input, args: args);
  let refused = setrange_refused(client: client, plan: &plan);
  if refused {
    return 0_u64;
  }
  let offset = cvt.wrap::<i64, u64>(plan.value);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value_span = arg(args: args, index: 3_u64);
  set client^.now = time^.check;
  let none = False();
  let work = StringWork(outcome: state_absent, length: 0_u64, removed: none);
  let slot = &keys^[key];
  set work = setrange_body(slot: slot, input: input, client: client, value_span: value_span, offset: offset);
  let changed = work.outcome == state_done;
  let recorded_part = changed_meta(log: effects, logged: logged, removed: work.removed, changed: changed, input: input, args: args, key: key);
  set records = records +wrap recorded_part;
  string_write_finish(client: client, work: &work);
  return records;
}

