  ensures keys^.len == entry(keys)^.len;
} {
  doc "HINCRBYFLOAT through the network command parts over the entries held by EXEC or a script.";
  let read = hincrbyfloat_parse(input: input, args: args);
  let refused = hincrbyfloat_refused(client: client, read: &read);
  if refused {
    return 0_u64;
  }
  hash_field_parse(input: input, args: args, client: client);
  let key_span = arg(args: args, index: 1_u64);
  let field_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  let empty = decimal_text(value: 0_i64);
  let floating = Floating(increment: read, text: move empty, state: state_absent);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let removed = hincrbyfloat_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, floating: &floating);
  let appended = hincrbyfloat_meta(log: effects, logged: logged, removed: removed, client: client, floating: &floating, input: input, key_span: key_span, field_span: field_span, key: key, budget: effect_budget);
  hincrbyfloat_finish(client: client, floating: &floating);
  return appended;
}

