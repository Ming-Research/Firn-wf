fn script_zcard(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "Runs the same ZCARD parts over the entries held by EXEC or a script.";
  let valid = zcard_parse(client: client);
  if bnot(valid) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  zcard_body(journal: journal, access_key: key, slot: slot, client: client);
  let lapsed = client^.state == state_expired;
  if lapsed {
    pkg::store::sequence_delete_key(sequence: sequence, slot: slot, key: key);
  }
  let appended = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key, budget: effect_budget);
  if client^.state == state_expired {
    set client^.number = 0_u64;
  }
  zcard_finish(client: client);
  return appended;
}

