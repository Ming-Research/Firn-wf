fn script_zcard(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "Runs the same ZCARD parts while EXEC or a script holds every key.";
  let valid = zcard_parse(client: client);
  if bnot(valid) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let slot = &keys^[key];
  zcard_body(journal: journal, access_key: key, slot: slot, client: client);
  let lapsed = client^.state == state_expired;
  if lapsed {
    set slot^ = None<Entry>();
  }
  let appended = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key);
  if client^.state == state_expired {
    set client^.number = 0_u64;
  }
  zcard_finish(client: client);
  return appended;
}

