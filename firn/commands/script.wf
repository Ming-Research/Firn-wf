fn script_command(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "Runs one command a script calls, inside the script's statement holding every key and the keyspace's metadata, writing its reply into the client's reply as the network does and returning how many commands it appended to effects, the script's own record of what it changed, which the caller wraps in MULTI and EXEC when it holds more than one, as Redis 7.0.15 propagates a script's effects. time is the script's: its check is the instant the script began. The commands held_kind names run through held_run; a count of arguments outside a command's arity is refused as Redis refuses it from a script, and AUTH, HELLO, QUIT, DEBUG, CONFIG, CLIENT and FUNCTION, which Redis 7.0.15 marks noscript, as Redis refuses them, after the arity check of the command itself: AUTH, DEBUG, CONFIG, CLIENT and FUNCTION need an argument, HELLO and QUIT none; a subcommand's own arity, such as CONFIG GET's, is not checked, so a short subcommand gets the refusal where Redis answers the arity error. Every other name is answered with Redis's error for a name no command has, extended to say that firn may know the command and not yet run it from scripts: firn names its commands only in execute's rows, so a script cannot tell an unknown name from a command firn has not split into its parts, and the extended text keeps the words Redis's own tests match.";
  let count = args^.inner.len;
  let name = arg(args: args, index: 0_u64);
  let kind = held_kind(input: input, name: name);
  if kind != 0_u64 {
    let arity = held_arity(kind: kind);
    if arity_holds(arity: arity, count: count) {
      let appended = held_run(kind: kind, keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
      return appended;
    }
    reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
    return 0_u64;
  }
  let code = name_code(input: input, start: name.start, length: name.length);
  let auth = code == code_auth;
  let hello = code == code_hello;
  let quit = code == code_quit;
  let debug = code == code_debug;
  let config = code == code_config;
  let client_command = code == code_client;
  let function = code == code_function;
  let greeting = bor(auth, hello);
  let leaving = bor(quit, debug);
  let settings = bor(config, client_command);
  let connection = bor(greeting, leaving);
  let administration = bor(settings, function);
  let refused = bor(connection, administration);
  if refused {
    let auth_or_debug = bor(auth, debug);
    let argued = bor(auth_or_debug, administration);
    if argued {
      if arity_holds(arity: arity_noscript_with_argument, count: count) {
      } else {
        reply_error(client: client, word: &text_script_arity[0_u64..58_u64]);
        return 0_u64;
      }
    }
    reply_error(client: client, word: &text_script_refused[0_u64..49_u64]);
    return 0_u64;
  }
  reply_error(client: client, word: &text_script_unknown_or_unsplit[0_u64..87_u64]);
  return 0_u64;
}

binding FirnCommands : ScriptCommands {
  doc "The commands a script calls are firn's commands written as parts, run by script_command.";
  call = script_command;
}

fn script_type(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "run_type through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let kind = 0_u64;
  let slot = &keys^[key];
  set kind = entry_kind(slot: slot, client: client);
  let removed = client^.state == state_expired;
  let recorded_part = mset_lapse_meta(log: effects, logged: logged, lapsed: removed, key: key);
  set records = records +wrap recorded_part;
  type_finish(client: client, kind: kind);
  return records;
}

fn script_persist(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "run_persist through its shared parts while EXEC or a script holds the keyspace; returns its propagated record count.";
  let records = 0_u64;
  let expiry = Expiry(at: 0_u64, now: time^.check, state: state_absent);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let slot = &keys^[key];
  persist_body(slot: slot, expiry: &expiry);
  let recorded_part = persist_meta(log: effects, logged: logged, expiry: &expiry, input: input, key_span: key_span, key: key);
  set records = records +wrap recorded_part;
  persist_finish(client: client, expiry: &expiry);
  return records;
}

