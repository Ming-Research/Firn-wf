alias extended_read = pkg::extended::extended_read;
alias decimal_text = pkg::bytes::decimal_text;
alias Bytes = pkg::bytes::Bytes;
alias reply_array = pkg::protocol::reply_array;
alias Client = pkg::protocol::Client;
alias ScriptCommands = pkg::scripting::ScriptCommands;
alias Entry = pkg::store::Entry;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Meta = pkg::store::Meta;
alias Span = pkg::protocol::Span;
alias Time = pkg::store::Time;
alias arg = pkg::protocol::arg;
alias log_removal = pkg::store::log_removal;
alias name_code = pkg::bytes::name_code;
alias name_is = pkg::bytes::name_is;
alias log_command = pkg::store::log_command;
alias reply_arity = pkg::protocol::reply_arity;
alias reply_ok = pkg::protocol::reply_ok;
alias reply_error = pkg::protocol::reply_error;
alias bytes_new = pkg::bytes::bytes_new;

const arity_get: i64 = 2_i64;

const arity_incr: i64 = 2_i64;

const arity_incrby: i64 = 3_i64;

const arity_expire: i64 = -3_i64;

const arity_ttl: i64 = 2_i64;

const arity_mset: i64 = -3_i64;

const arity_set: i64 = -3_i64;

const arity_del: i64 = -2_i64;

const arity_unlink: i64 = -2_i64;

const arity_exists: i64 = -2_i64;

const arity_type: i64 = 2_i64;

const arity_persist: i64 = 2_i64;

const arity_dbsize: i64 = 1_i64;

const arity_ping: i64 = -1_i64;

const arity_echo: i64 = 2_i64;

const arity_setnx: i64 = 3_i64;

const arity_setex: i64 = 4_i64;

const arity_psetex: i64 = 4_i64;

const arity_getset: i64 = 3_i64;

const arity_getdel: i64 = 2_i64;

const arity_getex: i64 = -2_i64;

const arity_append: i64 = 3_i64;

const arity_setrange: i64 = 4_i64;

const arity_strlen: i64 = 2_i64;

const arity_getrange: i64 = 4_i64;

const arity_mget: i64 = -2_i64;

const arity_msetnx: i64 = -3_i64;

const arity_incrbyfloat: i64 = 3_i64;

const arity_rename: i64 = 3_i64;

const arity_renamenx: i64 = 3_i64;

const arity_copy: i64 = -3_i64;

const arity_hset: i64 = -4_i64;

const arity_hmset: i64 = -4_i64;

const arity_hsetnx: i64 = 4_i64;

const arity_hget: i64 = 3_i64;

const arity_hmget: i64 = -3_i64;

const arity_hdel: i64 = -3_i64;

const arity_hexists: i64 = 3_i64;

const arity_hstrlen: i64 = 3_i64;

const arity_hlen: i64 = 2_i64;

const arity_hgetall: i64 = 2_i64;

const arity_hkeys: i64 = 2_i64;

const arity_hvals: i64 = 2_i64;

const arity_hincrby: i64 = 4_i64;

const arity_hincrbyfloat: i64 = 4_i64;

const arity_hrandfield: i64 = -2_i64;

const arity_noscript_with_argument: i64 = -2_i64;

const text_script_arity: Array<u8, 58> = "ERR Wrong number of args calling Redis command from script";

const text_script_unknown_or_unsplit: Array<u8, 87> = "ERR Unknown Redis command called from script, or one firn does not yet run from scripts";

const text_script_refused: Array<u8, 49> = "ERR This Redis command is not allowed from script";

fn arity_holds(arity: i64, count: u64) -> fits: Bool pure {
  doc "Whether a command of count arguments, its name among them, fits the arity Redis's command table gives it: exactly arity arguments when arity is positive, and at least its magnitude when negative.";
  let wide = cvt.wrap::<u64, i64>(count);
  if arity >= 0_i64 {
    return wide == arity;
  }
  let least = 0_i64 -wrap arity;
  return wide >= least;
}

fn script_get(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "GET inside a script holding every key: the work and reply of run_get, an expired key removed at once, as Redis 7.0.15 removes one a script's lookup finds expired, its removal appended to the script's effects when the keyspace keeps a file.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  let slot = &keys^[key];
  get_body(slot: slot, client: client);
  let appended = 0_u64;
  if client^.state == state_expired {
    set slot^ = None<Entry>();
    if logged {
      log_removal(log: effects, key: key);
      set appended = 1_u64;
    }
  }
  get_finish(client: client);
  return appended;
}

fn script_incr(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, delta: i64) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "INCR (delta 1), DECR (delta -1), and INCRBY and DECRBY once their amount is read, inside a script holding every key: the work, effects and reply of run_incr.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, delta: delta, now: time^.check, state: state_absent);
  let slot = &keys^[key];
  let removed = incr_body(slot: slot, counted: &counted);
  let appended = 0_u64;
  if logged {
    set appended = incr_log(log: effects, removed: removed, counted: &counted, input: input, args: args, key: key);
  }
  incr_finish(client: client, counted: &counted);
  return appended;
}

fn script_set(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "SET inside a script holding every key and the metadata: the options, work, effects and reply of run_set, its expiry options read against the script's frozen calendar time.";
  let setting = True();
  let options = string_options(input: input, args: args, first: 3_u64, setting: setting);
  if options.valid {
  } else {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return 0_u64;
  }
  let at = 0_u64;
  let timed_flag = iand(options.flags, options_expiry);
  if timed_flag != 0_u64 {
    let amount = arg(args: args, index: options.amount);
    let deadline = string_deadline(input: input, span: amount, flags: options.flags, unix_ms: time^.unix_ms);
    if deadline.state == 0_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return 0_u64;
    }
    if deadline.state == 2_u64 {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return 0_u64;
    }
    set at = deadline.at;
  }
  let value_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  set client^.now = time^.check;
  let plan = SetPlan(flags: options.flags, at: at, mode: mode_set, key_index: 1_u64, value_index: 2_u64);
  let slot = &keys^[key];
  let work = set_body(slot: slot, client: client, value: move value, flags: options.flags, at: at);
  let appended = set_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env);
  set_finish(client: client, plan: &plan, work: &work);
  return appended;
}

fn script_incrby(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, negate: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "INCRBY and DECRBY (negate) inside a script holding every key: the amount read as incrby_delta reads it, then the work, effects and reply of run_incr.";
  let delta = incrby_delta(input: input, args: args, negate: negate);
  let refused = delta_refused(client: client, delta: &delta);
  if refused {
    return 0_u64;
  }
  let appended = script_incr(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: delta.value);
  return appended;
}

fn script_expire(keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, scale: u64, absolute: Bool, invalid: &[u8]) -> appended: u64 reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "EXPIRE, PEXPIRE, EXPIREAT and PEXPIREAT inside a script holding every key and the metadata: the plan, work, effects and reply of run_expire, its deadline read against the script's frozen calendar time.";
  let not_loading = False();
  let plan = expire_plan(input: input, args: args, unix_ms: time^.unix_ms, loading: not_loading, scale: scale, absolute: absolute);
  let refused = expire_refused(client: client, input: input, args: args, plan: &plan, invalid: invalid);
  if refused {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let slot = &keys^[key];
  let outcome = expire_body(slot: slot, client: client, plan: &plan);
  let lapsed = client^.state == state_expired;
  let appended = expire_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, outcome: outcome, lapsed: lapsed, input: input, args: args, key: key, env: env);
  expire_finish(client: client, outcome: outcome);
  return appended;
}

fn script_ttl(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, in_seconds: Bool, absolute: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "TTL, PTTL, EXPIRETIME and PEXPIRETIME inside a script holding every key: the work, effects and reply of run_ttl, the time left counted from the script's start.";
  let remaining = Remaining(at: 0_u64, now: time^.check, state: 3_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let slot = &keys^[key];
  let removed = ttl_body(slot: slot, remaining: &remaining);
  let appended = ttl_meta(log: effects, logged: logged, removed: removed, key: key);
  ttl_finish(client: client, remaining: &remaining, now: time^.check, in_seconds: in_seconds, absolute: absolute);
  return appended;
}

fn script_mset(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "MSET inside a script holding every key: the work, effects and reply of run_mset, its pairs stored in order so that a key named twice keeps its last value. An even count of arguments is answered with MSET's own arity error, as Redis's msetGenericCommand answers it inside a script.";
  let count = args^.inner.len;
  let parity = count % 2_u64;
  if parity == 0_u64 {
    let name = arg(args: args, index: 0_u64);
    reply_arity(client: client, input: input, name: name);
    return 0_u64;
  }
  let pairs = count / 2_u64;
  let appended = 0_u64;
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let value_index = index +wrap 1_u64;
    let slot = &keys^[key];
    let lapsed = mset_body(slot: slot, input: input, args: args, value_index: value_index, now: time^.check);
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key);
    set appended = appended +wrap removal;
  }
  let recorded = mset_meta(log: effects, logged: logged, input: input, args: args);
  set appended = appended +wrap recorded;
  reply_ok(client: client);
  return appended;
}

fn held_kind(input: &[u8], name: Span) -> kind: u64 reads(input) {
  doc "Which command a statement holding every key and the metadata runs by its parts, for a script's call or a transaction's EXEC: 1 GET, 2 SET, 3 INCR, 4 DECR, 5 INCRBY, 6 DECRBY, 7 EXPIRE, 8 PEXPIRE, 9 EXPIREAT, 10 PEXPIREAT, 11 TTL, 12 PTTL, 13 EXPIRETIME, 14 PEXPIRETIME 15 MSET; 16 DEL, 17 UNLINK, 18 EXISTS, 19 TYPE, 20 PERSIST, 21 DBSIZE, 22 PING, 23 ECHO, 24 SETNX, 25 SETEX, 26 PSETEX, 27 GETSET, 28 GETDEL, 29 GETEX, 30 APPEND, 31 SETRANGE, 32 STRLEN, 33 GETRANGE, 34 MGET, 35 MSETNX, 36 INCRBYFLOAT, 37 RENAME, 38 RENAMENX, 39 COPY; 40 HSET, 41 HMSET, 42 HSETNX, 43 HGET, 44 HMGET, 45 HDEL, 46 HEXISTS, 47 HSTRLEN, 48 HLEN, 49 HGETALL, 50 HKEYS, 51 HVALS, 52 HINCRBY, 53 HINCRBYFLOAT, 54 HRANDFIELD, the command's name read in either case; 0 for any other name, firn naming its commands only in execute's rows.";
  let code = name_code(input: input, start: name.start, length: name.length);
  if code == code_get {
    return 1_u64;
  }
  if code == code_set {
    return 2_u64;
  }
  if code == code_incr {
    return 3_u64;
  }
  if code == code_decr {
    return 4_u64;
  }
  if code == code_incrby {
    return 5_u64;
  }
  if code == code_decrby {
    return 6_u64;
  }
  if code == code_expire {
    return 7_u64;
  }
  if code == code_pexpire {
    return 8_u64;
  }
  if code == code_expireat {
    return 9_u64;
  }
  if code == code_pexpireat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_pexpireat[0_u64..9_u64]);
    if spelled {
      return 10_u64;
    }
    let timed = name_is(input: input, start: name.start, length: name.length, word: &word_pexpiretime[0_u64..11_u64]);
    if timed {
      return 14_u64;
    }
    return 0_u64;
  }
  if code == code_ttl {
    return 11_u64;
  }
  if code == code_pttl {
    return 12_u64;
  }
  if code == code_expiretime {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_expiretime[0_u64..10_u64]);
    if spelled {
      return 13_u64;
    }
    return 0_u64;
  }
  if code == code_mset {
    return 15_u64;
  }
  if code == code_del {
    return 16_u64;
  }
  if code == code_unlink {
    return 17_u64;
  }
  if code == code_exists {
    return 18_u64;
  }
  if code == code_type {
    return 19_u64;
  }
  if code == code_persist {
    return 20_u64;
  }
  if code == code_dbsize {
    return 21_u64;
  }
  if code == code_ping {
    return 22_u64;
  }
  if code == code_echo {
    return 23_u64;
  }
  if code == code_setnx {
    return 24_u64;
  }
  if code == code_setex {
    return 25_u64;
  }
  if code == code_psetex {
    return 26_u64;
  }
  if code == code_getset {
    return 27_u64;
  }
  if code == code_getdel {
    return 28_u64;
  }
  if code == code_getex {
    return 29_u64;
  }
  if code == code_append {
    return 30_u64;
  }
  if code == code_setrange {
    return 31_u64;
  }
  if code == code_strlen {
    return 32_u64;
  }
  if code == code_getrange {
    return 33_u64;
  }
  if code == code_mget {
    return 34_u64;
  }
  if code == code_msetnx {
    return 35_u64;
  }
  if code == code_incrbyfloat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_incrbyfloat[0_u64..11_u64]);
    if spelled {
      return 36_u64;
    }
  }
  if code == code_rename {
    return 37_u64;
  }
  if code == code_renamenx {
    return 38_u64;
  }
  if code == code_copy {
    return 39_u64;
  }
  if code == code_hset {
    return 40_u64;
  }
  if code == code_hmset {
    return 41_u64;
  }
  if code == code_hsetnx {
    return 42_u64;
  }
  if code == code_hget {
    return 43_u64;
  }
  if code == code_hmget {
    return 44_u64;
  }
  if code == code_hdel {
    return 45_u64;
  }
  if code == code_hexists {
    return 46_u64;
  }
  if code == code_hstrlen {
    return 47_u64;
  }
  if code == code_hlen {
    return 48_u64;
  }
  if code == code_hgetall {
    return 49_u64;
  }
  if code == code_hkeys {
    return 50_u64;
  }
  if code == code_hvals {
    return 51_u64;
  }
  if code == code_hincrby {
    return 52_u64;
  }
  if code == code_hincrbyfloat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_hincrbyfloat[0_u64..12_u64]);
    if spelled {
      return 53_u64;
    }
  }
  if code == code_hrandfield {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_hrandfield[0_u64..10_u64]);
    if spelled {
      return 54_u64;
    }
  }
  return 0_u64;
}

fn held_arity(kind: u64) -> arity: i64 pure {
  doc "The arity Redis 7.0.15's command table gives a command held_kind names, positive for exactly that many arguments with its name and negative for at least its magnitude.";
  if kind == 1_u64 {
    return arity_get;
  }
  if kind == 2_u64 {
    return arity_set;
  }
  let counter = kind <= 4_u64;
  if counter {
    return arity_incr;
  }
  let amount = kind <= 6_u64;
  if amount {
    return arity_incrby;
  }
  let setter = kind <= 10_u64;
  if setter {
    return arity_expire;
  }
  let reader = kind <= 14_u64;
  if reader {
    return arity_ttl;
  }
  if kind == 15_u64 {
    return arity_mset;
  }
  if kind == 16_u64 {
    return arity_del;
  }
  if kind == 17_u64 {
    return arity_unlink;
  }
  if kind == 18_u64 {
    return arity_exists;
  }
  if kind == 19_u64 {
    return arity_type;
  }
  if kind == 20_u64 {
    return arity_persist;
  }
  if kind == 21_u64 {
    return arity_dbsize;
  }
  if kind == 22_u64 {
    return arity_ping;
  }
  if kind == 23_u64 {
    return arity_echo;
  }
  if kind == 24_u64 {
    return arity_setnx;
  }
  if kind == 25_u64 {
    return arity_setex;
  }
  if kind == 26_u64 {
    return arity_psetex;
  }
  if kind == 27_u64 {
    return arity_getset;
  }
  if kind == 28_u64 {
    return arity_getdel;
  }
  if kind == 29_u64 {
    return arity_getex;
  }
  if kind == 30_u64 {
    return arity_append;
  }
  if kind == 31_u64 {
    return arity_setrange;
  }
  if kind == 32_u64 {
    return arity_strlen;
  }
  if kind == 33_u64 {
    return arity_getrange;
  }
  if kind == 34_u64 {
    return arity_mget;
  }
  if kind == 35_u64 {
    return arity_msetnx;
  }
  if kind == 36_u64 {
    return arity_incrbyfloat;
  }
  if kind == 37_u64 {
    return arity_rename;
  }
  if kind == 38_u64 {
    return arity_renamenx;
  }
  if kind == 39_u64 {
    return arity_copy;
  }
  if kind == 40_u64 {
    return arity_hset;
  }
  if kind == 41_u64 {
    return arity_hmset;
  }
  if kind == 42_u64 {
    return arity_hsetnx;
  }
  if kind == 43_u64 {
    return arity_hget;
  }
  if kind == 44_u64 {
    return arity_hmget;
  }
  if kind == 45_u64 {
    return arity_hdel;
  }
  if kind == 46_u64 {
    return arity_hexists;
  }
  if kind == 47_u64 {
    return arity_hstrlen;
  }
  if kind == 48_u64 {
    return arity_hlen;
  }
  if kind == 49_u64 {
    return arity_hgetall;
  }
  if kind == 50_u64 {
    return arity_hkeys;
  }
  if kind == 51_u64 {
    return arity_hvals;
  }
  if kind == 52_u64 {
    return arity_hincrby;
  }
  if kind == 53_u64 {
    return arity_hincrbyfloat;
  }
  if kind == 54_u64 {
    return arity_hrandfield;
  }
  return 0_i64;
}

fn held_run(kind: u64, keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "Runs a command held_kind names, its arity already checked, by its parts inside a statement holding every key and the keyspace's metadata, writing its reply into the client's reply as the network does and returning how many commands it appended to effects, the caller's record of what it changed. time is the statement's: its check is the instant the script or the transaction began, and its calendar time is frozen with it.";
  let relative = False();
  let calendar = True();
  if kind == 1_u64 {
    let got = script_get(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time);
    return got;
  }
  if kind == 2_u64 {
    let stored = script_set(keys: keys, meta: meta, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
    return stored;
  }
  if kind == 3_u64 {
    let bumped = script_incr(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: 1_i64);
    return bumped;
  }
  if kind == 4_u64 {
    let lowered = script_incr(keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: -1_i64);
    return lowered;
  }
  if kind == 5_u64 {
