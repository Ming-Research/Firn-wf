const text_script_arity: Array<u8, 58> = "ERR Wrong number of args calling Redis command from script";

const text_script_unknown: Array<u8, 44> = "ERR Unknown Redis command called from script";

const text_script_unknown_or_unsplit: Array<u8, 87> = "ERR Unknown Redis command called from script, or one firn does not yet run from scripts";

const text_script_refused: Array<u8, 49> = "ERR This Redis command is not allowed from script";

fn arity_holds(arity: i64, count: u64) -> fits: Bool pure {
  doc "Whether a command of count arguments, its name among them, fits the arity Redis's command table gives it: exactly arity arguments when arity is positive, and at least its magnitude when negative.";
  let wide = cvt.wrap::<u64, i64>(count);
  if arity >= 0_i64 {
    return wide == arity;
  }
  let least = 0_i64 -wrap arity;
  return wide >= least;
}

fn script_get(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "GET inside a script holding every key: the work and reply of run_get, an expired key removed at once, as Redis 7.0.15 removes one a script's lookup finds expired, its removal appended to the script's effects when the keyspace keeps a file.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  let slot = &keys^[key];
  get_body(journal: journal, access_key: key, slot: slot, client: client);
  let appended = 0_u64;
  if client^.state == state_expired {
    set slot^ = None<Entry>();
    if logged {
      log_removal(log: effects, key: key);
      set appended = 1_u64;
    }
  }
  get_finish(client: client);
  return appended;
}

fn script_incr(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, delta: i64) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "INCR (delta 1), DECR (delta -1), and INCRBY and DECRBY once their amount is read, inside a script holding every key: the work, effects and reply of run_incr.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, delta: delta, now: time^.check, state: state_absent);
  let slot = &keys^[key];
  let removed = incr_body(journal: journal, access_key: key, client: client, slot: slot, counted: &counted);
  let appended = 0_u64;
  if logged {
    set appended = incr_log(log: effects, removed: removed, counted: &counted, input: input, args: args, key: key);
  }
  incr_finish(client: client, counted: &counted);
  return appended;
}

fn script_set(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(journal), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "SET inside a script holding every key and the metadata: the options, work, effects and reply of run_set, its expiry options read against the script's frozen calendar time.";
  let setting = True();
  let options = string_options(input: input, args: args, first: 3_u64, setting: setting);
  if options.valid {
  } else {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return 0_u64;
  }
  let at = 0_u64;
  let timed_flag = iand(options.flags, options_expiry);
  if timed_flag != 0_u64 {
    let amount = arg(args: args, index: options.amount);
    let deadline = string_deadline(input: input, span: amount, flags: options.flags, unix_ms: time^.unix_ms);
    if deadline.state == 0_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return 0_u64;
    }
    if deadline.state == 2_u64 {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return 0_u64;
    }
    set at = deadline.at;
  }
  let value_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  set client^.now = time^.check;
  let plan = SetPlan(flags: options.flags, at: at, mode: mode_set, key_index: 1_u64, value_index: 2_u64);
  let slot = &keys^[key];
  let work = set_body(journal: journal, access_key: key, slot: slot, client: client, value: move value, flags: options.flags, at: at);
  let appended = set_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env);
  set_finish(client: client, plan: &plan, work: &work);
  return appended;
}

fn script_incrby(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, negate: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "INCRBY and DECRBY (negate) inside a script holding every key: the amount read as incrby_delta reads it, then the work, effects and reply of run_incr.";
  let delta = incrby_delta(input: input, args: args, negate: negate);
  let refused = delta_refused(client: client, delta: &delta);
  if refused {
    return 0_u64;
  }
  let appended = script_incr(journal: journal, keys: keys, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: delta.value);
  return appended;
}

fn script_expire(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, meta: &Meta, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, scale: u64, absolute: Bool, invalid: &[u8]) -> appended: u64 reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(journal), writes(keys), writes(meta), writes(effects), writes(client) {
  doc "EXPIRE, PEXPIRE, EXPIREAT and PEXPIREAT inside a script holding every key and the metadata: the plan, work, effects and reply of run_expire, its deadline read against the script's frozen calendar time.";
  let not_loading = False();
  let plan = expire_plan(input: input, args: args, unix_ms: time^.unix_ms, loading: not_loading, scale: scale, absolute: absolute);
  let refused = expire_refused(client: client, input: input, args: args, plan: &plan, invalid: invalid);
  if refused {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let slot = &keys^[key];
  let outcome = expire_body(journal: journal, access_key: key, slot: slot, client: client, plan: &plan);
  let lapsed = client^.state == state_expired;
  let appended = expire_meta(due: &meta^.due, log: effects, logged: logged, plan: &plan, outcome: outcome, lapsed: lapsed, input: input, args: args, key: key, env: env);
  expire_finish(client: client, outcome: outcome);
  return appended;
}

fn script_ttl(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, in_seconds: Bool, absolute: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "TTL, PTTL, EXPIRETIME and PEXPIRETIME inside a script holding every key: the work, effects and reply of run_ttl, the time left counted from the script's start.";
  let remaining = Remaining(at: 0_u64, now: time^.check, state: 3_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let slot = &keys^[key];
  let removed = ttl_body(slot: slot, remaining: &remaining);
  let appended = ttl_meta(log: effects, logged: logged, removed: removed, key: key);
  ttl_finish(client: client, remaining: &remaining, now: time^.check, in_seconds: in_seconds, absolute: absolute);
  return appended;
}

fn script_mset(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "MSET inside a script holding every key: the work, effects and reply of run_mset, its pairs stored in order so that a key named twice keeps its last value. An even count of arguments is answered with MSET's own arity error, as Redis's msetGenericCommand answers it inside a script.";
  let count = args^.inner.len;
  let rejected = mset_pairs_refused(input: input, args: args, client: client);
  if rejected {
    return 0_u64;
  }
  let pairs = count / 2_u64;
  let appended = 0_u64;
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let value_index = index +wrap 1_u64;
    let slot = &keys^[key];
    let lapsed = mset_body(journal: journal, client: client, slot: slot, input: input, args: args, value_index: value_index, now: time^.check);
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key);
    set appended = appended +wrap removal;
  }
  let recorded = mset_meta(log: effects, logged: logged, input: input, args: args);
  set appended = appended +wrap recorded;
  reply_ok(client: client);
  return appended;
}

fn command_kind(input: &[u8], name: Span) -> kind: u64 reads(input) {
  doc "Shared command identity for admission and dispatch; kinds through 171 run by held parts: 1 GET, 2 SET, 3 INCR, 4 DECR, 5 INCRBY, 6 DECRBY, 7 EXPIRE, 8 PEXPIRE, 9 EXPIREAT, 10 PEXPIREAT, 11 TTL, 12 PTTL, 13 EXPIRETIME, 14 PEXPIRETIME, 15 MSET; 16 DEL, 17 UNLINK, 18 EXISTS, 19 TYPE, 20 PERSIST, 21 DBSIZE, 22 PING, 23 ECHO, 24 SETNX, 25 SETEX, 26 PSETEX, 27 GETSET, 28 GETDEL, 29 GETEX, 30 APPEND, 31 SETRANGE, 32 STRLEN, 33 GETRANGE, 34 MGET, 35 MSETNX, 36 INCRBYFLOAT, 37 RENAME, 38 RENAMENX, 39 COPY; 40 HSET, 41 HMSET, 42 HSETNX, 43 HGET, 44 HMGET, 45 HDEL, 46 HEXISTS, 47 HSTRLEN, 48 HLEN, 49 HGETALL, 50 HKEYS, 51 HVALS, 52 HINCRBY, 53 HINCRBYFLOAT, 54 HRANDFIELD; 60 LPUSH, 61 RPUSH, 62 LPUSHX, 63 RPUSHX, 64 LPOP, 65 RPOP, 66 LRANGE, 67 LLEN, 68 LINDEX, 69 LSET, 70 LREM, 71 LTRIM, 72 LINSERT, 73 LPOS, 74 LMOVE, 75 RPOPLPUSH; 90 SADD, 91 SREM, 92 SPOP, 93 SCARD, 94 SMEMBERS, 95 SISMEMBER, 96 SMISMEMBER, 97 SRANDMEMBER, 98 SMOVE, 99 SINTER, 100 SUNION, 101 SDIFF, 102 SINTERCARD, 103 SINTERSTORE, 104 SUNIONSTORE, 105 SDIFFSTORE; 120 ZADD, 121 ZINCRBY, 122 ZREM, 123 ZPOPMIN, 124 ZPOPMAX, 125 ZCARD, 126 ZSCORE, 127 ZMSCORE, 128 ZRANK, 129 ZREVRANK, 130 ZRANGE, 131 ZREVRANGE, 132 ZRANGEBYSCORE, 133 ZREVRANGEBYSCORE, 134 ZRANGEBYLEX, 135 ZREVRANGEBYLEX, 136 ZCOUNT, 137 ZLEXCOUNT, 138 ZREMRANGEBYRANK, 139 ZREMRANGEBYSCORE, 140 ZREMRANGEBYLEX; 160 TOUCH, 161 SUBSTR, 162 TIME, 163 SELECT, 164 FLUSHALL, 165 FLUSHDB, 166 COMMAND, 168 SCAN, 169 KEYS, 170 RANDOMKEY, 171 OBJECT, 167 is reserved. Network-only kinds are 172 EVAL, 173 EVALSHA, 174 SCRIPT, 175 INFO, 176 CONFIG, 177 AUTH, 178 HELLO, 179 QUIT, 180 CLIENT, 181 DEBUG, 182 FUNCTION, 183 SHUTDOWN, 184 BGREWRITEAOF, 185 MULTI, 186 EXEC, 187 DISCARD, 188 WATCH (only its inside-MULTI refusal), 189 RESET. Names are case insensitive; zero is unknown.";
  let code = name_code(input: input, start: name.start, length: name.length);
  if code == code_object {
    return 171_u64;
  }
  if code == code_get {
    return 1_u64;
  }
  if code == code_set {
    return 2_u64;
  }
  if code == code_incr {
    return 3_u64;
  }
  if code == code_decr {
    return 4_u64;
  }
  if code == code_incrby {
    return 5_u64;
  }
  if code == code_decrby {
    return 6_u64;
  }
  if code == code_expire {
    return 7_u64;
  }
  if code == code_pexpire {
    return 8_u64;
  }
  if code == code_expireat {
    return 9_u64;
  }
  if code == code_pexpireat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_pexpireat[0_u64..9_u64]);
    if spelled {
      return 10_u64;
    }
    let timed = name_is(input: input, start: name.start, length: name.length, word: &word_pexpiretime[0_u64..11_u64]);
    if timed {
      return 14_u64;
    }
    return 0_u64;
  }
  if code == code_ttl {
    return 11_u64;
  }
  if code == code_pttl {
    return 12_u64;
  }
  if code == code_expiretime {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_expiretime[0_u64..10_u64]);
    if spelled {
      return 13_u64;
    }
    return 0_u64;
  }
  if code == code_mset {
    return 15_u64;
  }
  if code == code_del {
    return 16_u64;
  }
  if code == code_unlink {
    return 17_u64;
  }
  if code == code_exists {
    return 18_u64;
  }
  if code == code_type {
    return 19_u64;
  }
  if code == code_persist {
    return 20_u64;
  }
  if code == code_dbsize {
    return 21_u64;
  }
  if code == code_ping {
    return 22_u64;
  }
  if code == code_echo {
    return 23_u64;
  }
  if code == code_setnx {
    return 24_u64;
  }
  if code == code_setex {
    return 25_u64;
  }
  if code == code_psetex {
    return 26_u64;
  }
  if code == code_getset {
    return 27_u64;
  }
  if code == code_getdel {
    return 28_u64;
  }
  if code == code_getex {
    return 29_u64;
  }
  if code == code_append {
    return 30_u64;
  }
  if code == code_setrange {
    return 31_u64;
  }
  if code == code_strlen {
    return 32_u64;
  }
  if code == code_getrange {
    return 33_u64;
  }
  if code == code_mget {
    return 34_u64;
  }
  if code == code_msetnx {
    return 35_u64;
  }
  if code == code_incrbyfloat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_incrbyfloat[0_u64..11_u64]);
    if spelled {
      return 36_u64;
    }
  }
  if code == code_rename {
    return 37_u64;
  }
  if code == code_renamenx {
    return 38_u64;
  }
  if code == code_copy {
    return 39_u64;
  }
  if code == code_hset {
    return 40_u64;
  }
  if code == code_hmset {
    return 41_u64;
  }
  if code == code_hsetnx {
    return 42_u64;
  }
  if code == code_hget {
    return 43_u64;
  }
  if code == code_hmget {
    return 44_u64;
  }
  if code == code_hdel {
    return 45_u64;
  }
  if code == code_hexists {
    return 46_u64;
  }
  if code == code_hstrlen {
    return 47_u64;
  }
  if code == code_hlen {
    return 48_u64;
  }
  if code == code_hgetall {
    return 49_u64;
  }
  if code == code_hkeys {
    return 50_u64;
  }
  if code == code_hvals {
    return 51_u64;
  }
  if code == code_hincrby {
    return 52_u64;
  }
  if code == code_hincrbyfloat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_hincrbyfloat[0_u64..12_u64]);
    if spelled {
      return 53_u64;
    }
  }
  if code == code_hrandfield {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_hrandfield[0_u64..10_u64]);
    if spelled {
      return 54_u64;
    }
  }
  if code == code_lpush {
    return 60_u64;
  }
  if code == code_rpush {
    return 61_u64;
  }
  if code == code_lpushx {
    return 62_u64;
  }
  if code == code_rpushx {
    return 63_u64;
  }
  if code == code_lpop {
    return 64_u64;
  }
  if code == code_rpop {
