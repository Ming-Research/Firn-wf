fn script_lpos(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "LPOS by the network parts under EXEC or a script; expired keys are removed and recorded immediately.";
  let no = False();
  let seek = Seek(rank: 1_i64, count: 0_i64, counted: no, maxlen: 0_u64, now: time^.check, state: state_absent);
  let ready = lpos_parse(input: input, args: args, client: client, time: time, seek: &seek);
  if bnot(ready) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let positions = box_slots_new::<u64>(capacity: 0_u64);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  lpos_body(journal: journal, access_key: key, client: client, slot: slot, input: input, args: args, seek: &seek, positions: &positions);
  let removed = seek.state == state_expired;
  if removed {
    pkg::store::sequence_delete_key(sequence: sequence, slot: slot, key: key);
  }
  let appended = ttl_meta(log: effects, logged: logged, removed: removed, key: key, budget: effect_budget);
  lpos_finish(client: client, seek: &seek, positions: &positions);
  return appended;
}

fn script_lmove(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, named: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "LMOVE or RPOPLPUSH through the same key-set body and metadata as the network, under the caller's statement.";
  let from_head = False();
  let to_head = True();
  if named {
    let ready = lmove_parse(input: input, args: args, client: client);
    if bnot(ready) {
      return 0_u64;
    }
    set from_head = client^.low == 0_i64;
    set to_head = client^.high == 0_i64;
  }
  let ks = key_set_new(capacity: 2_u64);
  let pair = rename_parse(input: input, args: args, keys: &ks);
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let ranks = script_key_ranks(keys: &ks, declared: declared);
  let source = key_position(positions: &ranks, index: pair.source);
  let target = key_position(positions: &ranks, index: pair.target);
  let work = lmove_body(sequence: sequence, journal: journal, access_keys: declared, slots: keys, source: source, destination: target, client: client, from_head: from_head, to_head: to_head);
  let appended = lmove_meta(log: effects, logged: logged, work: &work, input: input, args: args, budget: effect_budget);
  lmove_finish(client: client);
  return appended;
}

