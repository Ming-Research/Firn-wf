fn held_kind(input: &[u8], name: Span) -> kind: u64 reads(input) {
  doc "The command identity when it has parts usable under EXEC or a script's atomic statement; zero otherwise.";
  let kind = command_kind(input: input, name: name);
  if kind <= 171_u64 {
    return kind;
  }
  return 0_u64;
}

