fn script_smembers(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "SMEMBERS under a held statement, through the network parts, removing and recording an expired entry at once.";
  smembers_parse(client: client, now: time^.check);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let slot = &keys^[key];
  let lapsed = smembers_body(journal: journal, access_key: key, slot: slot, client: client);
  if lapsed {
    set slot^ = None<Entry>();
  }
  let appended = ttl_meta(log: effects, logged: logged, removed: lapsed, key: key);
  smembers_finish(client: client);
  return appended;
}

