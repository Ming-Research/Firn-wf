const text_script_arity: Array<u8, 58> = "ERR Wrong number of args calling Redis command from script";

const text_script_unknown: Array<u8, 44> = "ERR Unknown Redis command called from script";

const text_script_unknown_or_unsplit: Array<u8, 87> = "ERR Unknown Redis command called from script, or one firn does not yet run from scripts";

const text_script_refused: Array<u8, 49> = "ERR This Redis command is not allowed from script";

fn arity_holds(arity: i64, count: u64) -> fits: Bool pure {
  doc "Whether a command of count arguments, its name among them, fits the arity Redis's command table gives it: exactly arity arguments when arity is positive, and at least its magnitude when negative.";
  let wide = cvt.wrap::<u64, i64>(count);
  if arity >= 0_i64 {
    return wide == arity;
  }
  let least = 0_i64 -wrap arity;
  return wide >= least;
}

fn script_whole_kind(kind: u64) -> whole: Bool pure {
  doc "The admitted commands whose footprint is the whole keyspace, independently of its present contents.";
  if kind == 190_u64 {
    return True();
  }
  if kind == 191_u64 {
    return True();
  }
  let flushall = kind == 164_u64;
  let flushdb = kind == 165_u64;
  let flush = bor(flushall, flushdb);
  let scan = kind == 168_u64;
  let keys = kind == 169_u64;
  let enumeration = bor(scan, keys);
  let size = kind == 21_u64;
  let random = kind == 170_u64;
  let global = bor(size, random);
  let changing_or_enumerating = bor(flush, enumeration);
  return bor(changing_or_enumerating, global);
}

fn script_key_plan(kind: u64, input: &[u8], args: &Box<Slots<Span>>) -> plan: ScriptKeyPlan reads(input), reads(args) {
  doc "The complete binary key footprint after command admission: insertion order retains the command's first occurrence of each name; command execution still retains every original argument and duplicate. Invalid SINTERCARD counts produce an empty footprint so its normal parser can issue its error before entries are touched.";
  if script_whole_kind(kind: kind) {
    return ScriptKeyPlan::WholeMap();
  }
  let ping = kind == 22_u64;
  let echo = kind == 23_u64;
  let time = kind == 162_u64;
  let select = kind == 163_u64;
  let command = kind == 166_u64;
  let local_replies = bor(ping, echo);
  let session_commands = bor(select, command);
  let local_commands = bor(time, session_commands);
  let no_keys = bor(local_replies, local_commands);
  if no_keys {
    return ScriptKeyPlan::NoKeys();
  }
  let first = 1_u64;
  let end = 2_u64;
  let step = 1_u64;
  if kind == 171_u64 {
    let sub = arg(args: args, index: 1_u64);
    if word_at(input: input, span: sub, word: &object_help_name[0_u64..4_u64]) {
      return ScriptKeyPlan::NoKeys();
    }
    set first = 2_u64;
    set end = 3_u64;
  }
  let del = kind == 16_u64;
  let unlink = kind == 17_u64;
  let exists = kind == 18_u64;
  let mget = kind == 34_u64;
  let touch = kind == 160_u64;
  let removals = bor(del, unlink);
  let named_reads = bor(mget, touch);
  let probes = bor(exists, named_reads);
  let named = bor(removals, probes);
  let algebra_first = kind >= 99_u64;
  let algebra_last = kind <= 105_u64;
  let algebra = band(algebra_first, algebra_last);
  if bor(named, algebra) {
    set end = args^.inner.len;
  }
  let mset = kind == 15_u64;
  let msetnx = kind == 35_u64;
  if bor(mset, msetnx) {
    set end = args^.inner.len;
    set step = 2_u64;
  }
  let transfer_first = kind >= 37_u64;
  let transfer_last = kind <= 39_u64;
  let key_transfers = band(transfer_first, transfer_last);
  let lmove = kind == 74_u64;
  let rpoplpush = kind == 75_u64;
  let smove = kind == 98_u64;
  let legacy_moves = bor(rpoplpush, smove);
  let moves = bor(lmove, legacy_moves);
  let transfers = bor(key_transfers, moves);
  if transfers {
    set end = 3_u64;
  }
  if kind == 102_u64 {
    set first = 2_u64;
    set end = first;
    let span = arg(args: args, index: 1_u64);
    let count = read_integer(input: input, start: span.start, length: span.length);
    let numeric = count.state == 1_u64;
    let positive = count.value > 0_i64;
    if band(numeric, positive) {
      let amount = cvt.wrap::<i64, u64>(count.value);
      let available = args^.inner.len -sat 2_u64;
      if amount <= available {
        set end = amount +wrap 2_u64;
      }
    }
  }
  let capacity = end -sat first;
  let keys = key_set_new(capacity: capacity);
  let index = first;
  loop @keys {
    if index >= end {
      break @keys;
    }
    let bounds = key_bounds(input: input, args: args, index: index);
    let key = &input^[bounds.start..bounds.end];
    key_set_insert(keys: &keys, key: key);
    set index = index +wrap step;
  }
  return ScriptKeyPlan::Finite(keys: move keys);
}

fn script_key_rank(keys: &KeySet, key: &[u8]) -> rank: u64 reads(keys), reads(key) {
  return pkg::store::key_rank(keys: keys, key: key);
}

fn script_key_ranks(keys: &KeySet, declared: &KeySet) -> ranks: Box<Slots<u64>> reads(keys), reads(declared) {
  doc "Translate command-local insertion ranks to immutable declaration ranks, without changing either key set or operand order.";
  let ranks = box_slots_new::<u64>(capacity: keys^.len);
  for @keys (index in 0_u64..keys^.len) {
    if index < keys^.len {
      let key = scanned_key(keys: keys, index: index);
      let length = key.inner.len;
      let rank = script_key_rank(keys: declared, key: &key.inner[0_u64..length]);
      if ranks.inner.len < ranks.inner.cap {
        place_back(window: &ranks.inner, value: rank);
      }
    }
  }
  return move ranks;
}

fn script_entries_ready(kind: u64, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, input: &[u8], args: &Box<Slots<Span>>, time: &Time) -> ready: Bool reads(keys), reads(declared), reads(input), reads(args), reads(time), writes(undo) {
  doc "Check every operand before touching an entry, then save a declared WRITE operand once, or an expired read operand before lazy removal. Returning false is attempt control, never a Lua command error.";
  let plan = script_key_plan(kind: kind, input: input, args: args);
  match move plan {
    NoKeys() => {
      return True();
    }
    WholeMap() => {
      return False();
    }
    Finite(keys: planned) => {
      let ranks = script_key_ranks(keys: &planned, declared: declared);
      for @check (index in 0_u64..ranks.inner.len) {
        if index < ranks.inner.len {
          let rank = ranks.inner[index];
          if rank >= keys^.len {
            return False();
          }
        }
      }
      match undo^ {
        None() => {
        }
        Some(value: journal) => {
          let writing = command_writes(kind: kind);
          for @save (index in 0_u64..ranks.inner.len) {
            if index < ranks.inner.len {
              let rank = ranks.inner[index];
              if rank < keys^.len {
                let slot = &keys^[rank];
                let save = writing;
                match slot^ {
                  None() => {
                  }
                  Some(value: held_entry) => {
                    if pkg::store::expired(expires: held_entry^.expires, now: time^.check) {
                      set save = True();
                    }
                  }
                }
                if save {
                  pkg::store::attempt_save(undo: journal, index: rank, slot: slot);
                }
              }
            }
          }
        }
      }
    }
  }
  return True();
}

fn script_object(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  let kind = object_plan(input: input, args: args, client: client);
  if kind == 0_u64 {
    return 0_u64;
  }
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let bounds = key_bounds(input: input, args: args, index: 2_u64);
  let key = &input^[bounds.start..bounds.end];
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  set client^.now = time^.check;
  let lapsed = object_body(sequence: sequence, capture_key: key, slot: &keys^[rank], client: client, kind: kind);
  return mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key, budget: effect_budget);
}

fn script_get(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "GET inside a script over its held entries: the work and reply of run_get, an expired key removed at once, as Redis 7.0.15 removes one a script's lookup finds expired, its removal appended to the script's effects when the keyspace keeps a file.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  get_body(journal: journal, access_key: key, slot: slot, client: client);
  let appended = 0_u64;
  if client^.state == state_expired {
    pkg::store::sequence_delete_key(sequence: sequence, slot: slot, key: key);
    if logged {
      log_removal(log: effects, key: key, budget: effect_budget);
      set appended = 1_u64;
    }
  }
  get_finish(client: client);
  return appended;
}

fn script_incr(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, delta: i64) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "INCR (delta 1), DECR (delta -1), and INCRBY and DECRBY once their amount is read, inside a script over its held entries: the work, effects and reply of run_incr.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, delta: delta, now: time^.check, state: state_absent);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let removed = incr_body(sequence: sequence, journal: journal, access_key: key, client: client, slot: slot, counted: &counted);
  let appended = 0_u64;
  if logged {
    set appended = incr_log(log: effects, removed: removed, counted: &counted, input: input, args: args, key: key, budget: effect_budget);
  }
  incr_finish(client: client, counted: &counted);
  return appended;
}

fn script_set(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "SET inside a script over its held entries and expiry metadata: the options, work, effects and reply of run_set, its expiry options read against the script's frozen calendar time.";
  let setting = True();
  let options = string_options(input: input, args: args, first: 3_u64, setting: setting);
  if options.valid {
  } else {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return 0_u64;
  }
  let at = 0_u64;
  let timed_flag = iand(options.flags, options_expiry);
  if timed_flag != 0_u64 {
    let amount = arg(args: args, index: options.amount);
    let deadline = string_deadline(input: input, span: amount, flags: options.flags, unix_ms: time^.unix_ms);
    if deadline.state == 0_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return 0_u64;
    }
    if deadline.state == 2_u64 {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return 0_u64;
    }
    set at = deadline.at;
  }
  let value_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  set client^.now = time^.check;
  let plan = SetPlan(flags: options.flags, at: at, mode: mode_set, key_index: 1_u64, value_index: 2_u64);
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let work = set_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, value: move value, flags: options.flags, at: at);
  let appended = set_meta(due: due, log: effects, logged: logged, plan: &plan, work: &work, input: input, args: args, key: key, env: env, budget: effect_budget);
  set_finish(client: client, plan: &plan, work: &work);
  return appended;
}

fn script_incrby(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, negate: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "INCRBY and DECRBY (negate) inside a script over its held entries: the amount read as incrby_delta reads it, then the work, effects and reply of run_incr.";
  let delta = incrby_delta(input: input, args: args, negate: negate);
  let refused = delta_refused(client: client, delta: &delta);
  if refused {
    return 0_u64;
  }
  let appended = script_incr(sequence: sequence, effect_budget: effect_budget, journal: journal, keys: keys, declared: declared, undo: undo, fallback: fallback, operation_kind: operation_kind, effects: effects, logged: logged, input: input, args: args, client: client, time: time, delta: delta.value);
  return appended;
}

fn script_expire(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, due: &pkg::store::ExpiryQueue, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, scale: u64, absolute: Bool, invalid: &[u8]) -> appended: u64 reads(declared), reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(due), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "EXPIRE, PEXPIRE, EXPIREAT and PEXPIREAT inside a script over its held entries and expiry metadata: the plan, work, effects and reply of run_expire, its deadline read against the script's frozen calendar time.";
  let not_loading = False();
  let plan = expire_plan(input: input, args: args, unix_ms: time^.unix_ms, loading: not_loading, scale: scale, absolute: absolute);
  let refused = expire_refused(client: client, input: input, args: args, plan: &plan, invalid: invalid);
  if refused {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let outcome = expire_body(sequence: sequence, journal: journal, access_key: key, slot: slot, client: client, plan: &plan);
  let lapsed = client^.state == state_expired;
  let appended = expire_meta(due: due, log: effects, logged: logged, plan: &plan, outcome: outcome, lapsed: lapsed, input: input, args: args, key: key, env: env, budget: effect_budget);
  expire_finish(client: client, outcome: outcome);
  return appended;
}

fn script_ttl(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, in_seconds: Bool, absolute: Bool) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "TTL, PTTL, EXPIRETIME and PEXPIRETIME inside a script over its held entries: the work, effects and reply of run_ttl, the time left counted from the script's start.";
  let remaining = Remaining(at: 0_u64, now: time^.check, state: 3_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  let removed = ttl_body(sequence: sequence, capture_key: key, slot: slot, remaining: &remaining);
  let appended = ttl_meta(log: effects, logged: logged, removed: removed, key: key, budget: effect_budget);
  ttl_finish(client: client, remaining: &remaining, now: time^.check, in_seconds: in_seconds, absolute: absolute);
  return appended;
}

fn script_mset(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, journal: &Option<pkg::store::AccessJournal>, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(journal), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "MSET inside a script over its held entries: the work, effects and reply of run_mset, its pairs stored in order so that a key named twice keeps its last value. An even count of arguments is answered with MSET's own arity error, as Redis's msetGenericCommand answers it inside a script.";
  let count = args^.inner.len;
  let rejected = mset_pairs_refused(input: input, args: args, client: client);
  if rejected {
    return 0_u64;
  }
  let pairs = count / 2_u64;
  let appended = 0_u64;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let value_index = index +wrap 1_u64;
    let rank = script_key_rank(keys: declared, key: key);
    if rank >= keys^.len {
      set fallback^ = True();
      return 0_u64;
    }
    let slot = &keys^[rank];
    let lapsed = mset_body(sequence: sequence, journal: journal, client: client, slot: slot, input: input, args: args, value_index: value_index, now: time^.check);
    let removal = mset_lapse_meta(log: effects, logged: logged, lapsed: lapsed, key: key, budget: effect_budget);
    set appended = appended +wrap removal;
  }
  let recorded = mset_meta(log: effects, logged: logged, input: input, args: args, budget: effect_budget);
  set appended = appended +wrap recorded;
  reply_ok(client: client);
  return appended;
}

