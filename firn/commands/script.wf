  let lapsed = sadd_body(journal: journal, access_key: key, slot: slot, client: client);
  let appended = set_members_meta(log: effects, logged: logged, lapsed: lapsed, client: client, input: input, args: args, key: key);
  sadd_finish(client: client);
  return appended;
}

