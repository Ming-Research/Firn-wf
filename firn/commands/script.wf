  } else {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  set client^.number = 0_u64;
  let slot = &keys^[key];
  let removed = hset_body(slot: slot, client: client);
  let changed = client^.state == state_done;
  let appended = changed_meta(log: effects, logged: logged, removed: removed, changed: changed, input: input, args: args, key: key);
  hset_finish(client: client, counted: counted);
  return appended;
}

fn script_hsetnx(keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(keys), writes(effects), writes(client) {
  doc "HSETNX through the network command parts while EXEC or a script holds every key.";
  prepare_keys(input: input, args: args, client: client, first: 2_u64);
