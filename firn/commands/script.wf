    return 0_u64;
  }
  let plan = script_key_plan(kind: kind, input: input, args: args);
  let command_keys = key_set_new(capacity: 0_u64);
  match move plan {
    NoKeys() => {
    }
    Finite(keys: planned) => {
      set command_keys = move planned;
    }
    WholeMap() => {
      return 0_u64;
    }
  }
  let slots = &keys^[command_keys];
  let undo = None<pkg::store::AttemptUndo>();
  let fallback = False();
  return pkg::store::command_held_entries_run_due::<Box<Slots<Span>>, Client, fn held_entries_run>(meta: meta, sequence: sequence, effect_budget: effect_budget, journal: journal, kind: kind, keys: slots, declared: &command_keys, undo: &undo, fallback: &fallback, effects: effects, logged: logged, input: input, args: args, client: client, env: env, time: time);
}

