fn script_smove(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "SMOVE under a held statement, using the same key set, entries body, metadata and reply as the network.";
  let ks = key_set_new(capacity: 2_u64);
  let pair = smove_parse(input: input, args: args, client: client, keys: &ks, now: time^.check);
  let slots = &keys^[ks];
  let work = smove_body(journal: journal, access_keys: &ks, slots: slots, source: pair.source, destination: pair.target, client: client);
  let appended = smove_meta(log: effects, logged: logged, work: &work, input: input, args: args);
  smove_finish(client: client);
  return appended;
}

fn script_set_combine(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, operation: u64, storing: Bool) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "SINTER, SUNION, SDIFF and their STORE forms under a held statement, through the shared ordered operand lookup, removal records and reply, including wrong-type refusals.";
  let ks = set_combine_parse(input: input, args: args, client: client, storing: storing, now: time^.check);
  let members = hash_map_new::<Key, unit, ceiling>(capacity: 0_u64);
  let slots = &keys^[ks];
  let work = set_combine_body(journal: journal, slots: slots, keys: &ks, client: client, env: env, operation: operation, storing: storing, members: &members);
  let appended = set_operands_meta(log: effects, logged: logged, removed: &work.removed, changed: work.changed, input: input, args: args);
  set_combine_finish(client: client, storing: storing, members: &members);
  return appended;
}

fn script_sintercard(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> appended: u64 reads(input), reads(args), reads(env), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "SINTERCARD under a held statement, through the network parts, removing and recording each expired operand once.";
  let plan = sintercard_parse(input: input, args: args, client: client);
  if bnot(plan.valid) {
    return 0_u64;
  }
  let ks = sintercard_keys(input: input, args: args, client: client, end: plan.end, now: time^.check);
  let slots = &keys^[ks];
  let removed = sintercard_body(journal: journal, slots: slots, keys: &ks, client: client, env: env, limit: plan.limit);
  let changed = False();
  let appended = set_operands_meta(log: effects, logged: logged, removed: &removed, changed: changed, input: input, args: args);
  sintercard_finish(client: client);
  return appended;
}

fn script_zadd(journal: &Option<pkg::store::AccessJournal>, keys: &ConcurrentHashMap<Entry>, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time, increment: Bool) -> appended: u64 reads(input), reads(args), reads(time), writes(journal), writes(keys), writes(effects), writes(client) {
  doc "Runs the same ZADD parts while EXEC or a script holds every key.";
  let plan = zadd_plan();
  let valid = zadd_parse(input: input, args: args, client: client, increment: increment, plan: &plan);
  if bnot(valid) {
    return 0_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let slot = &keys^[key];
  let lapsed = zadd_body(journal: journal, access_key: key, slot: slot, client: client, plan: &plan);
  let appended = zadd_meta(log: effects, logged: logged, lapsed: lapsed, plan: &plan, input: input, args: args, key: key);
  zadd_finish(client: client, plan: &plan);
  return appended;
}

