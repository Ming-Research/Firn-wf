}

fn script_type(sequence: &pkg::store::WriteSequence, effect_budget: &pkg::store::LogBudget, keys: &Entries<Entry>, declared: &KeySet, undo: &Option<pkg::store::AttemptUndo>, fallback: &Bool, operation_kind: u64, effects: &Box<Slots<u8>>, logged: Bool, input: &[u8], args: &Box<Slots<Span>>, client: &Client, time: &Time) -> appended: u64 reads(declared), reads(input), reads(args), reads(time), writes(sequence), writes(effect_budget), writes(keys), writes(undo), writes(fallback), writes(effects), writes(client) contract {
  requires keys^.len == declared^.len;
  ensures keys^.len == entry(keys)^.len;
} {
  doc "run_type through its shared parts over the entries held by EXEC or a script; returns its propagated record count.";
  let records = 0_u64;
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let kind = 0_u64;
  let footprint_ready = script_entries_ready(kind: operation_kind, keys: keys, declared: declared, undo: undo, input: input, args: args, time: time);
  if bnot(footprint_ready) {
    set fallback^ = True();
    return 0_u64;
  }
  let rank = script_key_rank(keys: declared, key: key);
  if rank >= keys^.len {
    set fallback^ = True();
    return 0_u64;
  }
  let slot = &keys^[rank];
  set kind = entry_kind(sequence: sequence, capture_key: key, slot: slot, client: client);
  let removed = client^.state == state_expired;
  let recorded_part = mset_lapse_meta(log: effects, logged: logged, lapsed: removed, key: key, budget: effect_budget);
  set records = records +wrap recorded_part;
  type_finish(client: client, kind: kind);
  return records;
}

