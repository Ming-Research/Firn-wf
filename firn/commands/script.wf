fn held_kind(input: &[u8], name: Span) -> kind: u64 reads(input) {
  doc "The command identity when it has parts usable under EXEC or a script's atomic statement; zero otherwise.";
  let kind = command_kind(input: input, name: name);
  if kind <= 171_u64 {
    return kind;
  }
  if kind == 190_u64 {
    return kind;
  }
  if kind == 191_u64 {
    return kind;
  }
  return 0_u64;
}

fn held_arity(kind: u64) -> arity: i64 pure {
  doc "The arity Redis 7.0.15's command table gives a command held_kind names, positive for exactly that many arguments with its name and negative for at least its magnitude.";
  if kind == 171_u64 {
    return arity_object;
  }
  if kind == 1_u64 {
    return arity_get;
  }
  if kind == 2_u64 {
    return arity_set;
  }
  let counter = kind <= 4_u64;
  if counter {
    return arity_incr;
  }
  let amount = kind <= 6_u64;
  if amount {
    return arity_incrby;
  }
  let setter = kind <= 10_u64;
  if setter {
    return arity_expire;
  }
  let reader = kind <= 14_u64;
  if reader {
    return arity_ttl;
  }
  if kind == 15_u64 {
    return arity_mset;
  }
  if kind == 16_u64 {
    return arity_del;
  }
  if kind == 17_u64 {
    return arity_unlink;
  }
  if kind == 18_u64 {
    return arity_exists;
  }
  if kind == 19_u64 {
    return arity_type;
  }
