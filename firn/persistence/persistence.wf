alias Clock = std::time::Clock;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Span = pkg::protocol::Span;
alias Keyspace = pkg::store::Keyspace;
alias Time = pkg::store::Time;
alias WriteFile = std::fs::WriteFile;
alias append_once = std::fs::append_once;
alias client_new = pkg::protocol::client_new;
alias close_read = std::fs::close_read;
alias close_write = std::fs::close_write;
alias execute = pkg::commands::execute;
alias input_grow = pkg::protocol::input_grow;
alias input_new = pkg::protocol::input_new;
alias arg = pkg::protocol::arg;
alias name_is = pkg::bytes::name_is;
alias instant_after = std::time::instant_after;
alias keep_rest = pkg::protocol::keep_rest;
alias nanoseconds_from = std::time::nanoseconds_from;
alias open_file = std::fs::open_file;
alias parse_request = pkg::protocol::parse_request;
alias read_at = std::fs::read_at;
alias sleep_until = std::time::sleep_until;
alias sync_file = std::fs::sync_file;

fn append_all(factory: &HandleFactory, file: &WriteFile, source: &Box<Slots<u8>>) -> result: u64 reads(source), writes(factory), writes(file) waits {
  doc "Appends every byte the buffer holds to the file, reattempting until the host has taken them all; returns the number of bytes accepted, including a partial append before a refusal.";
  let length = source^.inner.len;
  let bytes = &source^.inner[0_u64..length];
  let written = 0_u64;
  loop @appending {
    if written >= length {
      break @appending;
    }
    match append_once(factory: factory, file: file, source: bytes, start: written, end: length) {
      Ok(value: next) => {
        if next == written {
          return written;
        }
        set written = next;
      }
      Err(error: problem) => {
        return written;
      }
    }
  }
  return written;
}

fn write_log(store: Keyspace, factory: HandleFactory, log: AofLog, clock: Clock, time: Time) -> result: unit pure waits {
  doc "Drain acknowledged commands, start manual or automatic rewrites at a metadata cut, and join every rebuild before closing the directories. Preserve a partial append for the next drain. Main sets stopping only after clients have left.";
  let pending = box_slots_new::<u8>(capacity: 65536_u64);
  let last_sync = std::time::now(clock: &clock);
  let never = std::time::cancel_never();
  loop @writing {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 10000000_u64);
    match sleep_until(deadline: wake, cancel: &never) {
      Ok(..) => {
      }
      Err(..) => {
      }
    }
    let stop = False();
    atomic m = &store.meta {
      set stop = m^.stopping;
    }
    let drained = aof_rw_flush(store: &store, factory: &factory, file: &log.file, pending: &pending, clock: &clock, last_sync: &last_sync, force: stop);
    if stop {
      if drained {
        let empty = False();
        atomic m = &store.meta {
          set empty = m^.log.inner.len == 0_u64;
        }
        if empty {
          break @writing;
        }
      }
    } else {
      let cancelled = aof_rw_cancelled(store: &store);
      if cancelled {
        atomic m = &store.meta {
          if m^.aof_rewrite_requested {
            set m^.aof_rewrite_requested = False();
            set m^.aof_rewrite_in_progress = False();
            set m^.aof_rewrite_reply = 2_u64;
          }
        }
      } else {
        let rewrite = False();
        let manual = False();
        atomic m = &store.meta {
          set manual = m^.aof_rewrite_requested;
          set m^.aof_rewrite_requested = False();
          set rewrite = manual;
          if m^.aof_rewrite_in_progress {
          } else if m^.aof_rewrite_reply == 0_u64 {
            set rewrite = aof_rw_growth(current_size: m^.aof_current_size, base_size: m^.aof_base_size, percentage: m^.aof_rewrite_percentage, minimum: m^.aof_rewrite_min_size);
          }
          if rewrite {
            set m^.aof_rewrite_in_progress = True();
          }
        }
        if rewrite {
          let aof_cycled = aof_rw_cycle(store: &store, factory: &factory, log: move log, pending: &pending, clock: &clock, last_sync: &last_sync, time: &time, manual: manual);
          set log = move aof_cycled;
        }
      }
    }
  }
  std::time::close_cancel_watch(watch: move never);
  let AofLog(directory: directory, writable: writable, prefix: prefix, manifest: manifest, file: file) = move log;
  close_write(factory: &factory, file: move file);
  std::fs::close_directory(factory: &factory, directory: move directory);
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  return unit;
}

const word_multi: Array<u8, 5> = "MULTI";

const word_exec: Array<u8, 4> = "EXEC";

fn replay(store: &Keyspace, factory: &HandleFactory, root: &DirectoryRead, name: &[u8], name_length: u64, time: &Time, clock: &Clock) -> loaded: Loaded reads(store), reads(root), reads(name), reads(time), writes(factory), writes(clock) waits contract {
  requires name_length <= name^.len;
} {
  doc "Applies every command of the append-only file the name names, refusing an absent file, and returns how many it applied and how much of the file to keep. The commands between MULTI and EXEC apply only once their EXEC is read, so a block the file ends inside, as a write cut short leaves one, applies none of its commands, as Redis 7.0.15 reverts an incomplete MULTI/EXEC block while loading; an EXEC outside a block is passed over. A file whose reading reaches its end inside a command is to be cut after the last whole command, and one that ends cleanly inside a block before its latest MULTI, as Redis cuts each with aof-load-truncated, its default, so the commands appended after the replay follow whole commands; a file that ends after a whole command outside a block is kept whole. As Redis does while loading, no key counts as expired during the replay, time's check being zero, and an expiry whose calendar time has passed is kept as one already reached, so the commands after it in the file apply as they did when they were written; lazy and active expiry remove such a key once the server listens. A record that is not a well-formed command, a read that fails other than at the file's end, or a block or command larger than the input window's ceiling stops the replay with stopped true, as Redis 7.0.15 stops loading and exits.";
  let applied = 0_u64;
  let kept = 0_u64;
  let size = 0_u64;
  let cut = False();
  let stopped = False();
  let reverted = 0_u64;
  let unfinished = False();
  match open_file(factory: factory, root: root, name: name, start: 0_u64, end: name_length) {
    Ok(value: file) => {
      let env = KeyEnv();
      let client = client_new(capacity: 16384_u64);
      atomic m = &store^.meta {
        set client.random = m^.random;
      }
      let args = box_slots_new::<Span>(capacity: 16_u64);
      let input = input_new(capacity: 65536_u64);
      let held = 0_u64;
      let offset = 0_u64;
      let resume = 0_u64;
      let scanning = False();
      let block_start = 0_u64;
      let block_body = 0_u64;
      let latest_multi = 0_u64;
      let first_multi = 0_u64;
      loop @chunks {
        if held >= input.inner.len {
          input_grow(input: &input);
          if held >= input.inner.len {
            set stopped = True();
            break @chunks;
          }
        }
        let ended = False();
        let failed = False();
        let length = input.inner.len;
        let window = &input.inner[0_u64..length];
        match read_at(factory: factory, file: &file, destination: window, file_offset: offset, start: held, end: length) {
          Ok(value: next) => {
            let got = next -wrap held;
            set offset = offset +wrap got;
            set size = offset;
            set held = next;
            if got == 0_u64 {
              set ended = True();
            }
          }
          Err(error: stop) => {
            set ended = True();
            match stop {
              ReadEnd() => {
              }
              ReadFailed(error: problem) => {
                set failed = True();
              }
            }
          }
        }
        if ended {
          let base = offset -wrap held;
          if failed {
            set stopped = True();
          } else if held > resume {
            set kept = base +wrap resume;
            set cut = True();
          } else if scanning {
            set kept = latest_multi;
            set cut = True();
          }
          set unfinished = scanning;
          if scanning {
            set reverted = first_multi;
          }
          break @chunks;
        }
        let consumed = resume;
        let window_base = offset -wrap held;
        let broken = False();
        let executing = False();
        loop @commands {
          let current = input.inner.len;
          let bytes = &input.inner[0_u64..current];
          let unlocked = False();
          let parsed = parse_request(input: bytes, start: consumed, held: held, args: &args, locked: unlocked);
          if parsed.state == 0_u64 {
            break @commands;
          }
          let next = parsed.next;
          if parsed.state == 1_u64 {
            let command = arg(args: &args, index: 0_u64);
            let only = args.inner.len == 1_u64;
            let multi_word = name_is(input: bytes, start: command.start, length: command.length, word: &word_multi[0_u64..5_u64]);
            let exec_word = name_is(input: bytes, start: command.start, length: command.length, word: &word_exec[0_u64..4_u64]);
            let multi = band(only, multi_word);
            let exec = band(only, exec_word);
            if scanning {
              if exec {
                set scanning = False();
                set executing = True();
                set next = block_body;
              } else if multi {
                set latest_multi = window_base +wrap consumed;
              }
            } else if executing {
              if exec {
                set executing = False();
              } else {
                execute(store: store, input: bytes, args: &args, client: &client, env: &env, time: time, clock: clock);
                set client.at = 0_u64;
                set applied = applied +wrap 1_u64;
              }
            } else if multi {
              set scanning = True();
              set latest_multi = window_base +wrap consumed;
              set first_multi = latest_multi;
              set block_start = consumed;
              set block_body = parsed.next;
            } else if exec {
            } else {
              execute(store: store, input: bytes, args: &args, client: &client, env: &env, time: time, clock: clock);
              set client.at = 0_u64;
              set applied = applied +wrap 1_u64;
            }
          } else if parsed.state != 6_u64 {
            set broken = True();
            break @commands;
          }
          set consumed = next;
        }
        if broken {
          set stopped = True();
          break @chunks;
        }
        let kept_from = consumed;
        if scanning {
          set kept_from = block_start;
        }
        set resume = consumed -sat kept_from;
        set block_body = block_body -sat kept_from;
        set block_start = 0_u64;
        set held = keep_rest(input: &input, from: kept_from, held: held);
      }
      let closed = close_read(factory: factory, file: move file);
    }
    Err(error: problem) => {
      set stopped = True();
    }
  }
  return Loaded(applied: applied, kept: kept, size: size, cut: cut, stopped: stopped, reverted: reverted, unfinished: unfinished);
}
