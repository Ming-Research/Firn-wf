alias Clock = std::time::Clock;
alias HandleFactory = std::io::HandleFactory;
alias Keyspace = pkg::store::Keyspace;
alias Time = pkg::store::Time;
alias WriteFile = std::fs::WriteFile;
alias append_once = std::fs::append_once;
alias close_write = std::fs::close_write;
alias instant_after = std::time::instant_after;
alias sleep_until = std::time::sleep_until;

struct AofAppend {
  doc "A complete append or its accepted prefix and terminal host error. A zero-progress success becomes Whitefoot's semantic WriteZero, with no host code.";
  written: u64;
  error: Option<std::io::IoError>;
}

fn append_all(factory: &HandleFactory, file: &WriteFile, source: &Box<Slots<u8>>) -> result: AofAppend reads(source), writes(factory), writes(file) waits {
  doc "Retries positive short writes as Redis 7.0.15 aof.c:1024-1040 does; retains the terminal IoError alongside cumulative progress for rollback and admission status.";
  let length = source^.inner.len;
  let bytes = &source^.inner[0_u64..length];
  let written = 0_u64;
  loop @appending {
    if written >= length {
      break @appending;
    }
    match append_once(factory: factory, file: file, source: bytes, start: written, end: length) {
      Ok(value: next) => {
        if next == written {
          let problem = std::io::IoError::WriteZero(code: 0_u32, origin: 0_u8);
          let error = Some<std::io::IoError>(value: problem);
          return AofAppend(written: written, error: error);
        }
        set written = next;
      }
      Err(error: problem) => {
        let error = Some<std::io::IoError>(value: problem);
        return AofAppend(written: written, error: error);
      }
    }
  }
  let error = None<std::io::IoError>();
  return AofAppend(written: written, error: error);
}

fn write_log(store: Keyspace, factory: HandleFactory, log: AofLog, clock: Clock, time: Time, meter: std::process::MemoryMeter) -> result: unit pure waits {
  doc "Drain acknowledged commands, start manual or automatic rewrites at a metadata cut, and join every rebuild before closing the directories. Retain failed appends for periodic recovery. After a saved sync error, each later successful sync with nothing retained starts a recovery rewrite, whatever the automatic-rewrite block, and only its durable installation clears the error; a recovery attempt that fails blocks automatic rewrites as any failed attempt does, and one that succeeds leaves the block as it found it, which only a manual success lifts. Main sets stopping only after clients have left; then take all collecting bytes for one final append and sync attempt, abandoning failures as Redis 7.0.15 everysec does (server.c:4239-4247,4301-4308).";
  let pending = box_slots_new::<u8>(capacity: 0_u64);
  atomic pending_meta = &store.meta {
    set pending = box_slots_new::<u8>(capacity: 65536_u64);
    set pending_meta^.aof_pending_capacity = pending.inner.cap;
  }
  let last_sync = std::time::now(clock: &clock);
  let last_append = last_sync;
  let healed = False();
  let never = std::time::cancel_never();
  loop @writing {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 10000000_u64);
    match sleep_until(deadline: wake, cancel: &never) {
      Ok(..) => {
      }
      Err(..) => {
      }
    }
    let stop = False();
    atomic m = &store.meta {
      set stop = m^.stopping;
    }
    aof_rw_flush(store: &store, factory: &factory, log: &log, pending: &pending, clock: &clock, last_sync: &last_sync, last_append: &last_append, force: stop, healed: &healed);
    if stop {
      break @writing;
    } else {
      let cancelled = aof_rw_cancelled(store: &store);
      if cancelled {
        atomic m = &store.meta {
          if m^.aof_rewrite_requested {
            set m^.aof_rewrite_requested = False();
            set m^.aof_rewrite_in_progress = False();
            set m^.aof_rewrite_reply = 2_u64;
          }
        }
      } else {
        let rewrite = False();
        let manual = False();
        let recovery = False();
        let blocked = False();
        atomic m = &store.meta {
          set manual = m^.aof_rewrite_requested;
          set m^.aof_rewrite_requested = False();
          set rewrite = manual;
          set blocked = m^.aof_rewrite_retry_blocked;
          let saved = False();
          match m^.aof_sync_error {
            Some(..) => {
              set saved = True();
            }
            None() => {
            }
          }
          let recovering = band(healed, saved);
          if m^.aof_rewrite_in_progress {
          } else if recovering {
            set rewrite = True();
            set recovery = True();
          } else if m^.aof_rewrite_retry_blocked {
          } else if m^.aof_rewrite_reply == 0_u64 {
            set rewrite = aof_rw_growth(current_size: m^.aof_current_size, base_size: m^.aof_base_size, percentage: m^.aof_rewrite_percentage, minimum: m^.aof_rewrite_min_size);
          }
          if rewrite {
            set m^.aof_rewrite_in_progress = True();
          }
        }
        if rewrite {
          set healed = False();
          let aof_cycled = aof_rw_cycle(store: &store, factory: &factory, log: move log, pending: &pending, clock: &clock, last_sync: &last_sync, last_append: &last_append, manual: manual, meter: &meter);
          set log = move aof_cycled;
          if recovery {
            atomic m = &store.meta {
              if m^.aof_rewrite_ok {
                set m^.aof_rewrite_retry_blocked = blocked;
              }
            }
          }
        }
      }
    }
  }
  std::time::close_cancel_watch(watch: move never);
  let AofLog(directory: directory, writable: writable, prefix: prefix, manifest: manifest, file: file, boundary: boundary) = move log;
  close_write(factory: &factory, file: move file);
  std::fs::close_directory(factory: &factory, directory: move directory);
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  return unit;
}

const word_multi: Array<u8, 5> = "MULTI";

const word_exec: Array<u8, 4> = "EXEC";
