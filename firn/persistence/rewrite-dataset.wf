alias Clock = std::time::Clock;
alias Entry = pkg::store::Entry;
alias Keyspace = pkg::store::Keyspace;
alias HandleFactory = std::io::HandleFactory;
alias WriteFile = std::fs::WriteFile;

const aof_rw_select: Array<u8, 23> = "*2\r\n$6\r\nSELECT\r\n$1\r\n0\r\n";

const aof_rw_scan_most: u64 = 64_u64;

const aof_rw_slice: u64 = 1000000_u64;

const aof_rw_step_buffer: u64 = 65560_u64;

const aof_rw_delay_slice: u64 = 100000000_u64;

fn aof_rw_dataset(store: &Keyspace, factory: &HandleFactory, file: &WriteFile, clock: &Clock, meter: &std::process::MemoryMeter) -> result: Result<u64, unit> reads(store), writes(factory), writes(file), writes(clock), writes(meter) waits {
  doc "One whole-map-and-Meta statement per step observes membership, complete owned payload, absolute expiry and last_write. Each step scans with map_scan_within, its limit the reserve left after the step's 64-KiB output buffer, and charges the KeySet's bytes as key_set_bytes reports them, the growth across the call in either result, so no scan allocation precedes its charge or exceeds R. Key copies, images and buffer growth are charged before allocation without aborting. A step that does not fit is discarded unwritten with its cursor kept: a step of several positions is retried at count hint 1 at once; a one-position step, or a first position map_scan_within refuses, waits outside every hold and retries while its need so far fits R less admission's fixed charge (the KeySet need also less a fresh KeySet's bytes and the step buffer, which a retry holds again), and otherwise aborts with reserve. The count hint, about that many keys per step with whole positions kept together as the pinned runtime applies it, starts at 64, halves after a step emitting more than 64 KiB and doubles back after one emitting at most 32 KiB. Steps run back to back until about 1 ms has passed since the last wait, then pause outside every hold, so the scan yields its driver once per slice. A nonzero rdb-key-save-delay, read at each step, scans one position per step; a positive one sleeps its microseconds per key in cancellable slices of at most 100 ms, a negative -n one microsecond per n keys, each rounded up to whole milliseconds by the driver's timer.";
  let cursor = 0_u64;
  let size = 0_u64;
  let selected = False();
  let count = aof_rw_scan_most;
  let skipped = 0_u64;
  let slice = std::time::now(clock: clock);
  loop @scanning {
    let output = None<Box<Slots<u8>>>();
    let step_charge = 0_u64;
    let okay = False();
    let waiting = False();
    let discarded = False();
    let narrowed = False();
    let shortfall = 0_u64;
    let progressed = False();
    let selecting = False();
    let next_cursor = cursor;
    let scanned = 0_u64;
    let emitted = 0_u64;
    let delay = 0_i64;
    let cancelled = aof_rw_cancelled(store: store);
    if cancelled {
      return Err<u64, unit>(error: unit);
    }
    atomic table = &store^.keys, m = &store^.meta {
      set delay = m^.aof_rewrite_key_delay;
      if m^.rewrite.active {
        let hint = count;
        if delay != 0_i64 {
          set hint = 1_u64;
        }
        let splittable = hint > 1_u64;
        let heap_before = std::process::heap_in_use(meter: meter);
        let keys = key_set_new(capacity: 0_u64);
        let created = key_set_bytes(keys: &keys);
        let fresh = pkg::store::rewrite_charge(capture: &m^.rewrite, bytes: created);
        if fresh {
          set step_charge = created;
          let room = m^.rewrite.limit -sat m^.rewrite.used;
          let limit = room -sat aof_rw_step_buffer;
          let before = key_set_bytes(keys: &keys);
          let step = map_scan_within::<Entry>(map: table, cursor: cursor, count: hint, limit: limit, keys: &keys);
          let after = key_set_bytes(keys: &keys);
          let heap_after = std::process::heap_in_use(meter: meter);
          set m^.rewrite.scan_steps = m^.rewrite.scan_steps +sat 1_u64;
          let observed_heap = heap_after -sat heap_before;
          set m^.rewrite.scan_peak = imax(m^.rewrite.scan_peak, observed_heap);
          let retained = after - before;
          let charged = pkg::store::rewrite_charge(capture: &m^.rewrite, bytes: retained);
          if charged {
            set step_charge = step_charge +sat retained;
          }
          match step {
            Needs(bytes: needed) => {
              if charged {
                let held_value = m^.rewrite.fixed +sat created;
                let floor = held_value +sat aof_rw_step_buffer;
                let most = m^.rewrite.limit -sat floor;
                if needed <= most {
                  set waiting = True();
                  set okay = True();
                } else {
                  let reason_reserve_1 = pkg::store::RewriteAbortReason::Reserve();
                  pkg::store::rewrite_abort(capture: &m^.rewrite, reason: reason_reserve_1);
                }
              }
            }
            Next(next: reached) => {
              if charged {
                if keys.len == 0_u64 {
                  set okay = True();
                  set progressed = True();
                  set next_cursor = reached;
                } else {
                  let scratch = pkg::store::rewrite_charge(capture: &m^.rewrite, bytes: aof_rw_step_buffer);
                  if scratch {
                    set step_charge = step_charge +sat aof_rw_step_buffer;
                    let buffer = box_slots_new::<u8>(capacity: 65536_u64);
                    let probe = array_filled::<u8, 0>(value: 0_u8);
                    if selected {
                    } else {
                      pkg::store::log_append_plain(log: &buffer, bytes: &aof_rw_select[0_u64..23_u64]);
                      set selecting = True();
                    }
                    for (index in 0_u64..keys.len) {
                      if discarded {
                      } else if m^.rewrite.active {
                        let length = key_set_read_key(keys: &keys, index: index, out: &probe[0_u64..0_u64]);
                        let key_allocation = length +sat 16_u64;
                        let key_room = pkg::store::rewrite_try_charge(capture: &m^.rewrite, bytes: key_allocation);
                        if key_room {
                          set step_charge = step_charge +sat key_allocation;
                          let copied = box_array_filled::<u8>(count: length, value: 0_u8);
                          let copied_length = copied.inner.len;
                          let key = &copied.inner[0_u64..copied_length];
                          key_set_read_key(keys: &keys, index: index, out: key);
                          let slot = &table^[key];
                          let stamp = 0_u64;
                          match slot^ {
                            Some(value: held_value) => {
                              set stamp = held_value^.last_write;
                            }
                            None() => {
                            }
                          }
                          let measure = pkg::store::rewrite_measure(slot: slot, key_length: length);
                          let future = stamp > m^.commit_seq;
                          if future {
                            let reason_sequence_invalid_2 = pkg::store::RewriteAbortReason::SequenceInvalid();
                            pkg::store::rewrite_abort(capture: &m^.rewrite, reason: reason_sequence_invalid_2);
                          } else {
                            let with_key = measure.bytes +sat length;
                            let bytes = with_key +sat 256_u64;
                            let room_for_image = pkg::store::rewrite_try_charge(capture: &m^.rewrite, bytes: bytes);
                            if room_for_image {
                              set step_charge = step_charge +sat bytes;
                              let no = False();
                              let image = pkg::store::rewrite_image(slot: slot, key: key, capacity: measure.bytes, replacement: no);
                              let written = image.inner.len;
                              let wanted = buffer.inner.len +sat written;
                              let fits = True();
                              if wanted > buffer.inner.cap {
                                let doubled = buffer.inner.cap *sat 2_u64;
                                let target = imax(doubled, wanted);
                                let growth = target +sat 24_u64;
                                set fits = pkg::store::rewrite_try_charge(capture: &m^.rewrite, bytes: growth);
                                if fits {
                                  set step_charge = step_charge +sat growth;
                                } else {
                                  set discarded = True();
                                  set shortfall = step_charge +sat growth;
                                }
                              }
                              if fits {
                                pkg::store::log_append_plain(log: &buffer, bytes: &image.inner[0_u64..written]);
                              }
                            } else {
                              set discarded = True();
                              set shortfall = step_charge +sat bytes;
                            }
                          }
                        } else {
                          set discarded = True();
                          set shortfall = step_charge +sat key_allocation;
                        }
                      }
                    }
                    if discarded {
                      aof_rw_release::<Box<Slots<u8>>>(value: move buffer);
                      if splittable {
                        set narrowed = True();
                      } else {
                        let most = m^.rewrite.limit -sat m^.rewrite.fixed;
                        if shortfall > most {
                          let reason_reserve_5 = pkg::store::RewriteAbortReason::Reserve();
                          pkg::store::rewrite_abort(capture: &m^.rewrite, reason: reason_reserve_5);
                        } else {
                          set waiting = True();
                        }
                      }
                      set okay = m^.rewrite.active;
                    } else {
                      set okay = m^.rewrite.active;
                      set progressed = okay;
                      set next_cursor = reached;
                      set scanned = keys.len;
                      set output = Some<Box<Slots<u8>>>(value: move buffer);
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    match move output {
      Some(value: bytes) => {
        if okay {
          let appended = append_all(factory: factory, file: file, source: &bytes);
          if appended.written == bytes.inner.len {
            set size = size +sat appended.written;
            set emitted = appended.written;
            if selecting {
              set selected = True();
            }
          } else {
            let reason_base_io_3 = pkg::store::RewriteAbortReason::BaseIo();
            aof_rw_abort(store: store, reason: reason_base_io_3);
            set okay = False();
          }
        }
      }
      None() => {
      }
    }
    atomic released = &store^.meta {
      if okay {
      } else {
        let reason_cancelled_4 = pkg::store::RewriteAbortReason::Cancelled();
        pkg::store::rewrite_abort(capture: &released^.rewrite, reason: reason_cancelled_4);
      }
      set released^.rewrite.used = released^.rewrite.used -sat step_charge;
    }
    if okay {
    } else {
      return Err<u64, unit>(error: unit);
    }
    if narrowed {
      set count = 1_u64;
    } else if emitted > 65536_u64 {
      let halved = count / 2_u64;
      set count = imax(halved, 1_u64);
    } else if progressed {
      if emitted <= 32768_u64 {
        let doubled = count *sat 2_u64;
        set count = imin(doubled, aof_rw_scan_most);
      }
    }
    let paused = False();
    if waiting {
      aof_rw_pause(clock: clock);
      set paused = True();
    } else if delay > 0_i64 {
      if scanned > 0_u64 {
        aof_rw_key_delay(store: store, clock: clock, delay: delay, keys: scanned);
        set paused = True();
      }
    } else if delay < 0_i64 {
      let negated = 0_i64 -wrap delay;
      let every = cvt.wrap::<i64, u64>(negated);
      set skipped = skipped +sat scanned;
      if every == 0_u64 {
      } else if skipped >= every {
        set skipped = skipped % every;
        aof_rw_sleep(clock: clock, nanoseconds: 1000_u64);
        set paused = True();
      }
    }
    if paused {
      set slice = std::time::now(clock: clock);
    } else {
      let now = std::time::now(clock: clock);
      let worked = std::time::nanoseconds_from(earlier: slice, later: now);
      if worked >= aof_rw_slice {
        aof_rw_pause(clock: clock);
        set slice = std::time::now(clock: clock);
      }
    }
    if progressed {
      set cursor = next_cursor;
      if cursor == 0_u64 {
        break @scanning;
      }
    }
  }
  return Ok<u64, unit>(value: size);
}

fn aof_rw_key_delay(store: &Keyspace, clock: &Clock, delay: i64, keys: u64) -> result: unit reads(store), writes(clock) waits {
  doc "Sleeps delay microseconds per key outside every hold, in slices of at most 100 ms, ending early when the attempt is cancelled or aborted, shutdown included, or when CONFIG SET changes the delay, which the next step then reads. The driver's timer rounds each slice up to whole milliseconds.";
  let micros = cvt.wrap::<i64, u64>(delay);
  let per_key = micros *sat 1000_u64;
  let remaining = per_key *sat keys;
  loop @sleeping {
    if remaining == 0_u64 {
      break @sleeping;
    }
    let part = imin(remaining, aof_rw_delay_slice);
    aof_rw_sleep(clock: clock, nanoseconds: part);
    set remaining = remaining -sat part;
    let cancelled = aof_rw_cancelled(store: store);
    if cancelled {
      break @sleeping;
    }
    let current = delay;
    atomic m = &store^.meta {
      set current = m^.aof_rewrite_key_delay;
    }
    if current != delay {
      break @sleeping;
    }
  }
  return unit;
}

struct AofReconcile {
  limit: u64;
  sequence: u64;
  length: u64;
  kind: u64;
  header: u64;
  factor: u64;
  remaining: u64;
  previous: u64;
  end: u64;
}

fn aof_rw_select_empty(factory: &HandleFactory, file: &WriteFile) -> result: Result<u64, unit> writes(factory), writes(file) waits {
  doc "Select database zero before journal output when the scan emitted no image; no scratch owner is needed.";
  let offset = 0_u64;
  loop {
    if offset >= 23_u64 {
      return Ok<u64, unit>(value: offset);
    }
    match std::fs::append_once(factory: factory, file: file, source: &aof_rw_select[0_u64..23_u64], start: offset, end: 23_u64) {
      Ok(value: next) => {
        if next <= offset {
          return Err<u64, unit>(error: unit);
        }
        set offset = next;
      }
      Err(error: problem) => {
        return Err<u64, unit>(error: unit);
      }
    }
  }
}

fn aof_rw_reconcile(factory: &HandleFactory, file: &WriteFile, block: &[u8], decoder: &AofReconcile) -> result: Result<u64, pkg::store::RewriteAbortReason> reads(block), writes(factory), writes(file), writes(decoder) waits {
  doc "Strip the internal sequence/length/kind frames while streaming chronological units, each complete replacement images or a one-key statement's own append-only bytes. A frame may cross a chunk; no output allocation is needed and each append borrows only this one at-most-64-KiB chunk.";
  let size = 0_u64;
  let offset = 0_u64;
  let length = block^.len;
  loop @records {
    if offset >= length {
      break @records;
    }
    if decoder^.remaining > 0_u64 {
      let end = offset +sat decoder^.remaining;
      if end > length {
        set end = length;
      }
      let bytes = &block^[0_u64..length];
      loop @append {
        if offset >= end {
          break @append;
        }
        match std::fs::append_once(factory: factory, file: file, source: bytes, start: offset, end: end) {
          Ok(value: next) => {
            if next <= offset {
              let reason_base_io_4 = pkg::store::RewriteAbortReason::BaseIo();
              return Err<u64, pkg::store::RewriteAbortReason>(error: reason_base_io_4);
            }
            let written = next -sat offset;
            set decoder^.remaining = decoder^.remaining -sat written;
            set size = size +sat written;
            set offset = next;
          }
          Err(error: problem) => {
            let reason_base_io_5 = pkg::store::RewriteAbortReason::BaseIo();
            return Err<u64, pkg::store::RewriteAbortReason>(error: reason_base_io_5);
          }
        }
      }
    } else if offset < block^.len {
      let byte = block^[offset];
      let wide = cvt.wrap::<u8, u64>(byte);
      let part = wide *wrap decoder^.factor;
      if decoder^.header < 8_u64 {
        set decoder^.sequence = decoder^.sequence +wrap part;
      } else if decoder^.header < 16_u64 {
        set decoder^.length = decoder^.length +wrap part;
      } else {
        set decoder^.kind = decoder^.kind +wrap part;
      }
      set offset = offset +sat 1_u64;
      set decoder^.header = decoder^.header +sat 1_u64;
      set decoder^.factor = decoder^.factor *wrap 256_u64;
      if decoder^.header == 8_u64 {
        set decoder^.factor = 1_u64;
      } else if decoder^.header == 16_u64 {
        set decoder^.factor = 1_u64;
      } else if decoder^.header == 24_u64 {
        if decoder^.kind > 1_u64 {
          let reason = pkg::store::RewriteAbortReason::JournalInvalid();
          return Err<u64, pkg::store::RewriteAbortReason>(error: reason);
        }
        if decoder^.sequence <= decoder^.previous {
          let reason_journal_invalid_6 = pkg::store::RewriteAbortReason::JournalInvalid();
          return Err<u64, pkg::store::RewriteAbortReason>(error: reason_journal_invalid_6);
        }
        if decoder^.sequence > decoder^.end {
          let reason_journal_invalid_7 = pkg::store::RewriteAbortReason::JournalInvalid();
          return Err<u64, pkg::store::RewriteAbortReason>(error: reason_journal_invalid_7);
        }
        if decoder^.length > decoder^.limit {
          let reason_journal_invalid_8 = pkg::store::RewriteAbortReason::JournalInvalid();
          return Err<u64, pkg::store::RewriteAbortReason>(error: reason_journal_invalid_8);
        }
        set decoder^.remaining = decoder^.length;
        set decoder^.previous = decoder^.sequence;
        set decoder^.sequence = 0_u64;
        set decoder^.length = 0_u64;
        set decoder^.kind = 0_u64;
        set decoder^.header = 0_u64;
        set decoder^.factor = 1_u64;
      }
    }
  }
  return Ok<u64, pkg::store::RewriteAbortReason>(value: size);
}
