alias Clock = std::time::Clock;
alias HandleFactory = std::io::HandleFactory;
alias Keyspace = pkg::store::Keyspace;

fn aof_desk_new() -> desk: Shared<AofDesk> pure {
  doc "A desk with no slot, which no context waits at; aof_desk_open puts the active file on it.";
  let empty = None<AofSlot>();
  let untaken = False();
  let state = AofDesk(slot: move empty, taken: untaken, covered: 0_u64, ready: 18446744073709551615_u64);
  return shared_new::<AofDesk>(value: move state);
}

fn aof_slot_close(slot: AofSlot, factory: &HandleFactory) -> result: unit writes(factory) waits {
  doc "Closes a slot's file, dropping its boundary and any pending bytes.";
  let AofSlot(file: file, boundary: boundary, pending: pending, error_logged: unused_logged) = move slot;
  std::fs::close_write(factory: factory, file: move file);
  return unit;
}

fn aof_desk_open(desk: &Shared<AofDesk>, factory: &HandleFactory, slot: AofSlot) -> result: unit reads(desk), writes(factory) waits {
  doc "Puts the slot aof_start opened on the desk before any connection is served.";
  let placed = Some<AofSlot>(value: move slot);
  atomic d = &desk^ {
    swap(first: &d^.slot, second: &placed);
    set d^.taken = False();
    set d^.ready = 18446744073709551615_u64;
  }
  match move placed {
    Some(value: displaced) => {
      aof_slot_close(slot: move displaced, factory: factory);
    }
    None() => {
    }
  }
  return unit;
}

fn aof_desk_close(desk: Shared<AofDesk>, factory: &HandleFactory) -> result: unit writes(factory) waits {
  doc "Ends one handle of the desk; the handle that ends last closes the file if the desk still holds it.";
  match shared_close::<AofDesk>(shared: move desk) {
    Some(value: state) => {
      let AofDesk(slot: slot, taken: taken, covered: covered, ready: ready) = move state;
      match move slot {
        Some(value: kept) => {
          aof_slot_close(slot: move kept, factory: factory);
        }
        None() => {
        }
      }
    }
    None() => {
    }
  }
  return unit;
}

fn aof_desk_holds(desk: &AofDesk) -> present: Bool reads(desk.slot) {
  doc "Whether the desk holds the slot.";
  match desk^.slot {
    Some(..) => {
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn aof_desk_take(desk: &Shared<AofDesk>) -> taken: Option<AofSlot> reads(desk) waits {
  doc "The maintenance context's take: waits until no context holds the slot and takes it, none once the desk is retired.";
  let taken = None<AofSlot>();
  atomic d = &desk^ when bnot(d^.taken) {
    let present = aof_desk_holds(desk: d);
    if present {
      swap(first: &d^.slot, second: &taken);
      set d^.taken = True();
      set d^.ready = d^.covered;
    }
  }
  return move taken;
}

fn aof_desk_return(desk: &Shared<AofDesk>, factory: &HandleFactory, slot: AofSlot, covered: u64) -> result: unit reads(desk), writes(factory) waits {
  doc "Puts the slot back and publishes the covered mark its holder saw, waking the waiters, each of which sends once covered and otherwise takes the slot.";
  let placed = Some<AofSlot>(value: move slot);
  atomic d = &desk^ {
    swap(first: &d^.slot, second: &placed);
    set d^.taken = False();
    set d^.covered = imax(d^.covered, covered);
    set d^.ready = 18446744073709551615_u64;
  }
  match move placed {
    Some(value: displaced) => {
      aof_slot_close(slot: move displaced, factory: factory);
    }
    None() => {
    }
  }
  return unit;
}

fn aof_desk_retire(desk: &Shared<AofDesk>, factory: &HandleFactory) -> result: unit reads(desk), writes(factory) waits {
  doc "At exit, after the last append and sync: takes the slot and closes its file, leaving the desk without one and every mark covered, as no record is written after it.";
  let taken = aof_desk_take(desk: desk);
  atomic d = &desk^ {
    set d^.taken = False();
    set d^.covered = 18446744073709551615_u64;
    set d^.ready = 18446744073709551615_u64;
  }
  match move taken {
    Some(value: slot) => {
      aof_slot_close(slot: move slot, factory: factory);
    }
    None() => {
    }
  }
  return unit;
}

fn aof_lead(store: &Keyspace, factory: &HandleFactory, slot: &AofSlot) -> covered: u64 reads(store), writes(factory), writes(slot) waits {
  doc "A connection that took the slot appends for every waiting connection: in one Meta statement it exchanges the collecting buffer for the empty pending one, noting the commit sequence that covers it, then appends outside every statement and returns the covered mark the append's Meta statement published. With an append error saved, or bytes retained by a failed append, which only the maintenance context's retry writes, so that bytes sealed for a rewrite's old file are never followed there by later ones, it writes nothing; the saved error releases every reply, as Redis 7.2.16 everysec sends replies while its writes fail (aof.c:1191-1213).";
  let retained = slot^.pending.inner.len != 0_u64;
  let exchanged = False();
  let covered = 0_u64;
  atomic m = &store^.meta {
    let failing = False();
    match m^.aof_append_error {
      Some(..) => {
        set failing = True();
      }
      None() => {
      }
    }
    let blocked = bor(failing, retained);
    if blocked {
      set covered = pkg::store::aof_covered(meta: m);
    } else {
      swap(first: &m^.log, second: &slot^.pending);
      set m^.aof_pending_sequence = m^.commit_seq;
      set m^.aof_pending_capacity = slot^.pending.inner.cap;
      set m^.aof_pending_length = slot^.pending.inner.len;
      set exchanged = True();
    }
  }
  if exchanged {
    let drained = aof_rw_drain(store: store, factory: factory, slot: slot);
    set covered = drained.covered;
  }
  return covered;
}

fn aof_desk_wait(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory, dependency: u64) -> covered: u64 reads(store), reads(desk), writes(factory) waits {
  doc "Waits until the desk's covered mark reaches the dependency, taking the slot and appending as aof_lead does whenever no context holds it, and returns the mark. At the saturated commit sequence a mark cannot tell a later record apart, so such a dependency is met only by an append this context leads after it.";
  let saturated = dependency == 18446744073709551615_u64;
  loop @waiting {
    let taken = None<AofSlot>();
    let seen = 0_u64;
    let done = False();
    if saturated {
      atomic d = &desk^ when bnot(d^.taken) {
        let present = aof_desk_holds(desk: d);
        if present {
          swap(first: &d^.slot, second: &taken);
          set d^.taken = True();
          set d^.ready = d^.covered;
        } else {
          set seen = d^.covered;
          set done = True();
        }
      }
    } else {
      atomic d = &desk^ when d^.ready >= dependency {
        if d^.covered >= dependency {
          set seen = d^.covered;
          set done = True();
        } else {
          let present = aof_desk_holds(desk: d);
          if present {
            swap(first: &d^.slot, second: &taken);
            set d^.taken = True();
            set d^.ready = d^.covered;
          } else {
            set seen = d^.covered;
            set done = True();
          }
        }
      }
    }
    match move taken {
      Some(value: slot) => {
        let marked = aof_lead(store: store, factory: factory, slot: &slot);
        aof_desk_return(desk: desk, factory: factory, slot: move slot, covered: marked);
        if saturated {
          return marked;
        }
        if marked >= dependency {
          return marked;
        }
      }
      None() => {
        if done {
          return seen;
        }
      }
    }
  }
}

fn aof_reply_wait(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory, client: &pkg::protocol::Client) -> result: unit reads(store), reads(desk), writes(factory), writes(client.aof_dependency), writes(client.aof_covered), writes(client.aof_unnoted) waits {
  doc "Before the replies the client holds are sent: with an append-only file, waits until every record they may have observed is in the file or released, as Redis 7.2.16 writes the AOF before it sends the replies of an event-loop iteration (server.c:1721-1739). The dependency is what the commands' own Meta statements noted; when a reply came from a command that noted none, it is first raised to the commit sequence one Meta statement reads. A dependency below the covered mark the client last saw sends at once; otherwise the client waits at the desk, and takes the slot and appends for every waiting connection when no context holds it.";
  if store^.logging {
  } else {
    return unit;
  }
  if client^.aof_unnoted {
    let seen = pkg::store::aof_seen(store: store);
    set client^.aof_dependency = imax(client^.aof_dependency, seen.commit);
    set client^.aof_covered = imax(client^.aof_covered, seen.covered);
    set client^.aof_unnoted = False();
  }
  let dependency = client^.aof_dependency;
  let saturated = dependency == 18446744073709551615_u64;
  if bnot(saturated) {
    if client^.aof_covered >= dependency {
      return unit;
    }
  }
  let covered = aof_desk_wait(store: store, desk: desk, factory: factory, dependency: dependency);
  set client^.aof_covered = imax(client^.aof_covered, covered);
  return unit;
}

fn aof_frame_wait(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory) -> result: unit reads(store), reads(desk), writes(factory) waits {
  doc "Before a subscribed connection's frame is sent: with an append-only file, reads the commit sequence in one Meta statement and waits as aof_reply_wait does until every record through it is in the file or released.";
  if store^.logging {
  } else {
    return unit;
  }
  let seen = pkg::store::aof_seen(store: store);
  let saturated = seen.commit == 18446744073709551615_u64;
  if bnot(saturated) {
    if seen.covered >= seen.commit {
      return unit;
    }
  }
  let covered = aof_desk_wait(store: store, desk: desk, factory: factory, dependency: seen.commit);
  return unit;
}

fn aof_desk_release(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory, slot: AofSlot) -> result: unit reads(store), reads(desk), writes(factory) waits {
  doc "Ends a maintenance turn: reads the covered mark in one Meta statement and puts the slot back with it.";
  let seen = pkg::store::aof_seen(store: store);
  aof_desk_return(desk: desk, factory: factory, slot: move slot, covered: seen.covered);
  return unit;
}

fn aof_rw_turn(store: &Keyspace, factory: &HandleFactory, desk: &Shared<AofDesk>, clock: &Clock, last_sync: &std::time::Instant, last_append: &std::time::Instant, force: Bool, healed: &Bool) -> result: unit reads(store), reads(desk), writes(factory), writes(clock), writes(last_sync), writes(last_append), writes(healed) waits {
  doc "One ordinary maintenance turn: takes the slot when no connection holds it and runs aof_rw_flush with it, which appends the records no reply waits for, retries a failed append and syncs the file through the handle that appended its bytes, then puts the slot back. Connections that wait meanwhile wait for the whole turn, the sync included.";
  let taken = aof_desk_take(desk: desk);
  match move taken {
    Some(value: slot) => {
      aof_rw_flush(store: store, factory: factory, slot: &slot, clock: clock, last_sync: last_sync, last_append: last_append, force: force, healed: healed);
      aof_desk_release(store: store, desk: desk, factory: factory, slot: move slot);
    }
    None() => {
    }
  }
  return unit;
}
