alias Clock = std::time::Clock;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias Keyspace = pkg::store::Keyspace;
alias Time = pkg::store::Time;
alias WriteFile = std::fs::WriteFile;

public fn write_log(store: Keyspace, factory: HandleFactory, log: AofLog, desk: Shared<AofDesk>, clock: Clock, time: Time, meter: std::process::MemoryMeter) -> result: unit pure waits doc "The maintenance context. Every 10 ms it takes the active file from the desk for a turn that appends the records no reply waits for, retries a failed append and syncs; start manual or automatic rewrites at a metadata cut, and join every rebuild before closing the directories. Retain failed appends for periodic recovery. After a saved sync error, each later successful sync with nothing retained starts a recovery rewrite, whatever the automatic-rewrite block, and only its durable installation clears the error; a recovery attempt that fails blocks automatic rewrites as any failed attempt does, and one that succeeds leaves the block as it found it, which only a manual success lifts. Main sets stopping only after clients have left; then take all collecting bytes for one final append and sync attempt, abandoning failures as Redis 7.0.15 everysec does (server.c:4239-4247,4301-4308), and retire the desk, closing the file.";

public struct Loaded {
  doc "What replaying an append-only file found: applied, how many commands it applied, size, how many bytes were read, and, when cut, kept, the length the file is to be cut to before anything is appended to it, as Redis 7.0.15 truncates a file whose end it could not load, and stopped, that the replay ended at a record it could not load and the server must not start, as Redis 7.0.15 exits. At EOF inside a block, kept follows Redis's partial-command or latest-MULTI truncation rule. unfinished and reverted describe the retained bytes after that cut: whether a block remains open and its first MULTI offset. interrupted reports that the replay saw a stop request and ended early, so its other fields describe no whole file and nothing may be written after it, as Redis 7.2.16 exits during loading without writing (server.c:1592-1599).";
  public applied: u64;
  public kept: u64;
  public size: u64;
  public cut: Bool;
  public stopped: Bool;
  public unfinished: Bool;
  public reverted: u64;
  public interrupted: Bool;
}

public fn replay(store: &Keyspace, factory: &HandleFactory, root: &DirectoryRead, name: &[u8], name_length: u64, time: &Time, clock: &Clock) -> loaded: Loaded reads(store), reads(root), reads(name), reads(time), writes(factory), writes(clock) waits contract {
  requires name_length <= name^.len;
} doc "Applies every command of the append-only file the name names, refusing an absent file, and returns how many it applied and how much of the file to keep. The commands between MULTI and EXEC apply only once their EXEC is read, so a block the file ends inside, as a write cut short leaves one, applies none of its commands, as Redis 7.0.15 reverts an incomplete MULTI/EXEC block while loading; an EXEC outside a block is passed over. A file whose reading reaches its end inside a command is to be cut after the last whole command, and one that ends cleanly inside a block before its latest MULTI, as Redis cuts each with aof-load-truncated, its default, so the commands appended after the replay follow whole commands; a file that ends after a whole command outside a block is kept whole. As Redis does while loading, no key counts as expired during the replay, time's check being zero, and an expiry whose calendar time has passed is kept as one already reached, so the commands after it in the file apply as they did when they were written; lazy and active expiry remove such a key once the server listens. A record that is not a well-formed command, a read that fails other than at the file's end, or a block or command larger than the input window's ceiling stops the replay with stopped true, as Redis 7.0.15 stops loading and exits. Before the first whole command the file's reading parses, and then once every 1024 commands, the replay reads the shutdown request a stop signal records and, when it is set, ends with interrupted true, applying nothing more and leaving the file to be closed unchanged, as Redis 7.2.16 serves events every 1024 commands while it loads (aof.c:1480-1485) and exits with status 0 when it finds a stop signal's request there (server.c:1592-1599).";

public struct AofPart {
  doc "A Redis manifest record: the filename, signed sequence and b, i or h type byte.";
  public name: Box<Slots<u8>>;
  public sequence: i64;
  public kind: u8;
}

public struct AofManifest {
  doc "The manifest records in input order, current base and incremental sequences, and whether disk needs updating. Serialization orders base, history and incremental records as Redis does.";
  public parts: Box<Slots<AofPart>>;
  public base_sequence: i64;
  public incr_sequence: i64;
  public dirty: Bool;
}

public struct AofBoundary {
  doc "The current incremental file's syntax and block boundary. whole means all bytes are known to be complete syntax; false requires a syntax-only disk scan before switching. unfinished and reverted identify its first unmatched MULTI, and size is its known length. No state is inferred from queued bytes.";
  public whole: Bool;
  public unfinished: Bool;
  public reverted: u64;
  public size: u64;
}

public struct AofLog {
  doc "The maintenance context owns the directory halves, appendfilename and manifest; the active incremental file is in the desk's slot, which a connection takes to append and the maintenance context takes for its turns; the scan worker owns its temporary base and journal read handles.";
  public directory: DirectoryRead;
  public writable: std::fs::DirectoryWrite;
  public prefix: Box<Slots<u8>>;
  public manifest: AofManifest;
}

public struct AofSlot {
  doc "The active incremental file's append handle, its block boundary and pending, the bytes taken from Meta's collecting buffer and not yet in the file, retained after a failed append. Only the context that took the slot from the desk touches them, so appends, truncations and syncs of the file never run concurrently.";
  public file: WriteFile;
  public boundary: AofBoundary;
  public pending: Box<Slots<u8>>;
}

public struct AofDesk {
  doc "Where the active file waits between appends, the shared object of group commit. slot holds the file while no context has taken it, and none once the maintenance context retires it at exit or without an append-only file; taken says a context holds it. covered is the largest mark a context that held the slot published: every record of a commit sequence at or below it is in the file or released by an append failure. ready is covered while the slot is taken and the largest u64 otherwise, so that a waiter's guard, ready at least its dependency, is one comparison that holds once its records are covered or the slot can be taken.";
  public slot: Option<AofSlot>;
  public taken: Bool;
  public covered: u64;
  public ready: u64;
}

public struct AofStarted {
  doc "What aof_start opened: the maintenance context's directories and manifest, and the slot that goes on the desk.";
  public log: AofLog;
  public slot: AofSlot;
}

public fn aof_desk_new() -> desk: Shared<AofDesk> pure doc "A desk with no slot, which no context waits at; aof_desk_open puts the active file on it.";

public fn aof_desk_open(desk: &Shared<AofDesk>, factory: &HandleFactory, slot: AofSlot) -> result: unit reads(desk), writes(factory) waits doc "Puts the slot aof_start opened on the desk before any connection is served.";

public fn aof_desk_close(desk: Shared<AofDesk>, factory: &HandleFactory) -> result: unit writes(factory) waits doc "Ends one handle of the desk; the handle that ends last closes the file if the desk still holds it.";

public fn aof_reply_wait(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory, client: &pkg::protocol::Client) -> result: unit reads(store), reads(desk), writes(factory), writes(client.aof_dependency), writes(client.aof_covered), writes(client.aof_unnoted) waits doc "Before the replies the client holds are sent: with an append-only file, waits until every record they may have observed is in the file or released, as Redis 7.2.16 writes the AOF before it sends the replies of an event-loop iteration (server.c:1721-1739). The dependency is what the commands' own Meta statements noted; when a reply came from a command that noted none, it is first raised to the commit sequence one Meta statement reads. A dependency below the covered mark the client last saw sends at once; otherwise the client waits at the desk, and takes the slot and appends for every waiting connection when no context holds it.";

public fn aof_frame_wait(store: &Keyspace, desk: &Shared<AofDesk>, factory: &HandleFactory) -> result: unit reads(store), reads(desk), writes(factory) waits doc "Before a subscribed connection's frame is sent: with an append-only file, reads the commit sequence in one Meta statement and waits as aof_reply_wait does until every record through it is in the file or released.";

public enum AofStartError {
  doc "Why aof_start returned no log. Failed is a manifest or file that did not load, a file that could not be cut or opened for appending, or a manifest that could not be written, which stops firn with status 4. Interrupted is a stop request the replay saw, returned before any file is cut, created or removed and before the manifest is written, so firn can exit with status 0 leaving appendonlydir as it found it after any upgrade, which precedes the replay as Redis 7.2.16's does (aof.c:1668-1676).";
  Failed();
  Interrupted();
}

public fn aof_start(store: &Keyspace, factory: &HandleFactory, cwd: &DirectoryRead, cwd_write: &std::fs::DirectoryWrite, prefix: &[u8], time: &Time, clock: &Clock) -> result: Result<AofStarted, AofStartError> reads(store), reads(cwd), reads(prefix), reads(time), writes(factory), writes(cwd_write), writes(clock) waits doc "Opens appendonlydir, loads and upgrades Redis's manifest layout, cuts only its last active file, removes listed history and opens its last incremental file with an empty 64-KiB pending buffer, whose capacity Meta counts. A refusal returns Err before firn listens; a stop request the replay saw returns Interrupted before anything after the replay writes appendonlydir.";
