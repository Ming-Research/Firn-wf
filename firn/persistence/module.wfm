alias Clock = std::time::Clock;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias Keyspace = pkg::store::Keyspace;
alias Time = pkg::store::Time;
alias WriteFile = std::fs::WriteFile;

public fn write_log(store: Keyspace, factory: HandleFactory, log: AofLog, clock: Clock, time: Time, meter: std::process::MemoryMeter) -> result: unit pure waits doc "Drain acknowledged commands, start manual or automatic rewrites at a metadata cut, and join every rebuild before closing the directories. Retain failed appends for periodic recovery. After a saved sync error, each later successful sync with nothing retained starts a recovery rewrite, whatever the automatic-rewrite block, and only its durable installation clears the error; a recovery attempt that fails blocks automatic rewrites as any failed attempt does, and one that succeeds leaves the block as it found it, which only a manual success lifts. Main sets stopping only after clients have left; then take all collecting bytes for one final append and sync attempt, abandoning failures as Redis 7.0.15 everysec does (server.c:4239-4247,4301-4308).";

public struct Loaded {
  doc "What replaying an append-only file found: applied, how many commands it applied, size, how many bytes were read, and, when cut, kept, the length the file is to be cut to before anything is appended to it, as Redis 7.0.15 truncates a file whose end it could not load, and stopped, that the replay ended at a record it could not load and the server must not start, as Redis 7.0.15 exits. At EOF inside a block, kept follows Redis's partial-command or latest-MULTI truncation rule. unfinished and reverted describe the retained bytes after that cut: whether a block remains open and its first MULTI offset. interrupted reports that the replay saw a stop request and ended early, so its other fields describe no whole file and nothing may be written after it, as Redis 7.2.16 exits during loading without writing (server.c:1592-1599).";
  public applied: u64;
  public kept: u64;
  public size: u64;
  public cut: Bool;
  public stopped: Bool;
  public unfinished: Bool;
  public reverted: u64;
  public interrupted: Bool;
}

public fn replay(store: &Keyspace, factory: &HandleFactory, root: &DirectoryRead, name: &[u8], name_length: u64, time: &Time, clock: &Clock) -> loaded: Loaded reads(store), reads(root), reads(name), reads(time), writes(factory), writes(clock) waits contract {
  requires name_length <= name^.len;
} doc "Applies every command of the append-only file the name names, refusing an absent file, and returns how many it applied and how much of the file to keep. The commands between MULTI and EXEC apply only once their EXEC is read, so a block the file ends inside, as a write cut short leaves one, applies none of its commands, as Redis 7.0.15 reverts an incomplete MULTI/EXEC block while loading; an EXEC outside a block is passed over. A file whose reading reaches its end inside a command is to be cut after the last whole command, and one that ends cleanly inside a block before its latest MULTI, as Redis cuts each with aof-load-truncated, its default, so the commands appended after the replay follow whole commands; a file that ends after a whole command outside a block is kept whole. As Redis does while loading, no key counts as expired during the replay, time's check being zero, and an expiry whose calendar time has passed is kept as one already reached, so the commands after it in the file apply as they did when they were written; lazy and active expiry remove such a key once the server listens. A record that is not a well-formed command, a read that fails other than at the file's end, or a block or command larger than the input window's ceiling stops the replay with stopped true, as Redis 7.0.15 stops loading and exits. Before the first whole command the file's reading parses, and then once every 1024 commands, the replay reads the shutdown request a stop signal records and, when it is set, ends with interrupted true, applying nothing more and leaving the file to be closed unchanged, as Redis 7.2.16 serves events every 1024 commands while it loads (aof.c:1480-1485) and exits with status 0 when it finds a stop signal's request there (server.c:1592-1599).";

public struct AofPart {
  doc "A Redis manifest record: the filename, signed sequence and b, i or h type byte.";
  public name: Box<Slots<u8>>;
  public sequence: i64;
  public kind: u8;
}

public struct AofManifest {
  doc "The manifest records in input order, current base and incremental sequences, and whether disk needs updating. Serialization orders base, history and incremental records as Redis does.";
  public parts: Box<Slots<AofPart>>;
  public base_sequence: i64;
  public incr_sequence: i64;
  public dirty: Bool;
}

public struct AofBoundary {
  doc "The current incremental file's syntax and block boundary. whole means all bytes are known to be complete syntax; false requires a syntax-only disk scan before switching. unfinished and reverted identify its first unmatched MULTI, and size is its known length. No state is inferred from queued bytes.";
  public whole: Bool;
  public unfinished: Bool;
  public reverted: u64;
  public size: u64;
}

public struct AofLog {
  doc "The writer owns the directory halves, appendfilename, manifest and last incremental file; the scan worker owns its temporary base and journal read handles, leaving boundary validation and authoritative appends with the writer.";
  public directory: DirectoryRead;
  public writable: std::fs::DirectoryWrite;
  public prefix: Box<Slots<u8>>;
  public manifest: AofManifest;
  public file: WriteFile;
  public boundary: AofBoundary;
}

public enum AofStartError {
  doc "Why aof_start returned no log. Failed is a manifest or file that did not load, a file that could not be cut or opened for appending, or a manifest that could not be written, which stops firn with status 4. Interrupted is a stop request the replay saw, returned before any file is cut, created or removed and before the manifest is written, so firn can exit with status 0 leaving appendonlydir as it found it after any upgrade, which precedes the replay as Redis 7.2.16's does (aof.c:1668-1676).";
  Failed();
  Interrupted();
}

public fn aof_start(store: &Keyspace, factory: &HandleFactory, cwd: &DirectoryRead, cwd_write: &std::fs::DirectoryWrite, prefix: &[u8], time: &Time, clock: &Clock) -> result: Result<AofLog, AofStartError> reads(store), reads(cwd), reads(prefix), reads(time), writes(factory), writes(cwd_write), writes(clock) waits doc "Opens appendonlydir, loads and upgrades Redis's manifest layout, cuts only its last active file, removes listed history and opens its last incremental file. A refusal returns Err before firn listens; a stop request the replay saw returns Interrupted before anything after the replay writes appendonlydir.";
